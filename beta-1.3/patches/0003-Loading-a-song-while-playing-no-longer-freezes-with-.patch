From bc6f34635d244ee80f76ccba2964e2f6284a1bfe Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 14:54:03 +0000
Subject: [PATCH 3/9] Loading a song while playing no longer freezes with E455
 when the old song has an arrangement

Song::deleteSoundsWhichWontSound() emptied every Output's clipInstances only after its two loops
had deleted the clips that won't sound. Since #4903, deleteClipObject() freezes with E455 when a
clip still has instances, so any song with an arrangement whose clips weren't all playing froze
on a song change during playback. Empty the instances first: the end state is the same, and the
arrangement never points at freed clips.

Test (beta-1.3/tests): songswap_e455_emu.py, E455 on 62a516c2 in both loops; passes now.
---
 src/deluge/model/song/song.cpp | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/deluge/model/song/song.cpp b/src/deluge/model/song/song.cpp
index 1c9a8c1b..78b24e5f 100644
--- a/src/deluge/model/song/song.cpp
+++ b/src/deluge/model/song/song.cpp
@@ -2434,6 +2434,12 @@ void Song::loadCrucialSamplesOnly() {
 
 void Song::deleteSoundsWhichWontSound() {
 
+	// The arrangement goes first: the Clips deleted below may have ClipInstances, and deleteClipObject() requires those
+	// to be gone (E455). Nothing needs them any more - only session playback carries on until the song swap
+	for (Output* thisOutput = firstOutput; thisOutput; thisOutput = thisOutput->next) {
+		thisOutput->clipInstances.empty();
+	}
+
 	// Delete Clips inactive on Output
 	// For each Clip in session and arranger
 	AllClips allClips = AllClips::everywhere(this);
@@ -2465,10 +2471,6 @@ void Song::deleteSoundsWhichWontSound() {
 		}
 	}
 
-	for (Output* thisOutput = firstOutput; thisOutput; thisOutput = thisOutput->next) {
-		thisOutput->clipInstances.empty();
-	}
-
 	deleteAllOutputs((Output**)&firstHibernatingInstrument);
 	deleteHibernatingMIDIInstrument();
 
