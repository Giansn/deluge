From 02cbdf94d4cb2e5883b5ef7f921eef0a22678883 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 14:54:03 +0000
Subject: [PATCH 2/9] Save songs without duplicate audio clip attributes, keep
 a named CV track's channel; guard allowNoteTails (#4917, #4938)

- AudioClip::writeDataToFile() called Clip::writeDataToFile() twice: six attributes of every
  <audioClip> (colourOffset, isArmedForRecording, isPlaying, isSoloing, length, section) were
  written twice, which strict XML readers refuse (#4917).
- A named CV instrument now writes its channel too. Without it, it loaded on channel 0, the clip's
  cvChannel="1" found no instrument, and loading the song failed with "Error 5" (file corrupted).
- InstrumentClip::allowNoteTails(): a kit row whose ParamManager has no main collections (briefly,
  during NoteRow::setDrum()) is treated as allowing tails instead of reading through a null
  patched-param set (#4938, the guard proposed in the issue).

Test (beta-1.3/tests): save_4917_emu.py, fails on 62a516c2 (duplicates, no channel, Error 5 on load).
---
 src/deluge/model/clip/audio_clip.cpp       | 3 ++-
 src/deluge/model/clip/instrument_clip.cpp  | 5 +++++
 src/deluge/model/instrument/instrument.cpp | 4 +++-
 3 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/deluge/model/clip/audio_clip.cpp b/src/deluge/model/clip/audio_clip.cpp
index aeb4ea57..1b65337e 100644
--- a/src/deluge/model/clip/audio_clip.cpp
+++ b/src/deluge/model/clip/audio_clip.cpp
@@ -1090,7 +1090,8 @@ void AudioClip::writeDataToFile(Serializer& writer, Song* song) {
 		writer.writeAttribute("lastSelectedParamArrayPosition", lastSelectedParamArrayPosition);
 	}
 
-	Clip::writeDataToFile(writer, song);
+	// Once: a second call wrote colourOffset, isArmedForRecording, isPlaying, isSoloing, length and section twice
+	// into every <audioClip>, which strict XML readers refuse (#4917)
 	Clip::writeDataToFile(writer, song);
 
 	writer.writeOpeningTagEnd();
diff --git a/src/deluge/model/clip/instrument_clip.cpp b/src/deluge/model/clip/instrument_clip.cpp
index 569462c5..64269815 100644
--- a/src/deluge/model/clip/instrument_clip.cpp
+++ b/src/deluge/model/clip/instrument_clip.cpp
@@ -3358,6 +3358,11 @@ bool InstrumentClip::allowNoteTails(ModelStackWithNoteRow* modelStack) {
 	if (!noteRow || !noteRow->drum) {
 		return true;
 	}
+	// A SoundDrum's NoteRow can briefly have no ParamManager (drum reassignment, kit loading); Sound::allowNoteTails()
+	// would dereference its missing PatchedParamSet (#4938)
+	if (noteRow->drum->type == DrumType::SOUND && !noteRow->paramManager.containsAnyMainParamCollections()) {
+		return true;
+	}
 	ModelStackWithSoundFlags* modelStackWithSoundFlags =
 	    modelStack->addOtherTwoThings(noteRow->drum->toModControllable(), &noteRow->paramManager)->addSoundFlags();
 	return noteRow->drum->allowNoteTails(
diff --git a/src/deluge/model/instrument/instrument.cpp b/src/deluge/model/instrument/instrument.cpp
index 5d108d8f..bd6e5fb0 100644
--- a/src/deluge/model/instrument/instrument.cpp
+++ b/src/deluge/model/instrument/instrument.cpp
@@ -86,7 +86,9 @@ bool Instrument::writeDataToFile(Serializer& writer, Clip* clipForSavingOutputOn
 		if (!name.isEmpty()) {
 			writer.writeAttribute("presetName", name.get());
 		}
-		else if (type == OutputType::CV) {
+		// A CV instrument's channel also when it has a name: without it, a named one loads on channel 0 and its
+		// Clips (cvChannel="N") find no instrument, so the song fails to load as corrupted (#4917)
+		if (type == OutputType::CV) {
 			char const* slotXMLTag = getSlotXMLTag();
 
 			writer.writeAttribute(slotXMLTag, ((NonAudioInstrument*)this)->getChannel());
