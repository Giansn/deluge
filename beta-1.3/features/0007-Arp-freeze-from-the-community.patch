+
+/// The length and play direction of a clip and the lengths and directions of its rows, as an arp freeze changes them.
+/// Construct it before the change: reverting swaps the stored layout with the current one, so the same consequence does
+/// the undo and the redo. It keeps the clip playing from the same place.
+class ConsequenceArpFreezeLayout final : public Consequence {
+public:
+	ConsequenceArpFreezeLayout(InstrumentClip* newClip);
+	Error revert(TimeType time, ModelStack* modelStack) override;
+
+	struct RowLayout {
+		int32_t noteRowId;
+		int32_t loopLengthIfIndependent;
+		SequenceDirection sequenceDirectionMode;
+	};
+
+	InstrumentClip* clip;
+	int32_t loopLength;
+	SequenceDirection sequenceDirectionMode;
+	deluge::vector<RowLayout> rows;
+};
