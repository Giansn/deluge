+
+namespace deluge::gui::menu_item {
+
+/// Settings > Tuning > Master tune (Hz): reference pitch of A4, shown as 440.0
+class MasterTuneHz final : public Decimal {
+public:
+	using Decimal::Decimal;
+	[[nodiscard]] int32_t getMinValue() const override { return ::MasterTune::kMinTenthsHz; }
+	[[nodiscard]] int32_t getMaxValue() const override { return ::MasterTune::kMaxTenthsHz; }
+	[[nodiscard]] int32_t getNumDecimalPlaces() const override { return 1; }
+	[[nodiscard]] int32_t getDefaultEditPos() const override { return 1; }
+	void readCurrentValue() override { this->setValue(::MasterTune::getTenthsHz()); }
+	void writeCurrentValue() override { ::MasterTune::set(this->getValue()); }
+	// Decimal's own shows two decimal places (hundredths)
+	void getNotificationValue(StringBuf& valueBuf) override { valueBuf.appendFloat(this->getValue() / 10.f, 1, 1); }
+};
+
+} // namespace deluge::gui::menu_item
