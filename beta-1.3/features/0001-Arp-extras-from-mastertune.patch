+
+namespace deluge::gui::menu_item::arpeggiator {
+// Bounce velocity (mastertune): how a bouncing ratchet's velocity follows its gaps: even (every hit keeps it), fade
+// (softer as the gaps get shorter, like a ball coming to rest) or rise (louder, like a ping-pong ball between closing
+// plates)
+class BounceFade final : public Selection {
+public:
+	using Selection::Selection;
+	void readCurrentValue() override {
+		this->setValue(util::to_underlying(soundEditor.currentArpSettings->ratchetBounceFade));
+	}
+	bool usesAffectEntire() override { return true; }
+	void writeCurrentValue() override {
+		auto fade = static_cast<BounceVelocity>(this->getValue());
+		// If affect-entire button held, do whole kit
+		if (currentUIMode == UI_MODE_HOLDING_AFFECT_ENTIRE_IN_SOUND_EDITOR && soundEditor.editingKitRow()) {
+			for (Drum* thisDrum = getCurrentKit()->firstDrum; thisDrum != nullptr; thisDrum = thisDrum->next) {
+				thisDrum->arpSettings.ratchetBounceFade = fade;
+			}
+		}
+		else {
+			soundEditor.currentArpSettings->ratchetBounceFade = fade;
+		}
+	}
+	deluge::vector<std::string_view> getOptions(OptType optType) override {
+		(void)optType;
+		using enum l10n::String;
+		return {l10n::getView(STRING_FOR_BOUNCE_EVEN), l10n::getView(STRING_FOR_BOUNCE_SOFTER),
+		        l10n::getView(STRING_FOR_BOUNCE_LOUDER)};
+	}
+	bool isRelevant(ModControllableAudio* modControllable, int32_t whichThing) const override {
+		return soundEditor.currentArpSettings != nullptr;
+	}
+	void getColumnLabel(StringBuf& label) override {
+		label.append(deluge::l10n::get(deluge::l10n::built_in::seven_segment, this->name));
+	}
+};
+} // namespace deluge::gui::menu_item::arpeggiator
