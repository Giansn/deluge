+	float span = kStep * (float)ratchetSpanSteps;
+	float partSpan = 0.0f;
+	if (rollBall) {
+		// The plates meet after the first step (kBallMeet of a ratchet of one step), and part over the rest
+		float closeSpan = (ratchetSpanSteps >= 2) ? kStep : span * kBallMeet;
+		partSpan = span - closeSpan;
+		span = closeSpan;
+	}
+	// The buzz's gap in positions: from the arp's speed at the last render, or a guess before the first one
+	uint32_t increment = lastGateIncrement;
+	if (increment == 0 && settings->syncLevel != 0) {
+		increment = settings->getPhaseIncrement(0) >> 8;
+	}
+	float minGapSamples = rollBall ? kBallMinGapSamples : kRollMinGapSamples;
+	float minGap = (increment != 0) ? (float)increment * minGapSamples : kStep / 8;
+	minGap = std::clamp(minGap, kStep / 256, span);
+
+	int32_t amount = std::clamp<int32_t>(settings->ratchetBounce, -kMaxRatchetBounce, kMaxRatchetBounce);
+	rollSpan = span;
+	rollMinGap = minGap;
+	rollMirrored = amount < 0;
+	uint32_t hits;
+	if (amount == 0) {
+		rollRatio = 1.0f;
+		rollEvenGap = std::max(kStep / 8, minGap);
+		rollGeometricHits = 0;
+		hits = (uint32_t)(span / rollEvenGap);
+		rollLongestGap = rollShortestGap = rollEvenGap;
+	}
+	else {
+		float ratio = 1.0f - 0.05f * (float)std::abs(amount);
+		rollRatio = ratio;
+		// K: the first hit whose gap, S (1 - r) r^K, is shorter than the buzz's
+		float gap = span * (1.0f - ratio);
+		float remaining = span; // S r^K: from hit K to the end
+		uint32_t geometric = 0;
+		while (gap >= minGap && geometric < kMaxRollHits) {
+			gap *= ratio;
+			remaining *= ratio;
+			geometric++;
+		}
+		rollGeometricHits = geometric;
+		// Hits 0 ... K - 1 with their shrinking gaps, then the buzz from hit K, each at least one buzz gap before S
+		hits = geometric + (uint32_t)(remaining / minGap);
+		rollLongestGap = (geometric > 0) ? span * (1.0f - ratio) : minGap;
+		rollShortestGap = minGap;
+	}
+	if (rollBall) {
+		// The closing: the roll into the meeting point, as above, over the first step. The parting: the same kind of
+		// roll over the rest, backwards (its ratio from kBallPartFactor), so the ball slows down for as long as the
+		// bounce length leaves
+		rollSpanPart = partSpan;
+		rollBallHalfHits = std::clamp<uint32_t>(hits, 1, kMaxRollHits / 2);
+		rollRatioPart = rollRatio;
+		rollGeometricHitsPart = 0;
+		uint32_t partHits;
+		if (amount != 0) {
+			float ratio = std::max(0.3f, 1.0f - kBallPartFactor * (1.0f - rollRatio));
+			float gap = partSpan * (1.0f - ratio);
+			float remaining = partSpan;
+			uint32_t geometric = 0;
+			while (gap >= minGap && geometric < kMaxRollHits) {
+				gap *= ratio;
+				remaining *= ratio;
+				geometric++;
+			}
+			rollRatioPart = ratio;
+			rollGeometricHitsPart = geometric;
+			partHits = geometric + (uint32_t)(remaining / minGap);
+			// the parting's first gap (its last in time) is the longest of the ratchet
+			rollLongestGap = std::max(rollLongestGap, (geometric > 0) ? partSpan * (1.0f - ratio) : minGap);
+		}
+		else {
+			partHits = (uint32_t)(partSpan / rollEvenGap);
+		}
+		rollBallPartHits = std::clamp<uint32_t>(partHits, 1, kMaxRollHits / 2);
+		ratchetNotesCount = rollBallHalfHits + rollBallPartHits;
+		return;
+	}
+	ratchetNotesCount = std::clamp<uint32_t>(hits, 1, kMaxRollHits);
+}
+
+// Where hit index of an accelerating roll starts, in positions from the start of the ratchet
+float ArpeggiatorBase::getRollStartAccelerating(uint32_t index) {
+	return getRollStart(index, rollRatio, rollGeometricHits, rollSpan);
+}
+
+// The same for a roll over span with the given ratio and number of hits before its buzz (a ball's parting has its own)
+float ArpeggiatorBase::getRollStart(uint32_t index, float ratio, uint32_t geometricHits, float span) {
+	if (ratio >= 1.0f) {
+		return (float)index * rollEvenGap;
+	}
+	if (index <= geometricHits) {
+		return span * (1.0f - std::pow(ratio, (float)index));
+	}
+	return span * (1.0f - std::pow(ratio, (float)geometricHits)) + (float)(index - geometricHits) * rollMinGap;
+}
+
+// Where the note at index of the current ratchet starts, in 1/2^24ths of a step from the start of the ratchet. Index
+// ratchetNotesCount (and beyond) is its end
+uint32_t ArpeggiatorBase::getRatchetNoteStart(uint32_t index) {
+	uint32_t end = ratchetSpanSteps << 24;
+	if (isRatchetRolling) {
+		if (index >= ratchetNotesCount) {
+			return end;
+		}
+		float start;
+		if (rollBall) {
+			// rollSpan is the closing's part of the ratchet, rollSpanPart the parting's. Meeting inside: the roll into
+			// the meeting point (h hits), a hit right on it, then the parting roll (p hits) backwards from the end.
+			// Meeting at the ends: the parting roll backwards out of the start, then the roll into the end
+			uint32_t h = rollBallHalfHits;
+			uint32_t p = rollBallPartHits;
+			if (!rollMirrored) {
+				if (index < h) {
+					start = getRollStartAccelerating(index);
+				}
+				else if (index == h) {
+					start = rollSpan;
+				}
+				else {
+					start = rollSpan + rollSpanPart
+					        - getRollStart(h + p - index, rollRatioPart, rollGeometricHitsPart, rollSpanPart);
+				}
+			}
+			else {
+				start = (index == 0) ? 0.0f
+				        : (index < p)
+				            ? rollSpanPart - getRollStart(p - index, rollRatioPart, rollGeometricHitsPart, rollSpanPart)
+				            : rollSpanPart + getRollStartAccelerating(index - p);
+			}
+			return std::min((uint32_t)start, end);
+		}
+		if (!rollMirrored) {
+			start = getRollStartAccelerating(index);
+		}
+		else if (index == 0) {
+			start = 0.0f;
+		}
+		else {
+			start = rollSpan - getRollStartAccelerating(ratchetNotesCount - index);
+		}
+		return std::min((uint32_t)start, end);
+	}
+	if (isRatchetBouncing) {
+		return ratchetNoteStarts[std::min(index, ratchetNotesCount)];
+	}
+	if (ratchetNotesCount == 0) {
+		return 0;
+	}
+	// Evenly spaced. For the random counts (powers of two) this is exactly index * (maxGate >> multiplier)
+	return (uint32_t)(((uint64_t)std::min(index, ratchetNotesCount) * end) / ratchetNotesCount);
+}
