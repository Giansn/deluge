+#pragma once
+#include "gui/menu_item/selection.h"
+#include "gui/l10n/l10n.h"
+#include "gui/ui/sound_editor.h"
+#include "model/drum/drum.h"
+#include "model/instrument/kit.h"
+#include "model/song/song.h"
+#include "modulation/arpeggiator.h"
+
+namespace deluge::gui::menu_item::arpeggiator {
+// Number of notes in a ratchet (mastertune): Auto picks 2, 4 or 8 at random as 1.3 does (weighted by the ratchet
+// amount), 2 ... 8 always exactly that many, Roll as many as fit until the plates close, Ball a ping-pong ball between
+// plates that meet and part again (see the arp's setupRatchetRoll())
+class RatchetNotes final : public Selection {
+public:
+	using Selection::Selection;
+	void readCurrentValue() override {
+		uint8_t notes = soundEditor.currentArpSettings->ratchetNotes;
+		this->setValue((notes == kRatchetNotesRoll)   ? kRollOption
+		               : (notes == kRatchetNotesBall) ? kBallOption
+		               : (notes >= 2)                 ? notes - 1
+		                                              : 0);
+	}
+	bool usesAffectEntire() override { return true; }
+	void writeCurrentValue() override {
+		int32_t option = this->getValue();
+		uint8_t notes = (option == kRollOption)   ? kRatchetNotesRoll
+		                : (option == kBallOption) ? kRatchetNotesBall
+		                : (option == 0)           ? 0
+		                                          : option + 1;
+		// If affect-entire button held, do whole kit
+		if (currentUIMode == UI_MODE_HOLDING_AFFECT_ENTIRE_IN_SOUND_EDITOR && soundEditor.editingKitRow()) {
+			for (Drum* thisDrum = getCurrentKit()->firstDrum; thisDrum != nullptr; thisDrum = thisDrum->next) {
+				thisDrum->arpSettings.ratchetNotes = notes;
+			}
+		}
+		else {
+			soundEditor.currentArpSettings->ratchetNotes = notes;
+		}
+	}
+	deluge::vector<std::string_view> getOptions(OptType optType) override {
+		(void)optType;
+		using enum l10n::String;
+		return {l10n::getView(STRING_FOR_AUTO), "2", "3", "4", "5", "6", "7", "8", l10n::getView(STRING_FOR_ROLL),
+		        l10n::getView(STRING_FOR_BALL)};
+	}
+	bool isRelevant(ModControllableAudio* modControllable, int32_t whichThing) const override {
+		return soundEditor.currentArpSettings != nullptr;
+	}
+	void getColumnLabel(StringBuf& label) override {
+		label.append(deluge::l10n::get(deluge::l10n::built_in::seven_segment, this->name));
+	}
+
+private:
+	static constexpr int32_t kRollOption = 8;
+	static constexpr int32_t kBallOption = 9;
+};
+} // namespace deluge::gui::menu_item::arpeggiator
