+uint8_t ArpeggiatorBase::applyRatchetBounceToVelocity(ArpeggiatorSettings* settings, uint8_t velocity) {
+	if (ratchetNotesIndex >= ratchetNotesCount) {
+		return velocity;
+	}
+	uint8_t scale;
+	if (isRatchetRolling) {
+		float gap = (float)(getRatchetNoteStart(ratchetNotesIndex + 1) - getRatchetNoteStart(ratchetNotesIndex));
+		gap = std::clamp(gap, rollShortestGap, rollLongestGap);
+		scale = getBounceVelocityScale(settings->ratchetBounceFade, gap, rollLongestGap, rollShortestGap);
+	}
+	else if (isRatchetBouncing) {
+		scale = ratchetNoteVelocityScales[ratchetNotesIndex];
+	}
+	else {
+		return velocity;
+	}
+	uint32_t scaled = ((uint32_t)velocity * scale + 127) / 255;
+	return std::max<uint32_t>(scaled, 1);
+}
