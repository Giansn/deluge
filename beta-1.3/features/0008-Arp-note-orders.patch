@@ -542,7 +542,17 @@ enum class ArpNoteMode {
 	WALK3,
 	AS_PLAYED,
 	PATTERN,
-};
+	// mastertune: fixed orders of the held notes, an octave each (modulation/arp_note_order.h)
+	CONVERGE,     // lowest, highest, 2nd lowest, 2nd highest, ...
+	DIVERGE,      // from the middle outwards (Converge backwards)
+	UP_DOWN_EXCL, // up, then down without playing the top and the bottom note twice
+	THUMB,        // the lowest note between each of the others, going up
+	PINKY,        // the highest note between each of the others, going up
+};
+/// mastertune: whether the note mode is one of the fixed orders above
+constexpr bool isOrderedArpNoteMode(ArpNoteMode mode) {
+	return mode >= ArpNoteMode::CONVERGE && mode <= ArpNoteMode::PINKY;
+}
 
