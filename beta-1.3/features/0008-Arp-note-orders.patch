+#pragma once
+
+#include "definitions_cxx.hpp"
+#include <cstdint>
+
+/// mastertune: the arpeggiator's fixed note orders (isOrderedArpNoteMode()). A cycle goes once through the n notes
+/// held (0 the lowest, n - 1 the highest); after it the arpeggiator moves on to the next octave as its octave mode
+/// says, as Up does.
+namespace arp_note_order {
+
+/// How many steps a cycle through n notes takes
+constexpr int32_t cycleLength(ArpNoteMode mode, int32_t n) {
+	if (n <= 1) {
+		return 1;
+	}
+	switch (mode) {
+	case ArpNoteMode::UP_DOWN_EXCL:
+		return 2 * n - 2; // 0 .. n-1, then n-2 .. 1
+	case ArpNoteMode::THUMB:
+	case ArpNoteMode::PINKY:
+		return 2 * (n - 1); // the held note between each of the others
+	default:
+		return n; // Converge, Diverge
+	}
+}
+
+/// Which of the n notes the step plays
+constexpr int32_t noteIndex(ArpNoteMode mode, int32_t step, int32_t n) {
+	if (n <= 1) {
+		return 0;
+	}
+	step %= cycleLength(mode, n);
+	switch (mode) {
+	case ArpNoteMode::CONVERGE: // 0, n-1, 1, n-2, ...
+		return (step & 1) ? n - 1 - (step >> 1) : (step >> 1);
+	case ArpNoteMode::DIVERGE: // Converge backwards: from the middle outwards
+		return noteIndex(ArpNoteMode::CONVERGE, n - 1 - step, n);
+	case ArpNoteMode::UP_DOWN_EXCL:
+		return (step < n) ? step : 2 * n - 2 - step;
+	case ArpNoteMode::THUMB: // 0, 1, 0, 2, 0, 3, ...
+		return (step & 1) ? 1 + (step >> 1) : 0;
+	case ArpNoteMode::PINKY: // 0, n-1, 1, n-1, 2, n-1, ...
+		return (step & 1) ? n - 1 : (step >> 1);
+	default:
+		return 0;
+	}
+}
+
+} // namespace arp_note_order
