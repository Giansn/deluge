+void UsbAudioSetting::writeCurrentValue() {
+	Setting::writeCurrentValue();
+	// mastertune: saved to the card at once. The Settings menu saves only when it's left, and this setting asks for
+	// a restart, which people do right from here: then it was lost. Not while the card is busy (a select press waits
+	// for that anyway); then, as ever, when the menu is left.
+	if (!sdRoutineLock) {
+		// The startup song as it was (as the CPU monitor's save keeps it): a song loaded but not saved mustn't become
+		// the one "Last saved" opens; leaving the menu writes the file as v1.3 does
+		runtimeFeatureSettings.writeSettingsToFile(false);
+	}
+	display->displayPopup(l10n::get(l10n::String::STRING_FOR_RESTART_TO_APPLY));
+}
