+class CpuMonitorMode final : public Selection {
+public:
+	using Selection::Selection;
+	void readCurrentValue() override { this->setValue(cpu_stats::mode); }
+	void writeCurrentValue() override { cpu_stats::setMode(this->getValue()); }
+	deluge::vector<std::string_view> getOptions(OptType optType) override {
+		(void)optType;
+		using enum l10n::String;
+		return {l10n::getView(STRING_FOR_OFF), l10n::getView(STRING_FOR_ON), l10n::getView(STRING_FOR_CPU_ALERTS)};
+	}
+};
+} // namespace deluge::gui::menu_item
