+
+#pragma once
+
+// CPU monitor (from mastertune 1.2.1): Settings > CPU monitor, or LEARN held and the tempo encoder pressed (shortcut());
+// the mode is kept on the card across a restart (readSetting()). While on, it measures how long AudioEngine::routine()
+// takes for the audio it renders, counts voices, direness, culled voices and SD cluster reads, shows a line on the OLED
+// (a short popup on the 7-segment display) and sends the numbers once a second as SysEx to the computer over USB MIDI
+// (port 3, never to DIN). It only measures: no sound is changed. While off, each hook costs one flag test. The SysEx
+// format is in cpu_stats_core.h, the page that shows it is mastertune-1.2.1/tools/cpu_monitor.html.
+
+#include "processing/engines/cpu_stats_core.h"
+
+namespace cpu_stats {
+
+/// Settings > CPU monitor: Off, On, Alerts. (mastertune 1.2.1 has a fourth mode, Profile, with its sampling profiler,
+/// which this port leaves out; a Profile saved there is read as On.)
+enum Mode : uint8_t {
+	OFF,    ///< Nothing measured
+	ON,     ///< The line on the OLED (a popup on the 7-segment display) and the SysEx
+	ALERTS, ///< Only the warnings, when voices are cut or the quality is lowered
+};
+constexpr uint8_t kSavedProfile = 3; ///< mastertune 1.2.1's Profile, as saved on the card
+extern uint8_t mode;
+void setMode(uint8_t newMode);
+
+/// LEARN held and the tempo encoder pressed (hid/buttons.cpp): Off, and back on in the last of On and Alerts (at first
+/// On). Shows the mode in a popup; the save to the card follows in saveRoutine().
+void shortcut();
+
+/// Task with the SD card's resource: writes the community settings file after the shortcut changed the mode
+void saveRoutine();
+
+/// The mode's entry in CommunityFeatures.XML on the SD card (written with the community features, as MasterTune's), so
+/// it survives a restart. Firmware that doesn't know it keeps it as an unknown setting.
+constexpr char const* kSettingName = "cpuMonitor";
+
+/// Reads our entry from the community settings file at boot (mastertune's Profile as On). Returns false if the entry is
+/// not ours.
+bool readSetting(char const* name, int32_t value);
+
+/// Measuring: On or Alerts
+extern bool enabled;
+extern Collector collector;
+
+/// OS timer 0, see cpu_stats_core.h
+uint32_t now();
+
+/// Frame one call of AudioEngine::routine(), only while enabled
+void routineStart();
+void routineDone();
+
+/// The audio routine renders offline (a stem export): the collector stops, the line is taken away and SD reads aren't
+/// counted, until the routine renders in real time again (routineStart()), which starts new windows
+void offlineRender();
+
+/// A voice was culled because the CPU was behind
+inline void voiceCulled() {
+	if (enabled) [[unlikely]] {
+		collector.voiceCulled();
+	}
+}
+
+/// Taken just before a sample cluster is read from the SD card
+struct ReadStart {
+	uint32_t time;      ///< now()
+	uint32_t busyTicks; ///< Collector::busyTicksTotal()
+};
+ReadStart readStart();
+
+/// That read has finished. Records its wall-clock time and, apart, the time without the audio routine calls that ran
+/// while the read waited for the card (it yields to the task manager meanwhile).
+void clusterLoaded(ReadStart start);
+
+/// Task, a few times a second: display and SysEx, and a save the shortcut left for when the card is free
+void routine();
+
+/// What goes in the top left corner of every image sent to the OLED, nullptr if nothing: one short line (see
+/// formatCorner()), "CPU 43% 24V QL VC" in mode On, the warnings alone in mode Alerts
+char const* oledInfo();
+
+} // namespace cpu_stats
