+}
+
+namespace cpu_stats {
+
+static_assert(kSysexCommand == SysEx::SysexCommands::CpuStats);
+
+uint8_t mode = OFF;
+bool enabled = false;
+Collector collector;
+
+namespace {
+uint8_t lastOnMode = ON; ///< What the shortcut switches back on: the last of On and Alerts
+bool savePending = false;
+bool pausedOffline = false; ///< Set by offlineRender(), cleared by routineStart()
+
+} // namespace
+
+void saveRoutine() {
+	// Not while the card routine is in the middle of something; the task holds the SD card's resource
+	if (savePending && !sdRoutineLock) {
+		savePending = false;
+		// The startup song as it was: a song loaded but not saved mustn't become the one of "Last saved"
+		runtimeFeatureSettings.writeSettingsToFile(false);
+	}
+}
+
+void setMode(uint8_t newMode) {
+	mode = (newMode <= ALERTS) ? newMode : OFF;
+	enabled = (mode != OFF);
+	if (mode == ON || mode == ALERTS) {
+		lastOnMode = mode;
+	}
+}
+
+void shortcut() {
+	setMode(mode == OFF ? lastOnMode : OFF);
+	char const* text[2] = {"COFF", "CPU monitor: Off"}; // 7-segment, OLED
+	if (mode == ON) {
+		text[0] = "C-ON";
+		text[1] = "CPU monitor: On";
+	}
+	else if (mode == ALERTS) {
+		text[0] = "C-AL";
+		text[1] = "CPU monitor: Alerts";
+	}
+	display->displayPopup(text);
+	savePending = true;
+}
+
+bool readSetting(char const* name, int32_t value) {
+	if (strcmp(name, kSettingName) != 0) {
+		return false;
+	}
+	uint8_t saved = (value >= 0 && value <= kSavedProfile) ? (uint8_t)value : (uint8_t)OFF;
+	setMode((saved == kSavedProfile) ? (uint8_t)ON : saved);
+	return true;
+}
+
+namespace {
+
+/// Room that must stay free in the USB MIDI send buffer, so the numbers never crowd out notes or clock
+constexpr int32_t kMinUsbSendSpace = 1024;
+
+bool wasEnabled = false;
+uint32_t lastHalfSeq = 0;
+/// Warnings: voices cut in the window shown, and how many more half-seconds the warning stays up after the last cut
+int32_t cutHoldHalves = 0;
+bool blinkOff = false;
+constexpr int32_t kCutHoldHalves = 4; // 2 s
+uint32_t lastSecondSeq = 0;
+Window previousHalf;
+char line[kLineChars + 1]; // Empty until the first window is in
+uint32_t sysexSeq = 0;
+uint32_t secondsSeen = 0;
+uint8_t sysexMessage[kSysexLength];
+
+void sendSysex(const Summary& summary) {
+	uint32_t seq = sysexSeq++;
+	// Only to the computer, on USB port 3 (not used for notes); 0 space if the Deluge isn't connected to one
+	MIDICableUSBUpstream& port = MIDIDeviceManager::upstreamUSBMIDICable3;
+	if (port.sendBufferSpace() < (size_t)kMinUsbSendSpace) {
+		return;
+	}
+	size_t length = encodeSysex(summary, seq, sysexMessage);
+	port.sendSysex(sysexMessage, (int32_t)length);
+}
+
+void markOLEDChanged() {
+	if (display->haveOLED()) {
+		deluge::hid::display::OLED::markChanged();
+	}
+}
+
+} // namespace
+
+uint32_t now() {
+	return getTimerValue(0);
+}
+
+void offlineRender() {
+	collector.stop();
+	pausedOffline = true;
+}
+
+void routineStart() {
+	pausedOffline = false;
+	uint32_t time = now();
+	collector.routineStart(time, AudioEngine::audioSampleTimer);
+}
+
+void routineDone() {
+	uint32_t time = now();
+	collector.routineDone(time, AudioEngine::audioSampleTimer, AudioEngine::getNumVoices(), AudioEngine::cpuDireness);
+}
+
+ReadStart readStart() {
+	return ReadStart{now(), collector.busyTicksTotal()};
+}
+
+void clusterLoaded(ReadStart start) {
+	if (enabled && !pausedOffline) {
+		collector.clusterLoaded(now() - start.time, collector.busyTicksTotal() - start.busyTicks);
+	}
+}
+
+void routine() {
+	if (!enabled || pausedOffline) {
+		if (wasEnabled) {
+			wasEnabled = false;
+			collector.stop();
+			line[0] = 0;
+			cutHoldHalves = 0;
+			blinkOff = false;
+			markOLEDChanged(); // Takes the line away
+		}
+		return;
+	}
+
+	Window window;
+	if (!wasEnabled) {
+		wasEnabled = true;
+		previousHalf = Window{};
+		line[0] = 0;
+		// Skip anything left over from before
+		collector.readHalf(window, lastHalfSeq);
+		collector.readSecond(window, lastSecondSeq);
+		return;
+	}
+
+	// OLED: the last two half-second windows, so the numbers are new twice a second. Under them the warning: voices
+	// cut (blinking, and up 2 s after the last cut) or the quality lowered
+	if (collector.readHalf(window, lastHalfSeq)) {
+		Window shown = previousHalf;
+		merge(shown, window);
+		previousHalf = window;
+		Summary summary = summarize(shown);
+		if (window.culled > 0) {
+			cutHoldHalves = kCutHoldHalves;
+		}
+		else if (cutHoldHalves > 0) {
+			cutHoldHalves--;
+		}
+		bool cutting = cutHoldHalves > 0;
+		blinkOff = cutting && !blinkOff;
+		if (display->haveOLED()) {
+			// VC blinks while voices are cut (and 2 s after the last cut)
+			formatCorner(summary, mode == ON, summary.direMax > 0, cutting && !blinkOff, line,
+			             sizeof(line));
+			deluge::hid::display::OLED::markChanged();
+		}
+		else {
+			line[0] = 0;
+		}
+	}
+
+	// SysEx each second (mode On); the 7-segment display gets a short popup every other second, unless it shows
+	// another one: "CUT" while voices are cut, else the CPU (mode On)
+	if (collector.readSecond(window, lastSecondSeq)) {
+		Summary summary = summarize(window);
+		if (mode == ON) {
+			sendSysex(summary);
+		}
+		if (!display->haveOLED() && (secondsSeen++ & 1) == 0 && !display->hasPopup()) {
+			char text[8];
+			if (cutHoldHalves > 0) {
+				snprintf(text, sizeof(text), "CUT");
+			}
+			else if (mode == ON) {
+				formatSevenSegment(summary, text, sizeof(text));
+			}
+			else {
+				text[0] = 0;
+			}
+			if (text[0]) {
+				display->displayPopup(text, 1);
+			}
+		}
+	}
+}
+
+char const* oledInfo() {
+	return (enabled && line[0]) ? line : nullptr;
+}
+
+} // namespace cpu_stats
