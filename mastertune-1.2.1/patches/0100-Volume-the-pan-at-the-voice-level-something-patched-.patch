 	uint32_t lastSaturationTanHWorkingValue[2];
 
 	int32_t overallOscAmplitudeLastTime;
+	// mastertune v18: the pan at the voice level (where something is patched to it), its amplitudes moving per sample
+	deluge::dsp::gain::GainRamp panRampL_;
+	deluge::dsp::gain::GainRamp panRampR_;
 	int32_t sourceAmplitudesLastTime[kNumSources];
 	int32_t modulatorAmplitudeLastTime[kNumModulators];
 	uint32_t sourceWaveIndexesLastTime[kNumSources];
 
 	bool doneFirstRender;
 	bool previouslyIgnoredNoteOff;
-	bool invertReversed = false; // Set by the arpeggiator's reverse probability: play this voice's samples the other way
+	bool invertReversed =
+	    false; // Set by the arpeggiator's reverse probability: play this voice's samples the other way
 	uint8_t whichExpressionSourcesCurrentlySmoothing;
 	uint8_t whichExpressionSourcesFinalValueChanged;
 
