+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+/// Pad brightness (Settings > Defaults > Pad brightness 4..100 %, or SHIFT + LEARN + vertical encoder 0..100 %), as a
+/// dimmer interval: 0 = full brightness .. 25 = 0 %.
+///
+/// The PIC dims its LEDs by time: each step of its LED scan is lit for the "refresh time" and then dark for the "dimmer
+/// interval" (both in the same unit: 1.2.1 keeps their sum at 23, so the scan runs at the same rate at any brightness
+/// down to 40 %). Below that the refresh time stays at 8 and the dark time grows by 1.2x per step instead, so the whole
+/// scan slows down: at the menu's lowest level (4 %) 8 + 112 = 120, 5.2 times the period at full brightness, at 0 %
+/// 8 + 148 = 156, 6.8 times. That is the flicker at low brightness. Refresh times of 9 and below also give wrong
+/// colours on some pads (upstream discussion #1869; Synthstrom had raised the minimum from 6 to 8 for it).
+///
+/// Flicker-free dimming (community feature, on by default) lets the PIC dim only as far as the scan period stays 23 and
+/// the refresh time 10 or more (43.5 % light), and does the rest by scaling the pad colours and gold knob indicator
+/// values sent to the PIC (PIC::send()), so the light at each level stays what 1.2.1 gave (the PIC's PWM being linear
+/// in the value: the firmware squares the knob indicators' values itself). The button LEDs and the 7-segment display
+/// are on or off, and the PIC's own flash colours (the fast play cursor) aren't sent as values: those are only dimmed
+/// down to the 43.5 %.
+namespace deluge::hid::pad_dimming {
+
+constexpr int32_t kMaxDimmerInterval = 25;         ///< 0 %
+constexpr int32_t kScanPeriod = 23;                ///< Refresh time + dimmer interval while the scan keeps its rate
+constexpr int32_t kLegacyMinRefreshTime = 8;       ///< 1.2.1 stretches the dark time rather than going below this
+constexpr int32_t kMinRefreshTime = 10;            ///< Flicker-free: the PIC dims no further than this
+constexpr uint32_t kFullScale = uint32_t{1} << 16; ///< Colour scale that sends the values unchanged
+
+struct PicTiming {
+	int32_t refreshTime;
+	int32_t dimmerInterval;
+};
+
+/// What 1.2.1 sends to the PIC for a dimmer interval
+constexpr PicTiming legacyTiming(int32_t interval) {
+	int32_t refreshTime = kScanPeriod - interval;
+	while (refreshTime < kLegacyMinRefreshTime) {
+		refreshTime++;
+		// (From Roha, Nov 2023) Hmm, not sure why this was necessary...
+		interval = static_cast<int32_t>(interval * 1.2);
+	}
+	return {refreshTime, interval};
+}
+
+/// What flicker-free dimming sends to the PIC: the scan period always kScanPeriod
+constexpr PicTiming flickerFreeTiming(int32_t interval) {
+	interval = std::min(interval, kScanPeriod - kMinRefreshTime);
+	return {kScanPeriod - interval, interval};
+}
+
+/// Light of a PIC timing (lit share of each scan step) relative to another, in 16.16 fixed point, rounded
+constexpr uint32_t lightRatio(PicTiming timing, PicTiming reference) {
+	uint32_t numerator = (uint32_t)timing.refreshTime * (reference.refreshTime + reference.dimmerInterval) << 16;
+	uint32_t denominator = (uint32_t)(timing.refreshTime + timing.dimmerInterval) * reference.refreshTime;
+	return (numerator + denominator / 2) / denominator;
+}
+
+/// Colour scale with flicker-free dimming: the part of 1.2.1's dimming the PIC doesn't do (kFullScale down to 48 %)
+constexpr uint32_t colourScale(int32_t interval) {
+	return lightRatio(legacyTiming(interval), flickerFreeTiming(interval));
+}
+
+/// A channel (or gold knob indicator) value scaled, rounded; one that was lit stays lit (at least 1), so the darkest
+/// colours don't disappear
+constexpr uint8_t scaleChannel(uint8_t value, uint32_t scale) {
+	uint32_t scaled = (value * scale + (kFullScale >> 1)) >> 16;
+	return (scaled == 0 && value != 0) ? 1 : scaled;
+}
+
+} // namespace deluge::hid::pad_dimming
