+// mastertune v18: the 24 dB and drive ladders' feedback sum in a ramp. setConfig() makes the feedbacks from the
+// moveability G and d = divideBy1PlusTannedFrequency: lpf3Feedback = dG (Q30), lpf2Feedback = dG^2, lpf1Feedback = dG^3,
+// so the sum s1 dG^3 / 4 + s2 dG^2 / 4 + s3 dG / 4 + s4 d / 2 (the stages' memories s1..s4) is
+// d / 4 * (2 s4 + G (s3 + G (s2 + G s1))), Horner's rule: u = s2 / 2 + s1 G / 2 = (s2 + G s1) / 2,
+// v = s3 / 4 + u G / 2, w = s4 / 4 + v G / 2 = (2 s4 + G s3 + G^2 s2 + G^3 s1) / 8, each within full scale (G < 0.9),
+// and the sum 2 d w = 4 * smmulr(w, d); lshiftAndSaturate<2> of it as the loops take it. So a ramp moves G and d per
+// sample and the feedbacks follow them exactly (every sample a real ladder's feedback for its G and d), instead of
+// moving three more coefficients in straight lines of their own: fewer registers, fewer instructions. The same sum
+// as the three coefficients' to a few LSB (the halvings' rounding)
+// bounded: the input is a tanh's (every variant but NONE): at most 2^31 >> 4 (2^27, the tanh's output at its saturation
+// amount 2, less at 3). With the precise stages (moveability under 1/4: each stage's state within its input's range)
+// every state is then within 2^27, and the sums need no halving: u = s2 + G s1, v = s3 + G u, w = 2 s4 + G v (each
+// within 2^29), G s from smmlar by moveability2 = 2G, and the feedback sum d / 4 * w = smmulr(w, d) / 2, as the
+// loops take it (lshiftAndSaturate<2>) lshiftAndSaturate<1>(smmulr(w, d)): four instructions fewer per sample
+template <bool precise, bool bounded>
+[[gnu::always_inline]] inline q31_t LpLadderFilter::feedbackFromMoveability(const LpLadderState& state,
+                                                                           const Coefficients& c) {
+	if constexpr (precise && bounded) {
+		const q31_t m2 = c.moveability2;
+		q31_t u = multiply_accumulate_32x32_rshift32_rounded(state.lpfLPF2.memory, state.lpfLPF1.memory, m2);
+		q31_t v = multiply_accumulate_32x32_rshift32_rounded(state.lpfLPF3.memory, u, m2);
+		q31_t w = multiply_accumulate_32x32_rshift32_rounded(state.lpfLPF4.memory * 2, v, m2);
+		return doubleSaturate(multiply_32x32_rshift32_rounded(w, c.divideBy1PlusTannedFrequency));
+	}
+	const q31_t g = precise ? (c.moveability2 >> 1) : c.moveability;
+	q31_t u = multiply_accumulate_32x32_rshift32_rounded(state.lpfLPF2.memory >> 1, state.lpfLPF1.memory, g);
+	q31_t v = multiply_accumulate_32x32_rshift32_rounded(state.lpfLPF3.memory >> 2, u, g);
+	q31_t w = multiply_accumulate_32x32_rshift32_rounded(state.lpfLPF4.memory >> 2, v, g);
+	return lshiftAndSaturate<4>(multiply_32x32_rshift32_rounded(w, c.divideBy1PlusTannedFrequency));
+}
