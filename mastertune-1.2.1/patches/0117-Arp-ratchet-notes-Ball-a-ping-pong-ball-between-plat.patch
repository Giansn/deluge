+constexpr float kBallMinGapSamples = 661.0f;
 constexpr uint32_t kMaxRollHits = 255;
 
 // How a bouncing ratchet's velocity follows its gaps (the numbers are what songs store, 0 and 1 as the old on/off)
@@ -126,7 +130,8 @@ public:
 	uint8_t ratchetBounceLength{1};
 
 	// Number of notes in a ratchet: 0 = random like 1.3 (2, 4 or 8, weighted by the ratchet amount), 2 ... 8 = always
-	// exactly that many, kRatchetNotesRoll = a roll, as many as fit until the plates close
+	// exactly that many, kRatchetNotesRoll = a roll, as many as fit until the plates close, kRatchetNotesBall = the
+	// plates close in and part again within the ratchet
 	uint8_t ratchetNotes{0};
 
 	// MPE settings
@@ -380,6 +385,8 @@ protected:
 	// Roll state (ratchet notes = Roll): the hits are computed from these as they come, not stored
 	bool isRatchetRolling = false;
 	bool rollMirrored = false;      // negative bounce: the hits of the positive one, backwards in time
+	bool rollBall = false;          // Ball: a roll over each half, the second backwards (rollSpan is then a half)
+	uint32_t rollBallHalfHits = 0;  // Ball: the hits of one half
 	float rollRatio = 1.0f;         // each gap is the one before times this; 1 = an even roll
 	float rollSpan = 0.0f;          // the whole ratchet, in 1/2^24ths of a step
 	float rollMinGap = 0.0f;        // the buzz: no gap shorter than this
