@@ -604,7 +605,7 @@ void ArpeggiatorBase::switchAnyNoteOff(ArpReturnInstruction* instruction) {
 
 // Sets up the ratchet state if the probability is met
 void ArpeggiatorBase::maybeSetupNewRatchet(ArpeggiatorSettings* settings) {
-	bool roll = settings->ratchetNotes == kRatchetNotesRoll;
+	bool roll = settings->ratchetNotes == kRatchetNotesRoll || settings->ratchetNotes == kRatchetNotesBall;
 	bool fixedNumberOfNotes = settings->ratchetNotes >= 2; // Includes the roll
 	isRatcheting = isPlayRatchetForCurrentStep
 	               && (settings->ratchetAmount > 0 || fixedNumberOfNotes)
@@ -669,7 +670,9 @@ void ArpeggiatorBase::maybeSetupNewRatchet(ArpeggiatorSettings* settings) {
 // up (r < 1) or slows down (r > 1) while still filling exactly one step. A ball hits softer as the bounces get shorter,
 // so with bounce fade on, each note's velocity follows the square root of its gap relative to the longest one.
 void ArpeggiatorBase::setupRatchetBounce(ArpeggiatorSettings* settings) {
-	isRatchetRolling = isRatcheting && settings->ratchetNotes == kRatchetNotesRoll;
+	isRatchetRolling = isRatcheting
+	                   && (settings->ratchetNotes == kRatchetNotesRoll || settings->ratchetNotes == kRatchetNotesBall);
+	rollBall = isRatchetRolling && settings->ratchetNotes == kRatchetNotesBall;
 	if (isRatchetRolling) {
 		isRatchetBouncing = false;
 		setupRatchetRoll(settings);
@@ -731,15 +734,23 @@ uint8_t ArpeggiatorBase::getBounceVelocityScale(BounceVelocity mode, float gap,
 // come closer than kRollMinGapSamples, they go on at that pace as a buzz (trrrr), until one such gap before S.
 // Negative bounce plays the same hits backwards in time (plates moving apart), bounce 0 is an even roll of 8 hits per
 // step (never closer than the buzz). With r from the bounce amount like the ratchet bounce: 0.95 (+1) ... 0.5 (+10)
+// Ball (mastertune v18.4): the plates close in and part again within the ratchet. The first half is a roll into its
+// middle, where the ball buzzes (15 ms), the second half a roll backwards with its own, faster ratio (kBallPartFactor):
+// faster and faster, the buzz, then slower and slower, ending slower than it started. With negative bounce the plates meet at both ends of the ratchet (on the step) and are furthest
+// apart in its middle. The hits come from the roll of one half (rollSpan), see getRatchetNoteStart()
 void ArpeggiatorBase::setupRatchetRoll(ArpeggiatorSettings* settings) {
 	constexpr float kStep = (float)(1 << 24);
 	float span = kStep * (float)ratchetSpanSteps;
+	if (rollBall) {
+		span /= 2;
+	}
 	// The buzz's gap in positions: from the arp's speed at the last render, or a guess before the first one
 	uint32_t increment = lastGateIncrement;
 	if (increment == 0 && settings->syncLevel != 0) {
 		increment = settings->getPhaseIncrement(0) >> 8;
 	}
-	float minGap = (increment != 0) ? (float)increment * kRollMinGapSamples : kStep / 8;
+	float minGapSamples = rollBall ? kBallMinGapSamples : kRollMinGapSamples;
+	float minGap = (increment != 0) ? (float)increment * minGapSamples : kStep / 8;
 	minGap = std::clamp(minGap, kStep / 256, span);
 
 	int32_t amount = std::clamp<int32_t>(settings->ratchetBounce, -kMaxRatchetBounce, kMaxRatchetBounce);
@@ -772,19 +783,49 @@ void ArpeggiatorBase::setupRatchetRoll(ArpeggiatorSettings* settings) {
 		rollLongestGap = (geometric > 0) ? span * (1.0f - ratio) : minGap;
 		rollShortestGap = minGap;
 	}
+	if (rollBall) {
+		// The closing half: the roll into the middle, as above. The parting half: the same kind of roll with its own,
+		// faster ratio, backwards, so the ball ends slower than it started (kBallPartFactor)
+		rollBallHalfHits = std::clamp<uint32_t>(hits, 1, kMaxRollHits / 2);
+		rollRatioPart = rollRatio;
+		rollGeometricHitsPart = rollGeometricHits;
+		uint32_t partHits = hits;
+		if (amount != 0) {
+			float ratio = std::max(0.3f, 1.0f - kBallPartFactor * (1.0f - rollRatio));
+			float gap = span * (1.0f - ratio);
+			float remaining = span;
+			uint32_t geometric = 0;
+			while (gap >= minGap && geometric < kMaxRollHits) {
+				gap *= ratio;
+				remaining *= ratio;
+				geometric++;
+			}
+			rollRatioPart = ratio;
+			rollGeometricHitsPart = geometric;
+			partHits = geometric + (uint32_t)(remaining / minGap);
+			rollLongestGap = (geometric > 0) ? span * (1.0f - ratio) : minGap; // the parting's first gap is the longest
+		}
+		rollBallPartHits = std::clamp<uint32_t>(partHits, 1, kMaxRollHits / 2);
+		ratchetNotesCount = rollBallHalfHits + rollBallPartHits;
+		return;
+	}
 	ratchetNotesCount = std::clamp<uint32_t>(hits, 1, kMaxRollHits);
 }
 
 // Where hit index of an accelerating roll starts, in positions from the start of the ratchet
 float ArpeggiatorBase::getRollStartAccelerating(uint32_t index) {
-	if (rollRatio >= 1.0f) {
+	return getRollStart(index, rollRatio, rollGeometricHits);
+}
+
+// The same for a roll with the given ratio and number of hits before its buzz (a ball's parting half has its own)
+float ArpeggiatorBase::getRollStart(uint32_t index, float ratio, uint32_t geometricHits) {
+	if (ratio >= 1.0f) {
 		return (float)index * rollEvenGap;
 	}
-	if (index <= rollGeometricHits) {
-		return rollSpan * (1.0f - std::pow(rollRatio, (float)index));
+	if (index <= geometricHits) {
+		return rollSpan * (1.0f - std::pow(ratio, (float)index));
 	}
-	return rollSpan * (1.0f - std::pow(rollRatio, (float)rollGeometricHits))
-	       + (float)(index - rollGeometricHits) * rollMinGap;
+	return rollSpan * (1.0f - std::pow(ratio, (float)geometricHits)) + (float)(index - geometricHits) * rollMinGap;
 }
 
 // Where the note at index of the current ratchet starts, in 1/2^24ths of a step from the start of the ratchet. Index
@@ -796,6 +837,30 @@ uint32_t ArpeggiatorBase::getRatchetNoteStart(uint32_t index) {
 			return end;
 		}
 		float start;
+		if (rollBall) {
+			// rollSpan is half the ratchet. Closing in the middle: the roll into it (h hits), a hit right in it, then
+			// the parting roll (p hits) backwards. Meeting at the ends: the parting roll backwards out of the start,
+			// then the roll into the end
+			uint32_t h = rollBallHalfHits;
+			uint32_t p = rollBallPartHits;
+			if (!rollMirrored) {
+				if (index < h) {
+					start = getRollStartAccelerating(index);
+				}
+				else if (index == h) {
+					start = rollSpan;
+				}
+				else {
+					start = 2.0f * rollSpan - getRollStart(h + p - index, rollRatioPart, rollGeometricHitsPart);
+				}
+			}
+			else {
+				start = (index == 0)  ? 0.0f
+				        : (index < p) ? rollSpan - getRollStart(p - index, rollRatioPart, rollGeometricHitsPart)
+				                      : rollSpan + getRollStartAccelerating(index - p);
+			}
+			return std::min((uint32_t)start, end);
+		}
 		if (!rollMirrored) {
 			start = getRollStartAccelerating(index);
 		}
@@ -1994,9 +2059,12 @@ bool ArpeggiatorSettings::readCommonTagsFromFile(Deserializer& reader, char cons
 	}
 	else if (!strcmp(tagName, "ratchetNotes")) {
 		int32_t notes = reader.readTagOrAttributeValueInt();
-		ratchetNotes = (notes == kRatchetNotesRoll) ? kRatchetNotesRoll
-		               : (notes < 2)                ? 0
-		                                            : std::min<int32_t>(notes, kMaxFixedRatchetNotes);
+		if (notes == kRatchetNotesRoll || notes == kRatchetNotesBall) {
+			ratchetNotes = notes;
+		}
+		else {
+			ratchetNotes = (notes < 2) ? 0 : std::min<int32_t>(notes, kMaxFixedRatchetNotes);
+		}
 	}
 	else if (!strcmp(tagName, "lastLockedNoteProb")) {
 		lastLockedNoteProbabilityParameterValue = reader.readTagOrAttributeValueInt();
