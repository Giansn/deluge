-		uint8_t notes = (option == kRollOption) ? kRatchetNotesRoll : (option == 0) ? 0 : option + 1;
+		uint8_t notes = (option == kRollOption)   ? kRatchetNotesRoll
+		                : (option == kBallOption) ? kRatchetNotesBall
+		                : (option == 0)           ? 0
+		                                          : option + 1;
 		// If affect-entire button held, do whole kit
 		if (currentUIMode == UI_MODE_HOLDING_AFFECT_ENTIRE_IN_SOUND_EDITOR && soundEditor.editingKitRow()) {
 			for (Drum* thisDrum = getCurrentKit()->firstDrum; thisDrum != nullptr; thisDrum = thisDrum->next) {
@@ -50,7 +56,7 @@ public:
 	}
 	deluge::vector<std::string_view> getOptions() override {
 		return {l10n::getView(l10n::String::STRING_FOR_AUTO), "2", "3", "4", "5", "6", "7", "8",
-		        l10n::getView(l10n::String::STRING_FOR_ROLL)};
+		        l10n::getView(l10n::String::STRING_FOR_ROLL), "Ball"};
