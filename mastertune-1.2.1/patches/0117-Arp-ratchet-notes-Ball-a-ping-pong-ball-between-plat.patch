--- a/src/deluge/modulation/arpeggiator.h
+++ b/src/deluge/modulation/arpeggiator.h
@@ -44,10 +44,18 @@ constexpr int32_t kMaxRatchetBounce = 10;
 constexpr uint32_t kMaxFixedRatchetNotes = 8;
 // ratchetNotes value for a roll: hits until the plates close (see ArpeggiatorBase::setupRatchetRoll())
 constexpr uint8_t kRatchetNotesRoll = 255;
+// ratchetNotes value for a ping-pong ball: the roll into the middle of the ratchet and back out of it
+constexpr uint8_t kRatchetNotesBall = 254;
 // The longest ratchet, in arp steps
