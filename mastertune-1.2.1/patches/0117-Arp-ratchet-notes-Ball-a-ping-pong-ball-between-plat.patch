 	ratchetSpanStep = 0;
 	ratchetNotesMultiplier = 0;
@@ -604,7 +605,7 @@ void ArpeggiatorBase::switchAnyNoteOff(ArpReturnInstruction* instruction) {
 
 // Sets up the ratchet state if the probability is met
 void ArpeggiatorBase::maybeSetupNewRatchet(ArpeggiatorSettings* settings) {
-	bool roll = settings->ratchetNotes == kRatchetNotesRoll;
+	bool roll = settings->ratchetNotes == kRatchetNotesRoll || settings->ratchetNotes == kRatchetNotesBall;
 	bool fixedNumberOfNotes = settings->ratchetNotes >= 2; // Includes the roll
 	isRatcheting = isPlayRatchetForCurrentStep
 	               && (settings->ratchetAmount > 0 || fixedNumberOfNotes)
@@ -669,7 +670,9 @@ void ArpeggiatorBase::maybeSetupNewRatchet(ArpeggiatorSettings* settings) {
 // up (r < 1) or slows down (r > 1) while still filling exactly one step. A ball hits softer as the bounces get shorter,
 // so with bounce fade on, each note's velocity follows the square root of its gap relative to the longest one.
 void ArpeggiatorBase::setupRatchetBounce(ArpeggiatorSettings* settings) {
-	isRatchetRolling = isRatcheting && settings->ratchetNotes == kRatchetNotesRoll;
+	isRatchetRolling = isRatcheting
+	                   && (settings->ratchetNotes == kRatchetNotesRoll || settings->ratchetNotes == kRatchetNotesBall);
+	rollBall = isRatchetRolling && settings->ratchetNotes == kRatchetNotesBall;
 	if (isRatchetRolling) {
 		isRatchetBouncing = false;
 		setupRatchetRoll(settings);
@@ -731,15 +734,22 @@ uint8_t ArpeggiatorBase::getBounceVelocityScale(BounceVelocity mode, float gap,
 // come closer than kRollMinGapSamples, they go on at that pace as a buzz (trrrr), until one such gap before S.
 // Negative bounce plays the same hits backwards in time (plates moving apart), bounce 0 is an even roll of 8 hits per
 // step (never closer than the buzz). With r from the bounce amount like the ratchet bounce: 0.95 (+1) ... 0.5 (+10)
+// Ball (mastertune v18.4): the plates close in and part again within the ratchet. The first half is a roll into its
+// middle, where the ball buzzes (15 ms), the second half the same roll backwards: faster and faster, the buzz, then
+// slower and slower. With negative bounce the plates meet at both ends of the ratchet (on the step) and are furthest
+// apart in its middle. The hits come from the roll of one half (rollSpan), see getRatchetNoteStart()
 void ArpeggiatorBase::setupRatchetRoll(ArpeggiatorSettings* settings) {
 	constexpr float kStep = (float)(1 << 24);
 	float span = kStep * (float)ratchetSpanSteps;
+	if (rollBall) {
+		span /= 2;
+	}
 	// The buzz's gap in positions: from the arp's speed at the last render, or a guess before the first one
 	uint32_t increment = lastGateIncrement;
 	if (increment == 0 && settings->syncLevel != 0) {
 		increment = settings->getPhaseIncrement(0) >> 8;
 	}
-	float minGap = (increment != 0) ? (float)increment * kRollMinGapSamples : kStep / 8;
+	float minGap = (increment != 0) ? (float)increment * (rollBall ? kBallMinGapSamples : kRollMinGapSamples) : kStep / 8;
 	minGap = std::clamp(minGap, kStep / 256, span);
 
 	int32_t amount = std::clamp<int32_t>(settings->ratchetBounce, -kMaxRatchetBounce, kMaxRatchetBounce);
@@ -772,6 +782,12 @@ void ArpeggiatorBase::setupRatchetRoll(ArpeggiatorSettings* settings) {
 		rollLongestGap = (geometric > 0) ? span * (1.0f - ratio) : minGap;
 		rollShortestGap = minGap;
 	}
+	if (rollBall) {
+		// Both halves: hits 0 ... h - 1 of the roll into the middle, the hit in the middle, then the other half
+		rollBallHalfHits = std::clamp<uint32_t>(hits, 1, kMaxRollHits / 2);
+		ratchetNotesCount = 2 * rollBallHalfHits;
+		return;
+	}
 	ratchetNotesCount = std::clamp<uint32_t>(hits, 1, kMaxRollHits);
 }
 
@@ -796,6 +812,23 @@ uint32_t ArpeggiatorBase::getRatchetNoteStart(uint32_t index) {
 			return end;
 		}
 		float start;
+		if (rollBall) {
+			// rollSpan is half the ratchet; h hits per half. Closing in the middle: the roll into it, a hit right in
+			// it, then the same hits mirrored about it. Meeting at the ends: the mirrored roll out of the start, then
+			// the roll into the end
+			uint32_t h = rollBallHalfHits;
+			if (!rollMirrored) {
+				start = (index < h)    ? getRollStartAccelerating(index)
+				        : (index == h) ? rollSpan
+				                       : 2.0f * rollSpan - getRollStartAccelerating(2 * h - index);
+			}
+			else {
+				start = (index == 0) ? 0.0f
+				        : (index < h) ? rollSpan - getRollStartAccelerating(h - index)
+				                      : rollSpan + getRollStartAccelerating(index - h);
+			}
+			return std::min((uint32_t)start, end);
+		}
 		if (!rollMirrored) {
 			start = getRollStartAccelerating(index);
 		}
@@ -1994,9 +2027,12 @@ bool ArpeggiatorSettings::readCommonTagsFromFile(Deserializer& reader, char cons
 	}
 	else if (!strcmp(tagName, "ratchetNotes")) {
 		int32_t notes = reader.readTagOrAttributeValueInt();
-		ratchetNotes = (notes == kRatchetNotesRoll) ? kRatchetNotesRoll
-		               : (notes < 2)                ? 0
-		                                            : std::min<int32_t>(notes, kMaxFixedRatchetNotes);
+		if (notes == kRatchetNotesRoll || notes == kRatchetNotesBall) {
+			ratchetNotes = notes;
+		}
+		else {
+			ratchetNotes = (notes < 2) ? 0 : std::min<int32_t>(notes, kMaxFixedRatchetNotes);
+		}
 	}
 	else if (!strcmp(tagName, "lastLockedNoteProb")) {
 		lastLockedNoteProbabilityParameterValue = reader.readTagOrAttributeValueInt();
diff --git a/src/deluge/modulation/arpeggiator.h b/src/deluge/modulation/arpeggiator.h
index 77f6401b..5ec685a1 100644
--- a/src/deluge/modulation/arpeggiator.h
+++ b/src/deluge/modulation/arpeggiator.h
@@ -44,10 +44,14 @@ constexpr int32_t kMaxRatchetBounce = 10;
 constexpr uint32_t kMaxFixedRatchetNotes = 8;
 // ratchetNotes value for a roll: hits until the plates close (see ArpeggiatorBase::setupRatchetRoll())
 constexpr uint8_t kRatchetNotesRoll = 255;
