+namespace {
+
+/// A param of the unpatched set (the song's) in its own model stack, made in memory, or nullptr
+ModelStackWithAutoParam* unpatchedParam(char* memory, ModelStackWithThreeMainThings* modelStack, int32_t paramId) {
+	copyModelStack(memory, modelStack, sizeof(ModelStackWithThreeMainThings));
+	auto* stack = (ModelStackWithThreeMainThings*)memory;
+	ParamCollectionSummary* summary = stack->paramManager->getUnpatchedParamSetSummary();
+	ModelStackWithParamId* withId = stack->addParamCollectionAndId(summary->paramCollection, summary, paramId);
+	ModelStackWithAutoParam* param = summary->paramCollection->getAutoParamFromId(withId, true);
+	return (param && param->autoParam) ? param : nullptr;
+}
+
+/// A param's value as a knob position (-64 to 64)
+int32_t knobPosOf(ModelStackWithThreeMainThings* modelStack, int32_t paramId) {
+	char memory[MODEL_STACK_MAX_SIZE];
+	ModelStackWithAutoParam* param = unpatchedParam(memory, modelStack, paramId);
+	if (!param) {
+		return 0;
+	}
+	int32_t value = param->autoParam->getValuePossiblyAtPos(view.modPos, param);
+	return param->paramCollection->paramValueToKnobPos(value, param);
+}
+
+/// A param set to a knob position, as a gold knob sets it (automation recorded where it is being recorded)
+void setKnobPos(ModelStackWithThreeMainThings* modelStack, int32_t paramId, int32_t knobPos) {
+	char memory[MODEL_STACK_MAX_SIZE];
+	ModelStackWithAutoParam* param = unpatchedParam(memory, modelStack, paramId);
+	if (!param) {
+		return;
+	}
+	int32_t value = param->paramCollection->knobPosToParamValue(knobPos, param);
+	if (value != param->autoParam->getValuePossiblyAtPos(view.modPos, param)) {
+		param->autoParam->setValuePossiblyForRegion(value, param, view.modPos, view.modLength);
+	}
+}
+
+} // namespace
+
+int32_t GlobalEffectable::djKnobPos(int32_t whichModEncoder, ModelStackWithThreeMainThings* modelStack) {
+	int32_t dj = deluge::dsp::dj::fromFilterKnobs(knobPosOf(modelStack, params::UNPATCHED_LPF_FREQ),
+	                                              knobPosOf(modelStack, params::UNPATCHED_HPF_FREQ));
+	if (whichModEncoder == 1) { // Upper: low-pass closed, off, high-pass open
+		return dj;
+	}
+	// Lower: the resonance, as the one that is on has it
+	return knobPosOf(modelStack, (dj > 0) ? params::UNPATCHED_HPF_RES : params::UNPATCHED_LPF_RES);
+}
+
+ActionResult GlobalEffectable::djKnobAction(int32_t offset, int32_t whichModEncoder,
+                                            ModelStackWithThreeMainThings* modelStack) {
+	DEF_STACK_STRING_BUF(popupMsg, 40);
+	if (whichModEncoder == 1) {
+		int32_t lpf = knobPosOf(modelStack, params::UNPATCHED_LPF_FREQ);
+		int32_t hpf = knobPosOf(modelStack, params::UNPATCHED_HPF_FREQ);
+		for (int32_t i = std::abs(offset); i > 0; i--) {
+			deluge::dsp::dj::stepFilterKnobs(offset, &lpf, &hpf);
+		}
+		setKnobPos(modelStack, params::UNPATCHED_LPF_FREQ, lpf);
+		setKnobPos(modelStack, params::UNPATCHED_HPF_FREQ, hpf);
+		int32_t pos = deluge::dsp::dj::fromFilterKnobs(lpf, hpf);
+		int32_t displayLevel = (std::abs(pos) * kMaxMenuValue + 32) / 64;
+		// "DJ: LPF 25", "DJ: OFF", "DJ: HPF 25"; on 7 segments LP25, OFF, HP25
+		if (display->haveOLED()) {
+			popupMsg.append(deluge::l10n::get(deluge::l10n::String::STRING_FOR_DJ_FILTER));
+			popupMsg.append(": ");
+		}
+		if (pos == 0) {
+			popupMsg.append("OFF");
+		}
+		else {
+			popupMsg.append(display->haveOLED() ? ((pos < 0) ? "LPF " : "HPF ") : ((pos < 0) ? "LP" : "HP"));
+			popupMsg.appendInt(displayLevel);
+		}
+	}
+	else {
+		// Both resonances, each from where it is (no jump where they were set apart); shown as the one that is on
+		for (int32_t paramId : {params::UNPATCHED_LPF_RES, params::UNPATCHED_HPF_RES}) {
+			setKnobPos(modelStack, paramId, std::clamp<int32_t>(knobPosOf(modelStack, paramId) + offset, -64, 64));
+		}
+		int32_t pos = djKnobPos(whichModEncoder, modelStack);
+		if (display->haveOLED()) {
+			popupMsg.append(deluge::l10n::get(deluge::l10n::String::STRING_FOR_RESONANCE));
+			popupMsg.append(": ");
+		}
+		popupMsg.appendInt((pos + 64) * kMaxMenuValue / 128);
+	}
+	display->displayPopup(popupMsg.c_str());
+	return ActionResult::ACTIONED_AND_CAUSED_CHANGE;
+}
