+void PlaybackHandler::nudgeInternalClock(int8_t offset) {
+	uint64_t now = currentSong->timePerTimerTickBig;
+	if (!clockNudging || now != clockNudgeTimePerTick) {
+		clockNudgeBaseTimePerTick = now; // Not bent, or the tempo was set meanwhile: bend from what it is
+	}
+	uint64_t bend = clockNudgeBaseTimePerTick / 100 * kNudgePercent;
+	clockNudgeTimePerTick = (offset > 0) ? clockNudgeBaseTimePerTick - bend : clockNudgeBaseTimePerTick + bend;
+	currentSong->setTimePerTimerTick(clockNudgeTimePerTick, false); // Faster: the ticks shorter
+	clockNudging = true;
+	clockNudgeUntil = AudioEngine::audioSampleTimer + kNudgeSamples;
+}
+
+void PlaybackHandler::endClockNudge(bool now) {
+	if (!clockNudging || (!now && (int32_t)(AudioEngine::audioSampleTimer - clockNudgeUntil) < 0)) {
+		return;
+	}
+	clockNudging = false;
+	if (currentSong && currentSong->timePerTimerTickBig == clockNudgeTimePerTick) { // Else it was set meanwhile
+		currentSong->setTimePerTimerTick(clockNudgeBaseTimePerTick, false);
+	}
+}
+
+uint64_t PlaybackHandler::timePerTimerTickWithoutNudge(Song* song) {
+	if (clockNudging && song == currentSong && song->timePerTimerTickBig == clockNudgeTimePerTick) {
+		return clockNudgeBaseTimePerTick;
+	}
+	return song->timePerTimerTickBig;
+}
