+void ScanView::syncTempo() {
+	float bpm = shownBpm();
+	if (playbackHandler.isExternalClockActive()) {
+		display->displayPopup(display->haveOLED() ? "External clock" : "EXT"); // It sets the tempo
+		return;
+	}
+	if (bpm <= 0) {
+		display->displayPopup(display->haveOLED() ? "No tempo yet" : "----");
+		return;
+	}
+	currentSong->setBPM(bpm, true); // Undoable; playing, the next ticks follow
+	char buffer[24];
+	if (display->haveOLED()) {
+		int32_t tenths = (int32_t)std::lround(bpm * 10);
+		snprintf(buffer, sizeof(buffer), "Sync %d.%d BPM", (int)(tenths / 10), (int)(tenths % 10));
+	}
+	else {
+		snprintf(buffer, sizeof(buffer), "SYNC");
+	}
+	display->displayPopup(buffer);
+}
