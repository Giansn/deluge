+/// mastertune-v19: the DJ filter, one knob for the song's low-pass and high-pass (its filter type DJ, in Song view).
+/// The knob goes from -64 (low-pass closed) through 0 (both off) to +64 (high-pass open); it drives the song's own LPF
+/// and HPF cutoff params, as knob positions from -64 to +64 as the gold knobs set them.
+namespace deluge::dsp::dj {
+
+/// The knob's curve: the LPF's and HPF's cutoff knobs for a DJ knob position. Left of the middle the low-pass closes
+/// over its whole range (two of its steps a step) with the high-pass off; right of it the high-pass opens with the
+/// low-pass off
+constexpr void filterKnobs(int32_t dj, int32_t* lpf, int32_t* hpf) {
+	dj = std::clamp<int32_t>(dj, -64, 64);
+	*lpf = (dj < 0) ? 64 + 2 * dj : 64;
+	*hpf = (dj > 0) ? -64 + 2 * dj : -64;
+}
+
+/// The DJ knob's position for the LPF's and HPF's cutoff knobs: how far the low-pass is closed (to the left) plus how
+/// far the high-pass is open (to the right). On the curve, the inverse of filterKnobs()
+constexpr int32_t fromFilterKnobs(int32_t lpf, int32_t hpf) {
+	int32_t closed = (std::clamp<int32_t>(lpf, -64, 64) - 64) / 2; // -64 to 0
+	int32_t open = (std::clamp<int32_t>(hpf, -64, 64) + 64) / 2;   // 0 to 64
+	return std::clamp<int32_t>(closed + open, -64, 64);
+}
+
+/// One detent of the DJ knob (direction > 0: to the right): to the right the low-pass opens until it is off, then the
+/// high-pass opens; to the left the high-pass closes until it is off, then the low-pass closes; two of their steps a
+/// detent. On the curve this is filterKnobs(fromFilterKnobs() +- 1); where the two were set apart (both on, as the LPF
+/// and HPF knobs or automation can set them), it goes on from there without a jump
+constexpr void stepFilterKnobs(int32_t direction, int32_t* lpf, int32_t* hpf) {
+	if (direction > 0) {
+		if (*lpf < 64) {
+			*lpf = std::min<int32_t>(*lpf + 2, 64);
+		}
+		else {
+			*hpf = std::min<int32_t>(*hpf + 2, 64);
+		}
+	}
+	else if (direction < 0) {
+		if (*hpf > -64) {
+			*hpf = std::max<int32_t>(*hpf - 2, -64);
+		}
+		else {
+			*lpf = std::max<int32_t>(*lpf - 2, -64);
+		}
+	}
+}
+
+} // namespace deluge::dsp::dj
