+#include "hid/display/oled_brightness.h"
+#include "hid/display/display.h"
+#include <cstring>
+
+extern "C" {
+#include "drivers/oled/oled.h"
+}
+
+namespace deluge::hid::display::oled_brightness {
+
+namespace {
+/// The contrast per level, 1 + 254 * ((level - 1) / 9)^2: the OLED's light goes with its current, which goes with the
+/// contrast, and lightness as seen (CIE L*) goes roughly with the square root of that, so the steps look about even
+/// (L* about 4, 14, 28, 41, 53, 63, 73, 82, 91, 100; the SSD1309 datasheet: segment current = contrast / 256 * IREF)
+constexpr uint8_t kContrastForLevel[kNumLevels] = {1, 4, 14, 29, 51, 79, 114, 155, 202, 255};
+} // namespace
+
+uint8_t contrast() {
+	return oledContrast;
+}
+
+int32_t level() {
+	int32_t best = 1;
+	for (int32_t l = 2; l <= kNumLevels; l++) {
+		int32_t difference = kContrastForLevel[l - 1] - (int32_t)oledContrast;
+		int32_t bestDifference = kContrastForLevel[best - 1] - (int32_t)oledContrast;
+		if ((difference < 0 ? -difference : difference) < (bestDifference < 0 ? -bestDifference : bestDifference)) {
+			best = l;
+		}
+	}
+	return best;
+}
+
+void setLevel(int32_t level) {
+	level = (level < 1) ? 1 : (level > kNumLevels) ? kNumLevels : level;
+	setContrast(kContrastForLevel[level - 1]);
+}
+
+void setContrast(int32_t newContrast) {
+	newContrast = (newContrast < 1) ? 1 : (newContrast > 255) ? 255 : newContrast;
+	if (have_oled_screen) {
+		oledSetContrast((uint8_t)newContrast); // Sent only if it's new
+	}
+	else {
+		oledContrast = (uint8_t)newContrast; // Nothing to send it to; kept for the file
+	}
+}
+
+bool readSetting(char const* name, int32_t value) {
+	if (strcmp(name, kSettingName) != 0) {
+		return false;
+	}
+	setContrast(value);
+	return true;
+}
+
+} // namespace deluge::hid::display::oled_brightness
