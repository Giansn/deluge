+#pragma once
+#include <cstdint>
+
+/// mastertune-v18: Settings > Defaults > OLED brightness. The OLED's contrast (SSD1309 command 0x81), which used to be
+/// 0xFF always, in ten steps; kept on the card as the entry oledContrast in CommunityFeatures.XML (the contrast
+/// itself, 1-255; missing: 255) and sent to the OLED when it changes and at boot, once the file is read. The Deluge
+/// with the 7-segment display has no OLED: nothing is sent there and the menu doesn't show the item.
+namespace deluge::hid::display::oled_brightness {
+
+constexpr char const* kSettingName = "oledContrast";
+constexpr int32_t kNumLevels = 10;
+
+/// The contrast now (1-255)
+uint8_t contrast();
+/// The level (1-kNumLevels) whose contrast is nearest to the contrast now
+int32_t level();
+void setLevel(int32_t level);
+/// Clamped to 1-255; sent to the OLED if the Deluge has one and it's new
+void setContrast(int32_t contrast);
+/// From CommunityFeatures.XML: true if it's this setting's entry (and then it's applied)
+bool readSetting(char const* name, int32_t value);
+
+} // namespace deluge::hid::display::oled_brightness
