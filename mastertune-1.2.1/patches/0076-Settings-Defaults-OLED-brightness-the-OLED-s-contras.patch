index 670dc2c1..19f058dd 100644
--- a/src/RZA1/oled/oled_low_level.c
+++ b/src/RZA1/oled/oled_low_level.c
@@ -29,8 +29,6 @@
 #include "deluge/processing/engines/cv_engine_c_interface.h"
 #include "deluge/util/cfunctions.h"
 
-#define OLED_CODE_FOR_CV 1
-
 void setupSPIInterrupts()
 {
     setupAndEnableInterrupt(cvSPITransferComplete, INTC_ID_SPRI0 + SPI_CHANNEL_CV * 3, 5);
@@ -53,6 +51,14 @@ void oledRoutine()
     {
         oledWaitingForMessage    = oledPendingMessageToSend; // We'll wait to hear back from the PIC.
         oledPendingMessageToSend = 0;
+        // mastertune-v18: a command for the OLED (its contrast) goes with D/C low. The PIC sets it before it selects
+        // the OLED, and answers the selection after that; sendOledCommand() sets it high again. The queue's position
+        // stays on the item until the selection is done, so it's the one this selection is for.
+        if (oledWaitingForMessage == 248
+            && spiTransferQueue[spiTransferQueueReadPos].destinationId == OLED_CODE_FOR_COMMAND)
+        {
+            bufferPICUart(250); // D/C low
+        }
 sendMessageToPIC:
         oledMessageTimeoutTime = *TCNT[TIMER_SYSTEM_SLOW] + msToSlowTimerCount(50);
         bufferPICUart(oledWaitingForMessage);
@@ -70,12 +76,33 @@ sendMessageToPIC:
     }
 }
 
+// mastertune-v18: the command's two bytes (the OLED selected, D/C low), without the DMA, as oledMainInit() sends its
+// commands; then D/C high again and the OLED deselected, after which oledDeselectionComplete() goes on with the queue.
+// Only ever from the task that answers the PIC (oledLowLevelTimerCallback()): oledTransferComplete() goes straight on
+// with image data only, a command waits for the deselection and a selection with D/C low.
+static void sendOledCommand()
+{
+    uint32_t command        = (uint32_t)spiTransferQueue[spiTransferQueueReadPos].dataAddress;
+    spiTransferQueueReadPos = (spiTransferQueueReadPos + 1) & (SPI_TRANSFER_QUEUE_SIZE - 1);
+    R_RSPI_SendBasic8(SPI_CHANNEL_OLED_MAIN, command & 0xFF);
+    R_RSPI_SendBasic8(SPI_CHANNEL_OLED_MAIN, (command >> 8) & 0xFF);
+    R_RSPI_WaitEnd(SPI_CHANNEL_OLED_MAIN);
+    bufferPICUart(251);             // D/C high: what the OLED gets next is image data
+    oledPendingMessageToSend = 249; // Deselect
+}
+
 void oledSelectingComplete()
 {
     oledWaitingForMessage                   = 256;
     RSPI(SPI_CHANNEL_OLED_MAIN).SPDCR       = 0x20u;              // 8-bit
     RSPI(SPI_CHANNEL_OLED_MAIN).SPCMD0      = 0b0000011100000010; // 8-bit
     RSPI(SPI_CHANNEL_OLED_MAIN).SPBFCR.BYTE = 0b01100000;         // 0b00100000;
+
+    if (spiTransferQueue[spiTransferQueueReadPos].destinationId == OLED_CODE_FOR_COMMAND)
+    {
+        sendOledCommand();
+        return;
+    }
     // DMACn(OLED_SPI_DMA_CHANNEL).CHCFG_n = 0b00000000001000000000001001101000 | (OLED_SPI_DMA_CHANNEL & 7);
 
     int transferSize                   = (OLED_MAIN_HEIGHT_PIXELS >> 3) * OLED_MAIN_WIDTH_PIXELS;
@@ -125,8 +152,8 @@ void sendSPITransferFromQueue()
 
     spiDestinationSendingTo = spiTransferQueue[spiTransferQueueReadPos].destinationId;
 
-    // If it's OLED data...
-    if (spiDestinationSendingTo == 0)
+    // If it's OLED data (or, mastertune-v18, a command for the OLED)...
+    if (spiDestinationSendingTo != OLED_CODE_FOR_CV)
     {
         initiateSelectingOled();
     }
@@ -180,7 +207,7 @@ void cvSPITransferComplete(uint32_t sense)
     // Otherwise...
     else
     {
-        // And, if there's some OLED data waiting to send, do that.
+        // And, if there's some OLED data (or a command for the OLED) waiting to send, do that.
         if (spiTransferQueueWritePos != spiTransferQueueReadPos)
         {
             spiDestinationSendingTo = 0;
