+	bool countSecondary = secondaryBuffer.isActive() && !(fading && primaryBuffer.rate() < secondaryBuffer.rate());
+	const DelayBuffer& counting = countSecondary ? secondaryBuffer : primaryBuffer;
+
+	// mastertune-v14: in the last time round before the delay gives up, how far the fade out has to go: to where the
+	// counting buffer comes round, or, where that would take it down faster than from full level in
