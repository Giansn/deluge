+		uint32_t round = std::max(counting.samplesPerRound(), (uint32_t)1);
+		while ((uint64_t)tailGain * kFadeCrossfadeSamples > (uint64_t)kFullLevel * tailSamples) {
+			tailSamples += round;
+		}
+	}
