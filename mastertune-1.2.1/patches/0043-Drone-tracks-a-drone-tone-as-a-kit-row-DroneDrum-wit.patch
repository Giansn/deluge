+#include "model/drum/drone_drum.h"
+#include "gui/menu_item/drone/items.h"
+#include "lib/printf.h" // Not stdio: the firmware's snprintf, which doesn't allocate
+#include "model/clip/instrument_clip.h"
+#include "model/model_stack.h"
+#include "model/note/note_row.h"
+#include "model/tuning/master_tune.h"
+#include "modulation/automation/auto_param.h"
+#include "modulation/params/param_manager.h"
+#include "modulation/params/param_set.h"
+#include "playback/playback_handler.h"
+#include "processing/engines/audio_engine.h"
+#include "storage/storage_manager.h"
+#include "util/functions.h"
+#include <algorithm>
+#include <cmath>
+
+using Settings = deluge::dsp::DroneSettings;
+using Pitch = deluge::dsp::DroneTrackPitch;
+
+namespace {
+float masterTuneA4() {
+	return (float)MasterTune::getTenthsHz() * 0.1f;
+}
+} // namespace
+
+DroneDrum::DroneDrum() : NonAudioDrum(DrumType::DRONE) {
+	tone.active = true;
+	arpSettings.numOctaves = 1;
+}
+
+DroneDrum::~DroneDrum() {
+	// The tone menu mustn't be left editing a tone that's gone
+	if (deluge::gui::menu_item::drone::trackTone == &tone) {
+		deluge::gui::menu_item::drone::trackTone = nullptr;
+	}
+}
+
+void DroneDrum::noteOn(ModelStackWithThreeMainThings* modelStack, uint8_t velocity, Kit* kit, int16_t const* mpeValues,
+                       int32_t fromMIDIChannel, uint32_t sampleSyncLength, int32_t ticksLate, uint32_t samplesLate) {
+	// The lane where the note starts (the 16 bits of mpeValues are too coarse for it)
+	if (modelStack != nullptr && modelStack->paramManager != nullptr) {
+		ExpressionParamSet* expressionParams = modelStack->paramManager->getExpressionParamSet();
+		if (expressionParams != nullptr) {
+			pitchOffset = expressionParams->params[X_PITCH_BEND].getCurrentValue();
+		}
+	}
+	lastVelocity = velocity;
+	ArpReturnInstruction instruction;
+	// Through the row's arpeggiator, as a gate row's: with it on, it gates the tone in its rhythm
+	arpeggiator.noteOn(&arpSettings, kNoteForDrum, velocity, &instruction, fromMIDIChannel, mpeValues);
+	if (instruction.arpNoteOn != nullptr) {
+		for (int32_t n = 0; n < ARP_MAX_INSTRUCTION_NOTES; n++) {
+			if (instruction.arpNoteOn->noteCodeOnPostArp[n] == ARP_NOTE_NONE) {
+				break;
+			}
+			noteOnPostArp(instruction.arpNoteOn->noteCodeOnPostArp[n], instruction.arpNoteOn, n);
+			instruction.arpNoteOn->noteStatus[n] = ArpNoteStatus::PLAYING;
+		}
+	}
+}
+
+void DroneDrum::noteOff(ModelStackWithThreeMainThings* modelStack, int32_t velocity) {
+	ArpReturnInstruction instruction;
+	arpeggiator.noteOff(&arpSettings, kNoteForDrum, &instruction);
+	for (int32_t n = 0; n < ARP_MAX_INSTRUCTION_NOTES; n++) {
+		if (instruction.glideNoteCodeOffPostArp[n] == ARP_NOTE_NONE) {
+			break;
+		}
+		noteOffPostArp(instruction.glideNoteCodeOffPostArp[n]);
+	}
+	for (int32_t n = 0; n < ARP_MAX_INSTRUCTION_NOTES; n++) {
+		if (instruction.noteCodeOffPostArp[n] == ARP_NOTE_NONE) {
+			break;
+		}
+		noteOffPostArp(instruction.noteCodeOffPostArp[n]);
+	}
+}
+
+void DroneDrum::noteOnPostArp(int32_t noteCodePostArp, ArpNote* arpNote, int32_t noteIndex) {
+	NonAudioDrum::noteOnPostArp(noteCodePostArp, arpNote, noteIndex); // The gate opens
+}
+
+void DroneDrum::noteOffPostArp(int32_t noteCodePostArp) {
+	NonAudioDrum::noteOffPostArp(noteCodePostArp); // The gate closes: the tone fades out
+}
+
+void DroneDrum::unassignAllVoices() {
+	NonAudioDrum::unassignAllVoices();
+	voice_ = {}; // Cut, as a sound's voices are
+}
+
+void DroneDrum::polyphonicExpressionEventOnChannelOrNote(int32_t newValue, int32_t whichExpressionDimension,
+                                                         int32_t channelOrNoteNumber,
+                                                         MIDICharacteristic whichCharacteristic) {
+	if (whichExpressionDimension == X_PITCH_BEND) {
+		pitchOffset = newValue; // The voice glides there (about 15 ms)
+	}
+}
+
+float DroneDrum::baseHz(float a4Hz) const {
+	return Pitch::baseHz(tone, a4Hz);
+}
+
+float DroneDrum::currentHz(float a4Hz) const {
+	return Pitch::hz(tone, pitchOffset, a4Hz);
+}
+
+void DroneDrum::render(std::span<StereoSample> buffer, const deluge::dsp::Drone::Context& context) {
+	// The song's drone renders it: its scratch buffers, none of its tones
+	AudioEngine::drone.renderTone(voice_, Pitch::sounding(tone, state, pitchOffset, context.a4Hz), buffer, context,
+	                              kGain);
+}
+
+void DroneDrum::changePitch(ModelStackWithTimelineCounter* modelStack, int32_t offset, PitchStep step) {
+	if (offset == 0) {
+		return;
+	}
+	float a4 = masterTuneA4();
+
+	// Recording: into the lane at the play position, as cents from the tone's own pitch
+	InstrumentClip* clip = (InstrumentClip*)modelStack->getTimelineCounterAllowNull();
+	bool recording = clip != nullptr && playbackHandler.isEitherClockActive() && !playbackHandler.ticksLeftInCountIn
+	                 && playbackHandler.recording != RecordingMode::OFF && clip->armedForRecording
+	                 && clip->isPlayingAutomationNow();
+	if (recording) {
+		if (clip->possiblyCloneForArrangementRecording(modelStack)) {
+			clip = (InstrumentClip*)modelStack->getTimelineCounter(); // The arranger's clone
+		}
+		ModelStackWithNoteRow* modelStackWithNoteRow = clip->getNoteRowForDrum(modelStack, this);
+		NoteRow* noteRow = modelStackWithNoteRow->getNoteRowAllowNull();
+		ExpressionParamSet* expressionParams =
+		    (noteRow != nullptr) ? noteRow->paramManager.getOrCreateExpressionParamSet(true) : nullptr;
+		if (expressionParams != nullptr) {
+			int32_t value;
+			if (tone.byNote) {
+				bool semitones = (step == PitchStep::NORMAL || step == PitchStep::QUICK);
+				value = Pitch::valuePlusCents(pitchOffset, (float)offset * (semitones ? 100.f : 1.f));
+			}
+			else {
+				value = Pitch::valueForHz(tone, currentHz(a4) + (float)offset * stepHz(step), a4);
+			}
+
+			AutoParam* param = &expressionParams->params[X_PITCH_BEND];
+			ModelStackWithAutoParam* modelStackWithParam =
+			    modelStackWithNoteRow->addOtherTwoThingsAutomaticallyGivenNoteRow()->addParam(
+			        expressionParams, noteRow->paramManager.getExpressionParamSetSummary(), X_PITCH_BEND, param);
+			// As a gold knob records: a node here, and the lane held at it until the next one (Shift deletes the
+			// lane, as for any automation while recording). It tells us the new value
+			// (polyphonicExpressionEventOnChannelOrNote()).
+			param->setCurrentValueInResponseToUserInput(value, modelStackWithParam);
+			return;
+		}
+	}
+
+	// Otherwise the tone's own pitch, and the lane with it
+	if (tone.byNote) {
+		if (step == PitchStep::FINE || step == PitchStep::TENTH) {
+			tone.cents = std::clamp(tone.cents + offset, -Settings::kMaxCents, Settings::kMaxCents);
+		}
+		else {
+			tone.note = std::clamp(tone.note + offset, (int32_t)0, (int32_t)127);
+		}
+	}
+	else {
+		int32_t stepHundredths = (int32_t)std::lround(stepHz(step) * 100.f);
+		tone.frequency =
+		    std::clamp(tone.frequency + offset * stepHundredths, Settings::kMinFrequency, Settings::kMaxFrequency);
+	}
+}
+
+float DroneDrum::stepHz(PitchStep step) {
+	switch (step) {
+	case PitchStep::QUICK:
+		return 10.f;
+	case PitchStep::TENTH:
+		return 0.1f;
+	case PitchStep::FINE:
+		return 0.01f;
+	default:
+		return 1.f;
+	}
+}
+
+namespace {
+const char* modeName(Settings::Mode mode) {
+	using enum deluge::l10n::String;
+	switch (mode) {
+	case Settings::Mode::BINAURAL:
+		return deluge::l10n::get(STRING_FOR_BINAURAL);
+	case Settings::Mode::MONAURAL:
+		return deluge::l10n::get(STRING_FOR_MONAURAL);
+	case Settings::Mode::ISOCHRONIC:
+		return deluge::l10n::get(STRING_FOR_ISOCHRONIC);
+	default:
+		return deluge::l10n::get(STRING_FOR_DRONE_STEADY);
+	}
+}
+} // namespace
+
+void DroneDrum::getDisplayName(char* buffer, size_t size) const {
+	if (tone.byNote && pitchOffset == 0) {
+		char name[8];
+		noteCodeToString(tone.note, name);
+		if (tone.cents != 0) {
+			snprintf(buffer, size, "%s\n%s %+dc", modeName(tone.mode), name, (int)tone.cents);
+		}
+		else {
+			snprintf(buffer, size, "%s\n%s", modeName(tone.mode), name);
+		}
+		return;
+	}
+	int32_t hundredths = (int32_t)std::lround(currentHz(masterTuneA4()) * 100.f);
+	snprintf(buffer, size, "%s\n%d.%02d Hz", modeName(tone.mode), (int)(hundredths / 100), (int)(hundredths % 100));
+}
+
+// The 7-segment display: the frequency in four digits, as the drone view shows it (55.25, 440.0, 1200), or the note
+void DroneDrum::getName(char* buffer) {
+	if (tone.byNote && pitchOffset == 0) {
+		noteCodeToString(tone.note, buffer);
+		return;
+	}
+	int32_t hundredths = (int32_t)std::lround(currentHz(masterTuneA4()) * 100.f);
+	if (hundredths < 10000) {
+		snprintf(buffer, 6, "%d.%02d", (int)(hundredths / 100), (int)(hundredths % 100));
+	}
+	else if (hundredths < 100000) {
+		snprintf(buffer, 6, "%d.%d", (int)(hundredths / 100), (int)((hundredths / 10) % 10));
+	}
+	else {
+		snprintf(buffer, 6, "%d", (int)(hundredths / 100));
+	}
+}
+
+void DroneDrum::writeToFile(Serializer& writer, bool savingSong, ParamManager* paramManager) {
+	writer.writeOpeningTagBeginning("droneTone");
+	tone.writeAttributes([&](const char* name, int32_t value) { writer.writeAttribute(name, value); });
+	writer.writeOpeningTagEnd();
+
+	writeArpeggiatorToFile(writer);
+
+	if (savingSong) {
+		Drum::writeMIDICommandsToFile(writer);
+	}
+	writer.writeClosingTag("droneTone");
+}
+
+Error DroneDrum::readFromFile(Deserializer& reader, Song* song, Clip* clip, int32_t readAutomationUpToPos) {
+	char const* tagName;
+	while (*(tagName = reader.readNextTagOrAttributeName())) {
+		if (NonAudioDrum::readDrumTagFromFile(reader, tagName)) {}
+		else if (Tone::isAttribute(tagName)) {
+			tone.readAttribute(tagName, reader.readTagOrAttributeValueInt());
+			reader.exitTag(tagName);
+		}
+		else {
+			reader.exitTag(tagName);
+		}
+	}
+	tone.active = true;
+	return Error::NONE;
+}
