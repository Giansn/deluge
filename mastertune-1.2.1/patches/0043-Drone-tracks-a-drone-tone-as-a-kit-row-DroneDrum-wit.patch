+#pragma once
+
+#include "dsp/drone/drone.h"
+#include "model/drum/non_audio_drum.h"
+#include <cstdint>
+#include <span>
+
+class ModelStackWithTimelineCounter;
+
+/// mastertune-v16: a drone tone as a row of a kit, a "drone track". Its clips launch in Song view and sit in the
+/// arranger like any kit's, so drones can be placed and overlap. The row's notes open its gate (the tone fades in and
+/// out as the song's drone does); a note as long as the clip holds across the loop point.
+///
+/// Its pitch: the tone's own frequency (or note), and the row's Hz lane on top, in cents. The lane is the row's
+/// expression X (pitch bend, as MIDI rows have it), 2^31 for +9600 cents: 0, an empty lane, changes nothing, and it's
+/// saved, cloned, recorded to the arranger and undone like any automation. Turning the pitch while recording
+/// (changePitch()) writes the lane; otherwise it sets the tone's frequency, which moves the whole lane with it.
+///
+/// Rendered by the Drone's own code (Drone::renderTone()), into the kit's buffer
+/// (Kit::renderGlobalEffectableForClip()), so the kit's effects, volume and sidechain apply. Without life and FM, which
+/// belong to the song's drone.
+class DroneDrum final : public NonAudioDrum {
+public:
+	using Tone = deluge::dsp::DroneSettings::Tone;
+
+	DroneDrum();
+	~DroneDrum() override;
+
+	void noteOn(ModelStackWithThreeMainThings* modelStack, uint8_t velocity, Kit* kit, int16_t const* mpeValues,
+	            int32_t fromMIDIChannel = MIDI_CHANNEL_NONE, uint32_t sampleSyncLength = 0, int32_t ticksLate = 0,
+	            uint32_t samplesLate = 0) override;
+	void noteOff(ModelStackWithThreeMainThings* modelStack, int32_t velocity = kDefaultLiftValue) override;
+	void noteOnPostArp(int32_t noteCodePostArp, ArpNote* arpNote, int32_t noteIndex) override;
+	void noteOffPostArp(int32_t noteCodePostArp) override;
+	void unassignAllVoices() override;
+	void writeToFile(Serializer& writer, bool savingSong, ParamManager* paramManager) override;
+	Error readFromFile(Deserializer& reader, Song* song, Clip* clip, int32_t readAutomationUpToPos) override;
+	void getName(char* buffer) override;
+	int32_t getNumChannels() override { return 1; }
+	int8_t modEncoderAction(ModelStackWithThreeMainThings* modelStack, int8_t offset,
+	                        uint8_t whichModEncoder) override {
+		return -64; // No channel to change (the clip view gives the gold knobs to changePitch() and the level)
+	}
+
+	/// The Hz lane (expression X) as it plays or is recorded
+	void polyphonicExpressionEventOnChannelOrNote(int32_t newValue, int32_t whichExpressionDimension,
+	                                              int32_t channelOrNoteNumber,
+	                                              MIDICharacteristic whichCharacteristic) override;
+
+	/// Whether render() has anything to do: the gate open, or the tone still fading out
+	[[nodiscard]] bool isSounding() const { return state || voice_.started; }
+	/// Adds the tone to the kit's buffer
+	void render(std::span<StereoSample> buffer, const deluge::dsp::Drone::Context& context);
+
+	/// The frequency it plays at now, in hertz: the tone's with the lane's offset
+	[[nodiscard]] float currentHz(float a4Hz) const;
+	/// The tone's own frequency, before the lane
+	[[nodiscard]] float baseHz(float a4Hz) const;
+
+	/// How far the pitch goes for one click
+	enum class PitchStep : uint8_t {
+		NORMAL, ///< 1 Hz, or a semitone for a tone set by note
+		QUICK,  ///< 10 Hz (a quick turn), or a semitone
+		TENTH,  ///< 0.1 Hz, or a cent
+		FINE,   ///< 0.01 Hz, or a cent
+	};
+	[[nodiscard]] static float stepHz(PitchStep step);
+	/// Turns the pitch by offset clicks (select encoder, upper gold knob). While the clip plays and records (REC, the
+	/// clip armed), into the Hz lane at the play position, latching as a knob does; in the arranger's recording, into
+	/// the clone it records. Otherwise the tone's own frequency. modelStack: the clip (its timeline counter may change
+	/// to the clone).
+	void changePitch(ModelStackWithTimelineCounter* modelStack, int32_t offset, PitchStep step);
+
+	/// Name for the OLED: its mode and pitch, as "Binaural\n220.00 Hz", the lane's pitch if it's moved it
+	void getDisplayName(char* buffer, size_t size) const;
+
+	Tone tone; ///< What sounds; tone.active isn't used (the gate is)
+
+	/// The Hz lane's value (expression X), as DroneTrackPitch has it: 2^31 is +9600 cents
+	int32_t pitchOffset = 0;
+
+	/// Level against the song's drone: a row at a level in a new kit (its volume 3/4 of the way up) sounds as loud as
+	/// a tone of the song's drone at that level with the drone's volume at its default (40), so a drone made a drone
+	/// track keeps its level. Measured in the emulator: the kit's stages put a row 6.71 dB below the drone's tone, this
+	/// makes up for it (tests/song, run.sh's DRONE=1 checks it within 1 dB).
+	static constexpr float kGain = 2.166f;
+
+private:
+	deluge::dsp::Drone::Voice voice_{};
+};
