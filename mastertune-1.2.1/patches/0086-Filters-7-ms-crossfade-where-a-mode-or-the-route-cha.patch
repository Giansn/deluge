+// ---- mastertune v18: crossfades
+
+namespace {
+struct FilterFade {
+	FilterSet* owner; // nullptr: free
+	int32_t done;     // samples (frames) of the fade done
+	float gain;       // the gain compensation the filters as they were had (setConfig()'s output over its input)
+	alignas(FilterSet) uint8_t filters[sizeof(FilterSet)]; // a copy of the FilterSet as it was
+	FilterSet& old() { return *reinterpret_cast<FilterSet*>(filters); }
+};
+FilterFade fades[FilterSet::kNumFades];
+// The input of the filters as they were (the render buffers' size)
+q31_t fadeBuffer[SSI_TX_BUFFER_NUM_SAMPLES * 2];
+} // namespace
+
+bool FilterSet::startFade() {
+	for (int32_t i = 0; i < kNumFades; i++) {
+		FilterFade& f = fades[i];
+		if (f.owner == nullptr) {
+			memcpy(f.filters, (const void*)this, sizeof(FilterSet));
+			f.old().fadeSlot_ = 0; // the copy renders plainly
+			f.owner = this;
+			f.done = 0;
+			f.gain = gainCompensation_;
+			fadeSlot_ = (uint8_t)(i + 1);
+			return true;
+		}
+	}
+	return false; // all busy: the change switches at once, as before
+}
+
+uint8_t FilterSet::fadeSlot() {
+	int32_t i = (int32_t)fadeSlot_ - 1;
+	if (i >= 0 && i < kNumFades && fades[i].owner == this) {
+		return fadeSlot_;
+	}
+	fadeSlot_ = 0;
+	return 0;
+}
+
+// Also from reset() and the constructor, where fadeSlot_ may be anything: only a slot that is this one's goes
+void FilterSet::endFade() {
+	int32_t i = (int32_t)fadeSlot_ - 1;
+	if (i >= 0 && i < kNumFades && fades[i].owner == this) {
+		fades[i].owner = nullptr;
+	}
+	fadeSlot_ = 0;
+}
+
+// The filters as they were render the same input into fadeBuffer, this one's in place, and the output moves from theirs
+// to this one's over kFadeSamples. Their gain: the gain compensation their configuration gave against this one's, on
+// their input where the caller applies it before the filters (a voice), on their output where after (outputGain: the
+// song's, a kit's, an audio track's)
+void FilterSet::renderFade(q31_t* startSample, q31_t* endSample, int32_t sampleIncrement, bool stereo,
+                           int32_t hpfSaturation, int32_t lpfSaturation, bool outputGain) {
+	FilterFade& f = fades[fadeSlot_ - 1];
+	int32_t length = (int32_t)(endSample - startSample);
+	// Q2.29, 1 = 536870912
+	constexpr q31_t kOne = 1 << 29;
+	q31_t ratio = kOne;
+	if (gainCompensation_ > 0.0f && f.gain > 0.0f && f.gain != gainCompensation_) {
+		ratio = (q31_t)std::clamp(f.gain / gainCompensation_ * (float)kOne, (float)(kOne >> 2), 3.99f * kOne);
+	}
+	if (ratio != kOne && !outputGain) {
+		for (int32_t i = 0; i < length; i++) {
+			fadeBuffer[i] = lshiftAndSaturate<3>(multiply_32x32_rshift32_rounded(startSample[i], ratio));
+		}
+	}
+	else {
+		memcpy(fadeBuffer, startSample, length * sizeof(q31_t));
+	}
+	if (stereo) {
+		f.old().renderLongStereoInner(fadeBuffer, fadeBuffer + length, hpfSaturation, lpfSaturation);
+	}
+	else {
+		f.old().renderLongInner(fadeBuffer, fadeBuffer + length, sampleIncrement, hpfSaturation, lpfSaturation);
+	}
+	if (stereo) {
+		renderLongStereoInner(startSample, endSample, hpfSaturation, lpfSaturation);
+	}
+	else {
+		renderLongInner(startSample, endSample, sampleIncrement, hpfSaturation, lpfSaturation);
+	}
+	// out = new + (old - new) * (1 - w), w = (done + 1) / kFadeSamples up to 1, per frame
+	int32_t channels = stereo ? 2 : 1;
+	int32_t step = stereo ? 2 : sampleIncrement;
+	int32_t done = f.done;
+	for (int32_t i = 0; i < length && done < kFadeSamples; i += step) {
+		done++;
+		int64_t keep = (int64_t)(kFadeSamples - done) * ONE_Q31 / kFadeSamples; // the old one's share, Q31
+		for (int32_t c = 0; c < channels; c++) {
+			int64_t old = fadeBuffer[i + c];
+			if (ratio != kOne && outputGain) {
+				old = ((int64_t)old * ratio) >> 29;
+			}
+			int64_t now = startSample[i + c];
+			int64_t out = now + (((old - now) * keep) >> 31);
+			startSample[i + c] = (q31_t)std::clamp(out, (int64_t)INT32_MIN, (int64_t)INT32_MAX);
+		}
+	}
+	f.done = done;
+	if (done >= kFadeSamples) {
+		endFade();
 	}
 }
 
@@ -193,6 +319,26 @@ int32_t FilterSet::setConfig(q31_t lpfFrequency, q31_t lpfResonance, FilterMode
                              q31_t filterGain, FilterRoute routing, bool adjustVolumeForHPFResonance,
                              q31_t* overallOscAmplitude) {
 	const q31_t filterGainIn = filterGain;
+	if (configured_) {
+		if (fadeSlot() != 0) {
+			// One crossfade at a time: a change during one waits for its end (at most kFadeSamples), with the filters
+			// as they are now
+			lpfmode = lpfMode_;
+			hpfmode = hpfMode_;
+			routing = routing_;
+		}
+		else {
+			// A filter switched off or to another mode, or the route changed with a filter on: fade from the filters as
+			// they were. (A filter switched on fades in from the dry signal itself, see Filter::reset())
+			bool lpfChange = lpfMode_ != FilterMode::OFF && lpfmode != lpfMode_;
+			bool hpfChange = hpfMode_ != FilterMode::OFF && hpfmode != hpfMode_;
+			bool routeChange = routing != routing_ && (LPFOn || HPFOn);
+			if (lpfChange || hpfChange || routeChange) {
+				startFade();
+			}
+		}
+	}
+	configured_ = true;
 	LPFOn = lpfmode != FilterMode::OFF;
 	HPFOn = hpfmode != FilterMode::OFF;
 	lpfMode_ = lpfmode;
