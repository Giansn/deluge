+/// A block's step along a course: the noise through both low-passes
+float Drone::advance(Course& course, const Lively& lively, CourseIndex index) {
+	float coefficient = lively.coefficient[index];
+	course.smooth += coefficient * (randomBipolar() * lively.noiseGain[index] - course.smooth);
+	course.value += coefficient * (course.smooth - course.value);
+	return std::clamp(course.value, -kCourseLimit, kCourseLimit);
+}
