+const float* Drone::sawTableFor(float highestFrequencyHz, int32_t mostHarmonics) {
+	float allowed = kHighestHarmonicHz / std::max(highestFrequencyHz, 1.f);
+	for (size_t s = 0; s < kNumSawTables; s++) {
+		if (kSawHarmonics[s] <= mostHarmonics && (float)kSawHarmonics[s] <= allowed) {
+			return tables_[kNumTimbreTables + s];
+		}
+	}
+	return tables_[kNumTimbreTables + kNumSawTables - 1];
