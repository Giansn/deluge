+/// One side of a lively tone (mastertune-v15), before its gains: the timbre, or a pulse as the difference of two saws,
+/// read where FM moves the phase to, crossfaded towards its fundamental by the shimmer
+template <Drone::FmKind kFm, bool kPulse, bool kShimmer>
+void Drone::renderSide(float* out, size_t numSamples, uint32_t phase, uint32_t increment, int32_t step, float* dc,
+                       const Oscillator& oscillator) {
+	// All in locals: the output could alias the oscillator's floats, which would have them read again each sample
+	const float* table = oscillator.table;
+	const float* sine = oscillator.sine;
+	const float* sawModulator = oscillator.sawModulator;
+	uint32_t modulatorOffset = oscillator.modulatorOffset;
+	const uint32_t modulatorIncrement = oscillator.modulatorIncrement;
+	float sineDepth = oscillator.sineDepth;
+	const float sineDepthStep = oscillator.sineDepthStep;
+	float sawDepth = oscillator.sawDepth;
+	const float sawDepthStep = oscillator.sawDepthStep;
+	uint32_t width = oscillator.width;
+	const uint32_t widthStep = (uint32_t)oscillator.widthStep;
+	float shimmer = oscillator.shimmer;
+	const float shimmerStep = oscillator.shimmerStep;
+	float fundamental = oscillator.fundamental;
+	const float fundamentalStep = oscillator.fundamentalStep;
+	float dcShare = oscillator.dcShare;
+	const float dcShareStep = oscillator.dcShareStep;
+	float low1 = dc[0];
+	float low2 = dc[1];
+	for (size_t s = 0; s < numSamples; s++) {
+		uint32_t p = phase;
+		if constexpr (kFm != FmKind::NONE) {
+			// The modulator at the carrier's phase plus its slowly turning offset. At most 2 radians times the saw's
+			// 1.53 and its peak (below 1) of a cycle's 2^32: under 2^31, so the shift fits
+			uint32_t modulator = phase + modulatorOffset;
+			float shift = 0.f;
+			if constexpr (kFm == FmKind::SINE || kFm == FmKind::BOTH) {
+				shift += sineDepth * readTable(sine, modulator);
+				sineDepth += sineDepthStep;
+			}
+			if constexpr (kFm == FmKind::SAW || kFm == FmKind::BOTH) {
+				shift += sawDepth * readTable(sawModulator, modulator);
+				sawDepth += sawDepthStep;
+			}
+			p += (uint32_t)(int32_t)shift;
+			modulatorOffset += modulatorIncrement;
+		}
+		float v;
+		if constexpr (kPulse) {
+			v = 0.5f * (readTable(table, p) - readTable(table, p - width));
+		}
+		else {
+			v = readTable(table, p);
+		}
+		if constexpr (kShimmer) {
+			// The fundamental alone; a pulse's is a quarter cycle and half its width off the saw's
+			uint32_t fundamentalPhase = kPulse ? p + 0x40000000 - (width >> 1) : p;
+			v += fundamental * readTable(sine, fundamentalPhase) - shimmer * v;
+			shimmer += shimmerStep;
+			fundamental += fundamentalStep;
+		}
+		if constexpr (kPulse) {
+			width += widthStep;
+		}
+		if constexpr (kFm != FmKind::NONE) {
+			// Each high-pass takes out what its low-pass lets through
+			low1 += kDcBlock * (v - low1);
+			low2 += kDcBlock * (v - low1 - low2);
+			v -= dcShare * (low1 + low2);
+			dcShare += dcShareStep;
+		}
+		out[s] = v;
+		phase += increment;
+		increment += (uint32_t)step;
+	}
+	dc[0] = low1;
+	dc[1] = low2;
+}
