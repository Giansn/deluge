+/// Highest harmonic of each band-limited saw, best first (the highest tone, 5 kHz, still gets 3)
+constexpr std::array<int32_t, Drone::kNumSawTables> kSawHarmonics{24, 16, 12, 8, 6, 4, 3};
+/// The saw modulator's harmonics, at most
