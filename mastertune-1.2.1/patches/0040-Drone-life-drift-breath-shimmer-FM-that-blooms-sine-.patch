+/// Life and FM for the whole drone this block: the settings glide, so turning them doesn't step, and the courses'
+/// low-passes follow the rate and the block's length
+void Drone::updateLively(Lively& lively, const Settings& settings, size_t numSamples) {
+	float lifeTarget = (float)std::clamp(settings.life, (int32_t)0, S::kMaxLife) * (1.f / (float)S::kMaxLife);
+	float fmTarget = (float)std::clamp(settings.fm, (int32_t)0, S::kMaxLife) * (kFmDeepest / (float)S::kMaxLife);
+	float sawTarget = (settings.fmForm == S::FmForm::SAW) ? 1.f : 0.f;
+	if (!isSounding()) {
+		// From silence, at the settings straight away
+		life_ = lifeTarget;
+		fmDepth_ = fmTarget;
+		saw_ = sawTarget;
+	}
+	lively.sawStart = saw_;
+	life_ = glide(life_, lifeTarget, 0.0005f);
+	fmDepth_ = glide(fmDepth_, fmTarget, 0.001f);
+	saw_ = glide(saw_, sawTarget, 0.0005f);
+	lively.life = life_;
+	lively.fmDepth = fmDepth_;
+	lively.sawEnd = saw_;
+	lively.width = (float)std::clamp(settings.pulseWidth, S::kMinPulseWidth, S::kMaxPulseWidth) * (1.f / 100.f);
+	if (life_ <= 0.f && fmDepth_ <= 0.f) {
+		return; // The courses stand still
+	}
+
+	if (settings.lifeRate != rateForFactor_) {
+		rateForFactor_ = settings.lifeRate;
+		rateFactor_ = std::exp2((float)(std::clamp(settings.lifeRate, (int32_t)0, S::kMaxLife) - 25) * (1.f / 12.5f));
+	}
+	float radiansPerHz = 6.28318531f * rateFactor_ * (float)numSamples / (float)kSampleRate;
+	for (size_t i = 0; i < kNumCourses; i++) {
+		// Each low-pass: 1 - e^-delta of the way a block, and the noise scaled so the second one's output has a
+		// standard deviation of 1 (the noise, uniform, has a variance of 1/3)
+		float delta = kCourseHz[i] * radiansPerHz;
+		float coefficient = delta * (1.f - 0.5f * delta);
+		float a = 1.f - coefficient;
+		lively.coefficient[i] = coefficient;
+		lively.noiseGain[i] = std::sqrt(3.f * (1.f + a) * (1.f + a) * (1.f + a) / (coefficient * (1.f + a * a)));
+	}
+}
