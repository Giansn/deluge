+/// How fast each course moves at the life rate's middle (25): its low-passes' cutoff in hertz. By CourseIndex: drift,
+/// breath, shimmer, pan, the FM's bloom and the pulse width.
+constexpr std::array<float, 6> kCourseHz{0.08f, 0.12f, 0.05f, 0.05f, 0.07f, 0.1f};
+/// A course stays within this many standard deviations, so a tone never strays far
+constexpr float kCourseLimit = 3.f;
+/// What a standard deviation of each course does at the top of life: 6 cents of drift and 3 dB of breath (both as
+/// natural logarithms of the factor), 0.25 of pan (1 is all the way) and 12 % of pulse width. The shimmer crossfades
+/// up to this far towards the fundamental.
+constexpr float kDriftPerCourse = 6.f / 1200.f * 0.693147181f;
+constexpr float kBreathPerCourse = 3.f / 20.f * 2.302585093f;
+constexpr float kPanPerCourse = 0.25f;
