+/// Uniform from -1 to 1: xorshift64 (Marsaglia), its upper half
+float Drone::randomBipolar() {
+	random_ ^= random_ << 13;
+	random_ ^= random_ >> 7;
+	random_ ^= random_ << 17;
+	return (float)(int32_t)(uint32_t)(random_ >> 32) * (1.f / 2147483648.f);
+}
