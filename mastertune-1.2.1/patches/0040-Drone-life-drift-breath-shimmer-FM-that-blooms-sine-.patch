+constexpr float kFmDeepest = 2.f;
+constexpr float kModulatorOffsetHz = 0.3f;
+constexpr float kPhasePerRadian = 4294967296.f / 6.28318531f;
+/// FM spreads each harmonic into sidebands, the further the deeper and the higher the tone, until they reach past the
+/// Nyquist frequency and alias: the index times the tone's frequency (in hertz) stays within this, by timbre (sine,
+/// soft, organ, rich, pulse). Measured (tests/drone): with the sine modulator nothing aliases louder than -50 dB, with
+/// the saw no louder than in the sound it was chosen by (a pulse at 220 Hz, saw FM of 1.2 radians: about -28 dB).
+constexpr std::array<float, S::kNumTimbres> kFmReachSine{7000.f, 2200.f, 900.f, 900.f, 650.f};
+constexpr std::array<float, S::kNumTimbres> kFmReachSaw{2500.f, 1600.f, 400.f, 300.f, 240.f};
+/// And for a tone whose table has its highest harmonic just below kHighestHarmonicHz: that harmonic's sidebands, about
+/// index times it plus 3 of them further out (kSawTopSpread times as far for the saw), stay below this, whose alias
+/// is above 16 kHz
+constexpr float kFmFoldHz = 28100.f;
+constexpr float kSawTopSpread = 3.f;
+/// FM also puts a sideband at the modulator's 0.3 Hz offset, which ducking or an isochronic pulse would turn into
+/// thumps: a DC blocker (two one-pole high-passes at 3 Hz, -40 dB at 0.3 Hz) takes it out of the tones with FM
+constexpr float kDcBlock = 2.f * 3.14159265f * 3.f / (float)kSampleRate;
+
+/// The highest harmonic in the table Drone::tableFor() picks
+int32_t highestHarmonicOf(S::Timbre timbre, float highestFrequencyHz) {
+	float allowed = kHighestHarmonicHz / std::max(highestFrequencyHz, 1.f);
+	if (timbre == S::Timbre::PULSE) {
+		for (int32_t highest : kSawHarmonics) {
+			if ((float)highest <= allowed) {
+				return highest;
+			}
+		}
+		return kSawHarmonics.back();
+	}
+	for (int32_t highest : kTimbres[static_cast<size_t>(timbre)].levels) {
+		if (highest == 0) {
+			break;
+		}
+		if ((float)highest <= allowed) {
+			return highest;
+		}
+	}
+	return 1;
+}
