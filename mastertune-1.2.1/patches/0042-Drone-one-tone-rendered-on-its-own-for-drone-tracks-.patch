+bool DroneSettings::Tone::readAttribute(const char* name, int32_t value) {
+	if (!strcmp(name, "mode")) {
+		mode = (Mode)std::clamp(value, (int32_t)0, kNumModes - 1);
+	}
+	else if (!strcmp(name, "timbre")) {
+		timbre = (Timbre)std::clamp(value, (int32_t)0, kNumTimbres - 1);
+	}
+	else if (!strcmp(name, "byNote")) {
+		byNote = (value != 0);
+	}
+	else if (!strcmp(name, "note")) {
+		note = std::clamp(value, (int32_t)0, (int32_t)127);
+	}
+	else if (!strcmp(name, "cents")) {
+		cents = std::clamp(value, -kMaxCents, kMaxCents);
+	}
+	else if (!strcmp(name, "frequency")) {
+		frequency = std::clamp(value, kMinFrequency, kMaxFrequency);
+	}
+	else if (!strcmp(name, "beat")) {
+		beat = std::clamp(value, (int32_t)0, kMaxBeat);
+	}
+	else if (!strcmp(name, "sync")) {
+		sync = std::clamp(value, (int32_t)0, kMaxSync);
+	}
+	else if (!strcmp(name, "triplet")) {
+		triplet = (value != 0);
+	}
+	else if (!strcmp(name, "pulseAttack")) {
+		pulseAttack = std::clamp(value, (int32_t)0, kMaxPulseEdge);
+	}
+	else if (!strcmp(name, "pulseRelease")) {
+		pulseRelease = std::clamp(value, (int32_t)0, kMaxPulseEdge);
+	}
+	else if (!strcmp(name, "level")) {
+		level = std::clamp(value, (int32_t)0, kMaxLevel);
+	}
+	else if (!strcmp(name, "pan")) {
+		pan = std::clamp(value, -kMaxPan, kMaxPan);
+	}
+	else {
+		return false;
+	}
+	return true;
+}
+
+float DroneTrackPitch::baseHz(const Tone& tone, float a4Hz) {
+	if (tone.byNote) {
+		return Drone::noteToHz(tone.note, tone.cents, a4Hz);
+	}
+	return (float)std::clamp(tone.frequency, S::kMinFrequency, S::kMaxFrequency) * 0.01f;
+}
+
+float DroneTrackPitch::hz(const Tone& tone, int32_t value, float a4Hz) {
+	float frequency = baseHz(tone, a4Hz);
+	if (value != 0) {
+		frequency *= std::exp2((float)value * (kCentsPerValue / 1200.f));
+	}
+	return std::clamp(frequency, (float)S::kMinFrequency * 0.01f, (float)S::kMaxFrequency * 0.01f);
+}
+
+int32_t DroneTrackPitch::valuePlusCents(int32_t value, float cents) {
+	float total = std::clamp((float)value * kCentsPerValue + cents, -kMaxCents, kMaxCents);
+	// Within int32_t before rounding (the float next below 2^31)
+	return (int32_t)std::lround(std::clamp(total / kCentsPerValue, -2147483520.f, 2147483520.f));
+}
+
+int32_t DroneTrackPitch::valueForHz(const Tone& tone, float hz, float a4Hz) {
+	hz = std::clamp(hz, (float)S::kMinFrequency * 0.01f, (float)S::kMaxFrequency * 0.01f);
+	return valuePlusCents(0, 1200.f * std::log2(hz / baseHz(tone, a4Hz)));
+}
+
+DroneSettings::Tone DroneTrackPitch::sounding(const Tone& tone, bool gate, int32_t value, float a4Hz) {
+	Tone result = tone;
+	result.active = gate;
+	if (value != 0) {
+		result.byNote = false;
+		result.frequency =
+		    std::clamp((int32_t)std::lround(hz(tone, value, a4Hz) * 100.f), S::kMinFrequency, S::kMaxFrequency);
+	}
+	return result;
+}
+
+bool DroneSettings::Tone::isAttribute(const char* name) {
+	Tone scratch;
+	return scratch.readAttribute(name, 0);
+}
