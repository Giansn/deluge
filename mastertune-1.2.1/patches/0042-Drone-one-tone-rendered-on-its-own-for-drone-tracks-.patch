+/// mastertune-v16: the pitch of a drone track's row (DroneDrum): its tone's own, with the row's Hz lane on top. The
+/// lane's value is in cents: 2^31 is +9600 cents (8 octaves, as far as MIDI pitch bend reaches), 0 the tone's own.
+struct DroneTrackPitch {
+	using Tone = DroneSettings::Tone;
+	static constexpr float kCentsPerValue = 9600.f / 2147483648.f;
+	static constexpr float kMaxCents = 9600.f;
+
+	/// The tone's own frequency in hertz
+	[[nodiscard]] static float baseHz(const Tone& tone, float a4Hz);
+	/// With the lane's value on top, within the drone's range
+	[[nodiscard]] static float hz(const Tone& tone, int32_t value, float a4Hz);
+	/// The lane's value that gives a frequency (within +-9600 cents)
+	[[nodiscard]] static int32_t valueForHz(const Tone& tone, float hz, float a4Hz);
+	/// The lane's value moved by some cents
+	[[nodiscard]] static int32_t valuePlusCents(int32_t value, float cents);
+	/// What Drone::renderTone() gets: on while the gate's open, and once the lane has moved the pitch, the frequency
+	/// it gives, to a hundredth of a hertz
+	[[nodiscard]] static Tone sounding(const Tone& tone, bool gate, int32_t value, float a4Hz);
+};
