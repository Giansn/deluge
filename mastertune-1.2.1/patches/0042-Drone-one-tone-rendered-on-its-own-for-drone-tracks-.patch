@@ -513,6 +601,44 @@ void Drone::render(std::span<StereoSample> buffer, const Settings& settings, con
 	}
 }
 
+void Drone::renderTone(Voice& voice, const Tone& tone, std::span<StereoSample> buffer, const Context& context,
+                       float gain) {
+	if (!tablesReady()) {
+		return;
+	}
+	float volumeGain = gain * context.volume * kFullScale;
+	Lively lively; // Life and FM off
+	lively.width = (float)S{}.pulseWidth * (1.f / 100.f);
+
+	Context chunkContext = context;
+	for (size_t start = 0; start < buffer.size(); start += kChunk) {
+		if (!voice.started && !tone.active) {
+			return;
+		}
+		std::span<StereoSample> chunk = buffer.subspan(start, std::min(kChunk, buffer.size() - start));
+		std::array<float, 2 * kChunk> mix{};
+		std::span<float> mixSpan{mix.data(), 2 * chunk.size()};
+
+		// As render() does for a tone of the drone: a pulse, or until it's come to rest, the lively way
+		Timbre timbre = voice.started ? voice.timbre : tone.timbre;
+		if (voice.lively || timbre == Timbre::PULSE) {
+			renderLivelyVoice(voice, tone, mixSpan, chunkContext, volumeGain, lively);
+		}
+		else {
+			renderVoice(voice, tone, mixSpan, chunkContext, volumeGain);
+		}
+
+		for (size_t s = 0; s < chunk.size(); s++) {
+			chunk[s].l += (int32_t)mix[2 * s];
+			chunk[s].r += (int32_t)mix[2 * s + 1];
+		}
+
+		if (chunkContext.position >= 0.) {
+			chunkContext.position += (double)chunk.size() * (double)context.quarterNotesPerSecond / (double)kSampleRate;
+		}
+	}
+}
