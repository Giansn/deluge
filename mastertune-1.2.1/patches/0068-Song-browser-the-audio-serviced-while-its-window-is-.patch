diff --git a/src/deluge/util/container/array/c_string_array.cpp b/src/deluge/util/container/array/c_string_array.cpp
index 1dc46d24..14313dbc 100644
--- a/src/deluge/util/container/array/c_string_array.cpp
+++ b/src/deluge/util/container/array/c_string_array.cpp
@@ -24,6 +24,13 @@
 
 int32_t workCount;
 
+namespace {
+bool sortServicesAudio = false; // sortForStrings(true)
+// With sortServicesAudio, ranges from this many elements on are partitioned right after the audio routine: between its
+// calls a partition of the whole array or the sort of a range below this (~150 comparisons, strcmpspecial())
+constexpr int32_t kSortElementsBetweenAudio = 24;
+} // namespace
+
 // This uses Hoare's partitioning scheme, which has the advantage that it won't go slow if the elements are already
 // sorted - which they often will be as filenames read off an SD card. You must set shouldInterpretNoteNames and
 // octaveStartsFromA before calling this.
@@ -54,6 +61,9 @@ int32_t CStringArray::partitionForStrings(int32_t low, int32_t high) {
 // You must set shouldInterpretNoteNames and octaveStartsFromA before calling this.
 void CStringArray::quickSortForStrings(int32_t low, int32_t high) {
 	while (low < high) {
+		if (sortServicesAudio && high - low >= kSortElementsBetweenAudio) {
+			AudioEngine::routineWithClusterLoading();
+		}
 		/* pi is partitioning index, arr[p] is now
 		at right place */
 		int32_t pi = partitionForStrings(low, high);
@@ -78,13 +88,15 @@ void CStringArray::quickSortForStrings(int32_t low, int32_t high) {
 }
 
 // You must set shouldInterpretNoteNames and octaveStartsFromA before calling this.
-void CStringArray::sortForStrings() {
+void CStringArray::sortForStrings(bool serviceAudio) {
 	if (numElements < 2) {
 		return;
 	}
 
 	workCount = 0;
+	sortServicesAudio = serviceAudio;
 	quickSortForStrings(0, numElements - 1);
+	sortServicesAudio = false;
 }
 
 // Array must be sorted before you call this.
diff --git a/src/deluge/util/container/array/c_string_array.h b/src/deluge/util/container/array/c_string_array.h
