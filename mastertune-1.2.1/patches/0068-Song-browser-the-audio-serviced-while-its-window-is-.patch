 public:
 	CStringArray(int32_t newElementSize) : ResizeableArray(newElementSize) {}
-	void sortForStrings();
+	// mastertune: serviceAudio runs the audio routine (with cluster loading) before each partition of a larger range,
+	// for a sort that would take longer than the audio buffer lasts (the song browser's window of file items)
+	void sortForStrings(bool serviceAudio = false);
 	int32_t search(char const* searchString, bool* foundExact = NULL);
 
 private:
