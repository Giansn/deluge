+		return;
+	}
+	deluge::dsp::DroneSettings& settings = currentSong->drone;
+	deluge::dsp::Drone::Context context;
+
+	// Tempo and position both in the song's quarter notes, as the metronome counts them
+	float timePerTick = playbackHandler.getTimePerInternalTickFloat();
+	double quarterNoteLength = (double)currentSong->getQuarterNoteLength();
+	if (timePerTick > 0.f) {
+		context.quarterNotesPerSecond = (float)((double)kSampleRate / ((double)timePerTick * quarterNoteLength));
+	}
+	if (playbackHandler.isEitherClockActive()) {
+		double tick;
+		if (playbackHandler.isExternalClockActive()) {
+			// Following the clock between its ticks (getCurrentInternalTickCount() only has whole ticks for it)
+			tick = playbackHandler.getCurrentInternalTickFloatFollowingExternalClock();
+		}
+		else {
+			uint32_t timeSinceLastTick = 0;
+			int64_t ticks = playbackHandler.getCurrentInternalTickCount(&timeSinceLastTick);
+			tick = (double)ticks + (timePerTick > 0.f ? (double)timeSinceLastTick / (double)timePerTick : 0.);
+		}
+		context.position = std::max(tick, 0.) / quarterNoteLength;
+	}
+
+	// The song's volume, as the metronome follows it (1 at the song's neutral volume)
+	int32_t songVolume =
+	    getFinalParameterValueVolume(
+	        134217728, cableToLinearParamShortcut(
+	                       currentSong->paramManager.getUnpatchedParamSet()->getValue(params::UNPATCHED_VOLUME)))
+	    >> 1;
+	context.volume = (float)songVolume * (1.f / 67108864.f);
+	context.a4Hz = (float)MasterTune::getTenthsHz() * 0.1f;
+
+	if (settings.sidechain > 0) {
+		if (sideChainHitPending != 0) {
+			currentSong->droneSidechain.registerHit(sideChainHitPending);
+		}
+		// 0 when not ducking, down to -1 (in Q31) at the bottom of a full hit
+		int32_t envelope = currentSong->droneSidechain.render(numSamples, settings.sidechainShape);
+		float gain = 1.f
+		             + (float)settings.sidechain * (1.f / deluge::dsp::DroneSettings::kMaxLevel)
+		                   * ((float)envelope * (1.f / 2147483648.f));
+		gain = std::max(gain, 0.f);
+		context.duck = gain * gain; // A volume curve, as the reverb's ducking
+	}
+
+	drone.render(std::span<StereoSample>(renderingBuffer.data(), numSamples), settings, context);
+}
