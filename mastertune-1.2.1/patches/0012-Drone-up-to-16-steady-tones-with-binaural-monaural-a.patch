+#pragma once
+
+#include "dsp/stereo_sample.h"
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace deluge::dsp {
+
+/// A drone of up to 16 steady tones, each set by its frequency in hertz, mixed
+/// under the song (mastertune-v12).
+///
+/// Each tone can also beat, the way brainwave generators do it:
+/// - Binaural: the left ear gets the frequency minus half the beat, the right
+/// ear plus half, so the beat forms in the
+///   head (needs headphones).
+/// - Monaural: both tones in both ears, so the beat is in the sound itself.
+/// - Isochronic: the tone pulses on and off at the beat, with soft edges.
+///
+/// A beat can follow the song's tempo, and then locks to the beat grid while
+/// the song plays. The drone ducks with the song's sidechain (see
+/// Context::duck).
+///
+/// The settings (DroneSettings) belong to the song; the Drone renders them and
+/// keeps what's sounding, so a new song's drone takes over from the last one
+/// without a break: tones glide to their new frequencies and levels, and fade
+/// out and in where the mode or timbre changes.
+struct DroneSettings {
+	static constexpr size_t kNumTones = 16;
+
+	enum class Mode : uint8_t { TONE, BINAURAL, MONAURAL, ISOCHRONIC };
+	static constexpr int32_t kNumModes = 4;
+
+	enum class Timbre : uint8_t {
+		SINE,  ///< Pure
+		SOFT,  ///< Harmonics 2 to 5, each at 1 / n^2: mellow
+		ORGAN, ///< Octaves 2, 4 and 8, like drawbars
+		RICH,  ///< Harmonics 2 to 8 at 1 / n, a band-limited saw
+	};
+	static constexpr int32_t kNumTimbres = 4;
+
+	// Frequencies in hundredths of a hertz, as the menu shows them
+	static constexpr int32_t kMinFrequency = 1000;   ///< 10.00 Hz
+	static constexpr int32_t kMaxFrequency = 500000; ///< 5000.00 Hz
+	static constexpr int32_t kMaxBeat = 10000;       ///< 100.00 Hz
+	static constexpr int32_t kMaxLevel = 50;         ///< 1 dB steps; 50 is -12 dBFS for a tone, 0 is silent
+	static constexpr int32_t kMaxPan = 32;
+	/// Beat synced to the tempo: 0 is off (the beat in hertz), 1 to kMaxSync a
+	/// whole note to a 64th
+	static constexpr int32_t kMaxSync = 7;
+
+	static constexpr int32_t kMaxCents = 50;
+
+	struct Tone {
+		bool active = false; ///< Sounding (the mute pad), keeping the rest
+		Mode mode = Mode::TONE;
+		Timbre timbre = Timbre::SINE;
+		/// Pitch as a note (and cents) that follows the master tune, like everything else on the Deluge, instead of
+		/// a frequency. So a drone fits an external synth tuned to the same master tune.
+		bool byNote = false;
+		int32_t note = 57;         ///< A3, as MIDI note numbers (A4 is 69)
+		int32_t cents = 0;         ///< -50 to 50
+		int32_t frequency = 20000; ///< 200.00 Hz
+		int32_t beat = 1000;       ///< 10.00 Hz, alpha
+		int32_t sync = 0;
+		int32_t level = 40;
+		int32_t pan = 0;
+
+		bool operator==(const Tone&) const = default;
+	};
+
+	std::array<Tone, kNumTones> tones{};
+	int32_t volume = 40; ///< The whole drone, 0 to 50 in 1 dB steps (50 is 0 dB)
+
+	/// How far the drone ducks when the song's sidechain is hit, 0 to 50 (the envelope's attack, release and sync are
+	/// in Song::droneSidechain)
+	int32_t sidechain = 0;
+	int32_t sidechainShape = -601295438; ///< As the reverb's default
+
+	[[nodiscard]] bool anyActive() const {
+		for (const Tone& tone : tones) {
+			if (tone.active) {
+				return true;
+			}
+		}
+		return false;
+	}
+};
+
+class Drone {
+public:
+	using Settings = DroneSettings;
+	using Tone = DroneSettings::Tone;
+	using Mode = DroneSettings::Mode;
+	using Timbre = DroneSettings::Timbre;
+	static constexpr size_t kNumTones = DroneSettings::kNumTones;
+
+	/// What the drone needs from the rest of the firmware for one block
+	struct Context {
+		float quarterNotesPerSecond = 2.f; ///< The tempo, for synced beats
+		double position = -1.;             ///< Song position in quarter notes at the block's
+		                                   ///< start; negative: stopped
+		float duck = 1.f;                  ///< Sidechain gain at the block's end, 0 to 1: the drone
+		                                   ///< glides there
+		float volume = 1.f;                ///< The song's volume, as for the metronome
+		float a4Hz = 440.f;                ///< The master tune, for tones set by note
+	};
+
+	/// Must be called once before the first render(), with kTableMemoryFloats
+	/// floats that stay put
+	static void initTables(float* memory);
+	static constexpr size_t kTableSize = 512;
+	static constexpr size_t kNumTables = 13;
+	static constexpr size_t kTableMemoryFloats = kNumTables * (kTableSize + 1);
+	[[nodiscard]] static bool tablesReady() { return tables_[0] != nullptr; }
+
+	/// Adds the drone to the buffer
+	void render(std::span<StereoSample> buffer, const Settings& settings, const Context& context);
+
+	/// Whether render() has anything to do for these settings: a tone on, or one
+	/// still fading out
+	[[nodiscard]] bool isSounding(const Settings& settings) const;
+	/// Whether a tone is still sounding, whatever the settings
+	[[nodiscard]] bool isSounding() const;
+
+	/// Starts every tone from silence again, e.g. for a new song
+	void reset();
+
+	/// Fades out whatever is still sounding, at the pitch it's at: for when there's
+	/// no song to render the drone of, e.g. while one loads
+	void fadeOut(std::span<StereoSample> buffer);
+
+	/// Gain for a level of 0 to 50, 1 dB a step, 0 silent
+	static float levelToGain(int32_t level);
+	/// Frequency of a tone set by note, at a master tune
+	static float noteToHz(int32_t note, int32_t cents, float a4Hz);
+	/// Beat in hundredths of a hertz for a synced tone at the tempo
+	static float syncedBeatHz(int32_t sync, float quarterNotesPerSecond);
+
+private:
+	struct Voice {
+		uint32_t carrierPhase = 0;
+		uint32_t halfBeatPhase = 0;   ///< Runs at half the beat; the two tones sit
+		                              ///< this far either side of the carrier
+		float carrierIncrement = 0.f; ///< Phase per sample, gliding to the setting
+		float halfBeatIncrement = 0.f;
+		float level = 0.f; ///< Level and volume, gliding to the setting
+		float panL = 1.f;  ///< Pan gains, gliding to the setting
+		float panR = 1.f;
+		float gainL = 0.f; ///< Gains at the end of the last block, which this one starts from
+		float gainR = 0.f;
+		// Gains for the level and pan they were last worked out for (pow, cos and
+		// sin cost more than all the samples of a block)
+		int32_t gainForLevel = -1;
+		float levelGain = 0.f;
+		int32_t gainsForPan = -1000;
+		float panGainL = 1.f;
+		float panGainR = 1.f;
+		// Frequency of the note and master tune it was last worked out for
+		int32_t hzForNote = -1;
+		int32_t hzForCents = 0;
+		float hzForA4 = 0.f;
+		float noteHz = 0.f;
+		Mode mode = Mode::TONE; ///< What's sounding, which changes to the setting
+		                        ///< through silence
+		Timbre timbre = Timbre::SINE;
+		bool started = false;
+	};
+
+	const float* tableFor(Timbre timbre, float highestFrequencyHz) const;
+	void renderVoice(Voice& voice, const Tone& tone, std::span<float> mix, const Context& context, float volumeGain);
+	static void updatePanGains(Voice& voice, int32_t pan);
+	[[nodiscard]] static int32_t clampSync(int32_t sync);
+
+	std::array<Voice, kNumTones> voices_{};
+	int32_t gainForVolume_ = -1;
+	float volumeGain_ = 0.f;
+	float lastDuck_ = 1.f; ///< Sidechain gain the last block ended at, for fadeOut()
+
+	static std::array<const float*, kNumTables> tables_;
+};
+
+} // namespace deluge::dsp
