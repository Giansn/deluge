+using Settings = deluge::dsp::DroneSettings;
+namespace droneMenu = deluge::gui::menu_item::drone;
+
+DroneView droneView{};
+
+namespace {
+
+constexpr int32_t kMaxScroll = (int32_t)Settings::kNumTones - kDisplayHeight;
+constexpr int32_t kAnimationMs = 40;
+/// Beats faster than this aren't shown on the pads, which would only flicker
+constexpr float kFastestShownBeat = 12.f;
+
+Settings::Tone& toneAt(int32_t index) {
+	return currentSong->drone.tones[std::clamp(index, (int32_t)0, (int32_t)Settings::kNumTones - 1)];
+}
+
+RGB modeColour(Settings::Mode mode) {
+	switch (mode) {
+	case Settings::Mode::BINAURAL:
+		return RGB{30, 70, 255};
+	case Settings::Mode::MONAURAL:
+		return RGB{0, 190, 170};
+	case Settings::Mode::ISOCHRONIC:
+		return RGB{190, 30, 255};
+	default:
+		return RGB{255, 160, 60};
+	}
+}
+
+RGB scaled(RGB colour, float factor) {
+	return RGB{(uint8_t)(colour.r * factor), (uint8_t)(colour.g * factor), (uint8_t)(colour.b * factor)};
+}
+
+deluge::l10n::String modeName(Settings::Mode mode) {
+	using enum deluge::l10n::String;
+	switch (mode) {
+	case Settings::Mode::BINAURAL:
+		return STRING_FOR_BINAURAL;
+	case Settings::Mode::MONAURAL:
+		return STRING_FOR_MONAURAL;
+	case Settings::Mode::ISOCHRONIC:
+		return STRING_FOR_ISOCHRONIC;
+	default:
+		return STRING_FOR_DRONE_STEADY;
+	}
+}
+
+deluge::l10n::String timbreName(Settings::Timbre timbre) {
+	using enum deluge::l10n::String;
+	switch (timbre) {
+	case Settings::Timbre::SOFT:
+		return STRING_FOR_SOFT;
+	case Settings::Timbre::ORGAN:
+		return STRING_FOR_ORGAN;
+	case Settings::Timbre::RICH:
+		return STRING_FOR_RICH;
+	default:
+		return STRING_FOR_SINE;
+	}
+}
+
+float quarterNotesPerSecond() {
+	return playbackHandler.calculateBPMForDisplay() * (1.f / 60.f);
+}
+
+/// The beat in hundredths of a hertz: set, or from the tempo
+int32_t beatHundredths(const Settings::Tone& tone) {
+	if (tone.sync > 0) {
+		return (int32_t)std::lround(deluge::dsp::Drone::syncedBeatHz(tone.sync, quarterNotesPerSecond()) * 100.f);
+	}
+	return tone.beat;
+}
+
+/// Brainwave band the beat falls in
+const char* bandName(int32_t hundredthsHz) {
+	if (hundredthsHz < 400) {
+		return "Delta";
+	}
+	if (hundredthsHz < 800) {
+		return "Theta";
+	}
+	if (hundredthsHz < 1300) {
+		return "Alpha";
+	}
+	if (hundredthsHz < 3000) {
+		return "Beta";
+	}
+	return "Gamma";
+}
+
+/// Level on the pads of a row: 16 pads for 50 steps
+int32_t barLength(int32_t level) {
+	return (level * kDisplayWidth + Settings::kMaxLevel / 2) / Settings::kMaxLevel;
+}
+int32_t levelForPad(int32_t x) {
+	return ((x + 1) * Settings::kMaxLevel + kDisplayWidth / 2) / kDisplayWidth;
+}
+
+/// How brightly a tone's bar shows now: pulsing with its beat, if slow enough to see
+float brightness(const Settings::Tone& tone) {
+	if (!tone.active) {
+		return 0.1f;
+	}
+	int32_t beat = beatHundredths(tone);
+	if (tone.mode == Settings::Mode::TONE || beat <= 0 || beat > (int32_t)(kFastestShownBeat * 100.f)) {
+		return 1.f;
+	}
+	float seconds = (float)AudioEngine::audioSampleTimer * (1.f / (float)kSampleRate);
+	float phase = seconds * (float)beat * 0.01f;
+	phase -= std::floor(phase);
+	if (tone.mode == Settings::Mode::ISOCHRONIC) {
+		return phase < 0.5f ? 1.f : 0.25f;
+	}
+	float c = std::cos(phase * 3.14159265f);
+	return 0.35f + 0.65f * c * c;
+}
+
+void formatPitch(const Settings::Tone& tone, char* buffer, size_t size) {
+	if (tone.byNote) {
+		char name[8];
+		noteCodeToString(tone.note, name);
+		if (tone.cents != 0) {
+			snprintf(buffer, size, "%s %+dc", name, (int)tone.cents);
+		}
+		else {
+			snprintf(buffer, size, "%s", name);
+		}
+	}
+	else {
+		snprintf(buffer, size, "%d.%02d Hz", (int)(tone.frequency / 100), (int)(tone.frequency % 100));
+	}
+}
+
+} // namespace
+
+bool DroneView::opened() {
+	focusRegained();
+	return true;
+}
+
+void DroneView::focusRegained() {
+	view.focusRegained();
+	view.setActiveModControllableTimelineCounter(currentSong);
+
+	indicator_leds::setLedState(IndicatorLED::SYNTH, false);
+	indicator_leds::setLedState(IndicatorLED::KIT, false);
+	indicator_leds::setLedState(IndicatorLED::MIDI, false);
+	indicator_leds::setLedState(IndicatorLED::CV, false);
+	indicator_leds::setLedState(IndicatorLED::KEYBOARD, false);
+	indicator_leds::setLedState(IndicatorLED::CROSS_SCREEN_EDIT, false);
+	indicator_leds::setLedState(IndicatorLED::SESSION_VIEW, false);
+	indicator_leds::setLedState(IndicatorLED::SCALE_MODE, true); // Scale takes you back
+	indicator_leds::setLedState(IndicatorLED::BACK, false);      // The menu leaves it blinking
+
+	changed();
+}
+
+void DroneView::exitToSongView() {
+	indicator_leds::setLedState(IndicatorLED::SCALE_MODE, false);
+	changeRootUI(&sessionView);
+}
+
+void DroneView::changed(bool padsToo) {
+	if (padsToo) {
+		uiNeedsRendering(this);
+	}
+	if (display->haveOLED()) {
+		renderUIsForOled();
+	}
+	else {
+		showOnSevenSegment();
+	}
+}
+
+void DroneView::showOnSevenSegment() {
+	const Settings::Tone& tone = toneAt(selected_);
+	char buffer[12];
+	if (tone.byNote) {
+		noteCodeToString(tone.note, buffer);
+		display->setText(buffer);
+		return;
+	}
+	// Four digits, with as many after the point as fit: 55.25, 440.0, 1200
+	int32_t hundredths = tone.frequency;
+	uint8_t dot = 255;
+	if (hundredths < 10000) {
+		snprintf(buffer, sizeof(buffer), "%d", (int)hundredths);
+		dot = 1;
+	}
+	else if (hundredths < 100000) {
+		snprintf(buffer, sizeof(buffer), "%d", (int)(hundredths / 10));
+		dot = 2;
+	}
+	else {
+		snprintf(buffer, sizeof(buffer), "%d", (int)(hundredths / 100));
+	}
+	display->setText(buffer, true, dot);
+}
+
+bool DroneView::renderMainPads(uint32_t whichRows, RGB image[][kDisplayWidth + kSideBarWidth],
+                               uint8_t occupancyMask[][kDisplayWidth + kSideBarWidth], bool drawUndefinedArea) {
+	if (!image) {
+		return true;
+	}
+
+	PadLEDs::renderingLock = true;
+	for (int32_t y = 0; y < kDisplayHeight; y++) {
+		if (!(whichRows & (1 << y))) {
+			continue;
+		}
+		int32_t index = toneOnRow(y);
+		const Settings::Tone& tone = toneAt(index);
+		int32_t bar = barLength(tone.level);
+		RGB colour = scaled(modeColour(tone.mode), brightness(tone));
+		for (int32_t x = 0; x < kDisplayWidth; x++) {
+			RGB pixel = RGB::monochrome(0);
+			if (x < bar) {
+				pixel = colour;
+			}
+			else if (index == selected_) {
+				pixel = RGB::monochrome(12); // The selected row, faintly all the way
+			}
+			image[y][x] = pixel;
+			if (occupancyMask) {
+				occupancyMask[y][x] = 64;
+			}
+		}
+	}
+	PadLEDs::renderingLock = false;
+	return true;
+}
+
+bool DroneView::renderSidebar(uint32_t whichRows, RGB image[][kDisplayWidth + kSideBarWidth],
+                              uint8_t occupancyMask[][kDisplayWidth + kSideBarWidth]) {
+	if (!image) {
+		return true;
+	}
+
+	for (int32_t y = 0; y < kDisplayHeight; y++) {
+		if (!(whichRows & (1 << y))) {
+			continue;
+		}
+		int32_t index = toneOnRow(y);
+		const Settings::Tone& tone = toneAt(index);
+		// Mute column: on or off, as clips in Song view
+		image[y][kDisplayWidth] = tone.active ? RGB{0, 255, 0} : RGB{40, 0, 0};
+		// Audition column: the tone's mode, white when selected
+		image[y][kDisplayWidth + 1] = (index == selected_) ? RGB::monochrome(255) : scaled(modeColour(tone.mode), 0.3f);
+		if (occupancyMask) {
+			occupancyMask[y][kDisplayWidth] = 64;
+			occupancyMask[y][kDisplayWidth + 1] = 64;
+		}
+	}
+	return true;
+}
+
+void DroneView::renderOLED(deluge::hid::display::oled_canvas::Canvas& canvas) {
+	const Settings::Tone& tone = toneAt(selected_);
+
+	char title[32];
+	snprintf(title, sizeof(title), "%d: %s%s", (int)(selected_ + 1), deluge::l10n::get(modeName(tone.mode)),
+	         tone.active ? "" : " - off");
+	canvas.drawScreenTitle(title);
+
+	char pitch[24];
+	formatPitch(tone, pitch, sizeof(pitch));
+	canvas.drawStringCentred(pitch, OLED_MAIN_TOPMOST_PIXEL + 12, kTextBigSpacingX, kTextBigSizeY);
+
+	char line[40];
+	if (tone.mode == Settings::Mode::TONE) {
+		snprintf(line, sizeof(line), "%s  Level %d", deluge::l10n::get(timbreName(tone.timbre)), (int)tone.level);
+	}
+	else {
+		int32_t beat = beatHundredths(tone);
+		if (tone.sync > 0) {
+			snprintf(line, sizeof(line), "1/%d: %d.%02d Hz %s", 1 << (tone.sync - 1), (int)(beat / 100),
+			         (int)(beat % 100), bandName(beat));
+		}
+		else {
+			snprintf(line, sizeof(line), "Beat %d.%02d Hz %s", (int)(beat / 100), (int)(beat % 100), bandName(beat));
+		}
+	}
+	canvas.drawStringCentred(line, OLED_MAIN_TOPMOST_PIXEL + 30, kTextSpacingX, kTextSizeYUpdated);
+}
+
+ActionResult DroneView::buttonAction(deluge::hid::Button b, bool on, bool inCardRoutine) {
+	using namespace deluge::hid::button;
+
+	// Back to Song view. (Back doesn't undo in here.)
+	if (b == BACK || b == SCALE_MODE || (b == SESSION_VIEW && !Buttons::isShiftButtonPressed())) {
+		if (on && currentUIMode == UI_MODE_NONE) {
+			if (inCardRoutine) {
+				return ActionResult::REMIND_ME_OUTSIDE_CARD_ROUTINE;
+			}
+			exitToSongView();
+		}
+		return ActionResult::DEALT_WITH;
+	}
+
+	// The menu for the selected tone and the whole drone
+	if (b == SELECT_ENC && !Buttons::isShiftButtonPressed()) {
+		if (on && currentUIMode == UI_MODE_NONE) {
+			if (inCardRoutine) {
+				return ActionResult::REMIND_ME_OUTSIDE_CARD_ROUTINE;
+			}
+			droneMenu::currentTone = selected_;
+			display->setNextTransitionDirection(1);
+			if (soundEditor.setup(nullptr, &droneToneMenu)) {
+				openUI(&soundEditor);
+			}
+		}
+		return ActionResult::DEALT_WITH;
+	}
+
+	// Play, record, tempo, save, load, settings...
+	return view.buttonAction(b, on, inCardRoutine);
+}
+
+ActionResult DroneView::padAction(int32_t x, int32_t y, int32_t velocity) {
+	if (!velocity || y < 0 || y >= kDisplayHeight) {
+		return ActionResult::DEALT_WITH; // Everything happens on press
+	}
+	int32_t index = toneOnRow(y);
+	Settings::Tone& tone = toneAt(index);
+	if (x < kDisplayWidth) {
+		tone.level = levelForPad(x);
+	}
+	else if (x == kDisplayWidth) {
+		tone.active = !tone.active;
+	}
+	selected_ = index;
+	changed();
+	return ActionResult::DEALT_WITH;
+}
+
+ActionResult DroneView::horizontalEncoderAction(int32_t offset) {
+	Settings::Tone& tone = toneAt(selected_);
+	if (Buttons::isShiftButtonPressed()) {
+		tone.pan = std::clamp(tone.pan + offset, -Settings::kMaxPan, Settings::kMaxPan);
+		char buffer[12];
+		snprintf(buffer, sizeof(buffer), display->haveOLED() ? "Pan %d" : "%d", (int)tone.pan);
+		display->displayPopup(buffer);
+	}
+	else {
+		tone.level = std::clamp(tone.level + offset, (int32_t)0, Settings::kMaxLevel);
+		char buffer[12];
+		snprintf(buffer, sizeof(buffer), display->haveOLED() ? "Level %d" : "%d", (int)tone.level);
+		display->displayPopup(buffer);
+	}
+	changed();
+	return ActionResult::DEALT_WITH;
+}
+
+ActionResult DroneView::verticalEncoderAction(int32_t offset, bool inCardRoutine) {
+	int32_t newScroll = std::clamp(scroll_ + offset, (int32_t)0, kMaxScroll);
+	if (newScroll != scroll_) {
+		scroll_ = newScroll;
+		uiNeedsRendering(this);
+	}
+	return ActionResult::DEALT_WITH;
+}
+
+void DroneView::selectEncoderAction(int8_t offset) {
+	Settings::Tone& tone = toneAt(selected_);
+	int32_t mode = ((int32_t)tone.mode + offset) % Settings::kNumModes;
+	if (mode < 0) {
+		mode += Settings::kNumModes;
+	}
+	tone.mode = (Settings::Mode)mode;
+	display->displayPopup(deluge::l10n::get(modeName(tone.mode)));
+	changed();
+}
+
+void DroneView::modEncoderAction(int32_t whichModEncoder, int32_t offset) {
+	Settings::Tone& tone = toneAt(selected_);
+	bool shift = Buttons::isShiftButtonPressed();
+
+	// Upper knob: pitch. A note in semitones (with Shift, in cents); a frequency in 1 Hz steps, 10 Hz when turned
+	// quickly, and with Shift in hundredths
+	if (whichModEncoder == 1) {
+		if (tone.byNote) {
+			if (shift) {
+				tone.cents = std::clamp(tone.cents + offset, -Settings::kMaxCents, Settings::kMaxCents);
+			}
+			else {
+				tone.note = std::clamp(tone.note + offset, (int32_t)0, (int32_t)127);
+			}
+		}
+		else {
+			uint32_t now = AudioEngine::audioSampleTimer;
+			bool quick = (now - timeLastPitchTurn_) < (uint32_t)(kSampleRate / 16); // Under 60 ms apart
+			timeLastPitchTurn_ = now;
+			int32_t step = shift ? 1 : (quick ? 1000 : 100);
+			tone.frequency =
+			    std::clamp(tone.frequency + offset * step, Settings::kMinFrequency, Settings::kMaxFrequency);
+		}
+	}
+
+	// Lower knob: the beat, in tenths of a hertz (with Shift, hundredths), or the division when it's synced
+	else {
+		if (tone.sync > 0) {
+			tone.sync = std::clamp(tone.sync + offset, (int32_t)1, Settings::kMaxSync);
+		}
+		else {
+			tone.beat = std::clamp(tone.beat + offset * (shift ? 1 : 10), (int32_t)0, Settings::kMaxBeat);
+		}
+		// The OLED shows it on its beat line; the 7-segment display only has room for the pitch
+		if (!display->haveOLED()) {
+			char buffer[12];
+			if (tone.sync > 0) {
+				snprintf(buffer, sizeof(buffer), "%d", 1 << (tone.sync - 1)); // The division: 16 for 1/16
+				display->displayPopup(buffer);
+			}
+			else {
+				snprintf(buffer, sizeof(buffer), "%02d", (int)(tone.beat / 10)); // Tenths of a hertz: 7.8
+				display->displayPopup(buffer, 3, true, 2);
+			}
+		}
+	}
+	changed(false);
+}
+
+void DroneView::modEncoderButtonAction(uint8_t whichModEncoder, bool on) {
+	if (!on) {
+		return;
+	}
+	Settings::Tone& tone = toneAt(selected_);
+
+	// Upper knob pressed: Hz or note, keeping the pitch
+	if (whichModEncoder == 1) {
+		if (tone.byNote) {
+			tone.frequency = droneMenu::noteToFrequency(tone.note, tone.cents);
+		}
+		else {
+			droneMenu::frequencyToNote(tone.frequency, &tone.note, &tone.cents);
+		}
+		tone.byNote = !tone.byNote;
+		display->displayPopup(deluge::l10n::get(tone.byNote ? deluge::l10n::String::STRING_FOR_NOTE
+		                                                    : deluge::l10n::String::STRING_FOR_HERTZ));
+	}
+
+	// Lower knob pressed: the beat from the tempo, or back to hertz
+	else {
+		if (tone.sync > 0) {
+			lastSync_ = tone.sync;
+			tone.sync = 0;
+		}
+		else {
+			tone.sync = lastSync_;
+		}
+		display->displayPopup(deluge::l10n::get(tone.sync > 0 ? deluge::l10n::String::STRING_FOR_SYNC
+		                                                      : deluge::l10n::String::STRING_FOR_BEAT));
+	}
+	changed(false);
+}
+
+void DroneView::graphicsRoutine() {
+	// Every 40 ms, the rows whose beat shows as a pulse
+	uint32_t now = AudioEngine::audioSampleTimer;
+	if (now - timeLastAnimation_ < (uint32_t)(kSampleRate * kAnimationMs / 1000)) {
+		return;
+	}
+	timeLastAnimation_ = now;
+	uint32_t rows = 0;
+	for (int32_t y = 0; y < kDisplayHeight; y++) {
+		const Settings::Tone& tone = toneAt(toneOnRow(y));
+		if (tone.active && tone.mode != Settings::Mode::TONE) {
+			rows |= 1 << y;
+		}
+	}
+	if (rows) {
+		uiNeedsRendering(this, rows, 0);
+	}
+}
+
+// The Song menu's "Drone" item opens the view, from Song view only: the view goes back there (the same menu in the
+// arranger and its automation view would need the way back to them)
+bool deluge::gui::menu_item::drone::OpenView::isRelevant(ModControllableAudio*, int32_t) {
+	return getRootUI() == &sessionView;
+}
+
+MenuItem* deluge::gui::menu_item::drone::OpenView::selectButtonPress() {
+	soundEditor.exitCompletely();
+	changeRootUI(&droneView);
+	return NO_NAVIGATION;
+}
