+#include "dsp/drone/drone.h"
+#include "definitions_cxx.hpp"
+#include <algorithm>
+#include <cmath>
+
+namespace deluge::dsp {
+
+std::array<const float*, Drone::kNumTables> Drone::tables_{};
+
+namespace {
+
+using S = DroneSettings;
+
+constexpr float kPhasePerHz = 4294967296.f / (float)kSampleRate;
+
+/// Amplitude of a tone at level 50 with the drone's volume at 50: -12 dBFS (the
+/// output's full scale is 2^24 in the rendering buffer)
+constexpr float kFullScale = 4194304.f;
+
+/// Glides of level and frequency: this much of the way per block of 128
+/// samples, about 15 ms to get 63% there
+constexpr float kGlide = 0.18f;
+/// Fading out for a change of mode or timbre, or off: about 4 ms to 63%
+constexpr float kFade = 0.5f;
+/// Below this (in the rendering buffer's units, 144 dB below full scale), a
+/// fading tone is silent
+constexpr float kSilent = 1.f;
+
+/// Isochronic pulses: on half the time, with soft edges this long (at most a
+/// quarter of the cycle each)
+constexpr float kEdgeSeconds = 0.006f;
+
+constexpr size_t kChunk = 128;
+
+// Harmonics of each timbre, and which of them the band-limited versions keep
+struct TimbreSpec {
+	std::array<float, 9> amplitude; // By harmonic number, 1 to 8
+	std::array<int32_t, 5> levels;  // Highest harmonic of each version, best first; 0 ends the list
+	size_t firstTable;
+};
+
+constexpr std::array<TimbreSpec, S::kNumTimbres> kTimbres{{
+    // SINE
+    {{0.f, 1.f}, {1, 0}, 0},
+    // SOFT: 1 / n^2 up to the 5th
+    {{0.f, 1.f, 1.f / 4, 1.f / 9, 1.f / 16, 1.f / 25}, {5, 4, 3, 2, 0}, 1},
+    // ORGAN: octaves
+    {{0.f, 1.f, 0.5f, 0.f, 0.35f, 0.f, 0.f, 0.f, 0.25f}, {8, 4, 2, 0}, 5},
+    // RICH: 1 / n up to the 8th
+    {{0.f, 1.f, 1.f / 2, 1.f / 3, 1.f / 4, 1.f / 5, 1.f / 6, 1.f / 7, 1.f / 8}, {8, 6, 4, 3, 2}, 8},
+}};
+
+/// Harmonics stay below this, well clear of the Nyquist frequency
+constexpr float kHighestHarmonicHz = 18000.f;
+
+[[gnu::always_inline]] inline float readTable(const float* table, uint32_t phase) {
+	uint32_t index = phase >> 23; // 512 entries
+	float fraction = (float)(phase & 0x7FFFFF) * (1.f / 8388608.f);
+	float a = table[index];
+	return a + fraction * (table[index + 1] - a);
+}
+
+/// Isochronic pulse at a phase through its cycle (0 to 1)
+[[gnu::always_inline]] inline float pulse(float x, float edge, float inverseEdge) {
+	float t;
+	if (x < edge) {
+		t = x * inverseEdge;
+	}
+	else if (x < 0.5f) {
+		return 1.f;
+	}
+	else if (x < 0.5f + edge) {
+		t = 1.f - (x - 0.5f) * inverseEdge;
+	}
+	else {
+		return 0.f;
+	}
+	return t * t * (3.f - 2.f * t);
+}
+
+} // namespace
+
+void Drone::initTables(float* memory) {
+	// One sine, and each harmonic read from it at a multiple of the position:
+	// exact, and quick to make. A quarter of it is enough (and fits the stack).
+	constexpr size_t kQuarter = kTableSize / 4;
+	std::array<double, kQuarter + 1> quarterSine{};
+	for (size_t i = 0; i <= kQuarter; i++) {
+		quarterSine[i] = std::sin(2.0 * 3.14159265358979323846 * (double)i / (double)kTableSize);
+	}
+	auto sine = [&](size_t position) {
+		size_t quadrant = position / kQuarter;
+		size_t within = position % kQuarter;
+		double v = (quadrant & 1) ? quarterSine[kQuarter - within] : quarterSine[within];
+		return (quadrant & 2) ? -v : v;
+	};
+
+	for (const TimbreSpec& spec : kTimbres) {
+		// All versions of a timbre are scaled by the full one's peak, so the
+		// fundamental keeps its level when the highest harmonics drop out at high
+		// frequencies
+		double peak = 0;
+		for (size_t i = 0; i < kTableSize; i++) {
+			double v = 0;
+			for (int32_t h = 1; h <= spec.levels[0]; h++) {
+				v += spec.amplitude[h] * sine((i * h) % kTableSize);
+			}
+			peak = std::max(peak, std::abs(v));
+		}
+
+		size_t tableIndex = spec.firstTable;
+		for (int32_t highest : spec.levels) {
+			if (highest == 0 || (highest == 1 && tableIndex != 0)) {
+				break;
+			}
+			float* table = memory + tableIndex * (kTableSize + 1);
+			for (size_t i = 0; i < kTableSize; i++) {
+				double v = 0;
+				for (int32_t h = 1; h <= highest; h++) {
+					v += spec.amplitude[h] * sine((i * h) % kTableSize);
+				}
+				table[i] = (float)(v / peak);
+			}
+			table[kTableSize] = table[0]; // Guard point for the interpolation
+			tables_[tableIndex] = table;
+			tableIndex++;
+		}
+	}
+}
+
+const float* Drone::tableFor(Timbre timbre, float highestFrequencyHz) const {
+	const TimbreSpec& spec = kTimbres[static_cast<size_t>(timbre)];
+	float highestHarmonic = kHighestHarmonicHz / std::max(highestFrequencyHz, 1.f);
+	size_t tableIndex = spec.firstTable;
+	for (int32_t highest : spec.levels) {
+		if (highest == 0) {
+			break;
+		}
+		if ((float)highest <= highestHarmonic) {
+			return tables_[tableIndex];
+		}
+		tableIndex++;
+	}
+	return tables_[0]; // Too high for any harmonic: sine
+}
+
+float Drone::levelToGain(int32_t level) {
+	if (level <= 0) {
+		return 0.f;
+	}
+	return std::pow(10.f, (float)(std::min(level, S::kMaxLevel) - S::kMaxLevel) * 0.05f);
+}
+
+float Drone::noteToHz(int32_t note, int32_t cents, float a4Hz) {
+	float semitones = (float)(std::clamp(note, (int32_t)0, (int32_t)127) - 69)
+	                  + (float)std::clamp(cents, -S::kMaxCents, S::kMaxCents) * 0.01f;
+	return a4Hz * std::exp2(semitones * (1.f / 12.f));
+}
+
+int32_t Drone::clampSync(int32_t sync) {
+	return std::clamp(sync, (int32_t)1, S::kMaxSync);
+}
+
+float Drone::syncedBeatHz(int32_t sync, float quarterNotesPerSecond) {
+	// 1 is a whole note, each step half as long
+	return quarterNotesPerSecond * (float)(1 << (clampSync(sync) - 1)) * 0.25f;
+}
+
+bool Drone::isSounding(const Settings& settings) const {
+	for (size_t i = 0; i < kNumTones; i++) {
+		if (voices_[i].started || settings.tones[i].active) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool Drone::isSounding() const {
+	for (const Voice& voice : voices_) {
+		if (voice.started) {
+			return true;
+		}
+	}
+	return false;
+}
+
+void Drone::reset() {
+	voices_ = {};
+}
+
+void Drone::fadeOut(std::span<StereoSample> buffer) {
+	// Each tone off, at what its voice is playing (static: too big for the audio routine's stack)
+	static Settings fading;
+	bool any = false;
+	for (size_t i = 0; i < kNumTones; i++) {
+		const Voice& voice = voices_[i];
+		Tone& tone = fading.tones[i];
+		tone = Tone{};
+		if (voice.started) {
+			any = true;
+			tone.mode = voice.mode;
+			tone.timbre = voice.timbre;
+			tone.frequency = (int32_t)std::lround(voice.carrierIncrement * (100.f / kPhasePerHz));
+			tone.beat = (int32_t)std::lround(voice.halfBeatIncrement * (200.f / kPhasePerHz));
+			tone.pan = voice.gainsForPan;
+			tone.level = voice.gainForLevel;
+		}
+	}
+	if (!any) {
+		return;
+	}
+	fading.volume = gainForVolume_;
+	Context context;
+	context.duck = lastDuck_;
+	render(buffer, fading, context);
+}
+
+void Drone::render(std::span<StereoSample> buffer, const Settings& settings, const Context& context) {
+	if (!tablesReady()) {
+		return;
+	}
+	if (settings.volume != gainForVolume_) {
+		gainForVolume_ = settings.volume;
+		volumeGain_ = levelToGain(settings.volume);
+	}
+	float volumeGain = volumeGain_ * context.volume * kFullScale;
+	lastDuck_ = context.duck;
+
+	Context chunkContext = context;
+	for (size_t start = 0; start < buffer.size(); start += kChunk) {
+		std::span<StereoSample> chunk = buffer.subspan(start, std::min(kChunk, buffer.size() - start));
+		std::array<float, 2 * kChunk> mix{};
+		std::span<float> mixSpan{mix.data(), 2 * chunk.size()};
+
+		bool any = false;
+		for (size_t i = 0; i < kNumTones; i++) {
+			if (voices_[i].started || settings.tones[i].active) {
+				renderVoice(voices_[i], settings.tones[i], mixSpan, chunkContext, volumeGain);
+				any = true;
+			}
+		}
+		if (!any) {
+			return;
+		}
+
+		for (size_t s = 0; s < chunk.size(); s++) {
+			chunk[s].l += (int32_t)mix[2 * s];
+			chunk[s].r += (int32_t)mix[2 * s + 1];
+		}
+
+		if (chunkContext.position >= 0.) {
+			chunkContext.position += (double)chunk.size() * (double)context.quarterNotesPerSecond / (double)kSampleRate;
+		}
+	}
+}
+
+void Drone::updatePanGains(Voice& voice, int32_t pan) {
+	if (pan != voice.gainsForPan) {
+		voice.gainsForPan = pan;
+		// Constant power, 0 dB in the middle
+		float angle = ((float)std::clamp(pan, -S::kMaxPan, S::kMaxPan) / (float)S::kMaxPan + 1.f) * 0.785398163f;
+		voice.panGainL = std::cos(angle) * 1.41421356f;
+		voice.panGainR = std::sin(angle) * 1.41421356f;
+	}
+}
+
+void Drone::renderVoice(Voice& voice, const Tone& tone, std::span<float> mix, const Context& context,
+                        float volumeGain) {
+	size_t numSamples = mix.size() / 2;
+	float inverseNumSamples = 1.f / (float)numSamples;
+
+	// Settings, and where the glides get to by the end of this block
+	float frequencyHz;
+	if (tone.byNote) {
+		if (tone.note != voice.hzForNote || tone.cents != voice.hzForCents || context.a4Hz != voice.hzForA4) {
+			voice.hzForNote = tone.note;
+			voice.hzForCents = tone.cents;
+			voice.hzForA4 = context.a4Hz;
+			voice.noteHz = noteToHz(tone.note, tone.cents, context.a4Hz);
+		}
+		frequencyHz = voice.noteHz;
+	}
+	else {
+		frequencyHz = (float)std::clamp(tone.frequency, S::kMinFrequency, S::kMaxFrequency) * 0.01f;
+	}
+	float beatHz = (tone.sync > 0) ? syncedBeatHz(tone.sync, context.quarterNotesPerSecond)
+	                               : (float)std::clamp(tone.beat, (int32_t)0, S::kMaxBeat) * 0.01f;
+	beatHz = std::min(beatHz,
+	                  frequencyHz); // So the lower of the two tones doesn't go below 0 Hz
+	float carrierTarget = frequencyHz * kPhasePerHz;
+	float halfBeatTarget = beatHz * 0.5f * kPhasePerHz;
+
+	if (!voice.started) {
+		// From silence, at the setting straight away
+		voice.started = true;
+		voice.mode = tone.mode;
+		voice.timbre = tone.timbre;
+		voice.carrierIncrement = carrierTarget;
+		voice.halfBeatIncrement = halfBeatTarget;
+		voice.level = 0.f;
+		voice.gainL = voice.gainR = 0.f;
+		updatePanGains(voice, tone.pan);
+		voice.panL = voice.panGainL;
+		voice.panR = voice.panGainR;
+	}
+
+	// A new mode or timbre, or off, goes through silence
+	bool fadingOut = (!tone.active || tone.mode != voice.mode || tone.timbre != voice.timbre);
+	if (tone.level != voice.gainForLevel) {
+		voice.gainForLevel = tone.level;
+		voice.levelGain = levelToGain(tone.level);
+	}
+	float levelTarget = fadingOut ? 0.f : voice.levelGain * volumeGain;
+	float levelEnd = voice.level + (levelTarget - voice.level) * (fadingOut ? kFade : kGlide);
+	if (fadingOut && levelEnd < kSilent) {
+		levelEnd = 0.f;
+	}
+
+	float carrierStart = voice.carrierIncrement;
+	float carrierEnd = carrierStart + (carrierTarget - carrierStart) * kGlide;
+	float halfBeatStart = voice.halfBeatIncrement;
+	float halfBeatEnd = halfBeatStart + (halfBeatTarget - halfBeatStart) * kGlide;
+	voice.carrierIncrement = carrierEnd;
+	voice.halfBeatIncrement = halfBeatEnd;
+
+	// A synced beat locks to the song's beat grid while it plays, pulling a
+	// quarter of the way there each block
+	float lockCorrection = 0.f;
+	if (tone.sync > 0 && context.position >= 0.) {
+		double cyclesPerQuarter = (double)(1 << (clampSync(tone.sync) - 1)) * 0.25;
+		double halfBeats = context.position * cyclesPerQuarter * 0.5;
+		uint32_t target = (uint32_t)(uint64_t)((halfBeats - std::floor(halfBeats)) * 4294967296.0);
+		int32_t error = (int32_t)(target - voice.halfBeatPhase);
+		lockCorrection = std::clamp((float)error * 0.25f * inverseNumSamples, -0.5f * halfBeatEnd, 0.5f * halfBeatEnd);
+	}
+
+	// Gains: level, pan (constant power, 0 dB in the middle) and the sidechain,
+	// gliding over the block from where the last one ended, so ducking doesn't
+	// step
+	updatePanGains(voice, tone.pan);
+	voice.panL += (voice.panGainL - voice.panL) * kGlide;
+	voice.panR += (voice.panGainR - voice.panR) * kGlide;
+	float gainEndL = levelEnd * voice.panL * context.duck;
+	float gainEndR = levelEnd * voice.panR * context.duck;
+	float gainL = voice.gainL;
+	float gainR = voice.gainR;
+	float gainStepL = (gainEndL - gainL) * inverseNumSamples;
+	float gainStepR = (gainEndR - gainR) * inverseNumSamples;
+
+	// Phase increments, gliding sample by sample
+	uint32_t carrierIncrement = (uint32_t)carrierStart;
+	int32_t carrierStep = (int32_t)(((int64_t)(uint32_t)carrierEnd - (int64_t)carrierIncrement) / (int64_t)numSamples);
+	uint32_t halfBeatIncrement = (uint32_t)std::max(halfBeatStart + lockCorrection, 0.f);
+	int32_t halfBeatStep =
+	    (int32_t)(((int64_t)(uint32_t)std::max(halfBeatEnd + lockCorrection, 0.f) - (int64_t)halfBeatIncrement)
+	              / (int64_t)numSamples);
+
+	uint32_t carrierPhase = voice.carrierPhase;
+	uint32_t halfBeatPhase = voice.halfBeatPhase;
+
+	// Band-limited for the highest frequency this block reaches
+	float highestHz = (std::max(carrierStart, carrierEnd) + std::max(halfBeatStart, halfBeatEnd)) / kPhasePerHz;
+	const float* table = tableFor(voice.timbre, highestHz);
+
+	float* out = mix.data();
+	switch (voice.mode) {
+	case Mode::TONE:
+		for (size_t s = 0; s < numSamples; s++) {
+			float v = readTable(table, carrierPhase);
+			carrierPhase += carrierIncrement;
+			carrierIncrement += carrierStep;
+			gainL += gainStepL;
+			gainR += gainStepR;
+			out[2 * s] += v * gainL;
+			out[2 * s + 1] += v * gainR;
+		}
+		break;
+
+	case Mode::BINAURAL:
+		for (size_t s = 0; s < numSamples; s++) {
+			float left = readTable(table, carrierPhase - halfBeatPhase);
+			float right = readTable(table, carrierPhase + halfBeatPhase);
+			carrierPhase += carrierIncrement;
+			carrierIncrement += carrierStep;
+			halfBeatPhase += halfBeatIncrement;
+			halfBeatIncrement += halfBeatStep;
+			gainL += gainStepL;
+			gainR += gainStepR;
+			out[2 * s] += left * gainL;
+			out[2 * s + 1] += right * gainR;
+		}
+		break;
+
+	case Mode::MONAURAL:
+		for (size_t s = 0; s < numSamples; s++) {
+			float v =
+			    0.5f
+			    * (readTable(table, carrierPhase - halfBeatPhase) + readTable(table, carrierPhase + halfBeatPhase));
+			carrierPhase += carrierIncrement;
+			carrierIncrement += carrierStep;
+			halfBeatPhase += halfBeatIncrement;
+			halfBeatIncrement += halfBeatStep;
+			gainL += gainStepL;
+			gainR += gainStepR;
+			out[2 * s] += v * gainL;
+			out[2 * s + 1] += v * gainR;
+		}
+		break;
+
+	case Mode::ISOCHRONIC: {
+		bool pulsing = (halfBeatEnd + lockCorrection) > 0.f;
+		float edge = std::clamp(kEdgeSeconds * beatHz, 0.001f, 0.25f);
+		float inverseEdge = 1.f / edge;
+		for (size_t s = 0; s < numSamples; s++) {
+			float v = readTable(table, carrierPhase);
+			if (pulsing) {
+				// The pulse runs at the beat, twice the half-beat phase
+				v *= pulse((float)(halfBeatPhase << 1) * (1.f / 4294967296.f), edge, inverseEdge);
+			}
+			carrierPhase += carrierIncrement;
+			carrierIncrement += carrierStep;
+			halfBeatPhase += halfBeatIncrement;
+			halfBeatIncrement += halfBeatStep;
+			gainL += gainStepL;
+			gainR += gainStepR;
+			out[2 * s] += v * gainL;
+			out[2 * s + 1] += v * gainR;
+		}
+		break;
+	}
+	}
+
+	// The beat keeps its phase in the tone modes too, so a switch to a beating
+	// mode starts where the grid is
+	if (voice.mode == Mode::TONE) {
+		halfBeatPhase += (uint32_t)((halfBeatStart + halfBeatEnd) * 0.5f * (float)numSamples);
+	}
+
+	voice.carrierPhase = carrierPhase;
+	voice.halfBeatPhase = halfBeatPhase;
+	voice.level = levelEnd;
+	voice.gainL = gainEndL;
+	voice.gainR = gainEndR;
+
+	// Through silence: take on the new mode and timbre, or stop
+	if (fadingOut && levelEnd == 0.f) {
+		if (!tone.active) {
+			voice.started = false;
+		}
+		else {
+			voice.mode = tone.mode;
+			voice.timbre = tone.timbre;
+		}
+	}
+}
+
+} // namespace deluge::dsp
