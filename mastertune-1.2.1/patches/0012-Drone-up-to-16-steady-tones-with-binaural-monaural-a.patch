+// mastertune-v12: the drone. Written only when it's been set up, and only the tones that are, so a song without a drone
+// stays as it was. Older firmware skips the tag.
+void Song::writeDroneToFile(Serializer& writer) {
+	using Settings = deluge::dsp::DroneSettings;
+	const Settings defaults{};
+	bool anyTone = false;
+	for (const Settings::Tone& tone : drone.tones) {
+		anyTone = anyTone || !(tone == Settings::Tone{});
+	}
+	if (!anyTone && drone.volume == defaults.volume && drone.sidechain == defaults.sidechain) {
+		return;
+	}
+
+	writer.writeOpeningTagBeginning("drone");
+	writer.writeAttribute("volume", drone.volume);
+	writer.writeAttribute("sidechain", drone.sidechain);
+	writer.writeAttribute("sidechainShape", drone.sidechainShape);
+	writer.writeAttribute("attack", droneSidechain.attack);
+	writer.writeAttribute("release", droneSidechain.release);
+	writer.writeAbsoluteSyncLevelToFile(this, "syncLevel", droneSidechain.syncLevel, true);
+	writer.writeOpeningTagEnd();
+
+	for (size_t i = 0; i < Settings::kNumTones; i++) {
+		const Settings::Tone& tone = drone.tones[i];
+		if (tone == Settings::Tone{}) {
+			continue;
+		}
+		writer.writeOpeningTagBeginning("tone");
+		writer.writeAttribute("index", (int32_t)i);
+		writer.writeAttribute("active", tone.active ? 1 : 0);
+		writer.writeAttribute("mode", (int32_t)tone.mode);
+		writer.writeAttribute("timbre", (int32_t)tone.timbre);
+		writer.writeAttribute("byNote", tone.byNote ? 1 : 0);
+		writer.writeAttribute("note", tone.note);
+		writer.writeAttribute("cents", tone.cents);
+		writer.writeAttribute("frequency", tone.frequency);
+		writer.writeAttribute("beat", tone.beat);
+		writer.writeAttribute("sync", tone.sync);
+		writer.writeAttribute("level", tone.level);
+		writer.writeAttribute("pan", tone.pan);
+		writer.closeTag();
+	}
+
+	writer.writeClosingTag("drone");
+}
+
+void Song::readDroneFromFile(Deserializer& reader) {
+	using Settings = deluge::dsp::DroneSettings;
+	char const* tagName;
+	while (*(tagName = reader.readNextTagOrAttributeName())) {
+		if (!strcmp(tagName, "volume")) {
+			drone.volume = std::clamp(reader.readTagOrAttributeValueInt(), (int32_t)0, Settings::kMaxLevel);
+			reader.exitTag("volume");
+		}
+		else if (!strcmp(tagName, "sidechain")) {
+			drone.sidechain = std::clamp(reader.readTagOrAttributeValueInt(), (int32_t)0, Settings::kMaxLevel);
+			reader.exitTag("sidechain");
+		}
+		else if (!strcmp(tagName, "sidechainShape")) {
+			drone.sidechainShape = reader.readTagOrAttributeValueInt();
+			reader.exitTag("sidechainShape");
+		}
+		else if (!strcmp(tagName, "attack")) {
+			droneSidechain.attack = reader.readTagOrAttributeValueInt();
+			reader.exitTag("attack");
+		}
+		else if (!strcmp(tagName, "release")) {
+			droneSidechain.release = reader.readTagOrAttributeValueInt();
+			reader.exitTag("release");
+		}
+		else if (!strcmp(tagName, "syncLevel")) {
+			droneSidechain.syncLevel =
+			    (SyncLevel)convertSyncLevelFromFileValueToInternalValue(reader.readTagOrAttributeValueInt());
+			droneSidechain.syncLevel = (SyncLevel)std::min((uint8_t)droneSidechain.syncLevel, (uint8_t)9);
+			reader.exitTag("syncLevel");
+		}
+		else if (!strcmp(tagName, "tone")) {
+			Settings::Tone tone;
+			int32_t index = -1;
+			while (*(tagName = reader.readNextTagOrAttributeName())) {
+				int32_t value = reader.readTagOrAttributeValueInt();
+				if (!strcmp(tagName, "index")) {
+					index = value;
+				}
+				else if (!strcmp(tagName, "active")) {
+					tone.active = (value != 0);
+				}
+				else if (!strcmp(tagName, "mode")) {
+					tone.mode = (Settings::Mode)std::clamp(value, (int32_t)0, Settings::kNumModes - 1);
+				}
+				else if (!strcmp(tagName, "timbre")) {
+					tone.timbre = (Settings::Timbre)std::clamp(value, (int32_t)0, Settings::kNumTimbres - 1);
+				}
+				else if (!strcmp(tagName, "byNote")) {
+					tone.byNote = (value != 0);
+				}
+				else if (!strcmp(tagName, "note")) {
+					tone.note = std::clamp(value, (int32_t)0, (int32_t)127);
+				}
+				else if (!strcmp(tagName, "cents")) {
+					tone.cents = std::clamp(value, -Settings::kMaxCents, Settings::kMaxCents);
+				}
+				else if (!strcmp(tagName, "frequency")) {
+					tone.frequency = std::clamp(value, Settings::kMinFrequency, Settings::kMaxFrequency);
+				}
+				else if (!strcmp(tagName, "beat")) {
+					tone.beat = std::clamp(value, (int32_t)0, Settings::kMaxBeat);
+				}
+				else if (!strcmp(tagName, "sync")) {
+					tone.sync = std::clamp(value, (int32_t)0, Settings::kMaxSync);
+				}
+				else if (!strcmp(tagName, "level")) {
+					tone.level = std::clamp(value, (int32_t)0, Settings::kMaxLevel);
+				}
+				else if (!strcmp(tagName, "pan")) {
+					tone.pan = std::clamp(value, -Settings::kMaxPan, Settings::kMaxPan);
+				}
+				reader.exitTag(tagName);
+			}
+			if (index >= 0 && index < (int32_t)Settings::kNumTones) {
+				drone.tones[index] = tone;
+			}
+			reader.exitTag("tone");
+		}
+		else {
+			reader.exitTag(tagName);
+		}
+	}
+}
