+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+#pragma once
+#include "dsp/drone/drone.h"
+#include "gui/l10n/l10n.h"
+#include "gui/menu_item/decimal.h"
+#include "gui/menu_item/integer.h"
+#include "gui/menu_item/selection.h"
+#include "gui/menu_item/submenu.h"
+#include "gui/ui/sound_editor.h"
+#include "hid/display/display.h"
+#include "hid/display/oled.h"
+#include "model/song/song.h"
+#include "model/tuning/master_tune.h"
+#include "util/functions.h"
+#include <cmath>
+#include <string_view>
+
+// mastertune-v12: the drone's menu, opened from the drone view (select encoder) for the tone selected there, and the
+// drone's settings for the whole song
+namespace deluge::gui::menu_item::drone {
+
+using Settings = deluge::dsp::DroneSettings;
+
+/// The tone the drone view has selected, which the tone items edit
+inline int32_t currentTone = 0;
+inline Settings::Tone& tone() {
+	return currentSong->drone.tones[std::clamp(currentTone, (int32_t)0, (int32_t)Settings::kNumTones - 1)];
+}
+
+/// Nearest note and cents for a frequency at the current master tune, and back
+inline void frequencyToNote(int32_t hundredthsHz, int32_t* note, int32_t* cents) {
+	float a4 = (float)MasterTune::getTenthsHz() * 0.1f;
+	float semitones = 12.f * std::log2(std::max((float)hundredthsHz * 0.01f, 1.f) / a4) + 69.f;
+	int32_t n = std::clamp((int32_t)std::lround(semitones), (int32_t)0, (int32_t)127);
+	*note = n;
+	*cents =
+	    std::clamp((int32_t)std::lround((semitones - (float)n) * 100.f), -Settings::kMaxCents, Settings::kMaxCents);
+}
+inline int32_t noteToFrequency(int32_t note, int32_t cents) {
+	float hz = deluge::dsp::Drone::noteToHz(note, cents, (float)MasterTune::getTenthsHz() * 0.1f);
+	return std::clamp((int32_t)std::lround(hz * 100.f), Settings::kMinFrequency, Settings::kMaxFrequency);
+}
+
+class Mode final : public Selection {
+public:
+	using Selection::Selection;
+	void readCurrentValue() override { this->setValue((int32_t)tone().mode); }
+	void writeCurrentValue() override { tone().mode = this->getValue<Settings::Mode>(); }
+	deluge::vector<std::string_view> getOptions() override {
+		using enum l10n::String;
+		return {l10n::getView(STRING_FOR_DRONE_STEADY), l10n::getView(STRING_FOR_BINAURAL),
+		        l10n::getView(STRING_FOR_MONAURAL), l10n::getView(STRING_FOR_ISOCHRONIC)};
+	}
+};
+
+/// Hz or note. Switching keeps the pitch: the frequency becomes the nearest note and cents, and back.
+class PitchBy final : public Selection {
+public:
+	using Selection::Selection;
+	void readCurrentValue() override { this->setValue(tone().byNote ? 1 : 0); }
+	void writeCurrentValue() override {
+		bool byNote = (this->getValue() != 0);
+		Settings::Tone& t = tone();
+		if (byNote && !t.byNote) {
+			frequencyToNote(t.frequency, &t.note, &t.cents);
+		}
+		else if (!byNote && t.byNote) {
+			t.frequency = noteToFrequency(t.note, t.cents);
+		}
+		t.byNote = byNote;
+	}
+	deluge::vector<std::string_view> getOptions() override {
+		using enum l10n::String;
+		return {l10n::getView(STRING_FOR_HERTZ), l10n::getView(STRING_FOR_NOTE)};
+	}
+};
+
+class Frequency final : public Decimal {
+public:
+	using Decimal::Decimal;
+	[[nodiscard]] int32_t getMinValue() const override { return Settings::kMinFrequency; }
+	[[nodiscard]] int32_t getMaxValue() const override { return Settings::kMaxFrequency; }
+	[[nodiscard]] int32_t getNumDecimalPlaces() const override { return 2; }
+	void readCurrentValue() override { this->setValue(tone().frequency); }
+	void writeCurrentValue() override { tone().frequency = this->getValue(); }
+	bool isRelevant(ModControllableAudio*, int32_t) override { return !tone().byNote; }
+};
+
+/// A note, shown by name the way the Deluge names notes
+class Note final : public Integer {
+public:
+	using Integer::Integer;
+	[[nodiscard]] int32_t getMaxValue() const override { return 127; }
+	void readCurrentValue() override { this->setValue(tone().note); }
+	void writeCurrentValue() override { tone().note = this->getValue(); }
+	bool isRelevant(ModControllableAudio*, int32_t) override { return tone().byNote; }
+
+protected:
+	void drawValue() override {
+		char buffer[8];
+		noteCodeToString(this->getValue(), buffer);
+		display->setText(buffer);
+	}
+	void drawInteger(int32_t textWidth, int32_t textHeight, int32_t yPixel) override {
+		char buffer[8];
+		noteCodeToString(this->getValue(), buffer);
+		deluge::hid::display::OLED::main.drawStringCentred(buffer, yPixel + OLED_MAIN_TOPMOST_PIXEL, textWidth,
+		                                                   textHeight);
+	}
+};
+
+class Cents final : public Integer {
+public:
+	using Integer::Integer;
+	[[nodiscard]] int32_t getMinValue() const override { return -Settings::kMaxCents; }
+	[[nodiscard]] int32_t getMaxValue() const override { return Settings::kMaxCents; }
+	void readCurrentValue() override { this->setValue(tone().cents); }
+	void writeCurrentValue() override { tone().cents = this->getValue(); }
+	bool isRelevant(ModControllableAudio*, int32_t) override { return tone().byNote; }
+};
+
+class Beat final : public Decimal {
+public:
+	using Decimal::Decimal;
+	[[nodiscard]] int32_t getMaxValue() const override { return Settings::kMaxBeat; }
+	[[nodiscard]] int32_t getNumDecimalPlaces() const override { return 2; }
+	void readCurrentValue() override { this->setValue(tone().beat); }
+	void writeCurrentValue() override { tone().beat = this->getValue(); }
+	bool isRelevant(ModControllableAudio*, int32_t) override {
+		return tone().mode != Settings::Mode::TONE && tone().sync == 0;
+	}
+};
+
+/// The beat from the tempo: off, or a whole note to a 64th
+class Sync final : public Selection {
+public:
+	using Selection::Selection;
+	void readCurrentValue() override { this->setValue(tone().sync); }
+	void writeCurrentValue() override { tone().sync = this->getValue(); }
+	deluge::vector<std::string_view> getOptions() override {
+		if (display->haveOLED()) {
+			return {l10n::getView(l10n::String::STRING_FOR_OFF), "1/1", "1/2", "1/4", "1/8", "1/16", "1/32", "1/64"};
+		}
+		return {l10n::getView(l10n::String::STRING_FOR_OFF), "1", "2", "4", "8", "16", "32", "64"};
+	}
+	bool isRelevant(ModControllableAudio*, int32_t) override { return tone().mode != Settings::Mode::TONE; }
+};
+
+class Timbre final : public Selection {
+public:
+	using Selection::Selection;
+	void readCurrentValue() override { this->setValue((int32_t)tone().timbre); }
+	void writeCurrentValue() override { tone().timbre = this->getValue<Settings::Timbre>(); }
+	deluge::vector<std::string_view> getOptions() override {
+		using enum l10n::String;
+		return {l10n::getView(STRING_FOR_SINE), l10n::getView(STRING_FOR_SOFT), l10n::getView(STRING_FOR_ORGAN),
+		        l10n::getView(STRING_FOR_RICH)};
+	}
+};
+
+class Level final : public Integer {
+public:
+	using Integer::Integer;
+	[[nodiscard]] int32_t getMaxValue() const override { return Settings::kMaxLevel; }
+	void readCurrentValue() override { this->setValue(tone().level); }
+	void writeCurrentValue() override { tone().level = this->getValue(); }
+};
+
+class Pan final : public Integer {
+public:
+	using Integer::Integer;
+	[[nodiscard]] int32_t getMinValue() const override { return -Settings::kMaxPan; }
+	[[nodiscard]] int32_t getMaxValue() const override { return Settings::kMaxPan; }
+	void readCurrentValue() override { this->setValue(tone().pan); }
+	void writeCurrentValue() override { tone().pan = this->getValue(); }
+};
+
+/// The whole drone's volume
+class Volume final : public Integer {
+public:
+	using Integer::Integer;
+	[[nodiscard]] int32_t getMaxValue() const override { return Settings::kMaxLevel; }
+	void readCurrentValue() override { this->setValue(currentSong->drone.volume); }
+	void writeCurrentValue() override { currentSong->drone.volume = this->getValue(); }
+};
+
+/// How far the drone ducks with the song's sidechain
+class SidechainAmount final : public Integer {
+public:
+	using Integer::Integer;
+	[[nodiscard]] int32_t getMaxValue() const override { return Settings::kMaxLevel; }
+	void readCurrentValue() override { this->setValue(currentSong->drone.sidechain); }
+	void writeCurrentValue() override { currentSong->drone.sidechain = this->getValue(); }
+};
+
+/// The shape of the ducking, as the reverb's
+class SidechainShape final : public Integer {
+public:
+	using Integer::Integer;
+	[[nodiscard]] int32_t getMaxValue() const override { return kMaxMenuValue; }
+	void readCurrentValue() override {
+		this->setValue((((int64_t)currentSong->drone.sidechainShape + 2147483648) * kMaxMenuValue + 2147483648) >> 32);
+	}
+	void writeCurrentValue() override {
+		currentSong->drone.sidechainShape = (uint32_t)this->getValue() * 85899345 - 2147483648;
+	}
+	bool isRelevant(ModControllableAudio*, int32_t) override { return currentSong->drone.sidechain > 0; }
+};
+
+/// The Song menu's "Drone": opens the drone view (see gui/views/drone_view.cpp)
+class OpenView final : public MenuItem {
+public:
+	using MenuItem::MenuItem;
+	MenuItem* selectButtonPress() override;
+	bool shouldEnterSubmenu() override { return false; }
+	bool isRelevant(ModControllableAudio*, int32_t) override;
+};
+
+/// The sidechain submenu: its sync, attack and release items (shared with the other sidechain menus) edit the drone's
+/// envelope while in here
+class SidechainMenu final : public Submenu {
+public:
+	using Submenu::Submenu;
+	void beginSession(MenuItem* navigatedBackwardFrom = nullptr) override {
+		soundEditor.currentSidechain = &currentSong->droneSidechain;
+		Submenu::beginSession(navigatedBackwardFrom);
+	}
+};
+
+} // namespace deluge::gui::menu_item::drone
