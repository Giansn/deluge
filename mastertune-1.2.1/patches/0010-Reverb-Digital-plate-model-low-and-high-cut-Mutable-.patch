 namespace freeverb {
+/// a - b, clipped to the int32_t range
+[[gnu::always_inline]] static inline int32_t subtractSaturate(int32_t a, int32_t b) {
+#if defined(__arm__)
+	int32_t out;
+	asm("qsub %0, %1, %2" : "=r"(out) : "r"(a), "r"(b));
+	return out;
+#else
+	int64_t d = (int64_t)a - b;
+	return d > INT32_MAX ? INT32_MAX : (d < INT32_MIN ? INT32_MIN : (int32_t)d);
+#endif
+}
