+namespace reverb {
+// Song files keep the reverb settings the way 1.2.1 wrote them, so older firmware still reads them the same:
+//
+// - Damping of the Mutable (and Digital) model ran backwards in 1.2.1: 0 and 50 were both bright, 1 the darkest. The
+//   file keeps that value, the menu now runs like Freeverb's, from 0 bright to 50 dark, at the same sound.
+// - The low cut ("hpf") only reached 85 Hz in 1.2.1, which also never applied it when loading a song. Its value goes on
+//   in "lowCut", the old one is read at the cutoff it actually had.
+// - The high cut is new ("highCut"). The community firmware's "lpf" is read at the cutoff it actually has there.
+
+/// Damping in the menu's direction, from the value in the song file (Mutable and Digital model)
+inline float dampingFromFile(float value) {
+	return (value <= 0.f) ? 0.f : 1.f - std::min(value, 1.f);
+}
+
+/// The other way. The darkest setting becomes the smallest value above 0, since 0 means no damping in the file.
+inline float dampingToFile(float damping) {
+	return (damping <= 0.f) ? 0.f : std::max(1.f - damping, 1.f / 2147483648.f);
+}
+
+/// Cutoff where dsp::OnePole() with 1.2.1's coefficient f / (1 + f) actually puts its pole
+inline float actualHzOfOldCoefficient(float labelHz) {
+	float f = labelHz / static_cast<float>(kSampleRate);
+	float coefficient = f / (1.f + f);
+	return -std::log(1.f - coefficient) * static_cast<float>(kSampleRate) / (2.f * std::numbers::pi_v<float>);
+}
+
+/// Low cut position for the "hpf" value of 1.2.1 (and the community firmware), at the same actual cutoff
+inline float lowCutFromOldHPF(float value) {
+	float labelHz = 20.f + (std::exp(1.5f * value) - 1.f) * 150.f;
+	float hz = actualHzOfOldCoefficient(labelHz);
+	if (hz <= 20.f) {
+		return 0.f;
+	}
+	return std::clamp(std::log((hz - 20.f) / 150.f + 1.f) / 1.5f, 0.f, 1.f);
+}
+
+/// High cut position for the community firmware's "lpf" value, at the same actual cutoff
+inline float highCutFromCommunityLPF(float value) {
+	float labelHz = (std::exp(1.5f * value) - 1.f) * 5083.74f;
+	float hz = actualHzOfOldCoefficient(labelHz);
+	if (hz <= 500.f) {
+		return 0.f;
+	}
+	return std::clamp(std::log(hz / 500.f) / std::log(40.f), 0.f, 0.98f);
+}
+} // namespace reverb
 } // namespace deluge::dsp
