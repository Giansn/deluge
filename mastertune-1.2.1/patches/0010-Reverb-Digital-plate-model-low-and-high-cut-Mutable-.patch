+#pragma once
+#include "definitions_cxx.hpp"
+#include "dsp/reverb/mutable/reverb.hpp"
+#include <cmath>
+
+namespace deluge::dsp::reverb {
+
+/// The plate reverb from Jon Dattorro, "Effect Design, Part 1: Reverberator and Other Filters" (JAES, 1997), in the
+/// Griesinger topology after the Lexicon 224: a bandwidth filter and four allpass diffusers on the input, then a
+/// figure-eight tank of two halves, each a modulated allpass, a delay, the damping filter, a second allpass and a
+/// second delay, and each half fed by the input and the other half. Seven taps into the tank make each output channel.
+///
+/// The model and its place in the menu come from the community firmware (#3277). This version follows the paper where
+/// that one doesn't: the tank's first allpasses are real allpasses (there, their delay lines carry the other half's
+/// output at 0.7, which shortens and thins the tail), each half has its own damping filter (there, both share one), the
+/// delays are scaled up to 44.1 kHz (there, down, which makes the plate 2.2 times smaller), and Width sets the stereo
+/// width of the output.
+///
+/// The paper's delays are for 29761 Hz. They're scaled by 1.45 instead of 44100 / 29761 = 1.48, which keeps the whole
+/// plate in the 32768 samples of buffer it shares with the Mutable model, at a 2% smaller size.
+class Digital : public Mutable {
+	static constexpr float kScale = 1.45f;
+	static constexpr size_t scaled(float samples) { return static_cast<size_t>(samples * kScale + 0.5f); }
+
+	static constexpr float kExcursion = 16.f * kScale; // Peak to peak modulation of the tank's first allpasses,
+	                                                   // centred on their delay
+	static constexpr float kBandwidth = 0.9995f;
+	static constexpr float kInputDiffusion1 = 0.75f;
+	static constexpr float kInputDiffusion2 = 0.625f;
+	static constexpr float kDecayDiffusion1 = 0.70f;
+	static constexpr float kTapGain = 0.6f;
+
+	/// Brings the output to the level of the Mutable model at the same settings (measured with noise: within 0.5 dB
+	/// over the Room size range, see tests/reverb)
+	static constexpr float kOutputGain = 0.89f;
+
+	/// Decay per half of the tank from the Room size, through Mutable's reverb time (0.01 to 0.98): about 0.6 s at 0,
+	/// 4.5 s at 30 (the default, where Mutable has 5 s), 18 s at 45 and much longer at 50 (measured without damping)
+	static constexpr float kDecayExponent = 0.47f;
+
+public:
+	Digital() {
+		// About 1 Hz as in the paper, at slightly different rates for the two halves
+		engine_.SetLFOFrequency(LFO_1, 1.0f / sample_rate);
+		engine_.SetLFOFrequency(LFO_2, 0.77f / sample_rate);
+		setRoomSize(getRoomSize());
+	}
+	~Digital() override = default;
+
+	void process(std::span<int32_t> in, std::span<StereoSample> output) override {
+		typename FxEngine::Context c;
+
+		typename FxEngine::AllPass ap1(scaled(142));
+		typename FxEngine::AllPass ap2(scaled(107));
+		typename FxEngine::AllPass ap3(scaled(379));
+		typename FxEngine::AllPass ap4(scaled(277));
+
+		// Left half of the tank
+		typename FxEngine::AllPass dap1a(scaled(672 + 8) + 2); // Room for the modulation
+		typename FxEngine::DelayLine del1a(scaled(4453));
+		typename FxEngine::AllPass dap1b(scaled(1800));
+		typename FxEngine::DelayLine del1b(scaled(3720));
+
+		// Right half
+		typename FxEngine::AllPass dap2a(scaled(908 + 8) + 2);
+		typename FxEngine::DelayLine del2a(scaled(4217));
+		typename FxEngine::AllPass dap2b(scaled(2656));
+		typename FxEngine::DelayLine del2b(scaled(3163));
+
+		FxEngine::ConstructTopology(engine_, {&ap1, &ap2, &ap3, &ap4,         //<
+		                                      &dap1a, &del1a, &dap1b, &del1b, //<
+		                                      &dap2a, &del2a, &dap2b, &del2b});
+
+		const float decay = decay_;
+		const float decayDiffusion2 = std::clamp(decay + 0.15f, 0.25f, 0.5f);
+		const float damping = lp_;
+		const float side = width_;
+
+		float lp_1 = lp_decay_1_;
+		float lp_2 = lp_decay_2_;
+		float bandwidth = bandwidth_state_;
+
+		startPanRamp(in.size());
+		for (size_t frame = 0; frame < in.size(); ++frame) {
+			advancePanRamp();
+			engine_.Advance();
+
+			// Input: bandwidth filter, then diffusion
+			const float input_sample = in[frame] / static_cast<float>(std::numeric_limits<int32_t>::max());
+			c.Set(input_sample);
+			c.Lp(bandwidth, kBandwidth);
+			ap1.Process(c, kInputDiffusion1);
+			ap2.Process(c, kInputDiffusion1);
+			ap3.Process(c, kInputDiffusion2);
+			ap4.Process(c, kInputDiffusion2);
+			const float diffused = c.Get();
+
+			// What each half hands to the other, from the ends of their second delays
+			const float fromLeft = del1b.at(static_cast<int32_t>(del1b.length)) * decay;
+			const float fromRight = del2b.at(static_cast<int32_t>(del2b.length)) * decay;
+
+			// Left half. The modulated allpass has its coefficient's sign reversed, as in the paper.
+			c.Set(diffused + fromRight);
+			dap1a.ProcessInterpolate(c, scaled(672) - kExcursion / 2, LFO_1, kExcursion, -kDecayDiffusion1);
+			del1a.Process(c);
+			c.Lp(lp_1, damping);
+			c.Multiply(decay);
+			dap1b.Process(c, decayDiffusion2);
+			del1b.Write(0, c.Get());
+
+			// Right half
+			c.Set(diffused + fromLeft);
+			dap2a.ProcessInterpolate(c, scaled(908) - kExcursion / 2, LFO_2, kExcursion, -kDecayDiffusion1);
+			del2a.Process(c);
+			c.Lp(lp_2, damping);
+			c.Multiply(decay);
+			dap2b.Process(c, decayDiffusion2);
+			del2b.Write(0, c.Get());
+
+			// Output taps (table 2 of the paper)
+			float left = del2a.at(scaled(266));
+			left += del2a.at(scaled(2974));
+			left -= dap2b.at(scaled(1913));
+			left += del2b.at(scaled(1996));
+			left -= del1a.at(scaled(1990));
+			left -= dap1b.at(scaled(187));
+			left -= del1b.at(scaled(1066));
+
+			float right = del1a.at(scaled(353));
+			right += del1a.at(scaled(3627));
+			right -= dap1b.at(scaled(1228));
+			right += del1b.at(scaled(2673));
+			right -= del2a.at(scaled(2111));
+			right -= dap2b.at(scaled(335));
+			right -= del2b.at(scaled(121));
+
+			// Width: scale the difference between the channels
+			const float mid = (left + right) * 0.5f;
+			const float diff = (left - right) * 0.5f * side;
+			left = (mid + diff) * (kTapGain * kOutputGain);
+			right = (mid - diff) * (kTapGain * kOutputGain);
+
+			left = filterOutput(left, hp_l_, lp_l_);
+			right = filterOutput(right, hp_r_, lp_r_);
+
+			auto output_left =
+			    static_cast<int32_t>(left * static_cast<float>(std::numeric_limits<uint32_t>::max()) * 0xF);
+			auto output_right =
+			    static_cast<int32_t>(right * static_cast<float>(std::numeric_limits<uint32_t>::max()) * 0xF);
+
+			// Mix
+			output[frame].l += multiply_32x32_rshift32_rounded(output_left, getPanLeft());
+			output[frame].r += multiply_32x32_rshift32_rounded(output_right, getPanRight());
+		}
+		endPanRamp();
+
+		lp_decay_1_ = lp_1;
+		lp_decay_2_ = lp_2;
+		bandwidth_state_ = bandwidth;
+	}
+
+	void setRoomSize(float value) override {
+		Mutable::setRoomSize(value);
+		decay_ = std::pow(reverb_time_, kDecayExponent);
+	}
+
+	/// The stereo width of the output: 0 is mono, 1 the full width of the plate
+	void setWidth(float value) override { width_ = std::clamp(value, 0.f, 1.f); }
+	[[nodiscard]] float getWidth() const override { return width_; }
+
+private:
+	float decay_ = 0.5f;
+	float width_ = 1.f;
+	float bandwidth_state_ = 0.f;
+};
+} // namespace deluge::dsp::reverb
