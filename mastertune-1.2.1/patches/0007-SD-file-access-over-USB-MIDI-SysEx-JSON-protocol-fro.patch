+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include "definitions_cxx.hpp"
+#include <cstddef>
+#include <cstdint>
+
+class String;
+
+// In-memory JSON writer and reader for the SysEx file protocol (storage/smsysex.cpp). Ported from community firmware
+// 1.3: the memory mode of its FileWriter / FileReader and its JsonSerializer / JsonDeserializer, with only the parts
+// the protocol uses. 1.2.1 keeps storing songs and presets as XML, so nothing here touches files.
+
+class MemoryWriter {
+public:
+	void writeByte(int8_t b);
+	void writeBlock(uint8_t* block, uint32_t size);
+	void writeChars(char const* output);
+	char* getBufferPtr() { return writeClusterBuffer; }
+	int32_t bytesWritten() { return fileWriteBufferCurrentPos; }
+	int32_t bytesFree() { return (int32_t)bufferSize - fileWriteBufferCurrentPos; }
+	bool overflowed() { return fileAccessFailedDuringWrite; }
+	void setMemoryBased() {} // Always is
+	void setBuffer(char* buffer, uint32_t size) {
+		writeClusterBuffer = buffer;
+		bufferSize = size;
+	}
+	// Takes back everything written after pos (a value of bytesWritten() from before)
+	void rewindTo(int32_t pos) {
+		fileWriteBufferCurrentPos = pos;
+		fileAccessFailedDuringWrite = false;
+	}
+
+protected:
+	void resetWriter();
+
+	char* writeClusterBuffer = nullptr;
+	uint32_t bufferSize = 0;
+	int32_t fileWriteBufferCurrentPos = 0;
+	bool fileAccessFailedDuringWrite = false;
+};
+
+class MemoryReader {
+public:
+	MemoryReader(char* memBuffer, uint32_t bufLen) {
+		fileClusterBuffer = memBuffer;
+		currentReadBufferEndPos = bufLen;
+	}
+
+	bool peekChar(char* thisChar);
+	bool readChar(char* thisChar);
