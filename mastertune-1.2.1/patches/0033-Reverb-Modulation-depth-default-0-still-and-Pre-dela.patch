+
+namespace deluge::gui::menu_item::reverb {
+/// Depth of the reverb's modulated delays: 0 = still, a held tone stays steady in the reverb (the default);
+/// 50 = the depth of mastertune v10 to v13 (Mutable Instruments' and Dattorro's designs)
+class Modulation final : public Integer {
+public:
+	using Integer::Integer;
+	void readCurrentValue() override {
+		this->setValue(std::round(AudioEngine::reverb.getModulation() * kMaxMenuValue));
+	}
+	void writeCurrentValue() override { AudioEngine::reverb.setModulation((float)this->getValue() / kMaxMenuValue); }
+
+	[[nodiscard]] int32_t getMaxValue() const override { return kMaxMenuValue; }
+
+	bool isRelevant(ModControllableAudio* modControllable, int32_t whichThing) override {
+		return (AudioEngine::reverb.getModel() != dsp::Reverb::Model::FREEVERB);
+	}
+};
+} // namespace deluge::gui::menu_item::reverb
