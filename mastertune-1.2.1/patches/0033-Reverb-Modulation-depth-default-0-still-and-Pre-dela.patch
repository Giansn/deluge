@@ -49,6 +51,14 @@ public:
 
 	void process(std::span<int32_t> input, std::span<StereoSample> output) override {
 		using namespace reverb;
+		if (pre_delay_ != 0) {
+			for (int32_t& sample : input) {
+				pre_delay_buffer_[pre_delay_pos_] = sample;
+				size_t read = pre_delay_pos_ + kPreDelayBufferSize - pre_delay_;
+				sample = pre_delay_buffer_[read >= kPreDelayBufferSize ? read - kPreDelayBufferSize : read];
+				pre_delay_pos_ = (pre_delay_pos_ + 1 == kPreDelayBufferSize) ? 0 : pre_delay_pos_ + 1;
+			}
+		}
 		switch (model_) {
 		case Model::FREEVERB:
 			reverb_as<Freeverb>().process(input, output);
@@ -99,6 +109,26 @@ public:
 	}
 	[[nodiscard]] float getLPF() const override { return lpf_; }
 
+	void setModulation(float value) override {
+		modulation_ = std::clamp(value, 0.f, 1.f);
+		base_->setModulation(modulation_);
+	}
+	[[nodiscard]] float getModulation() const override { return modulation_; }
+
+	static constexpr int32_t kMaxPreDelayMs = 100;
+
+	/// Delay before the reverb, in ms (0 to kMaxPreDelayMs): the dry sound stands on its own before the reverb sets in
+	void setPreDelayMs(int32_t ms) {
+		ms = std::clamp<int32_t>(ms, 0, kMaxPreDelayMs);
+		size_t samples = static_cast<size_t>(ms) * kSampleRate / 1000;
+		if (pre_delay_ == 0 && samples != 0) {
+			pre_delay_buffer_.fill(0); // Nothing old comes out when it's switched on
+		}
+		pre_delay_ = samples;
+		pre_delay_ms_ = ms;
+	}
+	[[nodiscard]] int32_t getPreDelayMs() const { return pre_delay_ms_; }
+
 	template <typename T>
 	constexpr T& reverb_as() {
 		return std::get<T>(reverb_);
@@ -121,6 +151,13 @@ private:
 	float width_;
 	float hpf_ = 0.f;
 	float lpf_ = 1.f; // Off
+	float modulation_ = 0.f;
+
+	static constexpr size_t kPreDelayBufferSize = kMaxPreDelayMs * kSampleRate / 1000 + 1;
+	std::array<int32_t, kPreDelayBufferSize> pre_delay_buffer_{};
+	size_t pre_delay_pos_ = 0;
+	size_t pre_delay_ = 0; // In samples
+	int32_t pre_delay_ms_ = 0;
 };
 
