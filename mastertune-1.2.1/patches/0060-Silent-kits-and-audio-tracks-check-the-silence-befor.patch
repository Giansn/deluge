+// mastertune-v17: whether the check in renderOutput() after rendering nothing would find the effects dormant, and
+// setting them up before it would change nothing that is read before they're set up again. The same conditions, taken
+// from what they're made of before the setup (renderOutput() has made sure no sound came in last time):
+// - createDelayWorkingState() with no sound coming in: a delay with no buffers and no repeats to wait for
+//   (repeatsUntilAbandon) doesn't get any (doDelay false), Delay::setupWorkingState() only notes that no sound is
+//   coming in, which Delay::process() only reads after it has been set again. An old file's delay time change is
+//   resolved there, the first time.
+// - setupFilterSetConfig(): FilterSet::setConfig() resets a filter whose mode changes; otherwise it only sets what
+//   processFilters() reads, after it has been set again.
+// - The rest reads params and settings, as the check does.
+bool GlobalEffectableForClip::effectsStayDormant(ParamManager* paramManagerForClip, SampleRecorder* recorder) {
+	UnpatchedParamSet* unpatchedParams = paramManagerForClip->getUnpatchedParamSet();
+	if (clippingAmount || unpatchedParams->getValue(params::UNPATCHED_COMPRESSOR_THRESHOLD) > 0
+	    || (recorder && recorder->status < RecorderStatus::FINISHED_CAPTURING_BUT_STILL_WRITING) || delay.isActive()
+	    || delay.repeatsUntilAbandon || delay.timeChangeFromOldFile || stutterer.isStuttering(this)
+	    || isSRREnabled(paramManagerForClip) || getActiveModFXType(paramManagerForClip) != ModFXType::NONE) {
+		return false;
+	}
+	FilterMode lpfModeForRender;
+	FilterMode hpfModeForRender;
+	getFilterModesForRender(unpatchedParams, &lpfModeForRender, &hpfModeForRender);
+	return filterSet.keepsModes(lpfModeForRender, hpfModeForRender);
+}
+
+// mastertune-v17: what renderOutput() does when nothing is rendered and it skips the effects, and nothing else: the
+// sidechain, the compressor's threshold and reset, what the Kit or AudioOutput moves on without rendering, the reverb
+// kept awake while this sends to it, and the clip's automation
+void GlobalEffectableForClip::renderWithNothingToRender(ModelStackWithTimelineCounter* modelStack,
+                                                        ParamManager* paramManagerForClip, int32_t numSamples,
+                                                        int32_t reverbAmountAdjust, int32_t sideChainHitPending,
+                                                        bool isClipActive) {
+	UnpatchedParamSet* unpatchedParams = paramManagerForClip->getUnpatchedParamSet();
+
+	int32_t postReverbVolume = renderSidechain(paramManagerForClip, numSamples, sideChainHitPending);
+	compressor.setThreshold(unpatchedParams->getValue(params::UNPATCHED_COMPRESSOR_THRESHOLD));
+
+	advanceWithNothingToRender(modelStack, numSamples, isClipActive);
+
+	compressor.reset();
+	int32_t reverbSendAmount = getFinalParameterValueVolume(
+	    reverbAmountAdjust,
+	    cableToLinearParamShortcut(unpatchedParams->getValue(params::UNPATCHED_REVERB_SEND_AMOUNT)));
+	if (reverbSendAmount != 0) {
+		AudioEngine::timeThereWasLastSomeReverb = AudioEngine::audioSampleTimer; // As the volume stage would
+	}
+
+	postReverbVolumeLastTime = postReverbVolume;
+
+	tickParamManagerForClip(modelStack, paramManagerForClip, numSamples, isClipActive);
+}
+
 int32_t GlobalEffectableForClip::getSidechainVolumeAmountAsPatchCableDepth(ParamManager* paramManager) {
 	int32_t sidechainVolumeParam = paramManager->getUnpatchedParamSet()->getValue(params::UNPATCHED_SIDECHAIN_VOLUME);
 	return (sidechainVolumeParam >> 2) + 536870912;
