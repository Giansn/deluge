+// mastertune-v17: renderGlobalEffectableForClip() renders nothing, and changes nothing but the rows' automation, when
+// no drum is rendering (drumsWithRenderingActive) and no drone row is sounding
+bool Kit::hasNothingToRender(bool isClipActive) {
+	if (drumsWithRenderingActive.getNumElements() != 0) {
+		return false;
+	}
+	if (numDroneDrums > 0) {
+		for (Drum* list : {firstDrum, drumsWrittenToFile}) {
+			for (Drum* thisDrum = list; thisDrum; thisDrum = thisDrum->next) {
+				if (thisDrum->type == DrumType::DRONE && ((DroneDrum*)thisDrum)->isSounding()) {
+					return false;
+				}
+			}
+		}
+	}
+	return true;
+}
