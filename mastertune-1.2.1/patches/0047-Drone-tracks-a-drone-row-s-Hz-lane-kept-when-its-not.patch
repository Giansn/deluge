 						ParamCollectionSummary* mpeParamsSummary =
 						    thisNoteRow->paramManager.getExpressionParamSetSummary();
 						ExpressionParamSet* mpeParams = (ExpressionParamSet*)mpeParamsSummary->paramCollection;
-						if (mpeParams) {
+						// mastertune-v16: a drone row's Hz lane stays with the row, not the note (nothing taken)
+						if (mpeParams && !thisNoteRow->expressionIsHzLane()) {
 							int32_t distanceToNextNote = thisNoteRow->getDistanceToNextNote(pos, modelStackWithNoteRow);
 							int32_t loopLength = modelStackWithNoteRow->getLoopLength();
 							ModelStackWithParamCollection* modelStackWithParamCollection =
@@ -3066,7 +3067,9 @@ cancelPress:
 				editPadPresses[i].deleteOnScroll = success;
 
 				if (success) {
-					if (editPadPresses[i].mpeCachedYet) {
+					// mastertune-v16: nor does a note's MPE go into a drone row's Hz lane (the note keeps it for the
+					// next row it's moved to)
+					if (editPadPresses[i].mpeCachedYet && !noteRow->expressionIsHzLane()) {
 						int32_t anyActualNodes = 0;
 						for (int32_t m = 0; m < kNumExpressionDimensions; m++) {
 							anyActualNodes += editPadPresses[i].stolenMPE[m].num;
@@ -5955,7 +5958,8 @@ justDisplayOldNumNotes:
 					// that we do next, below.
 					ParamCollectionSummary* mpeParamsSummary = noteRow->paramManager.getExpressionParamSetSummary();
 					ExpressionParamSet* mpeParams = (ExpressionParamSet*)mpeParamsSummary->paramCollection;
-					if (mpeParams) {
+					// mastertune-v16: not a drone row's Hz lane, which isn't its notes'
+					if (mpeParams && !noteRow->expressionIsHzLane()) {
 						ModelStackWithParamCollection* modelStackWithParamCollection =
 						    modelStack->addOtherTwoThingsAutomaticallyGivenNoteRow()->addParamCollection(
 						        mpeParams, mpeParamsSummary);
@@ -6304,8 +6308,8 @@ void InstrumentClipView::reportNoteOffForMPEEditing(ModelStackWithNoteRow* model
 	NoteRow* noteRow = modelStack->getNoteRow();
 
 	// MPE stuff for note off - if they're still "editing" a note, they'll want the values from half a second ago,
-	// or the values from when they pressed hardest.
-	if (view.modLength && modelStack->noteRowId == view.modNoteRowId
+	// or the values from when they pressed hardest. (mastertune-v16: not into a drone row's Hz lane)
+	if (view.modLength && !noteRow->expressionIsHzLane() && modelStack->noteRowId == view.modNoteRowId
 	    && modelStack->getTimelineCounter() == view.activeModControllableModelStack.getTimelineCounterAllowNull()) {
 
 		ParamCollectionSummary* mpeParamsSummary = noteRow->paramManager.getExpressionParamSetSummary();
diff --git a/src/deluge/model/clip/instrument_clip.cpp b/src/deluge/model/clip/instrument_clip.cpp
index 06149131..1a90a35b 100644
--- a/src/deluge/model/clip/instrument_clip.cpp
+++ b/src/deluge/model/clip/instrument_clip.cpp
@@ -4528,6 +4528,13 @@ doNormal: // Wrap it back to the start.
 		return;
 	}
 
+	// mastertune-v16: a drone row's expression is its Hz lane, not the MPE of its notes: a note recorded (an audition
+	// pad, MIDI, the keyboard) leaves it as it is, rather than set to the note's values (0 for a pad) from here to the
+	// next note, or all of it for the row's only note
+	if (noteRow->expressionIsHzLane()) {
+		return;
+	}
+
 	// If we're doing MPE, we'll want to place a node here at the Note's start, so it's got the correct stuff
 	// to sound during its note-on when we play back.
 
diff --git a/src/deluge/model/note/note_row.cpp b/src/deluge/model/note/note_row.cpp
index a648d1fa..1c4d75f4 100644
--- a/src/deluge/model/note/note_row.cpp
+++ b/src/deluge/model/note/note_row.cpp
@@ -4194,13 +4194,16 @@ void NoteRow::getMPEValues(ModelStackWithNoteRow* modelStack, int16_t* mpeValues
 	}
 }
 
+bool NoteRow::expressionIsHzLane() const {
+	return drum != nullptr && drum->type == DrumType::DRONE;
+}
+
 // This is obviously very inefficient, doing deletions for every "screen", sequentially.
 // Also, pos is provided as the squareStart, but in a perfect world, we'd actually use the pos of the first note within
 // that square - for each "screen"! Or something like that...
 void NoteRow::clearMPEUpUntilNextNote(ModelStackWithNoteRow* modelStack, int32_t pos, int32_t wrapEditLevel,
                                       bool shouldJustDeleteNodes) {
-	// mastertune-v16: a drone row's expression is its Hz lane, not its notes' MPE: adding or deleting a note keeps it
-	if (drum && drum->type == DrumType::DRONE) {
+	if (expressionIsHzLane()) { // mastertune-v16: a drone row's lane, not its notes' MPE
 		return;
 	}
 
