+
+// The velocity scale (255 = unchanged) of a bouncing ratchet's hit, from its gap to the next one. Fade: the square root
+// of the gap relative to the longest, like a ball hitting softer as it comes to rest. Rise: from half the velocity at
+// the longest gap to the full one at the shortest, like a ping-pong ball getting faster between closing plates
+uint8_t ArpeggiatorBase::getBounceVelocityScale(BounceVelocity mode, float gap, float longest, float shortest) {
+	switch (mode) {
+	case BounceVelocity::FADE:
+		return (uint8_t)(255.0f * std::sqrt(gap / longest) + 0.5f);
+	case BounceVelocity::RISE:
+		if (longest > shortest) {
+			return (uint8_t)(255.0f * (1.0f - 0.5f * (gap - shortest) / (longest - shortest)) + 0.5f);
+		}
+		return 255;
+	default:
