+namespace deluge::gui::menu_item::arpeggiator {
+// Bounce length: how many arp steps a ratchet lasts. 1 is one step, like before. A longer ratchet holds its note over
+// the next steps, its hits spread over all of them, and the arp goes on with its next note on the step after them
+class BounceLength final : public Integer {
+public:
+	using Integer::Integer;
+	void readCurrentValue() override { this->setValue(soundEditor.currentArpSettings->ratchetBounceLength); }
+	bool usesAffectEntire() override { return true; }
+	void writeCurrentValue() override {
+		int32_t value = this->getValue();
+		// If affect-entire button held, do whole kit
+		if (currentUIMode == UI_MODE_HOLDING_AFFECT_ENTIRE_IN_SOUND_EDITOR && soundEditor.editingKitRow()) {
+			for (Drum* thisDrum = getCurrentKit()->firstDrum; thisDrum != nullptr; thisDrum = thisDrum->next) {
+				thisDrum->arpSettings.ratchetBounceLength = value;
+			}
+		}
+		else {
+			soundEditor.currentArpSettings->ratchetBounceLength = value;
+		}
+	}
+	[[nodiscard]] int32_t getMinValue() const override { return 1; }
+	[[nodiscard]] int32_t getMaxValue() const override { return kMaxBounceLength; }
+	bool isRelevant(ModControllableAudio* modControllable, int32_t whichThing) override {
+		return soundEditor.currentArpSettings != nullptr && soundEditor.currentArpSettings->mode != ArpMode::OFF;
+	}
+};
+} // namespace deluge::gui::menu_item::arpeggiator
