+#pragma once
+#include "gui/menu_item/integer.h"
+#include "gui/ui/sound_editor.h"
+#include "model/drum/drum.h"
+#include "model/instrument/kit.h"
+#include "model/song/song.h"
+#include "modulation/arpeggiator.h"
+
+namespace deluge::gui::menu_item::arpeggiator {
+// Ratchet bounce: spaces the notes of each ratchet like a bouncing ball. Positive values speed the ratchet up (each
+// gap and velocity smaller than the one before), negative ones slow it down, 0 keeps the notes evenly spaced
+class RatchetBounce final : public Integer {
+public:
+	using Integer::Integer;
+	void readCurrentValue() override { this->setValue(soundEditor.currentArpSettings->ratchetBounce); }
+	bool usesAffectEntire() override { return true; }
+	void writeCurrentValue() override {
+		int32_t value = this->getValue();
+		// If affect-entire button held, do whole kit
+		if (currentUIMode == UI_MODE_HOLDING_AFFECT_ENTIRE_IN_SOUND_EDITOR && soundEditor.editingKitRow()) {
+			for (Drum* thisDrum = getCurrentKit()->firstDrum; thisDrum != nullptr; thisDrum = thisDrum->next) {
+				thisDrum->arpSettings.ratchetBounce = value;
+			}
+		}
+		else {
+			soundEditor.currentArpSettings->ratchetBounce = value;
+		}
+	}
+	[[nodiscard]] int32_t getMinValue() const override { return -kMaxRatchetBounce; }
+	[[nodiscard]] int32_t getMaxValue() const override { return kMaxRatchetBounce; }
+	bool isRelevant(ModControllableAudio* modControllable, int32_t whichThing) override {
+		return soundEditor.currentArpSettings != nullptr && soundEditor.currentArpSettings->mode != ArpMode::OFF;
+	}
+};
+} // namespace deluge::gui::menu_item::arpeggiator
