+	if (instruction->arpNoteOn != nullptr && instruction->arpNoteOn->noteCodeOnPostArp[0] != ARP_NOTE_NONE
+	    && (!onlyPendingNoteOn || instruction->arpNoteOn->noteStatus[0] == ArpNoteStatus::PENDING)) {
