+// Refreshes the kit arp's settings from the kit's params. Returns nullptr if there's no kit arp to run.
+ArpeggiatorSettings* Kit::updateKitArpSettings(ParamManager* paramManager) {
+	ArpeggiatorSettings* arpSettings = getArpSettings();
+	if (arpSettings == nullptr || paramManager == nullptr || !paramManager->containsAnyMainParamCollections()) {
+		return nullptr;
+	}
+	UnpatchedParamSet* unpatchedParams = paramManager->getUnpatchedParamSet();
+	arpSettings->updateParamsFromUnpatchedParamSet(unpatchedParams);
+	// The kit arp plays one row at a time, so it has no chords or octaves (also keeps MIDI follow from setting them)
+	arpSettings->chordPolyphony = 0;
+	arpSettings->chordProbability = 0;
+	arpSettings->spreadOctave = 0;
+	arpSettings->gate = unpatchedParams->getValue(params::UNPATCHED_ARP_GATE);
+	arpSettings->rate = unpatchedParams->getValue(params::UNPATCHED_ARP_RATE);
+	return arpSettings;
+}
+
+void Kit::setupAndRenderArpPreOutput(ModelStackWithTimelineCounter* modelStack, ParamManager* paramManager,
+                                     int32_t numSamples) {
+	ArpeggiatorSettings* arpSettings = updateKitArpSettings(paramManager);
+	if (arpSettings == nullptr || arpSettings->mode == ArpMode::OFF) {
+		return;
+	}
+	uint32_t gateThreshold = (uint32_t)arpSettings->gate + 2147483648;
+	uint32_t phaseIncrement = arpSettings->getPhaseIncrement(getFinalParameterValueExp(
+	    paramNeutralValues[params::GLOBAL_ARP_RATE], cableToExpParamShortcut(arpSettings->rate)));
+
+	ArpReturnInstruction kitInstruction;
+	arpeggiator.render(arpSettings, &kitInstruction, numSamples, gateThreshold, phaseIncrement);
+	applyKitArpInstruction(modelStack, &kitInstruction, false);
+}
