+#pragma once
+#include "gui/l10n/l10n.h"
+#include "gui/menu_item/selection.h"
+#include "gui/ui/sound_editor.h"
+#include "model/clip/instrument_clip.h"
+#include "model/instrument/kit.h"
+#include "model/instrument/melodic_instrument.h"
+#include "model/model_stack.h"
+#include "model/song/song.h"
+#include "processing/sound/sound.h"
+
+namespace deluge::gui::menu_item::arpeggiator {
+// Latch: the arp keeps playing the notes after the keys are let go, until a new set of keys is pressed
+class Latch final : public Selection {
+public:
+	using Selection::Selection;
+	void readCurrentValue() override { this->setValue(soundEditor.currentArpSettings->latch); }
+	void writeCurrentValue() override {
+		bool latch = this->getValue() != 0;
+		if (soundEditor.currentArpSettings->latch && !latch) {
+			releaseLatchedNotes();
+		}
+		soundEditor.currentArpSettings->latch = latch;
+	}
+	bool isRelevant(ModControllableAudio* modControllable, int32_t whichThing) override {
+		// A kit row has one note, nothing to latch: that's what the kit arp is for
+		return !soundEditor.editingKitRow();
+	}
+	deluge::vector<std::string_view> getOptions() override {
+		using enum l10n::String;
+		return {l10n::getView(STRING_FOR_OFF), l10n::getView(STRING_FOR_ON)};
+	}
+	bool isToggle() override { return true; }
+	bool shouldEnterSubmenu() override { return false; }
+
+private:
+	// Switching latch off stops what's latched, like switching the arp off does
+	void releaseLatchedNotes() {
+		if (!getCurrentClip()->isActiveOnOutput()) {
+			return;
+		}
+		char modelStackMemory[MODEL_STACK_MAX_SIZE];
+		ModelStackWithThreeMainThings* modelStack = soundEditor.getCurrentModelStack(modelStackMemory);
+		if (soundEditor.editingKitAffectEntire()) {
+			Kit* kit = getCurrentKit();
+			kit->arpeggiator.reset();
+			kit->cutAllSound();
+		}
+		else if (soundEditor.editingCVOrMIDIClip()) {
+			((MelodicInstrument*)getCurrentOutput())->arpeggiator.reset();
+			getCurrentInstrumentClip()->stopAllNotesForMIDIOrCV(modelStack->toWithTimelineCounter());
+		}
+		else if (soundEditor.currentSound != nullptr) {
+			ModelStackWithSoundFlags* modelStackWithSoundFlags = modelStack->addSoundFlags();
+			soundEditor.currentSound->allNotesOff(modelStackWithSoundFlags, soundEditor.currentSound->getArp());
+			soundEditor.currentSound->reassessRenderSkippingStatus(modelStackWithSoundFlags);
+		}
+	}
+};
+} // namespace deluge::gui::menu_item::arpeggiator
