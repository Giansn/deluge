+void Kit::renderNonAudioArpPostOutput(int32_t numSamples) {
+	if (activeClip == nullptr) {
+		return;
+	}
+	InstrumentClip* clip = (InstrumentClip*)activeClip;
+	for (int32_t i = 0; i < clip->noteRows.getNumElements(); i++) {
+		Drum* drum = clip->noteRows.getElement(i)->drum;
+		if (drum == nullptr || (drum->type != DrumType::MIDI && drum->type != DrumType::GATE)) {
+			continue;
+		}
+		NonAudioDrum* nonAudioDrum = (NonAudioDrum*)drum;
+		if (nonAudioDrum->arpSettings.mode == ArpMode::OFF) {
+			continue;
+		}
+		uint32_t gateThreshold = (uint32_t)nonAudioDrum->arpSettings.gate + 2147483648;
+		uint32_t phaseIncrement = nonAudioDrum->arpSettings.getPhaseIncrement(getFinalParameterValueExp(
+		    paramNeutralValues[params::GLOBAL_ARP_RATE], cableToExpParamShortcut(nonAudioDrum->arpSettings.rate)));
+
+		ArpReturnInstruction instruction;
+		nonAudioDrum->arpeggiator.render(&nonAudioDrum->arpSettings, &instruction, numSamples, gateThreshold,
+		                                 phaseIncrement);
+		applyNonAudioDrumArpInstruction(nonAudioDrum, &instruction);
+	}
+}
+
+void Kit::beenEdited(bool shouldMoveToEmptySlot) {
+	if (activeClip) {
+		defaultArpSettings.cloneFrom(&((InstrumentClip*)activeClip)->arpSettings);
+	}
+	Instrument::beenEdited(shouldMoveToEmptySlot);
+}
