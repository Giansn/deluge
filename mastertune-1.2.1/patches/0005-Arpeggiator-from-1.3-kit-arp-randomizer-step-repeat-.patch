+// Everything that plays a drum goes through here, so the kit arp gets to see it first
+void Kit::noteOnPreKitArp(ModelStackWithThreeMainThings* modelStack, Drum* drum, uint8_t velocity,
+                          int16_t const* mpeValues, int32_t fromMIDIChannel, uint32_t sampleSyncLength,
+                          int32_t ticksLate, uint32_t samplesLate) {
+	ArpeggiatorSettings* arpSettings = getArpSettings();
+	int32_t drumIndex = -1;
+	NoteRow* thisNoteRow = nullptr;
+	if (arpSettings != nullptr) {
+		thisNoteRow = ((InstrumentClip*)activeClip)->getNoteRowForDrum(drum, &drumIndex);
+	}
+	bool bypassKitArp = (thisNoteRow == nullptr || drumIndex == -1 || !drum->arpSettings.includeInKitArp);
+	if (!bypassKitArp && drum->type == DrumType::SOUND) {
+		// A sound that doesn't allow note tails gets no note-offs, which would leave the kit arp with stuck notes
+		bypassKitArp = !((SoundDrum*)drum)->allowNoteTails(modelStack->addSoundFlags(), true);
+	}
+	if (bypassKitArp) {
+		drum->noteOn(modelStack, velocity, this, mpeValues, fromMIDIChannel, sampleSyncLength, ticksLate, samplesLate);
+		return;
+	}
+
+	ArpReturnInstruction kitInstruction;
+	arpeggiator.noteOn(arpSettings, drumIndex, velocity, &kitInstruction, fromMIDIChannel, mpeValues);
+	if (kitInstruction.arpNoteOn != nullptr && kitInstruction.arpNoteOn->noteCodeOnPostArp[0] != ARP_NOTE_NONE) {
+		drum->arpeggiator.invertReversedFromKitArp = kitInstruction.invertReversed;
+		drum->noteOn(modelStack, kitInstruction.arpNoteOn->velocity, this, kitInstruction.arpNoteOn->mpeValues, 0,
+		             sampleSyncLength, ticksLate, samplesLate);
+		kitInstruction.arpNoteOn->noteStatus[0] = ArpNoteStatus::PLAYING;
+	}
+}
+
+void Kit::noteOffPreKitArp(ModelStackWithThreeMainThings* modelStack, Drum* drum, int32_t velocity) {
+	ArpeggiatorSettings* arpSettings = getArpSettings();
+	int32_t drumIndex = -1;
+	NoteRow* thisNoteRow = nullptr;
+	if (arpSettings != nullptr) {
+		thisNoteRow = ((InstrumentClip*)activeClip)->getNoteRowForDrum(drum, &drumIndex);
+	}
+	bool bypassKitArp = (thisNoteRow == nullptr || drumIndex == -1 || !drum->arpSettings.includeInKitArp);
+	if (!bypassKitArp && drum->type == DrumType::SOUND) {
+		bypassKitArp = !((SoundDrum*)drum)->allowNoteTails(modelStack->addSoundFlags(), true);
+	}
+	if (bypassKitArp) {
+		drum->arpeggiator.invertReversedFromKitArp = false;
+		drum->noteOff(modelStack, velocity);
+		return;
+	}
+
+	ArpReturnInstruction kitInstruction;
+	arpeggiator.noteOff(arpSettings, drumIndex, &kitInstruction);
+	// With the kit arp off, always pass the note-off on: the note may have started before the kit arp saw it
+	if (kitInstruction.noteCodeOffPostArp[0] != ARP_NOTE_NONE || arpSettings->mode == ArpMode::OFF) {
+		drum->arpeggiator.invertReversedFromKitArp = false;
+		drum->noteOff(modelStack, velocity);
+	}
 }
 
