+// Plays the NoteRow at index noteRowIndex of the active clip (as told by the kit arpeggiator), or releases it
+void Kit::kitArpNoteToRow(ModelStackWithTimelineCounter* modelStack, int32_t noteRowIndex, bool on,
+                          ArpReturnInstruction* instruction) {
+	InstrumentClip* clip = (InstrumentClip*)activeClip;
+	if (noteRowIndex < 0 || noteRowIndex >= clip->noteRows.getNumElements()) {
+		return;
+	}
+	NoteRow* thisNoteRow = clip->noteRows.getElement(noteRowIndex);
+	Drum* drum = thisNoteRow->drum;
+	if (drum == nullptr) {
+		return;
+	}
+	ModelStackWithThreeMainThings* modelStackWithThreeMainThings =
+	    modelStack->addNoteRow(noteRowIndex, thisNoteRow)
+	        ->addOtherTwoThings(drum->toModControllable(), &thisNoteRow->paramManager);
+	if (on) {
+		// The kit arp's reverse probability is applied by the drum's own voices
+		drum->arpeggiator.invertReversedFromKitArp = instruction->invertReversed;
+		drum->noteOn(modelStackWithThreeMainThings, instruction->arpNoteOn->velocity, this,
+		             instruction->arpNoteOn->mpeValues, MIDI_CHANNEL_NONE, instruction->sampleSyncLengthOn, 0, 0);
+		instruction->arpNoteOn->noteStatus[0] = ArpNoteStatus::PLAYING;
+	}
+	else {
+		drum->arpeggiator.invertReversedFromKitArp = false;
+		drum->noteOff(modelStackWithThreeMainThings);
+	}
