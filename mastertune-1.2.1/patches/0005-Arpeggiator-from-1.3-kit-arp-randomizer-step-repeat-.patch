+// Spaces the notes of a new ratchet like a bouncing ball: each gap is the one before times r, so the ratchet speeds
+// up (r < 1) or slows down (r > 1) while still filling exactly one step. A ball hits softer as the bounces get shorter,
+// so each note's velocity follows the square root of its gap relative to the longest one.
+void ArpeggiatorBase::setupRatchetBounce(ArpeggiatorSettings* settings) {
+	isRatchetBouncing =
+	    isRatcheting && settings->ratchetBounce != 0 && ratchetNotesCount >= 2 && ratchetNotesCount <= kMaxRatchetNotes;
+	if (!isRatchetBouncing) {
+		return;
+	}
+	int32_t amount = std::clamp<int32_t>(settings->ratchetBounce, -kMaxRatchetBounce, kMaxRatchetBounce);
+	float shrink = 1.0f - 0.05f * (float)std::abs(amount); // 0.95 ... 0.5, like a ball losing 5 ... 50 % per bounce
+	float ratio = (amount > 0) ? shrink : 1.0f / shrink;
+
+	std::array<float, kMaxRatchetNotes> gaps;
+	float gap = 1.0f;
+	float total = 0.0f;
+	float longest = 0.0f;
+	for (uint32_t i = 0; i < ratchetNotesCount; i++) {
+		gaps[i] = gap;
+		total += gap;
+		longest = std::max(longest, gap);
+		gap *= ratio;
+	}
+
+	constexpr float kMaxGate = (float)(1 << 24);
+	float start = 0.0f;
+	for (uint32_t i = 0; i < ratchetNotesCount; i++) {
+		ratchetNoteStarts[i] = (uint32_t)(start * kMaxGate / total);
+		start += gaps[i];
+		ratchetNoteVelocityScales[i] = (uint8_t)(255.0f * std::sqrt(gaps[i] / longest) + 0.5f);
+	}
+	ratchetNoteStarts[ratchetNotesCount] = 1 << 24;
