+// mastertune v18: the gains after the filters (a sound's, a kit row's, a kit's, an audio track's and the song's
+// volume, with the pan, the sidechain ducking and the filters' gain compensation in it) move per sample.
+//
+// - One target per channel per block: whatever sets the params (knob, automation, patch cables, MIDI, several at
+//   once) only changes the target; GainRamp takes the gain there over the block, linearly in amplitude, from where the
+//   last block left it. The last sample is exactly on the target (see rampSteps()).
+// - A move by more than 6 dB (a factor 2, to or from 0 included) takes at least kMinRampSamples (5 ms), over several
+//   blocks if the blocks are shorter: the gain goes on along the straight line from where it is to the target, so a
+//   target that keeps moving (the sidechain) is followed like by a one-pole, and a jump from silence to full level
+//   doesn't click.
+// - The signal times the gain is rounded once, with the gain normalised: a Q31 multiplier m = gain * 2^(31 - unity
+//   bits - s) and a headroom shift s (0 for gains up to 1), out = round(signal * m / 2^31) << s, saturating (NEON
+//   vqrdmulh, vqshl). Up to unity gain the output is within half an LSB of the exact product; above it within 2^(s-1)
+//   (1 LSB up to +6 dB, 2 up to +12 dB: still below half an LSB of the 24-bit output). v17 truncated the product to
+//   32 LSBs (2^5) at every gain, with a DC bias of 16: about -116 dBFS of error, whatever the level. A gain of
+//   exactly 1 gives the input back (m = 2^31 - 1: exact below 2^30, 36 dB over the output's clip).
+//   The gains themselves are the ones v17 computed from the params, so a stored value gives the same level as in v17.
+
+#pragma once
+
+#include "dsp/stereo_sample.h"
+#include <algorithm>
+#include <arm_neon.h>
+#include <cmath>
+#include <cstdint>
+
+namespace deluge::dsp::gain {
+
+// 5 ms at 44.1 kHz: the shortest time in which a gain moves by more than 6 dB
+constexpr int32_t kMinRampSamples = 221;
+
+// Unity in the volume stages' gains (v17's: the product was multiply_32x32_rshift32(signal, gain) << 5)
+constexpr int32_t kVolumeShift = 27;
+// ... and in the pan's amplitudes (shouldDoPanning(): 1073741823 is the centre)
+constexpr int32_t kPanShift = 30;
+
+// Whether gains a and b (>= 0) are more than 6 dB apart: one more than twice the other, a move from or to 0 included
+[[gnu::always_inline]] inline bool isBigStep(int32_t a, int32_t b) {
+	int64_t lo = std::min(a, b);
+	int64_t hi = std::max(a, b);
+	return hi > 2 * lo;
+}
+
+// One gain moving towards its target, block by block
+class GainRamp {
+public:
+	// The gain at the end of the next block of n samples, on the way to target (which the caller sets per block).
+	// The first block after restart() takes the target at once.
+	int32_t advance(int32_t target, int32_t n) {
+		if (!started_) [[unlikely]] {
+			current_ = target_ = target;
+			left_ = 0;
+			started_ = true;
+			return current_;
+		}
+		if (target != target_) {
+			target_ = target;
+			left_ = isBigStep(current_, target) ? std::max(kMinRampSamples, n) : n;
+		}
+		if (left_ <= n) {
+			current_ = target_;
+			left_ = 0;
+		}
+		else {
+			// n / left of the way along the straight line to the target, rounded
+			int64_t d = (int64_t)(target_ - current_) * n;
+			current_ += (int32_t)((d + (d >= 0 ? left_ / 2 : -(left_ / 2))) / left_);
+			left_ -= n;
+		}
+		return current_;
+	}
+	// The next block takes its target at once (after silence: nothing to ramp from)
+	void restart() { started_ = false; }
+	// Takes the gain where the last block left it as if a factor in it had been 1 / startFactor instead: where the
+	// stage before moves its output by startFactor to 1 over the block itself (the filters' gain compensation, see
+	// FilterSet::gainRampStart()), so that the two ramps together start where the last block ended
+	void rescaleStart(float startFactor) {
+		if (started_ && startFactor > 0.0f && startFactor != 1.0f) {
+			current_ = (int32_t)std::clamp((double)current_ / (double)startFactor, 0.0, 2147483647.0);
+		}
+	}
+	[[nodiscard]] int32_t current() const { return current_; }
+	[[nodiscard]] bool started() const { return started_; }
+
+private:
+	int32_t current_ = 0;
+	int32_t target_ = 0;
+	int32_t left_ = 0; // samples left of the move to target_, 0 when there
+	bool started_ = false;
+};
+
+// The headroom shift for gains up to peak (unity 2^kShift): the smallest s >= 0 with peak <= 2^(kShift + s)
+template <int32_t kShift>
+[[gnu::always_inline]] inline int32_t headroomShift(int32_t peak) {
+	int32_t s = 0;
+	while (s < 31 - kShift && (int64_t)peak > ((int64_t)1 << (kShift + s))) {
+		s++;
+	}
+	return s;
+}
+
+// The Q31 multiplier for a gain (unity 2^kShift) with headroom shift s: gain << (31 - kShift - s), saturating (a gain
+// of exactly 2^(kShift + s) gives 2^31 - 1)
+template <int32_t kShift>
+[[gnu::always_inline]] inline int32_t multiplier(int32_t g, int32_t s) {
+	int64_t m = (int64_t)g << (31 - kShift - s);
+	return (int32_t)std::min<int64_t>(m, INT32_MAX);
+}
+
+// round(x * m / 2^31) << s, saturating: vqrdmulh's arithmetic, one sample
+[[gnu::always_inline]] inline int32_t applyMultiplier(int32_t x, int32_t m, int32_t s) {
+	int64_t r = (((int64_t)x * m + ((int64_t)1 << 30)) >> 31) << s;
+	return (int32_t)std::clamp<int64_t>(r, INT32_MIN, INT32_MAX);
+}
+
+// The same on four samples: vqrdmulh (the doubled product's high word, rounded), then vqshl by s (shiftV = s)
+[[gnu::always_inline]] inline int32x4_t applyMultiplier4(int32x4_t x, int32x4_t m, int32x4_t shiftV) {
+	return vqshlq_s32(vqrdmulhq_s32(x, m), shiftV);
+}
+
+// A gain's steps across a block of n samples, from start (the gain before the block) to end: sample i (1 to n) takes
+// start + (end - start) * i / n, rounded, so sample n takes end exactly. Kept as 32.32 fixed point, from start + 1/2:
+// the step is (end - start) * 2^32 / n to within 2^11 (in double precision: the gains are >= 0, the difference has
+// at most 31 bits, the quotient's rounding error is below 2^-21 of a unit), so n steps miss the difference * 2^32 by
+// less than n * 2^11 <= 2^18, far less than the half added for the rounding: the last sample's high word is end. (No
+// 64-bit division, which the Cortex-A9 only has as a slow library call: one double division, native conversions.) Four
+// samples at a time: the two halves of acc hold the sums for samples i, i + 1 and i + 2, i + 3.
+class RampSteps {
+public:
+	// The step: (end - start) * 2^32 / n, in 32.32 (gains are >= 0, so |q| < 2^31: its whole part fits an int32_t)
+	static int64_t stepFor(int32_t start, int32_t end, int32_t n) {
+		if (end == start) {
+			return 0;
+		}
+		double q = ((double)end - (double)start) / (double)n;
+		double whole = std::floor(q);
+		return (int64_t)((uint64_t)(uint32_t)(int32_t)whole << 32) + (uint32_t)((q - whole) * 4294967296.0);
+	}
+
+	RampSteps(int32_t start, int32_t end, int32_t n) {
+		step_ = stepFor(start, end, n);
+		int64_t base = ((int64_t)start << 32) + ((int64_t)1 << 31);
+		int64x2_t s = vdupq_n_s64(step_);
+		acc0_ = vaddq_s64(vdupq_n_s64(base),
+		                  vcombine_s64(vcreate_s64((uint64_t)step_), vcreate_s64((uint64_t)(2 * step_))));
+		acc1_ = vaddq_s64(acc0_, vaddq_s64(s, s));
+		step4_ = vshlq_n_s64(s, 2);
+		scalar_ = base;
+	}
+	// The next four samples' gains
+	[[gnu::always_inline]] int32x4_t next4() {
+		int32x4_t g = vcombine_s32(vshrn_n_s64(acc0_, 32), vshrn_n_s64(acc1_, 32));
+		acc0_ = vaddq_s64(acc0_, step4_);
+		acc1_ = vaddq_s64(acc1_, step4_);
+		scalar_ += step_ << 2;
+		return g;
+	}
+	// The next sample's gain
+	[[gnu::always_inline]] int32_t next() {
+		scalar_ += step_;
+		return (int32_t)(scalar_ >> 32);
+	}
+
+private:
+	int64x2_t acc0_;
+	int64x2_t acc1_;
+	int64x2_t step4_;
+	int64_t step_;
+	int64_t scalar_;
+};
+
+// RampSteps one sample at a time (scalar loops)
+class RampSteps1 {
+public:
+	RampSteps1(int32_t start, int32_t end, int32_t n)
+	    : step_(RampSteps::stepFor(start, end, n)), acc_(((int64_t)start << 32) + ((int64_t)1 << 31)) {}
+	[[gnu::always_inline]] int32_t next() {
+		acc_ += step_;
+		return (int32_t)(acc_ >> 32);
+	}
+
+private:
+	int64_t step_;
+	int64_t acc_;
+};
+
+// The volume stage of a sound, kit row, kit, audio track or the song (ModControllableAudio::
+// processReverbSendAndVolume()): the reverb send and the volume, both ramped from start to end over the block.
+// Per sample:
+//   reverb[i] += multiply_32x32_rshift32(in.l + in.r, send) << 1   (kReverb; as v17, the adds and shift saturating)
+//   o = in * gain / 2^27, rounded (applyMultiplier), per side; out = o (in place) or out += o (kAdd, saturating)
+// kRamp: the volume moves this block (else start == end on both sides, and the loop takes them as constants);
+// kRampSend: the same for the reverb send; kSameSides: both sides ramp the same (no pan), the left's gains serve both
+template <bool kReverb, bool kAdd, bool kRamp, bool kRampSend, bool kSameSides = false>
+[[gnu::always_inline]] inline void volumeAndSend(const StereoSample* in, StereoSample* out, int32_t numSamples,
+                                                 int32_t* reverb, int32_t sendStart, int32_t sendEnd, int32_t startL,
+                                                 int32_t endL, int32_t startR, int32_t endR) {
+	const int32_t s = headroomShift<kVolumeShift>(std::max(std::max(startL, endL), std::max(startR, endR)));
+	const int32x4_t shiftV = vdupq_n_s32(s);
+	const int32x4_t toMultiplier = vdupq_n_s32(31 - kVolumeShift - s);
+	RampSteps rampL(startL, endL, kRamp ? numSamples : 1);
+	RampSteps rampR(startR, endR, kRamp ? numSamples : 1);
+	RampSteps rampSend(sendStart, sendEnd, kRampSend ? numSamples : 1);
+	const int32x4_t constL = vdupq_n_s32(multiplier<kVolumeShift>(endL, s));
+	const int32x4_t constR = vdupq_n_s32(multiplier<kVolumeShift>(endR, s));
+	const int32x4_t constSend = vdupq_n_s32(sendEnd);
+
+	int32_t numBlocks = numSamples >> 2;
+	const int32_t* inW = &in->l;
+	int32_t* outW = &out->l;
+	for (int32_t b = 0; b < numBlocks; b++) {
+		int32x4x2_t x = vld2q_s32(inW); // val[0]: 4 x l, val[1]: 4 x r
+		inW += 8;
+		if constexpr (kReverb) {
+			int32x4_t sendV = kRampSend ? rampSend.next4() : constSend;
+			// smmul on four lanes: the high words of the 64-bit products
+			int32x4_t sum = vqaddq_s32(x.val[0], x.val[1]);
+			int32x4_t lo = vreinterpretq_s32_s64(vmull_s32(vget_low_s32(sum), vget_low_s32(sendV)));
+			int32x4_t hi = vreinterpretq_s32_s64(vmull_s32(vget_high_s32(sum), vget_high_s32(sendV)));
+			int32x4_t send = vqshlq_n_s32(vuzpq_s32(lo, hi).val[1], 1);
+			vst1q_s32(reverb, vqaddq_s32(vld1q_s32(reverb), send));
+			reverb += 4;
+		}
+		// (a ramp's gains made multipliers: shifted left, saturating, as multiplier() does)
+		int32x4_t mL = kRamp ? vqshlq_s32(rampL.next4(), toMultiplier) : constL;
+		int32x4_t mR = kRamp ? (kSameSides ? mL : vqshlq_s32(rampR.next4(), toMultiplier)) : constR;
+		int32x4_t oL = applyMultiplier4(x.val[0], mL, shiftV);
+		int32x4_t oR = applyMultiplier4(x.val[1], mR, shiftV);
+		if constexpr (kAdd) {
+			int32x4x2_t a = vld2q_s32(outW);
+			a.val[0] = vqaddq_s32(a.val[0], oL);
+			a.val[1] = vqaddq_s32(a.val[1], oR);
+			vst2q_s32(outW, a);
+		}
+		else {
+			int32x4x2_t o = {{oL, oR}};
+			vst2q_s32(outW, o);
+		}
+		outW += 8;
+	}
+
+	// The last 0 to 3 samples, one at a time
+	for (int32_t i = numBlocks << 2; i < numSamples; i++) {
+		StereoSample x = in[i];
+		if constexpr (kReverb) {
+			int32_t sendV = kRampSend ? rampSend.next() : sendEnd;
+			int32_t sum = (int32_t)std::clamp<int64_t>((int64_t)x.l + x.r, INT32_MIN, INT32_MAX);
+			int64_t send = ((int64_t)sum * sendV) >> 32;
+			*reverb = (int32_t)std::clamp<int64_t>(*reverb + (send << 1), INT32_MIN, INT32_MAX);
+			reverb++;
+		}
+		int32_t oL = applyMultiplier(x.l, multiplier<kVolumeShift>(kRamp ? rampL.next() : endL, s), s);
+		int32_t oR = applyMultiplier(x.r, multiplier<kVolumeShift>(kRamp ? rampR.next() : endR, s), s);
+		if constexpr (kAdd) {
+			out[i].l = (int32_t)std::clamp<int64_t>((int64_t)out[i].l + oL, INT32_MIN, INT32_MAX);
+			out[i].r = (int32_t)std::clamp<int64_t>((int64_t)out[i].r + oR, INT32_MIN, INT32_MAX);
+		}
+		else {
+			out[i].l = oL;
+			out[i].r = oR;
+		}
+	}
+}
+
+// A sound's pan (Sound::render(), before its effects, as in v17): an interleaved stereo buffer in place, each side
+// times its amplitude (unity 2^30, at most that: no headroom shift), ramped from start to end over the block
+[[gnu::always_inline]] inline void panInPlace(int32_t* buffer, int32_t numSamples, int32_t startL, int32_t endL,
+                                              int32_t startR, int32_t endR) {
+	RampSteps rampL(startL, endL, numSamples);
+	RampSteps rampR(startR, endR, numSamples);
+	const int32x4_t zero = vdupq_n_s32(0);
+	const int32x4_t one = vdupq_n_s32(31 - kPanShift);
+	int32_t numBlocks = numSamples >> 2;
+	int32_t* w = buffer;
+	for (int32_t b = 0; b < numBlocks; b++) {
+		int32x4x2_t x = vld2q_s32(w);
+		x.val[0] = applyMultiplier4(x.val[0], vqshlq_s32(rampL.next4(), one), zero);
+		x.val[1] = applyMultiplier4(x.val[1], vqshlq_s32(rampR.next4(), one), zero);
+		vst2q_s32(w, x);
+		w += 8;
+	}
+	for (int32_t i = numBlocks << 2; i < numSamples; i++) {
+		buffer[2 * i] = applyMultiplier(buffer[2 * i], multiplier<kPanShift>(rampL.next(), 0), 0);
+		buffer[2 * i + 1] = applyMultiplier(buffer[2 * i + 1], multiplier<kPanShift>(rampR.next(), 0), 0);
+	}
+}
+
+// The same for a mono buffer (the first numSamples values) spread to stereo in place, from the end backwards
+[[gnu::always_inline]] inline void panMonoToStereo(int32_t* buffer, int32_t numSamples, int32_t startL, int32_t endL,
+                                                   int32_t startR, int32_t endR) {
+	// Sample i's gains as RampSteps gives them, computed from the end
+	int64_t stepL = RampSteps::stepFor(startL, endL, numSamples);
+	int64_t stepR = RampSteps::stepFor(startR, endR, numSamples);
+	int64_t accL = ((int64_t)startL << 32) + ((int64_t)1 << 31) + stepL * numSamples;
+	int64_t accR = ((int64_t)startR << 32) + ((int64_t)1 << 31) + stepR * numSamples;
+	for (int32_t i = numSamples - 1; i >= 0; i--) {
+		int32_t x = buffer[i];
+		buffer[2 * i] = applyMultiplier(x, multiplier<kPanShift>((int32_t)(accL >> 32), 0), 0);
+		buffer[2 * i + 1] = applyMultiplier(x, multiplier<kPanShift>((int32_t)(accR >> 32), 0), 0);
+		accL -= stepL;
+		accR -= stepR;
+	}
+}
