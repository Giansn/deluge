+			                    rampStep(hpfHPF3Feedback, to.hpfHPF3Feedback, div),
+			                    rampStep(hpfLPF1Feedback, to.hpfLPF1Feedback, div),
+			                    rampStep(divideByTotalMoveability, to.divideByTotalMoveability, div),
+			                    rampStep(hpfDivideByProcessedResonance, to.hpfDivideByProcessedResonance, div),
+			                    rampStep(hpfProcessedResonance, to.hpfProcessedResonance, div),
 			                    0};
 		}
 		[[gnu::always_inline]] inline void step(const Coefficients& d) {
