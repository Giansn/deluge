+
+// A stage of the LP ladders: BasicFilterComponent's one-pole, which can also run with its state carried 32 bits below
+// the q31 LSB (doFilterPrecise(), doAPFPrecise()). BasicFilterComponent rounds the step (input - memory) * moveability
+// to 2 LSB, so the state moves by 4 LSB at the least: at low cutoff (moveability down to about 0.002) a difference
+// below about 500 LSB moves nothing (a dead band), and each sample's rounding adds up in the state, amplified by the
+// pole (by about 1 / moveability). The precise stage adds the exact product to a 64-bit state (smlal), so nothing is
+// lost in the state; only its output is rounded, to 1 LSB, and the next stage filters that.
+// The state is memory:fraction in units of 2^-32 LSB, biased by 2^31 (half an LSB): memory, the high word, is the state
+// rounded to the LSB, what doFilter(), the feedback taps and the next sample's difference read. So both kinds of step
+// share the state: doFilter() leaves fraction as it was (the state then differs from memory by under half an LSB), and
+// all zeroes is still a valid reset (a state of -0.5 LSB).
+class LadderStage {
+public:
+	// As BasicFilterComponent's
+	[[gnu::always_inline]] inline q31_t doFilter(q31_t input, q31_t moveability) {
+		q31_t a = multiply_32x32_rshift32_rounded(input - memory, moveability) << 1;
+		q31_t b = a + memory;
+		memory = b + a;
+		return b;
+	}
+	[[gnu::always_inline]] inline int32_t doAPF(q31_t input, int32_t moveability) {
+		q31_t a = multiply_32x32_rshift32_rounded(input - memory, moveability) << 1;
+		q31_t b = a + memory;
+		memory = a + b;
+		return b * 2 - input;
+	}
+	// moveability2: twice doFilter()'s moveability (under 2^31: the ladder runs this below kPreciseMoveabilityLimit).
+	// doFilter()'s a is (input - memory) * moveability2 / 2^32 here exactly: b = state + a, the new state b + a
+	[[gnu::always_inline]] inline q31_t doFilterPrecise(q31_t input, q31_t moveability2) {
+		uint64_t acc = get();
+		uint64_t a = (uint64_t)((int64_t)(input - memory) * moveability2); // smlal, twice
+		acc += a;
+		q31_t b = (q31_t)(acc >> 32); // b rounded to the LSB (the bias)
+		acc += a;
+		set(acc);
+		return b;
+	}
+	[[gnu::always_inline]] inline int32_t doAPFPrecise(q31_t input, int32_t moveability2) {
+		return doFilterPrecise(input, moveability2) * 2 - input;
+	}
+	[[gnu::always_inline]] inline void reset() {
+		fraction = 0;
+		memory = 0;
+	}
+
+	uint32_t fraction = 0; // the state's low word (2^31 in it is none, the bias)
+	q31_t memory = 0;
+
+private:
+	[[gnu::always_inline]] inline uint64_t get() const { return ((uint64_t)(uint32_t)memory << 32) | fraction; }
+	[[gnu::always_inline]] inline void set(uint64_t acc) {
+		memory = (q31_t)(acc >> 32);
+		fraction = (uint32_t)acc;
+	}
+};
 } // namespace deluge::dsp::filter
