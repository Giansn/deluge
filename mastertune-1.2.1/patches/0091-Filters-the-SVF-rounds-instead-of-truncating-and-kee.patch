+// mastertune v18: getTanHUnknown(x, 3) as the band's saturation, at full resolution and rounded. The same table and
+// straight lines between its entries, but the position between two entries to all 24 bits (getTanHUnknown() drops
+// the lowest 8: x in steps of 32 LSB, floored) and the result rounded (it floored, another -0.5 LSB on average). In
+// the band integrator, twice per sample, those steps were a dead band of 32 LSB and an offset that the low integrator
+// added up: -88 dBFS of DC and a tail stuck at -101 dBFS after the music (svf_precision). Near 0 this is exactly x.
+template <int32_t sat>
+[[gnu::always_inline]] static inline q31_t tanhRounded(q31_t x) {
+	const uint32_t w = (uint32_t)lshiftAndSaturate<sat>(x) + 2147483648u;
+	const uint32_t i = w >> 24;
+	const int32_t f = (int32_t)(w & 0xFFFFFF);
+	// getTanHUnknown(): (table[i] * (65536 - f16) + table[i + 1] * f16) >> (sat + 2), f16 = f >> 8
+	const int64_t v = (int64_t)tanHSmall[i] * (0x1000000 - f) + (int64_t)tanHSmall[i + 1] * f;
+	return (q31_t)((v + ((int64_t)1 << (8 + sat + 1))) >> (8 + sat + 2));
+}
+
+// mastertune v18: every product in the recursion rounds (smmulr) instead of truncating: a truncated product is on
+// average half an LSB too low, which the two integrators (low, band) add up every sample into an offset and, at low
+// cutoff, a dead band of about 1 / fc LSB where the state stops following its input. Rounded, the errors are
+// unbiased, a quarter as large in power. The band's saturation likewise (tanhRounded()). The sums and the output's
+// tripling saturate where they would exceed full scale instead of wrapping to the other end. (tests/filters
+// svf_precision: against a float64 model)
+// One integrator step, state += 2 * x * fc (a product of two q31 values >> 32, doubled). Plain: rounded to the LSB (the
+// fraction left as it is). Precise: exactly, into the state with its fraction (smlal), saturating at full scale
+template <bool precise>
+[[gnu::always_inline]] static inline q31_t integrate(q31_t& value, uint32_t& fraction, q31_t x, q31_t fc) {
+	if constexpr (precise) {
+		int64_t acc = (int64_t)(((uint64_t)(uint32_t)value << 32) | fraction);
+		int64_t sum;
+		if (__builtin_add_overflow(acc, (int64_t)x * (fc * 2), &sum)) {
+			sum = x > 0 ? INT64_MAX : INT64_MIN;
+		}
+		value = (q31_t)(sum >> 32);
+		fraction = (uint32_t)sum;
+	}
+	else {
+		value = addSaturate(value, 2 * multiply_32x32_rshift32_rounded(x, fc));
+	}
+	return value;
+}
+
+// The band's saturation; where it changes the band (beyond where tanhRounded() is exactly x), the fraction goes back to
+// none (half an LSB, the bias)
+template <bool precise>
+[[gnu::always_inline]] static inline q31_t saturateBand(q31_t& band, uint32_t& fraction) {
+	const q31_t t = tanhRounded<3>(band);
+	if constexpr (precise) {
+		if (t != band) {
+			fraction = 2147483648u;
+		}
+	}
+	band = t;
+	return band;
+}
