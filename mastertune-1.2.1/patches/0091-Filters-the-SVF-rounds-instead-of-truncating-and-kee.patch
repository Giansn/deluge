+// mastertune v18: saturating add and subtract (qadd / qsub; on the PC the same, exactly), where a sum can exceed full
+// scale: it clips there instead of wrapping to the other end (a full-scale click)
+[[gnu::always_inline]] inline q31_t addSaturate(q31_t a, q31_t b) {
+#if defined(__arm__)
+	q31_t out;
+	asm("qadd %0, %1, %2" : "=r"(out) : "r"(a), "r"(b));
+	return out;
+#else
+	int64_t s = (int64_t)a + b;
+	return (q31_t)(s > INT32_MAX ? INT32_MAX : s < INT32_MIN ? INT32_MIN : s);
+#endif
+}
+[[gnu::always_inline]] inline q31_t subSaturate(q31_t a, q31_t b) {
+#if defined(__arm__)
+	q31_t out;
+	asm("qsub %0, %1, %2" : "=r"(out) : "r"(a), "r"(b));
+	return out;
+#else
+	int64_t s = (int64_t)a - b;
+	return (q31_t)(s > INT32_MAX ? INT32_MAX : s < INT32_MIN ? INT32_MIN : s);
+#endif
+}
+// The all-pass output 2b - x, saturated (b and x each within full scale, 2b - x up to three times it)
+[[gnu::always_inline]] inline q31_t allPassOutput(q31_t b, q31_t input) {
+	return subSaturate(addSaturate(b, b), input);
+}
