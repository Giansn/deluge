+void TaskManager::delayTask(TaskID id, double seconds) {
+	if (id < 0 || id >= kMaxTasks) {
+		return;
+	}
+	Task* t = &list[id];
+	if (t->handle == nullptr || t->removeAfterUse) {
+		return;
+	}
+	// chooseBestTask() has a task due at lastCallTime + targetInterval - durationStats.average. (runTask() doesn't set
+	// lastCallTime after a call that ignoreForStats() left out.)
+	t->lastCallTime = getSecondsFromStart() + seconds - t->schedule.targetInterval + t->durationStats.average;
