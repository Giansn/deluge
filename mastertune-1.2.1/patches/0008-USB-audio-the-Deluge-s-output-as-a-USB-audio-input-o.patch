+extern "C" {
+#endif
+
+// Selects the USB audio pipe on D0FIFO. Returns whether a buffer of the pipe is free for a packet.
+int usbAudioPipeReady(void);
+// After a write: whether the other half is free too (the pipe stays selected)
+int usbAudioPipeHasRoom(void);
+// Writes one packet into that free buffer and marks it ready to send
+void usbAudioPipeWrite(uint8_t* data, uint16_t numBytes);
+// Whether the computer asked for a packet while none was ready, since the last call
+int usbAudioPipeTakeUnderrun(void);
+// Enables the "buffer free" interrupt and lets the pipe answer IN tokens
+void usbAudioPipeRun(void);
