diff --git a/src/deluge/io/usb/usb_audio_stream.h b/src/deluge/io/usb/usb_audio_stream.h
new file mode 100644
index 00000000..74db7ead
--- /dev/null
+++ b/src/deluge/io/usb/usb_audio_stream.h
@@ -0,0 +1,174 @@
+/*
+ * Copyright © 2026 Synthstrom Audible Limited
+ *
+ * This file is part of The Synthstrom Audible Deluge Firmware.
+ *
+ * The Synthstrom Audible Deluge Firmware is free software: you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software Foundation,
+ * either version 3 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+
+// The ring buffer between the audio engine (producer, main loop) and the USB interrupt (consumer), and the packet
+// sizes of the asynchronous isochronous IN endpoint. No hardware access, so the host test runs the same code.
+//
+// Packet sizes: nominally 44.1 frames per 1 ms USB frame, so nine packets of 44 and one of 45. The Deluge's sample
+// clock and the computer's USB clock drift apart by up to a few hundred ppm, which shows up as a slowly rising or
+// falling fill level of the ring. Every 8 packets at most, one packet takes a frame more or less (45 instead of 44,
+// or 44 instead of 45) while the smoothed level is off target. Packets stay at 44 or 45 frames, which every
+// operating system accepts from an asynchronous endpoint.
+class UsbAudioStream {
+public:
+	static constexpr uint32_t kRingFrames = 2048; // 46 ms; a power of two
+	static constexpr uint32_t kRingMask = kRingFrames - 1;
+	static constexpr int32_t kTargetFrames = 256; // fill level to steer towards: 5.8 ms
+	static constexpr int32_t kHysteresisFrames = 32;
+	static constexpr int32_t kResyncAboveFrames = 1024;  // far above any level in normal running
+	static constexpr uint32_t kNudgeIntervalPackets = 8; // up to ~2000 ppm of clock difference
+
+	static constexpr uint32_t kBytesPerFrame = 6; // two channels of 3 bytes
+	static constexpr uint32_t kMaxPacketFrames = 45;
+	static constexpr uint32_t kMaxPacketBytes = kMaxPacketFrames * kBytesPerFrame;
+
+	// Main loop, while the consumer is idle: starts over with kTargetFrames of silence in the ring
+	void start() {
+		uint32_t w = writeIndex.load(std::memory_order_relaxed);
+		for (int32_t i = 0; i < kTargetFrames; i++) {
+			uint32_t slot = (w + i) & kRingMask;
+			ring[slot * 2] = 0;
+			ring[slot * 2 + 1] = 0;
+		}
+		readIndex.store(w, std::memory_order_relaxed);
+		writeIndex.store(w + kTargetFrames, std::memory_order_release);
+		tenths = 0;
+		levelAverage = kTargetFrames << 8;
+		packetsSinceNudge = 0;
+		rebuffering = false;
+		running = true;
+	}
+
+	void stop() { running = false; }
+	bool isRunning() const { return running; }
+
+	// Producer: frames interleaved left/right, 24 bits in the top of 32, as sent to the codec. Frames that don't fit
+	// are dropped; that only happens when the computer has stopped reading.
+	void push(const int32_t* frames, int32_t numFrames) {
+		if (!running || numFrames <= 0) {
+			return;
+		}
+		uint32_t w = writeIndex.load(std::memory_order_relaxed);
+		uint32_t r = readIndex.load(std::memory_order_acquire);
+		uint32_t space = kRingFrames - (w - r);
+		uint32_t n = (uint32_t)numFrames;
+		if (n > space) {
+			droppedFrames += n - space;
+			n = space;
+		}
+		for (uint32_t i = 0; i < n; i++) {
+			uint32_t slot = (w + i) & kRingMask;
+			ring[slot * 2] = frames[i * 2];
+			ring[slot * 2 + 1] = frames[i * 2 + 1];
+		}
+		writeIndex.store(w + n, std::memory_order_release);
+	}
+
+	// Consumer: writes the next packet, 3 bytes per sample, little endian, and returns its length in bytes
+	uint32_t takePacket(uint8_t* out) {
+		uint32_t w = writeIndex.load(std::memory_order_acquire);
+		uint32_t r = readIndex.load(std::memory_order_relaxed);
+		int32_t level = (int32_t)(w - r);
+
+		// The computer stopped reading for a while (the ring filled up and the newest frames got dropped): everything
+		// in the ring is stale. Throw it away and start over with the usual reserve of new frames.
+		if (level > kResyncAboveFrames) {
+			r = w;
+			level = 0;
+			levelAverage = kTargetFrames << 8;
+			rebuffering = true;
+			resyncs++;
+		}
+
+		tenths += 441;
+		uint32_t n = tenths / 10;
+		tenths -= n * 10;
+
+		levelAverage += ((level << 8) - levelAverage) >> 4; // smoothed over about 16 ms
+		if (++packetsSinceNudge >= kNudgeIntervalPackets) {
+			int32_t average = levelAverage >> 8;
+			if (average > kTargetFrames + kHysteresisFrames && n == 44) {
+				n = 45;
+				packetsSinceNudge = 0;
+			}
+			else if (average < kTargetFrames - kHysteresisFrames && n == 45) {
+				n = 44;
+				packetsSinceNudge = 0;
+			}
+		}
+
+		// After running dry, send silence until the usual reserve has built up again, rather than a click with every
+		// packet
+		if (level < (int32_t)n) {
+			rebuffering = true;
+		}
+		else if (rebuffering && level >= kTargetFrames) {
+			rebuffering = false;
+			levelAverage = level << 8;
+		}
+		if (rebuffering) {
+			std::memset(out, 0, n * kBytesPerFrame);
+			silentFrames += n;
+			readIndex.store(r, std::memory_order_release);
+			return n * kBytesPerFrame;
+		}
+
+		uint8_t* p = out;
+		for (uint32_t i = 0; i < n; i++) {
+			uint32_t slot = (r + i) & kRingMask;
+			put24(p, ring[slot * 2]);
+			put24(p + 3, ring[slot * 2 + 1]);
+			p += kBytesPerFrame;
+		}
+		readIndex.store(r + n, std::memory_order_release);
+		return n * kBytesPerFrame;
+	}
+
+	int32_t level() const {
+		return (int32_t)(writeIndex.load(std::memory_order_acquire) - readIndex.load(std::memory_order_acquire));
+	}
+
+	// Statistics, for tests
+	uint32_t droppedFrames = 0;
+	uint32_t silentFrames = 0;
+	uint32_t resyncs = 0;
+
+private:
+	static void put24(uint8_t* p, int32_t sample) {
+		int32_t s = sample >> 8;
+		p[0] = (uint8_t)s;
+		p[1] = (uint8_t)(s >> 8);
+		p[2] = (uint8_t)(s >> 16);
+	}
+
+	int32_t ring[kRingFrames * 2] = {};
+	std::atomic<uint32_t> writeIndex{0};
+	std::atomic<uint32_t> readIndex{0};
+	volatile bool running = false;
+
+	// Consumer state
+	uint32_t tenths = 0;
+	int32_t levelAverage = 0; // in 1/256 frames
+	uint32_t packetsSinceNudge = 0;
+	bool rebuffering = false;
+};
