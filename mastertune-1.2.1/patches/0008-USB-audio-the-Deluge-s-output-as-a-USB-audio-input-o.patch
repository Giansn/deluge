 #include "RZA1/usb/r_usb_basic/src/hw/inc/r_usb_bitdefine.h"
 #include "RZA1/usb/r_usb_basic/src/hw/inc/r_usb_reg_access.h"
+#include "deluge/io/usb/usb_audio.h"
 
 /***********************************************************************************************************************
  Exported global variables (to be accessed by other files)
@@ -149,6 +150,30 @@ int usb_pstd_interrupt_handler(uint16_t* type, uint16_t* status)
         // uint16_t bsts  = (uint16_t)(brdysts & brdyenb);
         uint16_t bsts = brdysts;
 
+        // mastertune-v8: PIPE1 carries the USB audio stream. A free buffer gets its next packet right here, and the
+        // event must never reach the queue, whose handler takes every BRDY for MIDI.
+        if (usbAudioEnabled && (bsts & USB_BRDY1))
+        {
+#if USB_CFG_USE_USBIP == USB_CFG_IP0
+            USB200.BRDYSTS = (uint16_t)~USB_BRDY1;
+#else  /* USB_CFG_USE_USBIP == USB_CFG_IP1 */
+            USB201.BRDYSTS = (uint16_t)~USB_BRDY1;
+#endif /* USB_CFG_USE_USBIP == USB_CFG_IP1 */
+            usbAudioInBufferReady();
+            // Only pipes whose BRDY interrupt is on may go on to the queue: the MIDI send pipe and the DCP leave stale
+            // BRDY bits behind, which used to come along only with a real MIDI receive, but would now arrive with
+            // every PIPE1 interrupt and make the MIDI handler read an empty pipe (and stop receiving for good)
+#if USB_CFG_USE_USBIP == USB_CFG_IP0
+            bsts &= (uint16_t)(~USB_BRDY1) & USB200.BRDYENB;
+#else  /* USB_CFG_USE_USBIP == USB_CFG_IP1 */
+            bsts &= (uint16_t)(~USB_BRDY1) & USB201.BRDYENB;
+#endif /* USB_CFG_USE_USBIP == USB_CFG_IP1 */
+            if (bsts == 0u)
+            {
+                return 1; // All dealt with
+            }
+        }
+
         // Pipe 0
         if (bsts & USB_BRDY0)
         {
@@ -194,6 +219,11 @@ int usb_pstd_interrupt_handler(uint16_t* type, uint16_t* status)
 #endif
         // uint16_t nsts  = (uint16_t)(nrdysts & nrdyenb);
         uint16_t nsts = nrdysts;
+        // mastertune-v8: leave PIPE1's bit for the USB audio code, which counts it as a gap in the stream
+        if (usbAudioEnabled)
+        {
+            nsts &= (uint16_t)~USB_NRDY1;
+        }
 
         // Ok, disregard everything else below - NRDY interrupts never actually need dealing with - unless we have ISO
         // endpoints, which MIDI never does. We'll just clear the interrupt and get out. I've actually disabled NRDY
