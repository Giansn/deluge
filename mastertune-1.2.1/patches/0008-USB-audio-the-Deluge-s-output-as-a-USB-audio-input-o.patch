index 00000000..9335a471
--- /dev/null
+++ b/src/deluge/io/usb/usb_audio.cpp
@@ -0,0 +1,118 @@
+/*
+ * Copyright © 2026 Synthstrom Audible Limited
+ *
+ * This file is part of The Synthstrom Audible Deluge Firmware.
+ *
+ * The Synthstrom Audible Deluge Firmware is free software: you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software Foundation,
+ * either version 3 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "io/usb/usb_audio.h"
+#include "gui/l10n/l10n.h"
+#include "hid/display/display.h"
+#include "io/usb/usb_audio_pipe.h"
+#include "io/usb/usb_audio_stream.h"
+
+namespace AudioEngine {
+extern uint32_t audioSampleTimer;
+}
+
+namespace {
+
+UsbAudioStream stream;
+
+// Set by the main loop once the pipe is primed, cleared before it gets stopped. While set, the USB interrupt writes
+// a packet each time a buffer of the pipe is free.
+volatile bool pipeRunning = false;
+
+uint32_t packetBuffer[(UsbAudioStream::kMaxPacketBytes + 3) / 4];
+
+volatile uint32_t underruns = 0;
+
+void writeOnePacket() {
+	uint32_t numBytes = stream.takePacket(reinterpret_cast<uint8_t*>(packetBuffer));
+	usbAudioPipeWrite(reinterpret_cast<uint8_t*>(packetBuffer), (uint16_t)numBytes);
+}
+
+// Fills whatever halves of the double buffer are free. Usually that's one per interrupt, but the Deluge renders each
+// track with interrupts off, and if that took over a millisecond, both halves have gone out and their interrupts
+// arrive as one.
+void writePackets() {
+	if (!usbAudioPipeReady()) {
+		return; // Both halves still wait to be sent; the frames stay in the ring for the next packet
+	}
+	writeOnePacket();
+	if (usbAudioPipeHasRoom()) {
+		writeOnePacket();
+	}
+}
+
+} // namespace
+
+extern "C" {
+
+void usbAudioStart(void) {
+	usbAudioStop();
+	stream.start();
+	// Fill both halves of the double buffer before the pipe answers IN tokens, so the interrupt always has a packet
+	// in reserve. The pipe still NAKs here, so nothing gets sent and no buffer frees up in between.
+	writePackets();
+	usbAudioPipeTakeUnderrun(); // Forget anything left over from before
+	pipeRunning = true;
+	usbAudioPipeRun();
+}
+
+void usbAudioStop(void) {
+	if (!pipeRunning && !stream.isRunning()) {
+		return;
+	}
+	pipeRunning = false;
+	stream.stop();
+	usbAudioPipeHalt();
+}
+
+void usbAudioInBufferReady(void) {
+	if (pipeRunning) {
+		if (usbAudioPipeTakeUnderrun()) {
+			underruns = underruns + 1;
+		}
+		writePackets();
+	}
+}
+
+uint32_t usbAudioGetUnderruns(void) {
+	return underruns;
+}
+
+void usbAudioReportGaps(void) {
+	static uint32_t reported = 0;
+	static uint32_t lastPopupTime = 0;
+	static bool anyPopupYet = false;
+	uint32_t now = AudioEngine::audioSampleTimer;
+	uint32_t count = underruns;
+	if (count == reported) {
+		return;
+	}
+	// At most one notice every 10 seconds
+	if (anyPopupYet && now - lastPopupTime < 10 * 44100) {
+		return;
+	}
+	reported = count;
+	lastPopupTime = now;
+	anyPopupYet = true;
+	display->displayPopup(deluge::l10n::get(deluge::l10n::String::STRING_FOR_USB_AUDIO_GAP));
+}
+
+void usbAudioPushFrames(const int32_t* frames, int32_t numFrames) {
+	stream.push(frames, numFrames);
+}
+
+} // extern "C"
diff --git a/src/deluge/io/usb/usb_audio.h b/src/deluge/io/usb/usb_audio.h
new file mode 100644
index 00000000..8c710c6e
--- /dev/null
+++ b/src/deluge/io/usb/usb_audio.h
@@ -0,0 +1,68 @@
+/*
+ * Copyright © 2026 Synthstrom Audible Limited
+ *
+ * This file is part of The Synthstrom Audible Deluge Firmware.
+ *
+ * The Synthstrom Audible Deluge Firmware is free software: you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software Foundation,
+ * either version 3 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+// The Deluge as a USB audio device (USB Audio Class 1.0, full speed): its output goes to the computer as a stereo,
+// 24-bit, 44.1 kHz recording input, next to the usual USB MIDI. Off unless switched on in the community features,
+// and then only when the Deluge is a USB peripheral at boot.
+//
+// Data path: the audio engine hands every block it sends to the codec to usbAudioPushFrames() (main loop). The frames
+// wait in a ring buffer, and the USB interrupt takes a packet out of it each millisecond, when the isochronous IN pipe
+// (PIPE1, endpoint 3) has room again. The packet size follows the Deluge's own sample clock (asynchronous endpoint):
+// 44 or 45 frames, nudged by the fill level of the ring, so the computer needs no feedback endpoint.
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Interface numbers in the configuration with audio
+#define USB_AUDIO_CONTROL_INTERFACE 0
+#define USB_AUDIO_MIDI_INTERFACE 1
+#define USB_AUDIO_STREAMING_INTERFACE 2
+
+// Whether this boot enumerates with the audio interface. Set before openUSBPeripheral(), then fixed.
+extern uint8_t usbAudioEnabled;
+
+// Called before openUSBPeripheral() to choose the descriptors
+void usbAudioSetEnabled(uint8_t enabled);
+uint8_t* usbAudioDeviceDescriptor(void);
+uint8_t* usbAudioConfigurationDescriptor(void);
+uint16_t* usbAudioPipeTable(void);
+
+// USB driver hooks (main loop, from the standard request and state handling). Start once the driver has configured
+// PIPE1 for alternate setting 1 of the streaming interface; stop on alternate setting 0, reset, detach and any
+// configuration change.
+void usbAudioStart(void);
+void usbAudioStop(void);
+
+// USB interrupt: a buffer of the isochronous IN pipe is free again
+void usbAudioInBufferReady(void);
+
+// How often the computer got an empty packet because none was ready (a gap in its recording)
+uint32_t usbAudioGetUnderruns(void);
+// Main loop, twice a second: shows a short notice when there were new gaps
+void usbAudioReportGaps(void);
+
+// Audio engine (main loop): the frames just sent to the codec, interleaved left/right, 24 bits in the top of 32
+void usbAudioPushFrames(const int32_t* frames, int32_t numFrames);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/deluge/io/usb/usb_audio_descriptor.c b/src/deluge/io/usb/usb_audio_descriptor.c
new file mode 100644
index 00000000..b0407bee
--- /dev/null
+++ b/src/deluge/io/usb/usb_audio_descriptor.c
@@ -0,0 +1,161 @@
+/*
+ * Copyright © 2026 Synthstrom Audible Limited
+ *
+ * This file is part of The Synthstrom Audible Deluge Firmware.
+ *
+ * The Synthstrom Audible Deluge Firmware is free software: you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software Foundation,
+ * either version 3 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+// Descriptors and pipe table for the configuration with USB audio (see usb_audio.h). Without USB audio, the Deluge
+// keeps its MIDI-only descriptors in io/midi/r_usb_pmidi_descriptor.c unchanged.
+//
+// One audio function, USB Audio Class 1.0, no interface association descriptor (UAC1 groups its interfaces through
+// the AudioControl header, which Windows, macOS and Linux all follow):
+//   interface 0: AudioControl. Input terminal (the Deluge's output, a line connector) -> output terminal (USB
+//                streaming). No feature unit, so the computer has no volume or mute to set and sends no class requests.
+//   interface 1: MIDIStreaming, byte for byte the Deluge's usual MIDI interface.
+//   interface 2: AudioStreaming. Alternate setting 0 without endpoint, 1 with the isochronous IN endpoint 3:
+//                asynchronous, stereo, 24 bits in 3 bytes, 44.1 kHz only.
+// The MIDI interface comes before the audio stream, so the MIDI endpoints keep the first two entries of the pipe table
+// (PIPE2 and PIPE3, as always) and the audio endpoint takes the third (PIPE1).
+
+#include "RZA1/usb/r_usb_basic/r_usb_basic_if.h"
+#include "RZA1/usb/r_usb_basic/src/driver/inc/r_usb_basic_define.h"
+#include "RZA1/usb/r_usb_basic/src/driver/inc/r_usb_typedef.h"
+#include "io/usb/usb_audio.h"
+#include <string.h>
+
+extern uint8_t g_midi_device[];
+extern uint8_t g_midi_configuration[];
+extern uint16_t g_usb_pstd_eptbl[];
+
+// A different device release with audio, so a computer that keeps settings per device revision sets the device up
+// afresh when USB audio is switched on or off
+#define USB_AUDIO_BCD_DEVICE 0x0201
+
+#define USB_AUDIO_SAMPLE_RATE 44100
+#define USB_AUDIO_MAX_PACKET_SIZE (46 * 6) // 46 frames of 2 x 3 bytes; the Deluge sends 44 or 45
+
+#define CS_INTERFACE 0x24
+#define CS_ENDPOINT 0x25
+
+static const uint8_t audioControlInterface[] = {
+    // Standard AudioControl interface
+    9, USB_DT_INTERFACE, USB_AUDIO_CONTROL_INTERFACE, 0, 0, 0x01 /* AUDIO */, 0x01 /* AUDIOCONTROL */, 0, 0,
+    // Class-specific AC interface header: ADC 1.00, total length 10 + 12 + 9, two streaming interfaces
+    10, CS_INTERFACE, 0x01 /* HEADER */, 0x00, 0x01, 31, 0, 2, USB_AUDIO_MIDI_INTERFACE, USB_AUDIO_STREAMING_INTERFACE,
+    // Input terminal 1: line connector, two channels, left front and right front
+    12, CS_INTERFACE, 0x02 /* INPUT_TERMINAL */, 1, 0x03, 0x06, 0, 2, 0x03, 0x00, 0, 0,
+    // Output terminal 2: USB streaming, fed by terminal 1
+    9, CS_INTERFACE, 0x03 /* OUTPUT_TERMINAL */, 2, 0x01, 0x01, 0, 1, 0};
+
+static const uint8_t audioStreamingInterface[] = {
+    // Alternate setting 0: no bandwidth
+    9, USB_DT_INTERFACE, USB_AUDIO_STREAMING_INTERFACE, 0, 0, 0x01 /* AUDIO */, 0x02 /* AUDIOSTREAMING */, 0, 0,
+    // Alternate setting 1: streaming
+    9, USB_DT_INTERFACE, USB_AUDIO_STREAMING_INTERFACE, 1, 1, 0x01 /* AUDIO */, 0x02 /* AUDIOSTREAMING */, 0, 0,
+    // Class-specific AS general: linked to terminal 2, 1 frame delay, PCM
+    7, CS_INTERFACE, 0x01 /* AS_GENERAL */, 2, 1, 0x01, 0x00,
+    // Type I format: 2 channels, 3-byte subframes, 24 bits, one sample rate
+    11, CS_INTERFACE, 0x02 /* FORMAT_TYPE */, 0x01 /* FORMAT_TYPE_I */, 2, 3, 24, 1, (uint8_t)(USB_AUDIO_SAMPLE_RATE),
+    (uint8_t)(USB_AUDIO_SAMPLE_RATE >> 8), (uint8_t)(USB_AUDIO_SAMPLE_RATE >> 16),
+    // Standard endpoint (audio class form with bRefresh and bSynchAddress): endpoint 3 IN, isochronous, asynchronous,
+    // every frame
+    9, USB_DT_ENDPOINT, (uint8_t)(USB_EP_IN | USB_EP3), 0x05, (uint8_t)(USB_AUDIO_MAX_PACKET_SIZE),
+    (uint8_t)(USB_AUDIO_MAX_PACKET_SIZE >> 8), 1, 0, 0,
+    // Class-specific endpoint: no sampling frequency or pitch control, no lock delay
+    7, CS_ENDPOINT, 0x01 /* EP_GENERAL */, 0x00, 0, 0, 0};
+
+static uint8_t audioDevice[USB_DD_BLENGTH + (USB_DD_BLENGTH % 2)] __attribute__((aligned(4)));
+static uint8_t audioConfiguration[256] __attribute__((aligned(4)));
+
+// The MIDI pipes as usual, then PIPE1 for the audio stream. Type, direction, endpoint and packet size come from the
+// endpoint descriptor when the driver reads the configuration, as for the MIDI pipes.
+static uint16_t audioPipeTable[3 * USB_EPL + 1];
+static const uint16_t audioPipe[USB_EPL] = {
+    USB_PIPE1,
+    USB_BFREOFF | USB_CFG_DBLBON | USB_CFG_CNTMDOFF,  /* PIPECFG: double buffered */
+    (uint16_t)USB_BUF_SIZE(320u) | USB_BUF_NUMB(24u), /* PIPEBUF: blocks 24 to 33, between the two MIDI pipes' */
+    USB_NULL,                                         /* PIPEMAXP */
+    USB_IFISOFF,                                      /* PIPEPERI */
+    USB_NULL,                                         /* reserve */
+};
+
+uint8_t usbAudioEnabled = 0;
+
+// Returns 0 if the MIDI descriptors don't look as expected, in which case USB audio stays off
+static int buildDescriptors(void) {
+	// Device: the MIDI one with its own release number
+	memcpy(audioDevice, g_midi_device, USB_DD_BLENGTH);
+	audioDevice[12] = (uint8_t)(USB_AUDIO_BCD_DEVICE & 0xFF);
+	audioDevice[13] = (uint8_t)(USB_AUDIO_BCD_DEVICE >> 8);
+
+	// Configuration: header, AudioControl, the MIDI interface, AudioStreaming
+	uint16_t midiTotal = (uint16_t)(g_midi_configuration[2] | (g_midi_configuration[3] << 8));
+	uint8_t configLength = g_midi_configuration[0];
+	uint8_t* midiInterface = g_midi_configuration + configLength;
+	if (configLength != 9 || midiTotal <= configLength || midiInterface[1] != USB_DT_INTERFACE
+	    || g_midi_configuration[4] != 1) {
+		return 0;
+	}
+	uint16_t midiLength = (uint16_t)(midiTotal - configLength);
+	uint16_t total =
+	    (uint16_t)(configLength + sizeof(audioControlInterface) + midiLength + sizeof(audioStreamingInterface));
+	if (total > sizeof(audioConfiguration)) {
+		return 0;
+	}
+
+	uint8_t* p = audioConfiguration;
+	memcpy(p, g_midi_configuration, configLength);
+	p[2] = (uint8_t)(total & 0xFF);
+	p[3] = (uint8_t)(total >> 8);
+	p[4] = 3; // bNumInterfaces
+	p += configLength;
+	memcpy(p, audioControlInterface, sizeof(audioControlInterface));
+	p += sizeof(audioControlInterface);
+	memcpy(p, midiInterface, midiLength);
+	p[2] = USB_AUDIO_MIDI_INTERFACE; // bInterfaceNumber
+	p += midiLength;
+	memcpy(p, audioStreamingInterface, sizeof(audioStreamingInterface));
+
+	// Pipe table: the MIDI entries (exactly two, in the order of their endpoint descriptors), then the audio pipe
+	int numEntries = 0;
+	while (g_usb_pstd_eptbl[numEntries * USB_EPL] != USB_PDTBLEND) {
+		numEntries++;
+		if (numEntries > 2) {
+			return 0;
+		}
+	}
+	if (numEntries != 2) {
+		return 0;
+	}
+	memcpy(audioPipeTable, g_usb_pstd_eptbl, 2 * USB_EPL * sizeof(uint16_t));
+	memcpy(audioPipeTable + 2 * USB_EPL, audioPipe, sizeof(audioPipe));
+	audioPipeTable[3 * USB_EPL] = USB_PDTBLEND;
+	return 1;
+}
+
+void usbAudioSetEnabled(uint8_t enabled) {
+	usbAudioEnabled = (enabled && buildDescriptors()) ? 1 : 0;
+}
+
+uint8_t* usbAudioDeviceDescriptor(void) {
+	return usbAudioEnabled ? audioDevice : g_midi_device;
+}
+
+uint8_t* usbAudioConfigurationDescriptor(void) {
+	return usbAudioEnabled ? audioConfiguration : g_midi_configuration;
+}
+
+uint16_t* usbAudioPipeTable(void) {
+	return usbAudioEnabled ? audioPipeTable : g_usb_pstd_eptbl;
+}
diff --git a/src/deluge/io/usb/usb_audio_pipe.c b/src/deluge/io/usb/usb_audio_pipe.c
new file mode 100644
index 00000000..8fbb064f
--- /dev/null
+++ b/src/deluge/io/usb/usb_audio_pipe.c
@@ -0,0 +1,81 @@
+/*
+ * Copyright © 2026 Synthstrom Audible Limited
+ *
+ * This file is part of The Synthstrom Audible Deluge Firmware.
+ *
+ * The Synthstrom Audible Deluge Firmware is free software: you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software Foundation,
+ * either version 3 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+// Register access for the USB audio pipe (PIPE1, isochronous IN, endpoint 3), in C so it can use the Renesas driver's
+// headers and helpers. The pipe goes through the D0FIFO port with CPU access: USB DMA is off in this firmware, and
+// MIDI uses CFIFO from the main loop, so the USB interrupt can fill D0FIFO at any time without getting in its way.
+
+#include "io/usb/usb_audio_pipe.h"
+#include "RZA1/system/iodefine.h"
+#include "RZA1/usb/r_usb_basic/r_usb_basic_if.h"
+#include "RZA1/usb/r_usb_basic/src/driver/inc/r_usb_extern.h"
+#include "RZA1/usb/r_usb_basic/src/driver/inc/r_usb_typedef.h"
+#include "RZA1/usb/r_usb_basic/src/hw/inc/r_usb_bitdefine.h"
+#include "RZA1/usb/r_usb_basic/src/hw/inc/r_usb_reg_access.h"
+
+int usbAudioPipeReady(void) {
+	// PIPE1 on D0FIFO, 32-bit access, no DMA request, little endian
+	USB200.D0FIFOSEL = (uint16_t)(USB_MBW_32 | USB_PIPE1);
+	int i;
+	for (i = 0; (USB200.D0FIFOSEL & USB_CURPIPE) != USB_PIPE1; i++) {
+		if (i >= 100) {
+			return 0;
+		}
+	}
+	// FRDY: a buffer of the pipe is free for the CPU (not the case while both halves are still waiting to be sent)
+	for (i = 0; !(USB200.D0FIFOCTR & USB_FRDY); i++) {
+		if (i >= 100) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+int usbAudioPipeHasRoom(void) {
+	return (USB200.D0FIFOCTR & USB_FRDY) ? 1 : 0;
+}
+
+int usbAudioPipeTakeUnderrun(void) {
+	// NRDY: an IN token found both halves empty, so the computer got an empty packet. The status bit gets set whether
+	// or not the NRDY interrupt is on (it's off for this pipe).
+	if (USB200.NRDYSTS & USB_NRDY1) {
+		USB200.NRDYSTS = (uint16_t)~USB_NRDY1;
+		return 1;
+	}
+	return 0;
+}
+
+void usbAudioPipeWrite(uint8_t* data, uint16_t numBytes) {
+	usb_pstd_write_fifo(numBytes, USB_D0USE, data);
+	// Every packet is shorter than the endpoint's maximum packet size, so it has to be marked as complete
+	hw_usb_set_bval(USB_NULL, USB_D0USE);
+}
+
+void usbAudioPipeRun(void) {
+	hw_usb_set_brdyenb(USB_NULL, USB_PIPE1);
+	hw_usb_set_pid(USB_NULL, USB_PIPE1, USB_PID_BUF);
+}
+
+void usbAudioPipeHalt(void) {
+	hw_usb_clear_brdyenb(USB_NULL, USB_PIPE1);
+	hw_usb_set_pid(USB_NULL, USB_PIPE1, USB_PID_NAK);
+	// Release PIPE1 from D0FIFO so the driver can reconfigure it, and drop what's still in its buffers
+	USB200.D0FIFOSEL = 0;
+	hw_usb_set_aclrm(USB_NULL, USB_PIPE1);
+	hw_usb_clear_aclrm(USB_NULL, USB_PIPE1);
+	USB200.BRDYSTS = (uint16_t)~USB_BRDY1;
+}
