diff --git a/src/RZA1/usb/r_usb_basic/src/driver/r_usb_pstdrequest.c b/src/RZA1/usb/r_usb_basic/src/driver/r_usb_pstdrequest.c
index 5f8a4efa..8d23b480 100644
--- a/src/RZA1/usb/r_usb_basic/src/driver/r_usb_pstdrequest.c
+++ b/src/RZA1/usb/r_usb_basic/src/driver/r_usb_pstdrequest.c
@@ -30,6 +30,8 @@
  ***********************************************************************************************************************/
 #include "RZA1/usb/r_usb_basic/r_usb_basic_if.h"
 #include "RZA1/usb/r_usb_basic/src/driver/inc/r_usb_extern.h"
+#include "deluge/drivers/usb/userdef/r_usb_pmidi_config.h"
+#include "deluge/io/usb/usb_audio.h"
 #include "RZA1/usb/r_usb_basic/src/driver/inc/r_usb_typedef.h"
 #include "RZA1/usb/r_usb_basic/src/hw/inc/r_usb_bitdefine.h"
 #include "RZA1/usb/r_usb_basic/src/hw/inc/r_usb_reg_access.h"
@@ -1129,6 +1131,13 @@ static void usb_pstd_set_configuration3(void)
             usb_cstd_set_buf(USB_NULL, (uint16_t)USB_PIPE0);
             cfgok = USB_OK;
 
+            // mastertune-v8: a configuration change ends the audio stream and puts its interface back to setting 0
+            if (usbAudioEnabled)
+            {
+                usbAudioStop();
+                g_usb_pstd_alt_num[USB_AUDIO_STREAMING_INTERFACE] = 0;
+            }
+
             if ((g_usb_pstd_req_value > 0) && (g_usb_pstd_req_value != g_usb_pstd_config_num))
             {
                 usb_pstd_clr_eptbl_index();
@@ -1188,6 +1197,46 @@ static void usb_pstd_set_interface3(void)
 {
     uint16_t* p_table;
 
+    // mastertune-v8: with USB audio there's more than one interface. The Renesas code below forgets the endpoints of
+    // all other interfaces and (re)initialises every pipe it still knows, which would cut into MIDI transfers. Here only
+    // the interface that changes is touched: for the audio stream, PIPE1 gets configured and started, or stopped.
+    if (usbAudioEnabled)
+    {
+        uint16_t interface_num = g_usb_pstd_req_index;
+        uint16_t alt           = (uint16_t)(g_usb_pstd_req_value & USB_ALT_SET);
+        if ((USB_TRUE == usb_pstd_chk_configured()) && (USB_INTERFACE == (g_usb_pstd_req_type & USB_BMREQUESTTYPERECIP))
+            && (interface_num < usb_pstd_get_interface_num(g_usb_pstd_config_num)) && (0 == g_usb_pstd_req_length)
+            && (alt <= usb_pstd_get_alternate_num(g_usb_pstd_config_num, interface_num)))
+        {
+            g_usb_pstd_alt_num[interface_num] = alt;
+            usb_cstd_set_buf(USB_NULL, (uint16_t)USB_PIPE0);
+            if (USB_AUDIO_STREAMING_INTERFACE == interface_num)
+            {
+                usbAudioStop();
+                /* Endpoint 3 IN exists only in setting 1 */
+                g_usb_pstd_eptbl_index[1][USB_EP3] = USB_ERROR;
+                usb_pstd_set_eptbl_index(g_usb_pstd_config_num, interface_num, alt);
+                if (USB_ERROR != g_usb_pstd_eptbl_index[1][USB_EP3])
+                {
+                    usb_pstd_set_pipe_register((uint16_t)USB_PIPE1, g_usb_pstd_driver.p_pipetbl);
+                    usbAudioStart();
+                }
+            }
+            else if (USB_AUDIO_MIDI_INTERFACE == interface_num)
+            {
+                /* As in MIDI-only mode: the interface's pipes start over, with their data toggles reset */
+                usb_pstd_set_pipe_register((uint16_t)USB_CFG_PMIDI_BULK_IN, g_usb_pstd_driver.p_pipetbl);
+                usb_pstd_set_pipe_register((uint16_t)USB_CFG_PMIDI_BULK_OUT, g_usb_pstd_driver.p_pipetbl);
+            }
+        }
+        else
+        {
+            /* Request error */
+            usb_pstd_set_stall_pipe0();
+        }
+        return;
+    }
+
     /* Configured ? */
     if ((USB_TRUE == usb_pstd_chk_configured()) && ((USB_INTERFACE == g_usb_pstd_req_type & USB_BMREQUESTTYPERECIP)))
     {
diff --git a/src/RZA1/usb/r_usb_basic/src/hw/r_usb_preg_abs.c b/src/RZA1/usb/r_usb_basic/src/hw/r_usb_preg_abs.c
