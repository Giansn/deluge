+// The output from the last block's gain compensation to this one's (see renderLongStereo()), where it changed by more
+// than 1 in 2^20 (0.00001 dB; the division's rounding alone moves it by less, so a block whose filters' configuration
+// stays renders exactly as before). Q2.29 factor from last / now to 1, applied per frame
+void FilterSet::rampGainCompensation(q31_t* startSample, q31_t* endSample) {
+	float last = renderedGainCompensation_;
+	bool had = haveRenderedGain_;
+	renderedGainCompensation_ = gainCompensation_;
+	haveRenderedGain_ = true;
+	if (!had || gainCompensation_ <= 0.0f || last <= 0.0f) {
+		return;
+	}
+	float ratio = last / gainCompensation_;
+	if (std::fabs(ratio - 1.0f) < (1.0f / 1048576.0f)) {
+		return;
+	}
+	ratio = std::clamp(ratio, 0.25f, 3.99f);
+	constexpr q31_t kOne = 1 << 29;
+	int32_t frames = (int32_t)(endSample - startSample) >> 1;
+	if (frames <= 0) {
+		return;
+	}
+	q31_t factor = (q31_t)(ratio * (float)kOne);
+	q31_t step = (kOne - factor) / frames;
+	q31_t* sample = startSample;
+	do {
+		factor += step;
+		sample[0] = lshiftAndSaturate<3>(multiply_32x32_rshift32_rounded(sample[0], factor));
+		sample[1] = lshiftAndSaturate<3>(multiply_32x32_rshift32_rounded(sample[1], factor));
+		sample += 2;
+	} while (sample < endSample);
+}
