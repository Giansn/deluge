+	}
 	else if (!strcmp(tagName, "lastLockedNoteProb")) {
 		lastLockedNoteProbabilityParameterValue = reader.readTagOrAttributeValueInt();
 	}
@@ -1983,6 +2011,8 @@ void ArpeggiatorSettings::writeCommonParamsToFile(Serializer& writer, Song* song
 	writer.writeAttribute("randomizerLock", randomizerLock);
 	writer.writeAttribute("latch", latch);
 	writer.writeAttribute("ratchetBounce", ratchetBounce);
+	writer.writeAttribute("ratchetBounceFade", ratchetBounceFade);
