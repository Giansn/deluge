-	if (isRatcheting) {
+	if (isRatcheting && fixedNumberOfNotes) {
+		// Always the chosen number of notes, except where the step is too short to divide that finely: at most 2 at
+		// 128th and 256th (triplet or dotted) sync, 4 at 64th
+		uint32_t maxNotes = kMaxFixedRatchetNotes;
+		if (settings->syncLevel == SyncLevel::SYNC_LEVEL_128TH || settings->syncLevel == SyncLevel::SYNC_LEVEL_256TH) {
+			maxNotes = 2;
+		}
+		else if (settings->syncLevel == SyncLevel::SYNC_LEVEL_64TH) {
+			maxNotes = 4;
+		}
+		ratchetNotesCount = std::min<uint32_t>(settings->ratchetNotes, maxNotes);
+		ratchetNotesMultiplier = 0; // Only used by the random counts, which are powers of two
+	}
+	else if (isRatcheting) {
 		ratchetNotesMultiplier = getRandomWeighted2BitsAmount(settings->ratchetAmount);
 		ratchetNotesCount = 1 << ratchetNotesMultiplier;
 		if (settings->syncLevel == SyncLevel::SYNC_LEVEL_128TH) {
@@ -634,7 +648,7 @@ void ArpeggiatorBase::maybeSetupNewRatchet(ArpeggiatorSettings* settings) {
 
 // Spaces the notes of a new ratchet like a bouncing ball: each gap is the one before times r, so the ratchet speeds
 // up (r < 1) or slows down (r > 1) while still filling exactly one step. A ball hits softer as the bounces get shorter,
-// so each note's velocity follows the square root of its gap relative to the longest one.
+// so with bounce fade on, each note's velocity follows the square root of its gap relative to the longest one.
 void ArpeggiatorBase::setupRatchetBounce(ArpeggiatorSettings* settings) {
 	isRatchetBouncing =
 	    isRatcheting && settings->ratchetBounce != 0 && ratchetNotesCount >= 2 && ratchetNotesCount <= kMaxRatchetNotes;
@@ -661,7 +675,8 @@ void ArpeggiatorBase::setupRatchetBounce(ArpeggiatorSettings* settings) {
 	for (uint32_t i = 0; i < ratchetNotesCount; i++) {
 		ratchetNoteStarts[i] = (uint32_t)(start * kMaxGate / total);
 		start += gaps[i];
-		ratchetNoteVelocityScales[i] = (uint8_t)(255.0f * std::sqrt(gaps[i] / longest) + 0.5f);
+		ratchetNoteVelocityScales[i] =
+		    settings->ratchetBounceFade ? (uint8_t)(255.0f * std::sqrt(gaps[i] / longest) + 0.5f) : 255;
 	}
 	ratchetNoteStarts[ratchetNotesCount] = 1 << 24;
 }
@@ -671,7 +686,11 @@ uint32_t ArpeggiatorBase::getRatchetNoteStart(uint32_t index, uint32_t maxGate)
 	if (isRatchetBouncing) {
 		return ratchetNoteStarts[std::min(index, ratchetNotesCount)];
 	}
-	return index * (maxGate >> ratchetNotesMultiplier);
+	if (ratchetNotesCount == 0) {
+		return 0;
+	}
+	// Evenly spaced. For the random counts (powers of two) this is exactly index * (maxGate >> multiplier)
+	return (uint32_t)(((uint64_t)std::min(index, ratchetNotesCount) * maxGate) / ratchetNotesCount);
 }
 
 uint8_t ArpeggiatorBase::applyRatchetBounceToVelocity(uint8_t velocity) {
@@ -1730,6 +1749,8 @@ void ArpeggiatorSettings::cloneFrom(ArpeggiatorSettings const* other) {
