+
+namespace deluge::gui::menu_item::arpeggiator {
+// Whether a bouncing ratchet gets softer as its gaps get shorter, like a real ball (on), or keeps every note's
+// velocity (off)
+class BounceFade final : public Selection {
+public:
+	using Selection::Selection;
+	void readCurrentValue() override { this->setValue(soundEditor.currentArpSettings->ratchetBounceFade); }
+	bool usesAffectEntire() override { return true; }
+	void writeCurrentValue() override {
+		bool fade = this->getValue() != 0;
+		// If affect-entire button held, do whole kit
+		if (currentUIMode == UI_MODE_HOLDING_AFFECT_ENTIRE_IN_SOUND_EDITOR && soundEditor.editingKitRow()) {
+			for (Drum* thisDrum = getCurrentKit()->firstDrum; thisDrum != nullptr; thisDrum = thisDrum->next) {
+				thisDrum->arpSettings.ratchetBounceFade = fade;
+			}
+		}
+		else {
+			soundEditor.currentArpSettings->ratchetBounceFade = fade;
+		}
+	}
+	deluge::vector<std::string_view> getOptions() override {
+		using enum l10n::String;
+		return {l10n::getView(STRING_FOR_OFF), l10n::getView(STRING_FOR_ON)};
+	}
+	bool isRelevant(ModControllableAudio* modControllable, int32_t whichThing) override {
+		return soundEditor.currentArpSettings != nullptr && soundEditor.currentArpSettings->mode != ArpMode::OFF;
+	}
+	bool isToggle() override { return true; }
+	bool shouldEnterSubmenu() override { return false; }
+};
+} // namespace deluge::gui::menu_item::arpeggiator
