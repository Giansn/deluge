--- a/src/deluge/modulation/arpeggiator.cpp
+++ b/src/deluge/modulation/arpeggiator.cpp
@@ -601,11 +601,25 @@ void ArpeggiatorBase::switchAnyNoteOff(ArpReturnInstruction* instruction) {
 
 // Sets up the ratchet state if the probability is met
 void ArpeggiatorBase::maybeSetupNewRatchet(ArpeggiatorSettings* settings) {
+	bool fixedNumberOfNotes = settings->ratchetNotes >= 2;
 	isRatcheting = isPlayRatchetForCurrentStep
-	               && settings->ratchetAmount > 0
+	               && (settings->ratchetAmount > 0 || fixedNumberOfNotes)
