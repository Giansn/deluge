@@ -1772,6 +1793,13 @@ bool ArpeggiatorSettings::readCommonTagsFromFile(Deserializer& reader, char cons
 	else if (!strcmp(tagName, "ratchetBounce")) {
 		ratchetBounce = std::clamp<int32_t>(reader.readTagOrAttributeValueInt(), -kMaxRatchetBounce, kMaxRatchetBounce);
 	}
+	else if (!strcmp(tagName, "ratchetBounceFade")) {
