+#pragma once
+#include "gui/l10n/l10n.h"
+#include "gui/menu_item/selection.h"
+#include "gui/ui/sound_editor.h"
+#include "model/drum/drum.h"
+#include "model/instrument/kit.h"
+#include "model/song/song.h"
+#include "modulation/arpeggiator.h"
+
+namespace deluge::gui::menu_item::arpeggiator {
+// Number of notes in a ratchet: Auto picks 2, 4 or 8 at random like 1.3 (weighted by the number of ratchets), or
+// always exactly 2 ... 8
+class RatchetNotes final : public Selection {
+public:
+	using Selection::Selection;
+	void readCurrentValue() override {
+		uint8_t notes = soundEditor.currentArpSettings->ratchetNotes;
+		this->setValue((notes >= 2) ? notes - 1 : 0);
+	}
+	bool usesAffectEntire() override { return true; }
+	void writeCurrentValue() override {
+		int32_t option = this->getValue();
+		uint8_t notes = (option == 0) ? 0 : option + 1;
+		// If affect-entire button held, do whole kit
+		if (currentUIMode == UI_MODE_HOLDING_AFFECT_ENTIRE_IN_SOUND_EDITOR && soundEditor.editingKitRow()) {
+			for (Drum* thisDrum = getCurrentKit()->firstDrum; thisDrum != nullptr; thisDrum = thisDrum->next) {
+				thisDrum->arpSettings.ratchetNotes = notes;
+			}
+		}
+		else {
+			soundEditor.currentArpSettings->ratchetNotes = notes;
+		}
+	}
+	deluge::vector<std::string_view> getOptions() override {
+		return {l10n::getView(l10n::String::STRING_FOR_AUTO), "2", "3", "4", "5", "6", "7", "8"};
+	}
+	bool isRelevant(ModControllableAudio* modControllable, int32_t whichThing) override {
+		return soundEditor.currentArpSettings != nullptr && soundEditor.currentArpSettings->mode != ArpMode::OFF;
+	}
+};
+} // namespace deluge::gui::menu_item::arpeggiator
