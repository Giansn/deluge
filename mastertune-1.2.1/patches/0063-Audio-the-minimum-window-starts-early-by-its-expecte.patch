diff --git a/src/deluge/processing/engines/audio_engine.cpp b/src/deluge/processing/engines/audio_engine.cpp
index c8e4f556..161b7ab6 100644
--- a/src/deluge/processing/engines/audio_engine.cpp
+++ b/src/deluge/processing/engines/audio_engine.cpp
@@ -576,19 +576,28 @@ inline void setDireness(size_t numSamples) { // Consider direness and culling -
 // spends it on every track and kit, sounding or not (in the emulator 43,500 instructions a render for tests/sdload's
 // big project with nothing playing). Rendering whatever was due whenever routine() was called, the windows of a light
 // load were short (the task manager calls it about every 16 samples, and every few samples while the playback routine's
-// target interval was 0) and that cost was most of the CPU. At light load routine() now waits until kMinSamplesDue
-// samples are due and then, as always, renders about twice that (60 samples, while 96 are still in the output buffer).
-// Only while there's room to spare: the render time of windows that long under kMinWindowMaxLoadPermille of their
-// audio's time, measured around the render (routineMeasured()), and cpuDireness at 0; not while a file is saved or
-// loaded, which has its own minimum (minNumSamplesToRender).
-constexpr size_t kMinSamplesDue = 32;
+// target interval was 0) and that cost was most of the CPU. At light load routine() now renders kMinWindowSamples at
+// once (or, as always, twice what's due less 6 if more), and waits until enough is due for that: so many that the
+// render ends when about kMinWindowEndDue are due, i.e. that less the render time expected (the window at the load
+// measured). The output buffer keeps what's left of its 128 samples through the render: with the render time
+// subtracted it doesn't shrink as the load grows (starting at a fixed 32 due, a render of 60 samples at 38 % load,
+// tests/sdload S4, ended with 55 due, and one where voices started with 78), which leaves a reserve for the other tasks
+// and a render that takes longer than expected. Only while there's room to spare: the render time of windows that long
+// under kMinWindowMaxLoadPermille of their audio's time, measured around the render (routineMeasured()), and
+// cpuDireness at 0; not while a file is saved or loaded, which has its own minimum (minNumSamplesToRender).
+constexpr size_t kMinWindowSamples = 60;
+constexpr int32_t kMinWindowEndDue = 32;
+/// It renders once this many are due at the latest, however long the render is expected to take
+constexpr int32_t kMinWindowStartDueLeast = 8;
+/// The windows whose load is measured: that long at least
+constexpr size_t kWindowLoadMinSamples = 32;
 constexpr uint32_t kMinWindowMaxLoadPermille = 500;
 /// While the load keeps it off, no windows that long are rendered to measure it again: after this long it applies again
 /// until one is, and the load starts afresh from that one (1/8 s)
 constexpr uint32_t kWindowLoadMaxAge = kSampleRate >> 3;
-/// Render time over the audio's time of the windows of kMinSamplesDue samples or more, in 0.1 %: (7 * average + latest)
-/// / 8, so that one busy window (voices starting) doesn't switch the minimum window off; and audioSampleTimer after the
-/// latest
+/// Render time over the audio's time of the windows of kWindowLoadMinSamples samples or more, in 0.1 %: (7 * average +
+/// latest) / 8, so that one busy window (voices starting) doesn't switch the minimum window off; and audioSampleTimer
+/// after the latest
 static uint32_t windowLoadPermille = 0;
 static uint32_t windowLoadMeasuredAt = 0;
 
@@ -600,6 +609,12 @@ static bool minimumWindowApplies() {
 	       || audioSampleTimer - windowLoadMeasuredAt >= kWindowLoadMaxAge;
 }
 
+/// Samples due at which the minimum window is rendered: kMinWindowEndDue less the render time expected
+static size_t minimumWindowStartDue() {
+	int32_t renderTime = (int32_t)(std::min<uint32_t>(windowLoadPermille, 1000) * kMinWindowSamples / 1000);
+	return std::max<int32_t>(kMinWindowEndDue - renderTime, kMinWindowStartDueLeast);
+}
+
 void scheduleMidiGateOutISR(uint32_t saddrPosAtStart, int32_t unadjustedNumSamplesBeforeLappingPlayHead,
                             int32_t timeWithinWindowAtWhichMIDIOrGateOccurs);
 void setMonitoringMode();
@@ -639,12 +654,17 @@ void renderAudioForStemExport(size_t numSamples);
 	}
 
 	// mastertune-v17: the minimum window. Too little due yet: nothing rendered, and the audio task is due again when
-	// kMinSamplesDue will be. What MIDI and gates wait to go out now (live, MIDI thru) goes, as it would with a render.
-	if (!numRoutines && numSamples < kMinSamplesDue && minimumWindowApplies()) {
-		flushMIDIGateBuffers();
-		ignoreForStats();
-		delayTask(routineTaskID, (double)(kMinSamplesDue - numSamples) / kSampleRate);
-		return false;
+	// enough will be. What MIDI and gates wait to go out now (live, MIDI thru) goes, as it would with a render.
+	size_t minWindowSamples = 0;
+	if (!numRoutines && minimumWindowApplies()) {
+		size_t startDue = minimumWindowStartDue();
+		if (numSamples < startDue) {
+			flushMIDIGateBuffers();
+			ignoreForStats();
+			delayTask(routineTaskID, (double)(startDue - numSamples) / kSampleRate);
+			return false;
+		}
+		minWindowSamples = kMinWindowSamples;
 	}
 #if AUTOMATED_TESTER_ENABLED
 	AutomatedTester::possiblyDoSomething();
@@ -672,6 +692,10 @@ void renderAudioForStemExport(size_t numSamples);
 	if (numSamples < minNumSamplesToRender) {
 		numSamples = minNumSamplesToRender;
 	}
+	// mastertune-v17: the minimum window
+	if (numSamples < minWindowSamples) {
+		numSamples = minWindowSamples;
+	}
 
 	// Want to round to be doing a multiple of 4 samples, so the NEON functions can be utilized most efficiently.
 	// Note - this can take numSamples up as high as SSI_TX_BUFFER_NUM_SAMPLES (currently 128).
@@ -1304,7 +1328,7 @@ void scheduleMidiGateOutISR(uint32_t saddrPosAtStart, int32_t unadjustedNumSampl
 /// mastertune-v17: a call of routine() rendered `samples` in `ticks` of OS timer 0
 static void routineMeasured(uint32_t ticks, uint32_t samples) {
 	routineTimeAverage = (routineTimeAverage + ticks / DELUGE_CLOCKS_PERf) / 2;
-	if (samples >= kMinSamplesDue) {
+	if (samples >= kWindowLoadMinSamples) {
 		// 1000 * kSampleRate / DELUGE_CLOCKS_PER = 4410 / 3333
 		uint32_t load = (uint32_t)std::min<uint64_t>((uint64_t)ticks * 4410 / ((uint64_t)samples * 3333), 100000);
 		if (audioSampleTimer - windowLoadMeasuredAt > kWindowLoadMaxAge) {
