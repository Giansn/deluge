diff --git a/src/deluge/dsp/drone/drone.cpp b/src/deluge/dsp/drone/drone.cpp
index 2c9408ab..6b228cf2 100644
--- a/src/deluge/dsp/drone/drone.cpp
+++ b/src/deluge/dsp/drone/drone.cpp
@@ -193,7 +193,7 @@ float Drone::syncedBeatHz(int32_t sync, bool triplet, float quarterNotesPerSecon
 
 void Drone::pulseEdges(const Tone& tone, float beatHz, float* attack, float* release) {
 	// Each step is 2 % of the half cycle the pulse is on for, so 1 % of the cycle
-	float shortest = kMinEdgeSeconds * beatHz;
+	float shortest = std::min(kMinEdgeSeconds * beatHz, 0.5f); // A very fast beat is all edge
 	*attack = std::clamp((float)std::clamp(tone.pulseAttack, (int32_t)0, S::kMaxPulseEdge) * 0.01f, shortest, 0.5f);
 	*release = std::clamp((float)std::clamp(tone.pulseRelease, (int32_t)0, S::kMaxPulseEdge) * 0.01f, shortest, 0.5f);
 }
