 src/deluge/dsp/drone/drone.cpp                       |  2 +-
 src/deluge/gui/menu_item/drone/items.h               |  3 ++-
 src/deluge/gui/views/drone_view.cpp                  | 12 +++++++++++-
 src/deluge/gui/views/view.cpp                        |  4 +++-
 .../mod_controllable/mod_controllable_audio.cpp      |  2 +-
