+// mastertune v18: the volume knobs (a sound's and a kit row's level, a kit's, an audio track's and the song's volume,
+// in the menus and on the gold knobs) step by 0.5 dB per detent and show dB.
+//
+// Only the steps and the display change: the stored value and its gain law stay as in v17 (so a saved song keeps its
+// level exactly, and files load both ways), and automation, MIDI and patch cables work on the stored value as before.
+// The law: a stored value v gives x = (v + 2^31) / 2^31 (0 to 2, menu value n = 25 x) and the gain x^2, i.e.
+// 40 log10(x) dB. A sound's and a kit row's volume have 0 dB at x = 1 (n = 25, up to +12.0 dB); a kit's, an audio
+// track's and the song's halve it (their >> 1): 0 dB at x = sqrt 2 (n = 35.4, up to +6.0 dB). (A kit's and an audio
+// track's fixed factors, x1.25 and x1.2196, headroom for their filters, aren't counted: the knob's dB is what the
+// knob does.)
+// The steps: a value on the 0.5 dB grid moves by 0.5 dB per detent; one between (loaded, automated, set by MIDI) is
+// shown to 0.1 dB and the first detent takes it to the grid point in the direction turned. Below -60 dB comes off
+// (gain 0): the value v17 has at the knob's bottom, shown as -inf ("OFF" on the 7-segment display).
+
+#pragma once
+
+#include "modulation/params/param.h"
+#include <cstdint>
+
+namespace deluge::modulation::params::volume {
+
+enum class Scale : uint8_t {
+	SOUND,  // a sound's / kit row's level (GLOBAL_VOLUME_POST_FX): 0 dB at n = 25
+	GLOBAL, // a kit's, audio track's, the song's volume (UNPATCHED_VOLUME): 0 dB at n = 35.4
+};
+
+constexpr int32_t kGridPerDb = 2;    // 0.5 dB per detent
+constexpr int32_t kFloorGrid = -120; // -60 dB: the lowest step before off
+constexpr int32_t kOff = INT32_MIN;  // stored value for off (gain 0)
+
+// Whether this param is a volume knob's, and its scale
+bool isVolumeParam(Kind kind, int32_t paramID, Scale* scale = nullptr);
+
+// The stored value's dB (-inf for off)
+double storedToDb(int32_t stored, Scale scale);
+// The stored value nearest to this many dB (clamped to the knob's range)
+int32_t dbToStored(double db, Scale scale);
+// The stored value offset detents on (see above)
+int32_t step(int32_t stored, int32_t offset, Scale scale);
+// Its text: OLED "-3.5 dB", "+12.0 dB", "0.0 dB", "-inf dB"; 7-segment (oled false) "-3.5", "12.0", "0.0", "OFF".
+// buffer: at least 12 chars
+void toText(int32_t stored, Scale scale, char* buffer, bool oled);
+
+} // namespace deluge::modulation::params::volume
