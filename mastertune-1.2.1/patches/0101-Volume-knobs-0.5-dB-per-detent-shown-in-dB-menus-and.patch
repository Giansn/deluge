+#include "modulation/params/volume_steps.h"
+#include "util/cfunctions.h"
+#include <cmath>
+#include <cstring>
+
+namespace deluge::modulation::params::volume {
+
+namespace {
+// 20 log10(2): the kit's / audio track's / song's >> 1
+constexpr double kHalfDb = 6.020599913279624;
+
+double scaleOffsetDb(Scale scale) {
+	return scale == Scale::GLOBAL ? -kHalfDb : 0.0;
+}
+} // namespace
+
+bool isVolumeParam(Kind kind, int32_t paramID, Scale* scale) {
+	Scale s;
+	if (kind == Kind::PATCHED && paramID == GLOBAL_VOLUME_POST_FX) {
+		s = Scale::SOUND;
+	}
+	else if (kind == Kind::UNPATCHED_GLOBAL && paramID == UNPATCHED_VOLUME) {
+		s = Scale::GLOBAL;
+	}
+	else {
+		return false;
+	}
+	if (scale) {
+		*scale = s;
+	}
+	return true;
+}
+
+double storedToDb(int32_t stored, Scale scale) {
+	double x = ((double)stored + 2147483648.0) / 2147483648.0;
+	if (x <= 0.0) {
+		return -INFINITY;
+	}
+	// (40 log10 x, through log(): newlib's log10() would pull in a malloc the firmware doesn't have)
+	return (40.0 / 2.302585092994046) * std::log(x) + scaleOffsetDb(scale);
+}
+
+int32_t dbToStored(double db, Scale scale) {
+	double x = std::pow(10.0, (db - scaleOffsetDb(scale)) / 40.0);
+	double v = std::round((x - 1.0) * 2147483648.0);
+	if (v >= 2147483647.0) {
+		return INT32_MAX;
+	}
+	if (v <= -2147483648.0) {
+		return INT32_MIN;
+	}
+	return (int32_t)v;
+}
+
+int32_t step(int32_t stored, int32_t offset, Scale scale) {
+	if (offset == 0) {
+		return stored;
+	}
+	double h = storedToDb(stored, scale) * kGridPerDb; // in grid steps
+	int32_t k;
+	if (!(h >= kFloorGrid - 0.02)) { // off, or below the floor (-inf included)
+		if (offset < 0) {
+			return kOff;
+		}
+		k = kFloorGrid + offset - 1;
+	}
+	else {
+		double nearest = std::round(h);
+		if (std::fabs(h - nearest) < 0.02) { // on the grid (within 0.01 dB)
+			k = (int32_t)nearest + offset;
+		}
+		else { // between: the first detent takes it to the grid point in the direction turned
+			k = (offset > 0) ? (int32_t)std::ceil(h) + offset - 1 : (int32_t)std::floor(h) + offset + 1;
+		}
+	}
+	if (k < kFloorGrid) {
+		return kOff;
+	}
+	double maxDb = storedToDb(INT32_MAX, scale);
+	if ((double)k / kGridPerDb >= maxDb - 0.005) {
+		return INT32_MAX;
+	}
+	return dbToStored((double)k / kGridPerDb, scale);
+}
+
+void toText(int32_t stored, Scale scale, char* buffer, bool oled) {
+	double db = storedToDb(stored, scale);
+	int32_t tenths = std::isfinite(db) ? (int32_t)std::lround(db * 10.0) : INT32_MIN;
+	if (tenths <= -1000) { // off, or at -100 dB and below
+		strcpy(buffer, oled ? "-inf dB" : "OFF");
+		return;
+	}
+	// (No snprintf: the firmware doesn't link newlib's printf)
+	int32_t a = tenths < 0 ? -tenths : tenths;
+	char* p = buffer;
+	if (tenths < 0) {
+		*p++ = '-';
+	}
+	else if (tenths > 0 && oled) {
+		*p++ = '+';
+	}
+	intToString(a / 10, p, 1);
+	p += strlen(p);
+	*p++ = '.';
+	*p++ = (char)('0' + a % 10);
+	*p = 0;
+	if (oled) {
+		strcpy(p, " dB");
+	}
+}
+
+} // namespace deluge::modulation::params::volume
