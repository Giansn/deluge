@@ -83,6 +83,7 @@ public:
 	/// mastertune v18: how long the crossfade takes where a filter's mode or the route changes or a filter is switched
 	/// off: 320 samples, 7.3 ms
 	static constexpr int32_t kFadeSamples = 320;
+	static_assert(kFadeSamples == LpLadderFilter::kFadeInSamples, "a filter switched on fades in as long");
 	/// How many FilterSets can fade at once (the song's, kits' and voices' together); more changes at the same time
 	/// switch at once, as before
 	static constexpr int32_t kNumFades = 24;
