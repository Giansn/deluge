@@ -37,9 +41,25 @@ uint8_t mode = OFF;
 bool enabled = false;
 Collector collector;
 
+namespace {
+uint8_t lastOnMode = ON; ///< What the shortcut switches back on: the last of On and Alerts
+bool savePending = false;
+
+void saveIfPending() {
+	// Not while the card is busy (a file being read or written), as the menu's USB audio setting
+	if (savePending && !sdRoutineLock) {
+		savePending = false;
+		runtimeFeatureSettings.writeSettingsToFile(storageManager);
+	}
+}
+} // namespace
+
 void setMode(uint8_t newMode) {
 	mode = (newMode <= PROFILE) ? newMode : OFF;
 	enabled = (mode != OFF);
+	if (mode == ON || mode == ALERTS) {
+		lastOnMode = mode;
+	}
 	if (mode == PROFILE) {
 		profiler::start();
 	}
@@ -48,6 +68,31 @@ void setMode(uint8_t newMode) {
 	}
 }
 
+void shortcut() {
+	setMode(mode == OFF ? lastOnMode : OFF);
+	char const* text[2] = {"COFF", "CPU monitor: Off"}; // 7-segment, OLED
+	if (mode == ON) {
+		text[0] = "C-ON";
+		text[1] = "CPU monitor: On";
+	}
+	else if (mode == ALERTS) {
+		text[0] = "C-AL";
+		text[1] = "CPU monitor: Alerts";
+	}
+	display->displayPopup(text);
+	savePending = true;
+	saveIfPending();
+}
+
+bool readSetting(char const* name, int32_t value) {
+	if (strcmp(name, kSettingName) != 0) {
+		return false;
+	}
+	uint8_t saved = (value >= 0 && value <= PROFILE) ? (uint8_t)value : (uint8_t)OFF;
+	setMode((saved == PROFILE) ? (uint8_t)ON : saved);
+	return true;
+}
