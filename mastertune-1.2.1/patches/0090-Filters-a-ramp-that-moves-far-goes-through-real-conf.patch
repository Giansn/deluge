+
+	// A filter's coefficients are nonlinear in its cutoff and resonance (the ladders' feedbacks go with moveability^1..3
+	// and 1 / (1 + k moveability^4)), so a straight line between two far-apart sets passes through sets that belong to
+	// no configuration: the ladder's response strays from the real one in the middle (30 Hz -> 18 kHz in one block:
+	// 4 dB at 13 % resonance, 30 dB and unstable sets near self-oscillation; tests/filters lpf_ramp_math). So a ramp is
+	// cut into pieces: at their ends (the knots) the filter's own setConfig() gives the coefficients of a real
+	// configuration, the cutoff moving in equal ratios (log frequency, as a knob or an envelope moves it), resonance
+	// and morph in equal steps; within a piece the coefficients move in a straight line per sample, as before. One
+	// piece per third of an octave, per 1/16 of the resonance's range and per 1/8 of morph's, at most kMaxPieces (4
+	// samples each in a block of 128): 30 Hz -> 18 kHz in one block then stays within 0.5 dB of the real ladder
+	// (lpf_ramp_math). A small change (the usual one: an envelope, an LFO, a knob turned) stays one piece and costs
+	// nothing more.
+	// params_: what configure() last got (setConfig()'s arguments), lastParams_: the last block's (endBlock())
+	struct RampParams {
+		q31_t frequency;
+		q31_t resonance;
+		q31_t morph;
+		FilterMode mode;
+	};
+	RampParams params_{};
+	RampParams lastParams_{};
+
+public:
+	static constexpr int32_t kMaxPieces = 32;
+	// How many pieces a ramp from lastParams_ to params_ over n samples takes (1 to min(kMaxPieces, n))
+	[[nodiscard]] int32_t rampPieces(int32_t n) const {
+		int64_t pieces = 1;
+		if (params_.frequency > 0 && lastParams_.frequency > 0) {
+			// quickLog: 2^25 per octave
+			constexpr int64_t kThirdOctave = (1 << 25) / 3;
+			int64_t logs = std::abs((int64_t)quickLog(params_.frequency) - (int64_t)quickLog(lastParams_.frequency));
+			pieces = std::max(pieces, (logs + kThirdOctave - 1) / kThirdOctave);
+		}
+		// The resonance's range is 2^29 (the knob's), morph's 2^31
+		int64_t res = std::abs((int64_t)params_.resonance - (int64_t)lastParams_.resonance);
+		pieces = std::max(pieces, (res + (1 << 25) - 1) >> 25);
+		int64_t morph = std::abs((int64_t)params_.morph - (int64_t)lastParams_.morph);
+		pieces = std::max(pieces, (morph + (1 << 28) - 1) >> 28);
+		return (int32_t)std::clamp(pieces, (int64_t)1, (int64_t)std::max(std::min(kMaxPieces, n), (int32_t)1));
+	}
+	// The configuration at knot j of `pieces` (0: lastParams_, pieces: params_)
+	[[nodiscard]] RampParams pieceParams(int32_t j, int32_t pieces) const {
+		auto linear = [&](q31_t a, q31_t b) {
+			return (q31_t)((int64_t)a + ((int64_t)b - (int64_t)a) * j / pieces);
+		};
+		RampParams p{linear(lastParams_.frequency, params_.frequency),
+		             linear(lastParams_.resonance, params_.resonance), linear(lastParams_.morph, params_.morph),
+		             params_.mode};
+		if (params_.frequency > 0 && lastParams_.frequency > 0) {
+			float octaves = std::log2((float)params_.frequency / (float)lastParams_.frequency);
+			float f = (float)lastParams_.frequency * std::exp2(octaves * (float)j / (float)pieces);
+			p.frequency = (q31_t)std::clamp(f, 1.0f, 2147483520.0f);
+		}
+		return p;
+	}
+	// A knot of a ramp: the sample where it is, the coefficients the piece before it ends at (in) and the ones the piece
+	// after it starts from (out). The same, except where the coefficients jump (T::rampBreak(): a setConfig() that
+	// changes its formula at some cutoff), where the ramp jumps from one to the other between two samples
+	template <typename C>
+	struct Knot {
+		int32_t sample;
+		C in;
+		C out;
+	};
+	static constexpr int32_t kMaxKnots = kMaxPieces + 2; // the ends, the knots between, one break
+	// The knots of this block's ramp over n samples from `from` (the last block's coefficients) to `to` (this one's):
+	// knots[0] at sample 0 (from), the last at sample n (to), the ones between from T::rampKnot() (setConfig() at
+	// pieceParams(), the configuration put back after), at samples n * j / pieces, and where the ramp crosses a cutoff
+	// at which T's coefficients jump (T::rampBreak()), a knot there with the coefficients just below and just above it
+	// (the resonance and morph where the ramp has got to). knots: kMaxKnots of them. Returns how many. Piece k runs
+	// from knots[k].sample to knots[k + 1].sample, from knots[k].out to knots[k + 1].in (none where they're the same
+	// sample)
+	template <typename C>
+	int32_t rampKnots(int32_t n, const C& from, const C& to, Knot<C>* knots) {
+		T& self = *static_cast<T*>(this);
+		const int32_t pieces = rampPieces(n);
+		const q31_t f0 = lastParams_.frequency;
+		const q31_t f1 = params_.frequency;
+		// Where the ramp crosses T's break: the fraction of the way (-1: nowhere), the frequency just below it
+		float breakAt = -1;
+		q31_t below = 0;
+		if (f0 > 0 && f1 > 0 && f0 != f1 && self.rampBreak(params_.mode, std::min(f0, f1), std::max(f0, f1), &below)) {
+			breakAt = std::clamp(std::log2((float)below / (float)f0) / std::log2((float)f1 / (float)f0), 0.0f, 1.0f);
+		}
+		int32_t count = 0;
+		knots[count++] = Knot<C>{0, from, from};
+		if (pieces == 1 && breakAt < 0) {
+			knots[count++] = Knot<C>{n, to, to};
+			return count;
+		}
+		const T saved = self;
+		for (int32_t j = 1; j <= pieces; j++) {
+			if (breakAt >= 0 && (breakAt * (float)pieces < (float)j || j == pieces)) {
+				// Before this knot: the break
+				const int32_t sample = std::max(std::min((int32_t)(breakAt * (float)n), n), knots[count - 1].sample);
+				RampParams p = paramsAt(breakAt);
+				p.frequency = below;
+				const C lower = self.rampKnot(p);
+				p.frequency = below + 1;
+				const C upper = self.rampKnot(p);
+				knots[count++] = f1 > f0 ? Knot<C>{sample, lower, upper} : Knot<C>{sample, upper, lower};
+				breakAt = -1;
+			}
+			const int32_t sample = std::max(n * j / pieces, knots[count - 1].sample);
+			if (j == pieces) {
+				knots[count++] = Knot<C>{n, to, to};
+			}
+			else {
+				const C c = self.rampKnot(pieceParams(j, pieces));
+				knots[count++] = Knot<C>{sample, c, c};
+			}
+		}
+		self = saved;
+		return count;
+	}
+	// The configuration a fraction t of the way from lastParams_ to params_ (the cutoff in log frequency)
+	[[nodiscard]] RampParams paramsAt(float t) const {
+		auto linear = [&](q31_t a, q31_t b) { return (q31_t)((float)a + ((float)b - (float)a) * t); };
+		RampParams p{linear(lastParams_.frequency, params_.frequency),
+		             linear(lastParams_.resonance, params_.resonance), linear(lastParams_.morph, params_.morph),
+		             params_.mode};
+		if (params_.frequency > 0 && lastParams_.frequency > 0) {
+			float f = (float)lastParams_.frequency * std::exp2(std::log2((float)params_.frequency / (float)lastParams_.frequency) * t);
+			p.frequency = (q31_t)std::clamp(f, 1.0f, 2147483520.0f);
+		}
+		return p;
+	}
+	// A filter without a break: the coefficients follow the cutoff continuously
+	[[nodiscard]] bool rampBreak(FilterMode, q31_t, q31_t, q31_t*) const { return false; }
+	// Piece by piece, as rampKnots() gave them: render(begin, end, start, steps) for each that has samples, the
+	// coefficients from `start` moving by `steps` per sample (sample begin + k, k from 1, takes start + k * steps)
+	template <typename C, typename Render>
+	[[gnu::always_inline]] static inline void forEachPiece(const Knot<C>* knots, int32_t count, Render render) {
+		for (int32_t k = 0; k + 1 < count; k++) {
+			const int32_t begin = knots[k].sample;
+			const int32_t end = knots[k + 1].sample;
+			if (end > begin) {
+				render(begin, end, knots[k].out, knots[k].out.steps(knots[k + 1].in, end - begin));
+			}
+		}
+	}
+
+protected:
+	// After a block: its configuration is the next one's last
+	void rampEndBlock() {
+		lastParams_ = params_;
+		haveLast_ = true;
+	}
 };
 
 } // namespace deluge::dsp::filter
