+// Where the ramp crosses the cutoff at which the 12 and 24 dB ladders' extra feedback changes (setConfig():
+// tannedFrequency 304587486, about 11.8 kHz, where processedResonance falls to less than half), the frequency just
+// below it (the largest whose tannedFrequency is at most that): the ramp jumps there, between two real configurations,
+// instead of moving the resonance across a piece in a straight line (mid-piece sets that sing where neither end does)
+bool LpLadderFilter::rampBreak(FilterMode mode, q31_t lo, q31_t hi, q31_t* below) const {
+	constexpr int32_t kBreak = 304587486;
+	if (mode == FilterMode::TRANSISTOR_24DB_DRIVE) {
+		return false;
+	}
+	auto tanned = [](q31_t f) { return instantTan(lshiftAndSaturate<5>(f)); };
+	if (!(tanned(lo) <= kBreak && tanned(hi) > kBreak)) {
+		return false;
+	}
+	// tannedFrequency grows with the frequency: bisection between lo (at most) and hi (above)
+	while (hi - lo > 1) {
+		q31_t mid = lo + (hi - lo) / 2;
+		(tanned(mid) <= kBreak ? lo : hi) = mid;
+	}
+	*below = lo;
+	return true;
