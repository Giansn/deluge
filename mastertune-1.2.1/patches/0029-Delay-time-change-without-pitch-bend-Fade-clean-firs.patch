+	void writeCurrentValue() override {
+		soundEditor.currentModControllable->delay.timeChange = static_cast<Delay::TimeChange>(this->getValue());
+	}
+	deluge::vector<std::string_view> getOptions() override {
+		using enum l10n::String;
+		return {l10n::getView(STRING_FOR_FADE), l10n::getView(STRING_FOR_TAPE)};
+	}
+};
+
+} // namespace deluge::gui::menu_item::delay
