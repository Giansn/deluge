+// mastertune-v14: whether a buffer holds the delay time for a rate, for the fade mode: within a sample and 0.05 % (a
+// tempo that drifts by less leaves it), and at its own speed, unless the time is longer than the largest buffer
+bool Delay::fadeBufferFits(const DelayBuffer& buffer, int32_t rate) {
+	if (rate == buffer.rate() && buffer.isNative()) {
+		return true; // Most of the time, without dividing
+	}
+	int64_t want = DelayBuffer::delaySamplesForRate(rate);
+	int64_t have = DelayBuffer::delaySamplesForRate(buffer.rate());
+	if (std::abs(want - have) > 1 + (want >> 11)) {
+		return false;
+	}
+	return buffer.isNative() || DelayBuffer::getIdealBufferSizeFromRate(rate).second;
+}
+
+// mastertune-v14: in the fade mode, starts a change of time into a new buffer when the time has moved and settled (or
+// kept moving for a while). One change at a time: a further one waits until the old buffer has played out.
+void Delay::prepareFade(int32_t rate, int32_t numSamples) {
+	if (fading || !primaryBuffer.isActive()) {
+		return; // The first buffer fills at the time it began with, and becomes the primary one, before any change
+	}
+	if (secondaryBuffer.isActive()) {
+		secondaryBuffer.discard(); // A copy the tape mode was making when it was switched to the fade mode
+	}
+	if (fadeBufferFits(primaryBuffer, rate)) {
+		fadeWaitedSamples = 0;
+		return;
+	}
+	fadeWaitedSamples += numSamples;
+	if (countCyclesWithoutChange < kFadeSettleSamples && fadeWaitedSamples < kFadeMaxWaitSamples) {
+		return;
+	}
+	fadeWaitedSamples = 0;
+	if (secondaryBuffer.init(rate) != Error::NONE) {
+		return; // No memory for it now: try again after another wait
+	}
+	fading = true;
+	fadeSecondaryReadable = false;
+	fadeCrossfadeDone = 0;
+	int32_t oldTime = (int32_t)std::min(DelayBuffer::delaySamplesForRate(primaryBuffer.rate()), (uint32_t)1 << 30);
+	// What goes in last, at the end of the crossfade, comes out one time later (plus the reach of the resampling
+	// kernels, at most 2 positions of the buffer either side)
+	fadeSamplesLeft = kFadeCrossfadeSamples + oldTime + (oldTime >> 13) + 64;
+}
