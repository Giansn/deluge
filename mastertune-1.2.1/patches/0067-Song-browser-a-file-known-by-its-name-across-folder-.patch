@@ -217,11 +217,12 @@ void LoadSongUI::enterKeyPress() {
 	}
 
 	else {
-		// mastertune: a folded group of versions folds out, nothing loads; the cursor stays on its first version
+		// mastertune: a folded group of versions folds out, nothing loads; the cursor stays on its first version. A
+		// name typed loads, the group's first version too (the row shows what was typed)
 		if (currentFileItem) {
 			fillWindowAroundSelection(); // Whether the next file is one of its versions (may read the folder again)
 			syncOpenGroup();
-			if (isFoldedHeader(fileIndexSelected)) {
+			if (selectionShownFolded()) {
 				FileItem* header = getCurrentFileItem();
 				openGroup.set(header->displayName, groupKeyLength(header));
 				fillWindowForRows();
@@ -825,7 +826,10 @@ void LoadSongUI::selectEncoderAction(int8_t offset) {
 				}
 				topBefore.set(itemAt(direction > 0 ? keep : scrollPosVertical)->displayName);
 			}
-			int32_t start = numFileItemsDeletedAtStart + fileIndexSelected;
+			String start; // The file the turn began on, by name (selectionIs())
+			if (selectedItem()) {
+				start.set(&selectedItem()->filename);
+			}
 			int32_t skipped = 0;
 			steppingInGroup = true;
 			stepCompleted = false;
@@ -835,11 +839,11 @@ void LoadSongUI::selectEncoderAction(int8_t offset) {
 				if (!isHiddenVersion(fileIndexSelected)) {
 					break;
 				}
-				int32_t before = numFileItemsDeletedAtStart + fileIndexSelected;
+				String before;
+				before.set(&selectedItem()->filename);
 				LoadUI::selectEncoderAction(direction);
 				skipped++;
-				int32_t now = numFileItemsDeletedAtStart + fileIndexSelected;
-				if (now == before || now == start) {
+				if (selectionIs(before) || selectionIs(start)) {
 					break; // At the end (without wrapping), or all the way round
 				}
 			}
@@ -847,7 +851,7 @@ void LoadSongUI::selectEncoderAction(int8_t offset) {
 				selectGroupTop(); // Stopped inside a folded group: its first version
 			}
 			steppingInGroup = false;
-			if (stepCompleted && (!skipped || numFileItemsDeletedAtStart + fileIndexSelected != start)) {
+			if (stepCompleted && (!skipped || !selectionIs(start))) {
 				if (skipped) {
 					// The rows on the screen stay where they were (fixScrollPos() moves them as far as needed)
 					bool found = false;
@@ -1277,13 +1281,22 @@ void LoadSongUI::fillWindowForRows() {
 	rowsSidesTried = rowsBeyondWindow();
 }
 
+// Whether the selected file is the one named. Across reads of the folder a file is known by its name: the window's
+// items are new, and numFileItemsDeletedAtStart plus an index isn't where a file is in the folder (a read that culls
+// the window's start drops one more file than it counts, deleteFolderAndDuplicateItems())
+bool LoadSongUI::selectionIs(String& name) {
+	FileItem* item = selectedItem();
+	return item && !name.isEmpty() && !strcmp(item->filename.get(), name.get());
+}
+
 // The selected version's group's first version. Returns whether the selection moved
 bool LoadSongUI::selectGroupTop() {
 	FileItem* item = selectedItem();
 	if (!item || item->isFolder) {
 		return false;
 	}
-	int32_t start = numFileItemsDeletedAtStart + fileIndexSelected;
+	String start;
+	start.set(&item->filename);
 	for (int32_t n = 0; n < kMaxGroupSteps; n++) {
 		if (fileIndexSelected == 0 && numFileItemsDeletedAtStart) {
 			readWindow(fileIndexSelected, -1);
@@ -1293,7 +1306,7 @@ bool LoadSongUI::selectGroupTop() {
 		}
 		fileIndexSelected--;
 	}
-	if (!selectedItem() || numFileItemsDeletedAtStart + fileIndexSelected == start) {
+	if (!selectedItem() || selectionIs(start)) {
 		return false;
 	}
 	setEnteredTextFromCurrentFilename();
@@ -1304,26 +1317,42 @@ bool LoadSongUI::selectGroupTop() {
 	return true;
 }
 
-// The selection shown as its folded group ("TRACK >", "TRACK--"), not by its own name (typed, or arrived at by typing
-// on the 7-segment display)
+// The selection typed: the keyboard shown, or arrived at by typing. It's shown by the name typed, and pressing it loads
+// it, a group's first version too
+bool LoadSongUI::selectionTyped() {
+	return qwertyVisible || arrivedAtFileByTyping;
+}
+
+// The selection shown as its folded group ("TRACK >", "TRACK--"), not by its own name
 bool LoadSongUI::selectionShownFolded() {
-	return !qwertyVisible && !(display->have7SEG() && arrivedAtFileByTyping) && isFoldedHeader(fileIndexSelected);
+	return !selectionTyped() && isFoldedHeader(fileIndexSelected);
 }
 
 // BACK: an open group folds in, its first version selected; otherwise up a folder, or out, as before
 ActionResult LoadSongUI::backButtonAction() {
+	if (sdRoutineLock) {
+		return ActionResult::REMIND_ME_OUTSIDE_CARD_ROUTINE; // The folder may be read
+	}
+	// Typed onto a file at the window's start: whether it's a later version depends on the file before it
+	FileItem* item = selectedItem();
+	if (item && !item->isFolder && fileIndexSelected == 0 && numFileItemsDeletedAtStart) {
+		readWindow(0, -1);
+	}
 	syncOpenGroup();
 	if (openGroup.isEmpty()) {
 		return LoadUI::backButtonAction();
 	}
-	if (sdRoutineLock) {
-		return ActionResult::REMIND_ME_OUTSIDE_CARD_ROUTINE; // selectGroupTop() may read the folder
+	// Folded in: the group's row, not what was typed (the keyboard off the pads, the song's preview on them)
+	bool typed = selectionTyped();
+	arrivedAtFileByTyping = false;
+	if (!qwertyAlwaysVisible) {
+		qwertyVisible = false;
 	}
 	openGroup.clear();
 	bool moved = selectGroupTop();
 	fillWindowForRows();
 	displayText();
-	if (moved) {
+	if (moved || typed) {
 		currentFileChanged(-1);
 	}
 	return ActionResult::DEALT_WITH;
@@ -1377,7 +1406,7 @@ void LoadSongUI::renderOLED(deluge::hid::display::oled_canvas::Canvas& canvas) {
 		}
 		FileItem* thisFile = itemAt(i);
 		bool isSelectedIndex = (i == fileIndexSelected);
-		bool folded = isFoldedHeader(i) && !(isSelectedIndex && qwertyVisible); // Typing: the name typed
+		bool folded = isFoldedHeader(i) && !(isSelectedIndex && selectionTyped()); // Typed: the name typed
 		bool inOpenGroup = !folded && isInOpenGroup(thisFile)
 		                   && ((i > 0 && sameGroup(itemAt(i - 1), thisFile))
 		                       || (i + 1 < numItems && sameGroup(thisFile, itemAt(i + 1))));
