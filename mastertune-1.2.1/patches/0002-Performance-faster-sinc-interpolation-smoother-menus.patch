+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <arm_neon.h>
+#include <cstdint>
+
+namespace deluge::dsp {
+
+/// Moves the 16 values of one channel of a sinc interpolation buffer up by numPositions (1 ... 15): the value at i ends
+/// up at i + numPositions and the highest ones fall off. The positions below numPositions are left with unspecified
+/// values - the caller fills them with the new samples. Gives exactly the same buffer as moving the values along one by
+/// one, but takes a handful of NEON instructions instead of up to 15 loads and stores per position.
+[[gnu::always_inline]] inline void shiftInterpolationBuffer(int16x4_t* __restrict__ buffer, int32_t numPositions) {
+	int16x8_t low = vcombine_s16(buffer[0], buffer[1]);  // Positions 0 - 7
+	int16x8_t high = vcombine_s16(buffer[2], buffer[3]); // Positions 8 - 15
+
+	switch (numPositions) {
+		// Up to 8: the top half takes the upper end of the bottom half, the bottom half moves up within itself
+#define DELUGE_SHIFT_BY_UP_TO_8(n)                                                                                     \
+	case n:                                                                                                            \
+		high = vextq_s16(low, high, 8 - (n));                                                                          \
+		low = vextq_s16(low, low, 8 - (n));                                                                            \
+		break;
+		DELUGE_SHIFT_BY_UP_TO_8(1)
+		DELUGE_SHIFT_BY_UP_TO_8(2)
+		DELUGE_SHIFT_BY_UP_TO_8(3)
+		DELUGE_SHIFT_BY_UP_TO_8(4)
+		DELUGE_SHIFT_BY_UP_TO_8(5)
+		DELUGE_SHIFT_BY_UP_TO_8(6)
+		DELUGE_SHIFT_BY_UP_TO_8(7)
+#undef DELUGE_SHIFT_BY_UP_TO_8
+
+	case 8:
+		high = low;
+		break;
+
+		// More than 8: only the top half keeps anything, taken from the bottom half
+#define DELUGE_SHIFT_BY_MORE_THAN_8(n)                                                                                 \
+	case n:                                                                                                            \
+		high = vextq_s16(low, low, 16 - (n));                                                                          \
+		break;
+		DELUGE_SHIFT_BY_MORE_THAN_8(9)
+		DELUGE_SHIFT_BY_MORE_THAN_8(10)
+		DELUGE_SHIFT_BY_MORE_THAN_8(11)
+		DELUGE_SHIFT_BY_MORE_THAN_8(12)
+		DELUGE_SHIFT_BY_MORE_THAN_8(13)
+		DELUGE_SHIFT_BY_MORE_THAN_8(14)
+		DELUGE_SHIFT_BY_MORE_THAN_8(15)
+#undef DELUGE_SHIFT_BY_MORE_THAN_8
+
+	default: // 0: nothing moves. 16 and more: nothing stays, the caller refills every position anyway
+		return;
+	}
+
+	buffer[0] = vget_low_s16(low);
+	buffer[1] = vget_high_s16(low);
+	buffer[2] = vget_low_s16(high);
+	buffer[3] = vget_high_s16(high);
+}
+
+} // namespace deluge::dsp
