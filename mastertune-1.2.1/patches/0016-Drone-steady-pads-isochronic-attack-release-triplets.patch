+/// The tempo sync as one step, as the lower gold knob and the menu go through it: 0 off, then 1/1, 1/1T, 1/2, 1/2T
+/// ... 1/64, 1/64T (a triplet is three in the time of two, so it sits between its note and the next shorter one)
+constexpr int32_t kMaxSyncStep = 2 * Settings::kMaxSync;
+inline int32_t syncStep(const Settings::Tone& t) {
+	return (t.sync > 0) ? 2 * (t.sync - 1) + (t.triplet ? 1 : 0) + 1 : 0;
+}
+inline void setSyncStep(Settings::Tone& t, int32_t step) {
+	step = std::clamp(step, (int32_t)0, kMaxSyncStep);
+	if (step == 0) {
+		t.sync = 0; // Back to the beat in hertz; the triplet stays for when the sync comes back
+		return;
+	}
+	t.sync = (step + 1) / 2;
+	t.triplet = (step % 2) == 0;
+}
+/// "16" or "16T" for 1/16 and its triplet
