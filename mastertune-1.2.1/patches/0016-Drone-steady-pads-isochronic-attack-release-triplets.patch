+/// How an isochronic pulse rises (attack) or falls (release): 0 to 50, shown as 0 to 100 % of the half of the beat's
+/// cycle the pulse is on for. Never shorter than 1 ms, so it doesn't click.
+class PulseEdge final : public Integer {
+public:
+	PulseEdge(l10n::String name, l10n::String title, bool release) : Integer(name, title), release_(release) {}
+	[[nodiscard]] int32_t getMaxValue() const override { return Settings::kMaxPulseEdge; }
+	void readCurrentValue() override { this->setValue(release_ ? tone().pulseRelease : tone().pulseAttack); }
+	void writeCurrentValue() override { (release_ ? tone().pulseRelease : tone().pulseAttack) = this->getValue(); }
+	bool isRelevant(ModControllableAudio*, int32_t) override { return tone().mode == Settings::Mode::ISOCHRONIC; }
+
+protected:
+	void drawInteger(int32_t textWidth, int32_t textHeight, int32_t yPixel) override {
+		char buffer[12];
+		snprintf(buffer, sizeof(buffer), "%d%%", (int)(this->getValue() * 2));
+		deluge::hid::display::OLED::main.drawStringCentred(buffer, yPixel + OLED_MAIN_TOPMOST_PIXEL, textWidth,
+		                                                   textHeight);
+	}
+
+private:
+	bool release_;
+};
