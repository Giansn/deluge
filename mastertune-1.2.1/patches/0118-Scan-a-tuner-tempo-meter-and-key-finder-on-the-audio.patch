+/// The Scan's helpers, in their own namespace: dsp/ is built as a unity build, where the files' anonymous
+/// namespaces are one
+namespace scan_detail {
+
+constexpr float kPi = 3.14159265358979f;
+
+/// The half-band low-pass that halves the rate: a windowed sinc (Blackman, 23 taps), cut at a quarter of the rate it
+/// runs at. Symmetric, every other tap zero: the centre tap and these, at offsets 1, 3, 5 ... 11 on both sides.
+constexpr float kHalfBandCentre = 0.4999318f;
+constexpr std::array<float, 6> kHalfBandOdd = {0.309432992f,  -0.082065376f, 0.030561699f,
+                                               -0.010062152f, 0.002349748f,  -0.000182833f};
+
+/// The key profiles of Temperley (1999): how well each pitch class fits a major and a minor key, from its tonic
+constexpr std::array<float, 12> kMajorProfile = {5.0f, 2.0f, 3.5f, 2.0f, 4.5f, 4.0f,
+                                                 2.0f, 4.5f, 2.0f, 3.5f, 1.5f, 4.0f};
+constexpr std::array<float, 12> kMinorProfile = {5.0f, 2.0f, 3.5f, 4.5f, 2.0f, 4.0f,
+                                                 2.0f, 4.5f, 3.5f, 2.0f, 1.5f, 4.0f};
+
+/// The Pearson correlation of 12 values with a profile rotated to start at tonic
+float correlation(const float* x, const std::array<float, 12>& profile, int32_t tonic) {
+	float mx = 0, mp = 0;
+	for (int32_t i = 0; i < 12; i++) {
+		mx += x[i];
+		mp += profile[i];
+	}
+	mx /= 12;
+	mp /= 12;
+	float sxy = 0, sxx = 0, spp = 0;
+	for (int32_t i = 0; i < 12; i++) {
+		float dx = x[(tonic + i) % 12] - mx, dp = profile[i] - mp;
+		sxy += dx * dp;
+		sxx += dx * dx;
+		spp += dp * dp;
+	}
+	return (sxx > 0 && spp > 0) ? sxy / std::sqrt(sxx * spp) : 0;
+}
+
+/// The dot product of n values of a and b: on the Deluge sixteen at a time (NEON)
+float dot(const float* a, const float* b, int32_t n) {
+	const float* end = a + n;
+	float sum = 0;
+#if defined(__ARM_NEON)
+	float32x4_t acc0 = vdupq_n_f32(0), acc1 = vdupq_n_f32(0), acc2 = vdupq_n_f32(0), acc3 = vdupq_n_f32(0);
+	for (const float* stop = end - 15; a < stop; a += 16, b += 16) {
+		acc0 = vmlaq_f32(acc0, vld1q_f32(a), vld1q_f32(b));
+		acc1 = vmlaq_f32(acc1, vld1q_f32(a + 4), vld1q_f32(b + 4));
+		acc2 = vmlaq_f32(acc2, vld1q_f32(a + 8), vld1q_f32(b + 8));
+		acc3 = vmlaq_f32(acc3, vld1q_f32(a + 12), vld1q_f32(b + 12));
+	}
+	for (const float* stop = end - 3; a < stop; a += 4, b += 4) {
+		acc0 = vmlaq_f32(acc0, vld1q_f32(a), vld1q_f32(b));
+	}
+	float32x4_t acc = vaddq_f32(vaddq_f32(acc0, acc1), vaddq_f32(acc2, acc3));
+	float32x2_t pair = vadd_f32(vget_low_f32(acc), vget_high_f32(acc));
+	sum = vget_lane_f32(vpadd_f32(pair, pair), 0);
+#endif
+	while (a < end) {
+		sum += *a++ * *b++;
+	}
+	return sum;
+}
+
+/// log2(x) for x >= 1, to about 0.01: the exponent, and a parabola for the mantissa (the flux only compares them)
+float roughLog2(float x) {
+	int32_t bits;
+	std::memcpy(&bits, &x, 4);
+	float exponent = (float)((bits >> 23) - 127);
+	bits = (bits & 0x007FFFFF) | 0x3F800000; // The mantissa, 1 to 2
+	float m;
+	std::memcpy(&m, &bits, 4);
+	return exponent + (-0.34484843f * m + 2.02466578f) * m - 0.67487759f;
+}
+
+/// Where the parabola through (-1, a), (0, b), (1, c) has its extreme, -0.5 to 0.5 (0 if flat)
+float parabola(float a, float b, float c) {
+	float den = a - 2 * b + c;
+	if (den == 0) {
+		return 0;
+	}
+	return std::clamp(0.5f * (a - c) / den, -0.5f, 0.5f);
+}
+
+/// The median of n values (n at most 5), by insertion sort
+float median(const float* values, int32_t n) {
+	std::array<float, 5> v;
+	for (int32_t i = 0; i < n; i++) {
+		int32_t j = i;
+		while (j > 0 && v[j - 1] > values[i]) {
+			v[j] = v[j - 1];
+			j--;
+		}
+		v[j] = values[i];
+	}
+	return v[n / 2];
+}
+
