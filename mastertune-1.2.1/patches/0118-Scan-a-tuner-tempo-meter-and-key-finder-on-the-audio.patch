+/// mastertune-v18.4: the Scan view, a tuner, a tempo meter and a key finder on the audio input (Settings > Tuning >
+/// Scan, from Song view). It listens to the internal microphone, or to what is plugged into the mic or line input, and
+/// shows the note with its cents against the master tune (so at 432 Hz too), its frequency, the tempo in BPM and the
+/// key, major or minor, with its Camelot number (deluge::dsp::Scan does the analysis). The OLED shows one of note, Hz,
+/// BPM or key big and others small, with a needle for the cents; the 7-segment display shows the note, the Hz, the BPM
+/// or the key (AMIN, C#MAJ); the pads are the needle (a column per 6.7 cents, green in tune, the middle two when within
+/// 2 cents) and the sidebar the input's level.
+/// Select encoder: the input (Auto, Left, Right, Stereo); pressed: what is big (note, Hz, BPM, key). Horizontal
+/// encoder: the BPM halved or doubled (the music doesn't always say which it is). Back, Song or Scale: back to Song
+/// view.
+class ScanView final : public RootUI {
+public:
+	enum class Input : uint8_t { AUTO, LEFT, RIGHT, STEREO };
+	enum class Show : uint8_t { NOTE, HZ, BPM, KEY };
+
+	bool opened() override;
+	void focusRegained() override;
+
+	UIType getUIType() override { return UIType::SCAN; }
+	const char* getName() override { return "scan_view"; }
+	[[nodiscard]] bool supportsTriplets() const override { return false; }
+	/// Every 15 ms (the UI timer): analyses what came in, and shows it where it changed
+	void graphicsRoutine() override;
+
+	bool renderMainPads(uint32_t whichRows, RGB image[][kDisplayWidth + kSideBarWidth],
+	                    uint8_t occupancyMask[][kDisplayWidth + kSideBarWidth], bool drawUndefinedArea = true) override;
+	bool renderSidebar(uint32_t whichRows, RGB image[][kDisplayWidth + kSideBarWidth],
+	                   uint8_t occupancyMask[][kDisplayWidth + kSideBarWidth]) override;
+	void renderOLED(deluge::hid::display::oled_canvas::Canvas& canvas) override;
+
+	ActionResult buttonAction(deluge::hid::Button b, bool on, bool inCardRoutine) override;
+	ActionResult padAction(int32_t x, int32_t y, int32_t velocity) override;
+	ActionResult horizontalEncoderAction(int32_t offset) override;
+	ActionResult verticalEncoderAction(int32_t offset, bool inCardRoutine) override;
+	void selectEncoderAction(int8_t offset) override;
+
+	/// The analysis the audio routine feeds while the view is open, else nullptr
+	deluge::dsp::Scan* listening() { return scan_; }
+	/// The mix of the input's channels the analysis gets now (Auto: stereo with a jack plugged in, else the
+	/// internal microphone's left channel)
+	[[nodiscard]] deluge::dsp::Scan::Mix mix() const;
+
+private:
+	void exitToSongView();
+	void changed();
+	void showOnSevenSegment();
+	[[nodiscard]] const char* inputName() const;
+	/// The note nearest the pitch at the master tune, and the cents from it
+	void noteOf(float hz, int32_t* note, float* cents) const;
+	[[nodiscard]] float shownBpm() const;
+
+	deluge::dsp::Scan* scan_ = nullptr;
+	Input input_ = Input::AUTO;
+	Show show_ = Show::NOTE;
+	int32_t bpmOctave_ = 0; ///< The BPM shown doubled (1) or halved (-1)
+	float heldHz_ = 0;      ///< The last pitch, shown a moment after the tone stops
+	int32_t heldTicks_ = 0; ///< UI ticks (15 ms) it is still shown
+};
+
+extern ScanView scanView;
+
+namespace deluge::gui::menu_item::scan {
+/// Settings > Tuning > Scan: opens the view, from Song view
+class OpenView final : public MenuItem {
+public:
+	using MenuItem::MenuItem;
+	MenuItem* selectButtonPress() override;
+	bool shouldEnterSubmenu() override { return false; }
+	bool isRelevant(ModControllableAudio*, int32_t) override;
+};
+} // namespace deluge::gui::menu_item::scan
