+using deluge::dsp::Scan;
+
+ScanView scanView{};
+
+namespace {
+
+constexpr int32_t kHoldTicks = 100; ///< 1.5 s of UI ticks: the last note stays that long after the tone stops
+
+/// A frequency with as many decimals as fit in width characters: 55.003, 440.03, 1396.9
+void formatHz(float hz, char* buffer, size_t size) {
+	int32_t decimals = (hz < 100) ? 3 : (hz < 1000) ? 2 : 1;
+	int32_t scale = (decimals == 3) ? 1000 : (decimals == 2) ? 100 : 10;
+	int32_t value = (int32_t)std::lround(hz * (float)scale);
+	snprintf(buffer, size, "%d.%0*d", (int)(value / scale), (int)decimals, (int)(value % scale));
+}
+
+/// Cents with a sign and a decimal: +3.2, -0.4, 0.0
+void formatCents(float cents, char* buffer, size_t size) {
+	int32_t tenths = (int32_t)std::lround(cents * 10);
+	char sign = (tenths > 0) ? '+' : (tenths < 0) ? '-' : ' ';
+	tenths = std::abs(tenths);
+	snprintf(buffer, size, "%c%d.%d", sign, (int)(tenths / 10), (int)(tenths % 10));
+}
+
+/// The tempo with one decimal: 128.0
+void formatBpm(float bpm, char* buffer, size_t size) {
+	if (bpm <= 0) {
+		snprintf(buffer, size, "--");
+		return;
+	}
+	int32_t tenths = (int32_t)std::lround(bpm * 10);
+	snprintf(buffer, size, "%d.%d", (int)(tenths / 10), (int)(tenths % 10));
+}
+
+/// A key as the Deluge names notes (sharps): "A minor", "C# major"
+void formatKey(int32_t tonic, bool minor, char* buffer, size_t size) {
+	static constexpr const char* kNames[] = {"C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"};
+	snprintf(buffer, size, "%s %s", kNames[tonic], minor ? "minor" : "major");
+}
+
+/// A key on the Camelot wheel DJs mix by: the major keys 1B to 12B a fifth apart (C is 8B), a minor key the number of
+/// its relative major (A minor is 8A)
+void formatCamelot(int32_t tonic, bool minor, char* buffer, size_t size) {
+	int32_t major = minor ? (tonic + 3) % 12 : tonic;
+	snprintf(buffer, size, "%d%c", (int)(((7 * major) % 12 + 7) % 12 + 1), minor ? 'A' : 'B');
+}
+
+/// Where the cents' pad column is: 0 at -50, 15 at +50
+int32_t centsColumn(float cents) {
+	int32_t x = (int32_t)std::lround(7.5f + cents * 7.5f / 50.0f);
+	return std::clamp<int32_t>(x, 0, kDisplayWidth - 1);
+}
+
+} // namespace
+
+bool ScanView::opened() {
+	if (!scan_) {
+		void* memory = GeneralMemoryAllocator::get().allocLowSpeed(sizeof(Scan));
+		if (!memory) {
+			display->displayError(Error::INSUFFICIENT_RAM);
+			return false;
+		}
+		scan_ = new (memory) Scan();
+	}
+	heldHz_ = 0;
+	heldTicks_ = 0;
+	AudioEngine::startScan(scan_, mix());
+	focusRegained();
+	return true;
+}
+
+void ScanView::focusRegained() {
+	view.focusRegained();
+	view.setActiveModControllableTimelineCounter(currentSong);
+
+	indicator_leds::setLedState(IndicatorLED::SYNTH, false);
+	indicator_leds::setLedState(IndicatorLED::KIT, false);
+	indicator_leds::setLedState(IndicatorLED::MIDI, false);
+	indicator_leds::setLedState(IndicatorLED::CV, false);
+	indicator_leds::setLedState(IndicatorLED::KEYBOARD, false);
+	indicator_leds::setLedState(IndicatorLED::CROSS_SCREEN_EDIT, false);
+	indicator_leds::setLedState(IndicatorLED::SESSION_VIEW, false);
+	indicator_leds::setLedState(IndicatorLED::SCALE_MODE, true); // Scale takes you back, as in the drone view
+	indicator_leds::setLedState(IndicatorLED::BACK, false);      // The menu leaves it blinking
+
+	changed();
+}
+
+void ScanView::exitToSongView() {
+	AudioEngine::startScan(nullptr);
+	if (scan_) {
+		scan_->~Scan();
+		delugeDealloc(scan_);
+		scan_ = nullptr;
+	}
+	indicator_leds::setLedState(IndicatorLED::SCALE_MODE, false);
+	changeRootUI(&sessionView);
+}
+
+Scan::Mix ScanView::mix() const {
+	switch (input_) {
+	case Input::LEFT:
+		return Scan::Mix::LEFT;
+	case Input::RIGHT:
+		return Scan::Mix::RIGHT;
+	case Input::STEREO:
+		return Scan::Mix::STEREO;
+	default: // With nothing plugged in, the internal microphone, on the left channel only
+		return (AudioEngine::lineInPluggedIn || AudioEngine::micPluggedIn) ? Scan::Mix::STEREO : Scan::Mix::LEFT;
+	}
+}
+
+const char* ScanView::inputName() const {
+	switch (input_) {
+	case Input::LEFT:
+		return "Left";
+	case Input::RIGHT:
+		return "Right";
+	case Input::STEREO:
+		return "Stereo";
+	default:
+		return AudioEngine::lineInPluggedIn ? "Line" : AudioEngine::micPluggedIn ? "Mic in" : "Mic";
+	}
+}
+
+void ScanView::noteOf(float hz, int32_t* note, float* cents) const {
+	float a = (float)MasterTune::getTenthsHz() / 10.0f;
+	float semitones = 69.0f + 12.0f * std::log2(hz / a);
+	*note = (int32_t)std::lround(semitones);
+	*cents = (semitones - (float)*note) * 100.0f;
+}
+
+float ScanView::shownBpm() const {
+	float bpm = scan_ ? scan_->bpm() : 0;
+	return (bpmOctave_ > 0) ? bpm * 2 : (bpmOctave_ < 0) ? bpm / 2 : bpm;
+}
+
+void ScanView::graphicsRoutine() {
+	if (!scan_) {
+		return;
+	}
+	AudioEngine::startScan(scan_, mix());           // Auto follows a jack plugged in or out
+	scan_->setReference(MasterTune::getTenthsHz()); // The key's pitch classes from the master tune's A
+	bool anew = scan_->analyse();
+	if (scan_->pitchHz() > 0) {
+		heldHz_ = scan_->pitchHz();
+		heldTicks_ = kHoldTicks;
+	}
+	else if (heldTicks_ > 0 && --heldTicks_ == 0) {
+		heldHz_ = 0;
+		anew = true;
+	}
+	if (anew) {
+		changed();
+	}
+}
+
+void ScanView::changed() {
+	uiNeedsRendering(this);
+	if (display->haveOLED()) {
+		renderUIsForOled();
+	}
+	else {
+		showOnSevenSegment();
+	}
+}
+
+void ScanView::showOnSevenSegment() {
+	char buffer[16];
+	if (show_ == Show::KEY) {
+		// The tonic and MAJ or MIN: AMIN, C#MAJ (the sharp as the dot)
+		int32_t tonic = scan_ ? scan_->keyTonic() : -1;
+		if (tonic < 0) {
+			display->setText("----");
+			return;
+		}
+		static constexpr const char* kNames[] = {"C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"};
+		snprintf(buffer, sizeof(buffer), "%s%s", kNames[tonic], scan_->keyMinor() ? "MIN" : "MAJ");
+		display->setText(buffer);
+		return;
+	}
+	if (show_ == Show::BPM) {
+		float bpm = shownBpm();
+		if (bpm <= 0) {
+			display->setText("----");
+			return;
+		}
+		int32_t tenths = (int32_t)std::lround(bpm * 10);
+		snprintf(buffer, sizeof(buffer), "%d", (int)tenths);
+		display->setText(buffer, true, 1); // 128.0
+		return;
+	}
+	if (heldHz_ <= 0) {
+		display->setText("----");
+		return;
+	}
+	if (show_ == Show::HZ) {
+		// Four digits, with as many after the point as fit: 55.00, 440.0, 1397
+		int32_t hundredths = (int32_t)std::lround(heldHz_ * 100);
+		uint8_t dot = 255;
+		if (hundredths < 10000) {
+			snprintf(buffer, sizeof(buffer), "%d", (int)hundredths);
+			dot = 1;
+		}
+		else if (hundredths < 100000) {
+			snprintf(buffer, sizeof(buffer), "%d", (int)(hundredths / 10));
+			dot = 2;
+		}
+		else {
+			snprintf(buffer, sizeof(buffer), "%d", (int)(hundredths / 100));
+		}
+		display->setText(buffer, true, dot);
+		return;
+	}
+	int32_t note;
+	float cents;
+	noteOf(heldHz_, &note, &cents);
+	noteCodeToString(note, buffer); // The cents are on the pads
+	display->setText(buffer);
+}
+
+bool ScanView::renderMainPads(uint32_t whichRows, RGB image[][kDisplayWidth + kSideBarWidth],
+                              uint8_t occupancyMask[][kDisplayWidth + kSideBarWidth], bool drawUndefinedArea) {
+	if (!image) {
+		return true;
+	}
+	// The needle: the cents as a column, the middle two dim as the mark; within 2 cents both green
+	int32_t column = -1;
+	bool inTune = false;
+	RGB colour = RGB::monochrome(0);
+	if (heldHz_ > 0) {
+		int32_t note;
+		float cents;
+		noteOf(heldHz_, &note, &cents);
+		inTune = std::abs(cents) <= 2.0f;
+		column = centsColumn(cents);
+		colour = inTune ? RGB{0, 255, 0} : (std::abs(cents) <= 10.0f) ? RGB{255, 160, 0} : RGB{255, 0, 0};
+		if (heldTicks_ < kHoldTicks && scan_ && scan_->pitchHz() <= 0) {
+			colour = colour.dim(2); // Held: the tone has stopped
+		}
+	}
+	PadLEDs::renderingLock = true;
+	for (int32_t y = 0; y < kDisplayHeight; y++) {
+		if (!(whichRows & (1 << y))) {
+			continue;
+		}
+		for (int32_t x = 0; x < kDisplayWidth; x++) {
+			RGB pixel = RGB::monochrome(0);
+			bool middle = (x == kDisplayWidth / 2 - 1 || x == kDisplayWidth / 2);
+			if (middle) {
+				pixel = inTune ? colour : RGB::monochrome(24);
+			}
+			if (x == column && !inTune) {
+				pixel = colour;
+			}
+			image[y][x] = pixel;
+			if (occupancyMask) {
+				occupancyMask[y][x] = 64;
+			}
+		}
+	}
+	PadLEDs::renderingLock = false;
+	return true;
+}
+
+bool ScanView::renderSidebar(uint32_t whichRows, RGB image[][kDisplayWidth + kSideBarWidth],
+                             uint8_t occupancyMask[][kDisplayWidth + kSideBarWidth]) {
+	if (!image) {
+		return true;
+	}
+	// The input's level on the audition column, -60 to 0 dBFS from the bottom (7.5 dB a pad); the mute column dark
+	float level = scan_ ? scan_->levelDb() : -120.0f;
+	int32_t lit = std::clamp<int32_t>((int32_t)std::lround((level + 60.0f) / 7.5f), 0, kDisplayHeight);
+	for (int32_t y = 0; y < kDisplayHeight; y++) {
+		if (!(whichRows & (1 << y))) {
+			continue;
+		}
+		image[y][kDisplayWidth] = RGB::monochrome(0);
+		image[y][kDisplayWidth + 1] =
+		    (y < lit) ? ((y >= kDisplayHeight - 1) ? RGB{255, 0, 0} : RGB{0, 160, 0}) : RGB::monochrome(0);
+		if (occupancyMask) {
+			occupancyMask[y][kDisplayWidth] = 64;
+			occupancyMask[y][kDisplayWidth + 1] = 64;
+		}
+	}
+	return true;
+}
+
+void ScanView::renderOLED(deluge::hid::display::oled_canvas::Canvas& canvas) {
+	char title[32];
+	int32_t tenthsHz = MasterTune::getTenthsHz();
+	if (tenthsHz == MasterTune::kDefaultTenthsHz) {
+		snprintf(title, sizeof(title), "Scan %s", inputName());
+	}
+	else if (tenthsHz % 10 == 0) {
+		snprintf(title, sizeof(title), "Scan %s %d", inputName(), (int)(tenthsHz / 10));
+	}
+	else {
+		snprintf(title, sizeof(title), "Scan %s %d.%d", inputName(), (int)(tenthsHz / 10), (int)(tenthsHz % 10));
+	}
+	canvas.drawScreenTitle(title);
+
+	char note[12] = "--", cents[12] = "", hz[16] = "--", bpm[12];
+	float centsValue = 0;
+	if (heldHz_ > 0) {
+		int32_t code;
+		noteOf(heldHz_, &code, &centsValue);
+		noteCodeToString(code, note);
+		formatCents(centsValue, cents, sizeof(cents));
+		formatHz(heldHz_, hz, sizeof(hz));
+	}
+	formatBpm(shownBpm(), bpm, sizeof(bpm));
+
+	char big[24], small[40];
+	int32_t tonic = scan_ ? scan_->keyTonic() : -1;
+	switch (show_) {
+	case Show::NOTE:
+		snprintf(big, sizeof(big), "%s %s", note, cents);
+		snprintf(small, sizeof(small), "%s Hz  %s BPM", hz, bpm);
+		break;
+	case Show::HZ:
+		snprintf(big, sizeof(big), "%s Hz", hz);
+		snprintf(small, sizeof(small), "%s %s  %s BPM", note, cents, bpm);
+		break;
+	case Show::BPM:
+		snprintf(big, sizeof(big), "%s BPM", bpm);
+		snprintf(small, sizeof(small), "%s %s  %s Hz", note, cents, hz);
+		break;
+	default: // The key, with its Camelot number and the tempo: a DJ's two
+		if (tonic >= 0) {
+			char camelot[8];
+			formatKey(tonic, scan_->keyMinor(), big, sizeof(big));
+			formatCamelot(tonic, scan_->keyMinor(), camelot, sizeof(camelot));
+			snprintf(small, sizeof(small), "Camelot %s%s%s BPM", camelot, (camelot[2] != 0) ? " " : "  ", bpm);
+		}
+		else {
+			snprintf(big, sizeof(big), "--");
+		}
+		break;
+	}
+	bool nothing = (show_ == Show::KEY) ? (tonic < 0) : (heldHz_ <= 0 && show_ != Show::BPM);
+	if (nothing && scan_) {
+		snprintf(small, sizeof(small), "Input %d dB  %s BPM", (int)std::lround(scan_->levelDb()), bpm);
+	}
+	// Below the title's line (a pixel apart), the needle below it, the small line at the bottom
+	canvas.drawStringCentred(big, OLED_MAIN_TOPMOST_PIXEL + 14, kTextBigSpacingX, kTextBigSizeY);
+
+	// The needle: -50 to +50 cents, a pixel a cent, the middle marked
+	constexpr int32_t kMiddle = OLED_MAIN_WIDTH_PIXELS / 2;
+	constexpr int32_t kY = OLED_MAIN_TOPMOST_PIXEL + 31;
+	canvas.drawHorizontalLine(kY, kMiddle - 50, kMiddle + 50);
+	canvas.drawVerticalLine(kMiddle, kY - 3, kY + 1);
+	canvas.drawVerticalLine(kMiddle - 50, kY - 1, kY);
+	canvas.drawVerticalLine(kMiddle + 50, kY - 1, kY);
+	if (heldHz_ > 0) {
+		int32_t x = kMiddle + std::clamp<int32_t>((int32_t)std::lround(centsValue), -50, 50);
+		canvas.drawRectangle(x - 1, kY - 4, x + 1, kY - 1);
+	}
+
+	canvas.drawStringCentred(small, OLED_MAIN_TOPMOST_PIXEL + 34, kTextSpacingX, kTextSizeYUpdated);
+}
+
+ActionResult ScanView::buttonAction(deluge::hid::Button b, bool on, bool inCardRoutine) {
+	using namespace deluge::hid::button;
+
+	// Back to Song view
+	if (b == BACK || b == SCALE_MODE || (b == SESSION_VIEW && !Buttons::isShiftButtonPressed())) {
+		if (on && currentUIMode == UI_MODE_NONE) {
+			if (inCardRoutine) {
+				return ActionResult::REMIND_ME_OUTSIDE_CARD_ROUTINE;
+			}
+			exitToSongView();
+		}
+		return ActionResult::DEALT_WITH;
+	}
+
+	// What is big: note, Hz, BPM, key
+	if (b == SELECT_ENC && !Buttons::isShiftButtonPressed()) {
+		if (on && currentUIMode == UI_MODE_NONE) {
+			static constexpr const char* kPopups[] = {"NOTE", "HZ", "BPM", "KEY"};
+			show_ = (Show)(((int32_t)show_ + 1) % 4);
+			display->displayPopup(kPopups[(int32_t)show_]);
+			changed();
+		}
+		return ActionResult::DEALT_WITH;
+	}
+
+	// Play, record, tempo, save, load, settings...
+	return view.buttonAction(b, on, inCardRoutine);
+}
+
+ActionResult ScanView::padAction(int32_t x, int32_t y, int32_t velocity) {
+	return ActionResult::DEALT_WITH; // The pads only show
+}
+
+ActionResult ScanView::horizontalEncoderAction(int32_t offset) {
+	// The BPM doubled or halved: at 88 or 176, 87 or 174, the music doesn't always say which
+	bpmOctave_ = std::clamp<int32_t>(bpmOctave_ + (offset > 0 ? 1 : -1), -1, 1);
+	display->displayPopup((bpmOctave_ > 0) ? "BPM X2" : (bpmOctave_ < 0) ? "BPM /2" : "BPM X1");
+	changed();
+	return ActionResult::DEALT_WITH;
+}
+
+ActionResult ScanView::verticalEncoderAction(int32_t offset, bool inCardRoutine) {
+	return ActionResult::DEALT_WITH;
+}
+
+void ScanView::selectEncoderAction(int8_t offset) {
+	int32_t next = ((int32_t)input_ + (offset > 0 ? 1 : 3)) % 4;
+	input_ = (Input)next;
+	if (scan_) {
+		scan_->reset(); // Another input: its pitch, tempo and key anew
+	}
+	heldHz_ = 0;
+	heldTicks_ = 0;
+	AudioEngine::startScan(scan_, mix()); // The new mix from now
+	display->displayPopup(inputName());
+	changed();
+}
+
+// Settings > Tuning > Scan opens the view, from Song view only: the view goes back there (as the drone view)
+bool deluge::gui::menu_item::scan::OpenView::isRelevant(ModControllableAudio*, int32_t) {
+	return getRootUI() == &sessionView;
+}
+
+MenuItem* deluge::gui::menu_item::scan::OpenView::selectButtonPress() {
+	soundEditor.exitCompletely();
+	changeRootUI(&scanView);
+	return NO_NAVIGATION;
+}
