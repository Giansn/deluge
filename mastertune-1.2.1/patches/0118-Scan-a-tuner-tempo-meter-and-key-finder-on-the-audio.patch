+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace deluge::dsp {
+
+/// mastertune-v18.4: what the Scan view hears at the audio input: the pitch of a tone, to tune an instrument by, the
+/// tempo of music and its key. The audio routine feeds it the input (feed(): the channels mixed as chosen and halved
+/// to 22.05 kHz, a few operations per sample); the UI's routine analyses what came in (analyse()):
+/// - Pitch, every 93 ms: YIN (de Cheveigné and Kawahara, 2002) on the last 93 ms at 11.025 kHz finds the period, 30 Hz
+///   to 2 kHz; then the period is measured again at 22.05 kHz over as many periods as make 10 ms at least, where a
+///   steady tone gives it to a small fraction of a cent. Nothing when the input is quieter than kSilenceDb or has no
+///   clear period (noise, drums).
+/// - Tempo, every second: the spectral flux (how much the log spectrum rises, 512 points every 11.6 ms), its
+///   autocorrelation over the last 8 s: the beat's lag, where it, its double and quadruple (half a bar, a bar) and
+///   its half (the eighths) repeat most, weighted towards 120 BPM, 60 to 200 BPM. Which of a tempo and its double is
+///   meant, the music doesn't always say: the view can halve or double what it shows. Nothing without at least 4 clear
+///   onsets.
+/// - Key, every 0.5 s: the last 371 ms at a quarter of kRate (5.5 kHz), a 2048-point FFT (2.7 Hz a bin); the peaks
+///   from 60 Hz to 2.5 kHz that stand out (a note's partials: drums and noise have next to none) counted into the 12
+///   pitch classes against the master tune (the chroma), summed over about the last 10 s, and the major or minor key
+///   whose profile (Temperley, 1999, with the notes' harmonics) matches best. Nothing until it matches clearly, with 3
+///   pitch classes at least (a held note is no key); gone after 10 s without notes.
+/// analyse() does one of the dearer parts per call (a pitch frame, a chroma frame or a tempo estimate, 0.65 ms at most
+/// on the Deluge); pitch and key take turns by how long each has waited. The object is about 95 kB: the view allocates
+/// it while open.
+class Scan {
+public:
+	enum class Mix : uint8_t { LEFT, RIGHT, STEREO };
+
+	static constexpr int32_t kRate = 22050;      ///< The analysis' rate: the input's 44.1 kHz halved
+	static constexpr int32_t kRingSize = 8192;   ///< 371 ms of input waiting for analyse()
+	static constexpr int32_t kPitchFrame = 2048; ///< 93 ms at kRate, the pitch's frame
+	static constexpr int32_t kPitchHop = 2048;   ///< 93 ms between two pitch frames
+	static constexpr int32_t kCoarseFrame = kPitchFrame / 2;
+	static constexpr int32_t kCoarseTauMin = 5;    ///< At 11.025 kHz: 2205 Hz
+	static constexpr int32_t kCoarseTauMax = 368;  ///< At 11.025 kHz: 30 Hz
+	static constexpr int32_t kOnsetFft = 512;      ///< 23 ms
+	static constexpr int32_t kOnsetHop = 256;      ///< 11.6 ms: 86.1 onset values a second
+	static constexpr int32_t kOnsetRing = 1024;    ///< 11.9 s of onset values
+	static constexpr int32_t kTempoWindow = 689;   ///< The last 8 s of them for the tempo
+	static constexpr int32_t kTempoEvery = 86;     ///< Onset values between two tempo estimates (1 s)
+	static constexpr int32_t kTempoMinLag = 25;    ///< 207 BPM
+	static constexpr int32_t kTempoMaxLag = 86;    ///< 60 BPM
+	static constexpr int32_t kChromaFrame = 2048;  ///< At kRate / 4 (5.5 kHz): 371 ms, 2.7 Hz between bins
+	static constexpr int32_t kChromaEvery = 11025; ///< Samples at kRate between two chroma frames (0.5 s)
+	static constexpr float kChromaDecay = 0.95f;   ///< Per chroma frame: the key hears about the last 10 s
+	static constexpr float kPeakContrast = 3.0f;   ///< A partial: that many times the bins around it
+	static constexpr float kTonal = 0.01f;         ///< A frame with notes: its partials' share of the band
+	static constexpr int32_t kQuietFrames = 20;    ///< Chroma frames without notes (10 s) until the key is gone
+	static constexpr float kSilenceDb = -60.0f;
+
+	Scan() {
+		makeTables();
+		reset();
+	}
+	/// Forgets what it heard: pitch, tempo and key start anew (the view's input changed)
+	void reset();
+
+	/// Audio routine: numFrames frames of the input, stereo interleaved, 32 bits (the codec's 24 at the top)
+	void feed(const int32_t* frames, int32_t numFrames, Mix mix);
+
+	/// UI routine: analyses what came in since the last call; true if a result changed
+	bool analyse();
+
+	[[nodiscard]] float pitchHz() const { return pitchHz_; } ///< 0: no pitch
+	[[nodiscard]] float bpm() const { return bpm_; }         ///< 0: no tempo (yet)
+	[[nodiscard]] float levelDb() const { return levelDb_; } ///< The input's level over the last 93 ms, dBFS (RMS)
+	[[nodiscard]] uint32_t fed() const { return written_; }  ///< Samples at kRate fed in all
+	/// The key's tonic, 0 (C) to 11 (B), or -1: no key (yet); keyMinor(): minor, else major
+	[[nodiscard]] int32_t keyTonic() const { return keyTonic_; }
+	[[nodiscard]] bool keyMinor() const { return keyMinor_; }
+	/// The master tune the chroma counts the pitch classes from, in tenths of Hz (the view sets it)
+	void setReference(int32_t tenthsHz) { referenceHz_ = (float)tenthsHz / 10.0f; }
+
+	/// The tempo of n onset values at kOnsetRate a second, or 0 (x is changed): separate for the tests
+	float tempoOf(float* x, int32_t n);
+	/// The pitch of kPitchFrame samples at kRate, or 0: separate for the tests
+	float pitchOf(const float* x);
+	/// The key of a chroma (12 values from C): its tonic (-1: none clear) and whether minor, and how well it matches
+	/// (the correlation with the key's profile): separate for the tests
+	int32_t keyOf(const float* chroma, bool* minor, float* match = nullptr) const;
+	/// A chroma frame of the last 371 ms, as analyse() takes one every kChromaEvery: separate for the tests
+	void chromaFrame();
+
+	static constexpr float kOnsetRate = (float)kRate / kOnsetHop;
+
+private:
+	void onsetFrame(const float* x);
+	void pitchFrame(const float* x);
+	void makeTables();
+	void tempoEstimate();
+	/// The chroma of the last kChromaFrame samples at the quarter rate into chroma (12 values, zero before, summing to
+	/// 1): false if the frame has no notes
+	bool tonalChroma(float* chroma);
+	/// A complex FFT of n = 256 or 1024 points in place, its input in bit-reversed order
+	void fft(float* re, float* im, int32_t n) const;
+	[[nodiscard]] float at(uint32_t i) const { return ring_[i & (kRingSize - 1)]; }
+
+	// Halving the rate: a half-band FIR (23 taps, of which 12 not zero), on the input's samples
+	static constexpr int32_t kHalfBandTaps = 23;
+	/// The key's low-pass before a quarter of the rate, and with a zero tap after them: two NEON blocks of 16
+	static constexpr int32_t kQuarterBandTaps = 31;
+	static constexpr int32_t kQuarterBandPadded = 32;
+	std::array<float, 2 * kHalfBandTaps> history_{}; ///< Twice over: the last kHalfBandTaps in one piece
+	int32_t historyPos_ = 0;
+	bool odd_ = false;
+
+	std::array<float, kRingSize> ring_{};
+	uint32_t written_ = 0;   ///< Samples at kRate written into ring_
+	uint32_t pitchDone_ = 0; ///< Up to where pitch frames were taken
+	uint32_t onsetDone_ = 0; ///< Up to where onset values were taken
+
+	std::array<float, kPitchFrame> frame_{}; ///< The pitch frame, and scratch for an onset frame and the tempo
+	std::array<float, kCoarseFrame> coarse_{};
+	std::array<float, kCoarseTauMax + 1> difference_{};
+
+	/// The FFTs' tables, made once: Hann windows, the twiddles of a 1024-point complex FFT (the 256-point one
+	/// takes every fourth), those for taking a real FFT of 2048 (or 512) points apart, the bit reversals
+	struct Tables {
+		std::array<float, kOnsetFft> hann512;
+		std::array<float, kChromaFrame> hann2048;
+		std::array<float, 512> cos1024, sin1024;
+		std::array<float, 1025> cos2048, sin2048;
+		std::array<uint16_t, 1024> reversed1024;
+		std::array<uint16_t, 256> reversed256;
+		std::array<float, kQuarterBandPadded> quarterBand; ///< The low-pass (2.4 kHz) before taking every fourth sample
+		std::array<float, 12> majorProfile, minorProfile;  ///< The key profiles with the notes' harmonics
+	};
+	Tables tables_;
+
+	std::array<float, kChromaFrame / 2> fftRe_{}; ///< Both FFTs': the onset's uses the first 256
+	std::array<float, kChromaFrame / 2> fftIm_{};
+	std::array<float, kOnsetFft / 2 + 1> lastLog_{};
+	std::array<float, kOnsetRing> onsets_{};
+	std::array<float, 4 * kTempoMaxLag + 2> correlations_{}; ///< tempoOf()'s, per lag, as it needs them
+	uint32_t onsetCount_ = 0;
+	uint32_t sinceTempo_ = 0;
+	std::array<float, 3> bpms_{};
+	int32_t numBpms_ = 0;
+	std::array<float, 3> pitches_{};
+	std::array<float, kChromaFrame> quarter_{}; ///< The input at a quarter of kRate, for the key: the last 371 ms
+	uint32_t quarterNext_ = 0;                  ///< The middle (at kRate) of the next quarter-rate sample's window
+	uint32_t quarterCount_ = 0;                 ///< Quarter-rate samples made
+	std::array<float, 12> chroma_{};            ///< Summed over the chroma frames, the older ones fading (kChromaDecay)
+	int32_t chromaFrames_ = 0;                  ///< Frames with notes summed into chroma_
+	int32_t quietFrames_ = 0;                   ///< Frames without notes since the last with
+	uint32_t chromaDone_ = 0;                   ///< Up to where chroma frames were taken
+	int32_t keyTonic_ = -1;
+	bool keyMinor_ = false;
+	int32_t candidateTonic_ = -1; ///< A new key is shown when it wins twice in a row
+	bool candidateMinor_ = false;
+	float referenceHz_ = 440.0f;
+	int32_t numPitches_ = 0;
+	int32_t pitchMisses_ = 0;
+
+	float pitchHz_ = 0;
+	float bpm_ = 0;
+	float levelDb_ = -120.0f;
+};
+
+} // namespace deluge::dsp
