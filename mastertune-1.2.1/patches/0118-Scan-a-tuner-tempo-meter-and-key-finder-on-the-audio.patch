+void Scan::makeTables() {
+	using scan_detail::kPi;
+	Tables& t = tables_;
+	for (int32_t i = 0; i < kOnsetFft; i++) {
+		t.hann512[i] = 0.5f - 0.5f * std::cos(2 * kPi * (float)i / kOnsetFft);
+	}
+	for (int32_t i = 0; i < kChromaFrame; i++) {
+		t.hann2048[i] = 0.5f - 0.5f * std::cos(2 * kPi * (float)i / kChromaFrame);
+	}
+	for (int32_t i = 0; i < 512; i++) {
+		t.cos1024[i] = std::cos(2 * kPi * (float)i / 1024);
+		t.sin1024[i] = std::sin(2 * kPi * (float)i / 1024);
+	}
+	for (int32_t i = 0; i <= 1024; i++) {
+		t.cos2048[i] = std::cos(2 * kPi * (float)i / 2048);
+		t.sin2048[i] = std::sin(2 * kPi * (float)i / 2048);
+	}
+	for (int32_t i = 0; i < 1024; i++) {
+		int32_t r = 0;
+		for (int32_t b = 0; b < 10; b++) {
+			r |= ((i >> b) & 1) << (9 - b);
+		}
+		t.reversed1024[i] = r;
+	}
+	for (int32_t i = 0; i < 256; i++) {
+		int32_t r = 0;
+		for (int32_t b = 0; b < 8; b++) {
+			r |= ((i >> b) & 1) << (7 - b);
+		}
+		t.reversed256[i] = r;
+	}
+	// The quarter band: a windowed sinc (Blackman, 31 taps) cut at 2.4 kHz, for 22.05 kHz
+	constexpr int32_t kMiddle = kQuarterBandTaps / 2;
+	float sum = 0;
+	for (int32_t i = 0; i < kQuarterBandTaps; i++) {
+		float n = (float)(i - kMiddle);
+		float cut = 2400.0f / kRate;
+		float sinc = (i == kMiddle) ? 2 * cut : std::sin(2 * kPi * cut * n) / (kPi * n);
+		float w = 0.42f - 0.5f * std::cos(kPi * (float)i / kMiddle) + 0.08f * std::cos(2 * kPi * (float)i / kMiddle);
+		t.quarterBand[i] = sinc * w;
+		sum += t.quarterBand[i];
+	}
+	for (int32_t i = 0; i < kQuarterBandTaps; i++) {
+		t.quarterBand[i] /= sum;
+	}
+	t.quarterBand[kQuarterBandTaps] = 0; // The padding: 32 taps, two NEON blocks of 16
+	// The key profiles as a chroma of real notes has them: each pitch class with its first four harmonics (the octave,
+	// the twelfth, two octaves), 0.6 as strong each, a harmonic between two classes shared (Essentia's Key does the
+	// same, "usePolyphony"). Else a note's twelfth pulls the key a fifth up
+	for (int32_t minor = 0; minor < 2; minor++) {
+		const std::array<float, 12>& base = minor ? scan_detail::kMinorProfile : scan_detail::kMajorProfile;
+		std::array<float, 12>& profile = minor ? t.minorProfile : t.majorProfile;
+		profile.fill(0);
+		for (int32_t pc = 0; pc < 12; pc++) {
+			float weight = base[pc];
+			for (int32_t harmonic = 1; harmonic <= 4; harmonic++) {
+				float at = (float)pc + 12.0f * std::log2((float)harmonic);
+				int32_t below = (int32_t)at;
+				float c = std::cos(0.5f * kPi * (at - (float)below));
+				profile[below % 12] += c * c * weight;
+				profile[(below + 1) % 12] += (1 - c * c) * weight;
+				weight *= 0.6f;
+			}
+		}
+	}
+}
+
+void Scan::reset() {
+	history_.fill(0);
+	historyPos_ = 0;
+	odd_ = false;
+	ring_.fill(0);
+	written_ = pitchDone_ = onsetDone_ = 0;
+	lastLog_.fill(0);
+	onsets_.fill(0);
+	onsetCount_ = sinceTempo_ = 0;
+	numBpms_ = numPitches_ = pitchMisses_ = 0;
+	pitchHz_ = bpm_ = 0;
+	levelDb_ = -120.0f;
+	quarter_.fill(0);
+	quarterNext_ = kQuarterBandTaps / 2; // The first window from sample 0
+	quarterCount_ = 0;
+	chroma_.fill(0);
+	chromaFrames_ = quietFrames_ = 0;
+	chromaDone_ = 0;
+	keyTonic_ = candidateTonic_ = -1;
+	keyMinor_ = candidateMinor_ = false;
+}
+
+void Scan::feed(const int32_t* frames, int32_t numFrames, Mix mix) {
+	using namespace scan_detail;
+	constexpr float kScale = 1.0f / 2147483648.0f;
+	// The channel, or both at half: once per block, not per sample
+	const int32_t* first = frames + (mix == Mix::RIGHT ? 1 : 0);
+	const int32_t* second = (mix == Mix::STEREO) ? frames + 1 : first;
+	const float scale = (mix == Mix::STEREO) ? 0.5f * kScale : kScale;
+	const float weight = (mix == Mix::STEREO) ? 1.0f : 0.0f;
+	for (int32_t i = 0; i < numFrames; i++) {
+		float x = ((float)first[2 * i] + weight * (float)second[2 * i]) * scale;
+		// The history twice over, so that the last kHalfBandTaps samples are always in one piece, oldest first
+		history_[historyPos_] = x;
+		history_[historyPos_ + kHalfBandTaps] = x;
+		historyPos_ = (historyPos_ == kHalfBandTaps - 1) ? 0 : historyPos_ + 1;
+		odd_ = !odd_;
+		if (odd_) {
+			continue; // Every second sample only
+		}
+		const float* p = &history_[historyPos_]; // p[11] the centre
+		float y = kHalfBandCentre * p[11] + kHalfBandOdd[0] * (p[10] + p[12]) + kHalfBandOdd[1] * (p[8] + p[14])
+		          + kHalfBandOdd[2] * (p[6] + p[16]) + kHalfBandOdd[3] * (p[4] + p[18])
+		          + kHalfBandOdd[4] * (p[2] + p[20]) + kHalfBandOdd[5] * (p[0] + p[22]);
+		ring_[written_ & (kRingSize - 1)] = y;
+		written_++;
+	}
+}
+
+float Scan::pitchOf(const float* x) {
+	using namespace scan_detail;
+	// The level: nothing below kSilenceDb
+	float energy = 0;
+	for (int32_t i = 0; i < kPitchFrame; i++) {
+		energy += x[i] * x[i];
+	}
+	levelDb_ = 10.0f * std::log10(std::max(energy / kPitchFrame, 1e-12f));
+	if (levelDb_ < kSilenceDb) {
+		return 0;
+	}
+
+	// Coarse: YIN at half the rate, 11.025 kHz (the frame halved through the half-band filter; the few outputs at
+	// the ends with the frame's missing samples as silence)
+	for (int32_t i = 0; i < kCoarseFrame; i++) {
+		int32_t centre = 2 * i + 1;
+		if (centre >= 11 && centre + 11 < kPitchFrame) {
+			const float* p = x + centre - 11;
+			coarse_[i] = kHalfBandCentre * p[11] + kHalfBandOdd[0] * (p[10] + p[12]) + kHalfBandOdd[1] * (p[8] + p[14])
+			             + kHalfBandOdd[2] * (p[6] + p[16]) + kHalfBandOdd[3] * (p[4] + p[18])
+			             + kHalfBandOdd[4] * (p[2] + p[20]) + kHalfBandOdd[5] * (p[0] + p[22]);
+			continue;
+		}
+		float y = kHalfBandCentre * x[centre];
+		for (int32_t k = 0; k < 6; k++) {
+			int32_t offset = 2 * k + 1;
+			float before = (centre - offset >= 0) ? x[centre - offset] : 0;
+			float after = (centre + offset < kPitchFrame) ? x[centre + offset] : 0;
+			y += kHalfBandOdd[k] * (before + after);
+		}
+		coarse_[i] = y;
+	}
+	// d(t) = sum over j < n of (x[j] - x[j + t])^2 = e0 + e(t) - 2 r(t): the energies e run along, r is a dot
+	// product. Lag by lag, as far as the first dip whose bottom (the parabola through it and its neighbours: a high
+	// note's period falls between two lags, where both can be well above it) is under the threshold: a note's period
+	// is found after its own lags only
+	constexpr int32_t n = kCoarseFrame - kCoarseTauMax;
+	constexpr float kThreshold = 0.15f;
+	const float* c = coarse_.data();
+	float e0 = dot(c, c, n);
+	float et = e0;
+	float running = 0;
+	float shift = 0;
+	difference_[0] = 1;
+	int32_t tau = 0;
+	for (int32_t t = 1; t <= kCoarseTauMax; t++) {
+		et += c[t + n - 1] * c[t + n - 1] - c[t - 1] * c[t - 1];
+		float d = std::max(e0 + et - 2 * dot(c, c + t, n), 0.0f);
+		running += d;
+		difference_[t] = (running > 0) ? d * (float)t / running : 1; // The cumulative mean normalised difference
+		int32_t m = t - 1; // A dip at the lag before, now that its neighbours are known
+		if (m >= kCoarseTauMin && difference_[m] <= difference_[m - 1] && difference_[m] <= difference_[t]) {
+			shift = parabola(difference_[m - 1], difference_[m], difference_[t]);
+			if (difference_[m] - 0.25f * (difference_[m - 1] - difference_[t]) * shift < kThreshold) {
+				tau = m;
+				break;
+			}
+		}
+	}
+	if (tau == 0) {
+		return 0; // No clear period: noise, drums, a chord
+	}
+	float period = 2.0f * ((float)tau + shift);
+
+	// Fine: at the full kRate, the period measured again over 1, 2, 4 ... periods up to 10 ms or more, each step from
+	// the one before (a window of +-2 samples, always under half a period)
+	int32_t periods = 1;
+	while (true) {
+		float lag = periods * period;
+		int32_t centre = (int32_t)std::lround(lag);
+		if (centre + 2 >= kPitchFrame / 2) {
+			break;
+		}
+		// d(k) = e0 + e(k) - 2 r(k) over count samples, as in the coarse search
+		int32_t count = kPitchFrame - (centre + 2);
+		float e0 = dot(x, x, count);
+		float ek = dot(x + centre - 2, x + centre - 2, count);
+		std::array<float, 5> d;
+		for (int32_t i = 0; i < 5; i++) {
+			int32_t k = centre - 2 + i;
+			if (i > 0) {
+				ek += x[k + count - 1] * x[k + count - 1] - x[k - 1] * x[k - 1];
+			}
+			d[i] = e0 + ek - 2 * dot(x, x + k, count);
+		}
+		int32_t best = (int32_t)(std::min_element(d.begin(), d.end()) - d.begin());
+		if (best == 0 || best == 4) {
+			break; // Not in the window: keep what there is
+		}
+		period = ((float)(centre - 2 + best) + parabola(d[best - 1], d[best], d[best + 1])) / (float)periods;
+		if (lag >= 0.01f * kRate) {
+			break;
+		}
+		periods *= 2;
+	}
+	return (float)kRate / period;
+}
+
+void Scan::pitchFrame(const float* x) {
+	float f = pitchOf(x);
+	if (f <= 0) {
+		if (++pitchMisses_ >= 3) { // About 140 ms without: gone
+			pitchHz_ = 0;
+			numPitches_ = 0;
+		}
+		return;
+	}
+	pitchMisses_ = 0;
+	// The median of the last three, if they are within a quarter tone of each other: steady on a held note, and a
+	// new note shows at once
+	if (numPitches_ > 0 && std::abs(std::log2(f / pitches_[(numPitches_ - 1) % 3])) > 1.0f / 24) {
+		numPitches_ = 0;
+	}
+	pitches_[numPitches_ % 3] = f;
+	numPitches_++;
+	pitchHz_ = (numPitches_ >= 3) ? scan_detail::median(pitches_.data(), 3) : f;
+}
+
+void Scan::fft(float* re, float* im, int32_t n) const {
+	// Pairs first, where the twiddle is 1
+	for (int32_t a = 0; a < n; a += 2) {
+		float r = re[a + 1], i = im[a + 1];
+		re[a + 1] = re[a] - r;
+		im[a + 1] = im[a] - i;
+		re[a] += r;
+		im[a] += i;
+	}
+	const int32_t stride = 1024 / n; // The twiddles are the 1024-point FFT's
+	for (int32_t size = 4; size <= n; size *= 2) {
+		int32_t half = size / 2;
+		int32_t step = (n / size) * stride;
+		for (int32_t k = 0; k < half; k++) { // Each twiddle once, for all its butterflies
+			float c = tables_.cos1024[k * step];
+			float s = -tables_.sin1024[k * step];
+			for (int32_t a = k; a < n; a += size) {
+				int32_t b = a + half;
+				float r = re[b] * c - im[b] * s;
+				float i = re[b] * s + im[b] * c;
+				re[b] = re[a] - r;
+				im[b] = im[a] - i;
+				re[a] += r;
+				im[a] += i;
+			}
+		}
+	}
+}
+
+void Scan::onsetFrame(const float* x) {
+	using namespace scan_detail;
+	constexpr int32_t half = kOnsetFft / 2;
+	// 512 real samples as 256 complex ones (even and odd), windowed, in bit-reversed order
+	for (int32_t i = 0; i < half; i++) {
+		int32_t j = tables_.reversed256[i];
+		fftRe_[j] = x[2 * i] * tables_.hann512[2 * i];
+		fftIm_[j] = x[2 * i + 1] * tables_.hann512[2 * i + 1];
+	}
+	fft(fftRe_.data(), fftIm_.data(), half);
+	// The real FFT's bins 0 to 256 from it, their power compressed (log), and how much each rose since the last frame
+	float flux = 0;
+	for (int32_t k = 0; k <= half; k++) {
+		int32_t kk = k & (half - 1);
+		int32_t mk = (half - k) & (half - 1);
+		float a = fftRe_[kk], b = fftIm_[kk], c = fftRe_[mk], d = fftIm_[mk];
+		float eRe = 0.5f * (a + c), eIm = 0.5f * (b - d);
+		float oRe = 0.5f * (b + d), oIm = -0.5f * (a - c);
+		float co = tables_.cos2048[4 * k], si = tables_.sin2048[4 * k]; // 2 pi k / 512
+		float re = eRe + co * oRe + si * oIm;
+		float im = eIm + co * oIm - si * oRe;
+		float compressed = roughLog2(1.0f + 100.0f * (re * re + im * im));
+		flux += std::max(0.0f, compressed - lastLog_[k]);
+		lastLog_[k] = compressed;
+	}
+	onsets_[onsetCount_ & (kOnsetRing - 1)] = flux;
+	onsetCount_++;
+}
+
+void Scan::chromaFrame() {
+	std::array<float, 12> frame{};
+	if (levelDb_ < kSilenceDb || !tonalChroma(frame.data())) {
+		// Silence, drums, noise: the key stays a while (a drum break), and is gone after kQuietFrames of them
+		if (++quietFrames_ >= kQuietFrames) {
+			chroma_.fill(0);
+			chromaFrames_ = 0;
+			keyTonic_ = candidateTonic_ = -1;
+		}
+		return;
+	}
+	quietFrames_ = 0;
+	// Summed, the older frames fading; a key (or none clear) shown when it wins twice in a row
+	for (int32_t i = 0; i < 12; i++) {
+		chroma_[i] = kChromaDecay * chroma_[i] + frame[i];
+	}
+	chromaFrames_++;
+	if (chromaFrames_ < 6) {
+		return; // 3 s of tonal frames at least
+	}
+	bool minor;
+	int32_t tonic = keyOf(chroma_.data(), &minor);
+	if (tonic == candidateTonic_ && (tonic < 0 || minor == candidateMinor_)) {
+		keyTonic_ = tonic;
+		keyMinor_ = minor;
+	}
+	candidateTonic_ = tonic;
+	candidateMinor_ = minor;
+}
+
+bool Scan::tonalChroma(float* chroma) {
+	using namespace scan_detail;
+	constexpr int32_t n = kChromaFrame / 2;               // The complex FFT's points
+	constexpr float kBinHz = kRate / 4.0f / kChromaFrame; // 2.69 Hz
+	// The FFT of the last kChromaFrame samples at a quarter of kRate: 2048 real points as 1024 complex ones, windowed,
+	// in bit-reversed order
+	const uint32_t first = quarterCount_ - kChromaFrame;
+	for (int32_t i = 0; i < n; i++) {
+		int32_t j = tables_.reversed1024[i];
+		fftRe_[j] = quarter_[(first + 2 * i) & (kChromaFrame - 1)] * tables_.hann2048[2 * i];
+		fftIm_[j] = quarter_[(first + 2 * i + 1) & (kChromaFrame - 1)] * tables_.hann2048[2 * i + 1];
+	}
+	fft(fftRe_.data(), fftIm_.data(), n);
+	// The magnitudes of bins 0 to 1024 (frame_ as scratch)
+	float* magnitude = frame_.data();
+	for (int32_t k = 0; k <= n; k++) {
+		int32_t kk = k & (n - 1);
+		int32_t mk = (n - k) & (n - 1);
+		float a = fftRe_[kk], b = fftIm_[kk], c = fftRe_[mk], d = fftIm_[mk];
+		float eRe = 0.5f * (a + c), eIm = 0.5f * (b - d);
+		float oRe = 0.5f * (b + d), oIm = -0.5f * (a - c);
+		float co = tables_.cos2048[k], si = tables_.sin2048[k];
+		float re = eRe + co * oRe + si * oIm;
+		float im = eIm + co * oIm - si * oRe;
+		magnitude[k] = std::sqrt(re * re + im * im);
+	}
+	// The peaks from 60 Hz to 2.5 kHz that stand out (kPeakContrast times the mean of the bins around), a note's
+	// partials, into the pitch classes (from the master tune's A): each by the root of its magnitude (the loud ones
+	// don't drown the rest), weighed down the further it is from the class's middle. Drums and noise have next to
+	// none: a frame counts where they make kTonal of the band (as roots of the magnitudes) at least
+	constexpr int32_t kLow = (int32_t)(60.0f / kBinHz), kHigh = (int32_t)(2500.0f / kBinHz);
+	constexpr int32_t kAround = 16; // Bins on each side: 43 Hz
+	float around = 0;
+	for (int32_t k = kLow - kAround - 1; k < kLow + kAround; k++) {
+		around += magnitude[k];
+	}
+	float total = 0, peaks = 0, band = 0;
+	for (int32_t k = kLow; k <= kHigh; k++) {
+		around += magnitude[k + kAround] - magnitude[k - kAround - 1]; // Bins k - kAround to k + kAround
+		float m = magnitude[k];
+		float root = std::sqrt(m);
+		band += root;
+		if (m <= magnitude[k - 1] || m < magnitude[k + 1] || m < kPeakContrast / (2 * kAround + 1) * around) {
+			continue;
+		}
+		float bin = (float)k + parabola(magnitude[k - 1], m, magnitude[k + 1]);
+		float semitones = 12.0f * std::log2(bin * kBinHz / referenceHz_) + 69.0f;
+		float nearest = std::round(semitones);
+		float weight = root * (1.0f - std::abs(semitones - nearest));
+		chroma[((int32_t)nearest % 12 + 12) % 12] += weight;
+		total += weight;
+		peaks += root;
+	}
+	if (total <= 0 || peaks < kTonal * band) {
+		return false;
+	}
+	for (int32_t i = 0; i < 12; i++) {
+		chroma[i] /= total;
+	}
+	return true;
+}
+
+int32_t Scan::keyOf(const float* chroma, bool* minor, float* match) const {
+	using namespace scan_detail;
+	int32_t best = -1;
+	float bestMatch = -1;
+	*minor = false;
+	for (int32_t tonic = 0; tonic < 12; tonic++) {
+		float major = correlation(chroma, tables_.majorProfile, tonic);
+		float minorMatch = correlation(chroma, tables_.minorProfile, tonic);
+		if (major > bestMatch) {
+			bestMatch = major;
+			best = tonic;
+			*minor = false;
+		}
+		if (minorMatch > bestMatch) {
+			bestMatch = minorMatch;
+			best = tonic;
+			*minor = true;
+		}
+	}
+	if (match) {
+		*match = bestMatch;
+	}
+	// Clear: the profile matches well, and 3 pitch classes at least are strong (a held note is not a key)
+	float strongest = *std::max_element(chroma, chroma + 12);
+	int32_t strong = (int32_t)std::count_if(chroma, chroma + 12, [&](float v) { return v > 0.4f * strongest; });
+	return (bestMatch >= 0.5f && strong >= 3) ? best : -1;
+}
+
+float Scan::tempoOf(float* x, int32_t n) {
+	using namespace scan_detail;
+	constexpr float kNotYet = -1000.0f;
+	// Smoothed a little (29 ms): a kick's onset is a frame or two wide, and the beat's lag isn't a whole number of
+	// frames
+	float a = x[0], b = x[0];
+	for (int32_t i = 0; i < n; i++) {
+		float c = x[i], d = x[std::min(i + 1, n - 1)], e = x[std::min(i + 2, n - 1)];
+		x[i] = (a + 2 * b + 3 * c + 2 * d + e) * (1.0f / 9);
+		a = b;
+		b = c;
+	}
+	float mean = 0, square = 0;
+	for (int32_t i = 0; i < n; i++) {
+		mean += x[i];
+		square += x[i] * x[i];
+	}
+	mean /= (float)n;
+	float sd = std::sqrt(std::max(square / (float)n - mean * mean, 0.0f));
+	// A beat needs onsets: at least 4 well above the rest (mean + 2 standard deviations), 0.1 s apart. A held tone
+	// has one, when it starts, and a flux that barely moves
+	int32_t onsets = 0, last = -1000;
+	for (int32_t i = 1; i + 1 < n; i++) {
+		if (x[i] > mean + 2 * sd && x[i] >= x[i - 1] && x[i] > x[i + 1] && i - last >= (int32_t)(0.1f * kOnsetRate)) {
+			onsets++;
+			last = i;
+		}
+	}
+	if (onsets < 4 || sd <= 0) {
+		return 0;
+	}
+	// The autocorrelation of the onsets less their mean, per lag as a share of the lag 0's, computed where the beats
+	// below look (a lag, its double and quadruple, its half), each once
+	for (int32_t i = 0; i < n; i++) {
+		x[i] -= mean;
+	}
+	correlations_.fill(kNotYet);
+	float variance = sd * sd;
+	auto r = [&](int32_t lag) {
+		if (lag >= n - 1 || lag >= (int32_t)correlations_.size()) {
+			return 0.0f;
+		}
+		if (correlations_[lag] == kNotYet) {
+			correlations_[lag] = dot(x, x + lag, n - lag) / (float)(n - lag) / variance;
+		}
+		return correlations_[lag];
+	};
+	// The beat: its lag, twice it (half a bar) and four times (a bar) correlate, and so does half of it where the beat
+	// is divided (eighths: that tells a beat from one and a half, of which the half doesn't repeat); weighted towards
+	// 120 BPM (an octave away counts 0.6)
+	int32_t best = 0;
+	float bestScore = 0;
+	for (int32_t lag = kTempoMinLag; lag <= kTempoMaxLag; lag++) {
+		float bpm = 60.0f * kOnsetRate / (float)lag;
+		float octaves = std::log2(bpm / 120.0f);
+		float half = (lag & 1) ? 0.5f * (r(lag / 2) + r(lag / 2 + 1)) : r(lag / 2);
+		float score = (r(lag) + 0.5f * r(2 * lag) + 0.25f * r(4 * lag) + 0.5f * std::max(half, 0.0f))
+		              * std::exp(-0.5f * octaves * octaves);
+		if (score > bestScore) {
+			bestScore = score;
+			best = lag;
+		}
+	}
+	if (best == 0 || r(best) < 0.05f) {
+		return 0; // Nothing repeats
+	}
+	return 60.0f * kOnsetRate / ((float)best + parabola(r(best - 1), r(best), r(best + 1)));
+}
+
+void Scan::tempoEstimate() {
+	int32_t n = (int32_t)std::min<uint32_t>(onsetCount_, kTempoWindow);
+	if (n < kTempoWindow / 2) {
+		return; // 4 s at least
+	}
+	float* x = frame_.data(); // As scratch: the pitch frame is taken anew each time
+	for (int32_t i = 0; i < n; i++) {
+		x[i] = onsets_[(onsetCount_ - n + i) & (kOnsetRing - 1)];
+	}
+	float bpm = tempoOf(x, n);
+	if (bpm <= 0) {
+		numBpms_ = 0;
+		bpm_ = 0;
+		return;
+	}
+	bpms_[numBpms_ % bpms_.size()] = bpm;
+	numBpms_++;
+	int32_t have = std::min<int32_t>(numBpms_, bpms_.size());
+	bpm_ = scan_detail::median(bpms_.data(), have); // Of the last three (3 s)
+}
+
+bool Scan::analyse() {
+	float pitchBefore = pitchHz_, bpmBefore = bpm_, levelBefore = levelDb_;
+	int32_t keyBefore = keyTonic_ * 2 + (keyMinor_ ? 1 : 0);
+	uint32_t written = written_;
+
+	// Behind by more than the ring holds (the UI held up): on from what's still there
+	if (written - onsetDone_ > (uint32_t)(kRingSize - kOnsetFft)) {
+		onsetDone_ = written - (uint32_t)(kRingSize - kOnsetFft);
+	}
+
+	// One of the dearer parts per call at most (a tempo estimate, a pitch frame, a chroma frame: about 0.5 ms each on
+	// the Deluge), one that is due as well a call (15 ms) later: the audio routine waits while the UI's routine runs
+	bool busy = false;
+
+	// Onsets, every kOnsetHop samples, and the tempo every kTempoEvery of them
+	while (onsetDone_ + kOnsetHop <= written) {
+		onsetDone_ += kOnsetHop;
+		if (onsetDone_ < (uint32_t)kOnsetFft) {
+			continue;
+		}
+		float* chunk = frame_.data(); // As scratch: the pitch frame is taken anew below
+		for (int32_t i = 0; i < kOnsetFft; i++) {
+			chunk[i] = at(onsetDone_ - kOnsetFft + i);
+		}
+		onsetFrame(chunk);
+		sinceTempo_++;
+		if (sinceTempo_ >= kTempoEvery && !busy) {
+			sinceTempo_ = 0;
+			tempoEstimate();
+			busy = true;
+		}
+	}
+
+	// The key's signal: every fourth sample through the quarter band (5.5 kHz), as they come, a window at a time (its
+	// middle at quarterNext_, which can be ahead of what came yet) where it is in the ring
+	if ((int32_t)(written - quarterNext_) > kRingSize - kQuarterBandTaps) {
+		quarterNext_ = written - (uint32_t)(kRingSize - kQuarterBandTaps); // Behind by more than the ring holds
+	}
+	while ((int32_t)(written - quarterNext_) > kQuarterBandTaps / 2) {
+		uint32_t from = quarterNext_ - kQuarterBandTaps / 2;
+		int32_t physical = (int32_t)(from & (kRingSize - 1));
+		float y;
+		if (physical + kQuarterBandPadded <= kRingSize) {
+			y = scan_detail::dot(&ring_[physical], tables_.quarterBand.data(), kQuarterBandPadded);
+		}
+		else {
+			y = 0;
+			for (int32_t m = 0; m < kQuarterBandTaps; m++) {
+				y += tables_.quarterBand[m] * at(from + m);
+			}
+		}
+		quarter_[quarterCount_ & (kChromaFrame - 1)] = y;
+		quarterCount_++;
+		quarterNext_ += 4;
+	}
+
+	// Pitch (the last kPitchFrame samples, every kPitchHop) or key (a chroma frame of the last kChromaFrame samples at
+	// the quarter rate, every kChromaEvery): one frame, however long the UI held up, and of the two the one waiting the
+	// longer for its time, so that neither waits for ever where the UI's routine comes seldom
+	uint32_t pitchWait = written - pitchDone_, chromaWait = written - chromaDone_;
+	bool pitchDue = !busy && written >= (uint32_t)kPitchFrame && pitchWait >= (uint32_t)kPitchHop;
+	bool chromaDue = !busy && quarterCount_ >= (uint32_t)kChromaFrame && chromaWait >= (uint32_t)kChromaEvery;
+	if (pitchDue && (!chromaDue || (uint64_t)pitchWait * kChromaEvery >= (uint64_t)chromaWait * kPitchHop)) {
+		pitchDone_ = written;
+		for (int32_t i = 0; i < kPitchFrame; i++) {
+			frame_[i] = at(written - kPitchFrame + i);
+		}
+		pitchFrame(frame_.data());
+	}
+	else if (chromaDue) {
+		chromaDone_ = written;
+		chromaFrame();
+	}
+
+	return pitchHz_ != pitchBefore || bpm_ != bpmBefore || std::abs(levelDb_ - levelBefore) >= 1.0f
+	       || keyTonic_ * 2 + (keyMinor_ ? 1 : 0) != keyBefore;
+}
+
