+// mastertune-v18.4: the Scan view's analysis (gui/views/scan_view.h), fed as the recorders are: from where it read last
+// up to where the output has got to
+deluge::dsp::Scan* scan = nullptr;
+deluge::dsp::Scan::Mix scanMix = deluge::dsp::Scan::Mix::LEFT;
+int32_t* scanSourcePos = nullptr;
+
+void startScan(deluge::dsp::Scan* s, deluge::dsp::Scan::Mix mix) {
+	if (s != scan) {
+		scanSourcePos = (int32_t*)i2sRXBufferPos; // What comes in from now
+	}
+	scan = s;
+	scanMix = mix;
+}
+
+/// The input frames since the last call, in at most two pieces where the ring wraps
+void feedScan() {
+	for (int32_t piece = 0; piece < 2 && scanSourcePos != (int32_t*)i2sRXBufferPos; piece++) {
+		int32_t* stop =
+		    ((uint32_t)i2sRXBufferPos < (uint32_t)scanSourcePos) ? getRxBufferEnd() : (int32_t*)i2sRXBufferPos;
+		int32_t frames = (int32_t)(stop - scanSourcePos) >> NUM_MONO_INPUT_CHANNELS_MAGNITUDE;
+		scan->feed(scanSourcePos, frames, scanMix);
+		scanSourcePos += frames << NUM_MONO_INPUT_CHANNELS_MAGNITUDE;
+		if (scanSourcePos >= getRxBufferEnd()) {
+			scanSourcePos -= SSI_RX_BUFFER_NUM_SAMPLES << NUM_MONO_INPUT_CHANNELS_MAGNITUDE;
+		}
+	}
+}
