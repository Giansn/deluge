+DroneDrum* InstrumentClipView::getSelectedDroneDrum() {
+	InstrumentClip* clip = getCurrentInstrumentClip();
+	if (clip == nullptr || clip->output->type != OutputType::KIT || clip->affectEntire) {
+		return nullptr;
+	}
+	Drum* drum = ((Kit*)clip->output)->selectedDrum;
+	if (drum == nullptr || drum->type != DrumType::DRONE || clip->getNoteRowForDrum(drum) == nullptr) {
+		return nullptr;
+	}
+	return (DroneDrum*)drum;
