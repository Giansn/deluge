+// mastertune-v16: a new kit of 16 drone rows (DroneDrum) with the drone's tones, in a new clip at the end of Song view,
+// not launched: launched, it plays the tones that are on in the drone, each a note as long as the clip. The song's
+// drone stays as it is.
+InstrumentClip* SessionView::createNewDroneTrack(const deluge::dsp::DroneSettings& drone) {
+	actionLogger.deleteAllLogs();
+
+	ParamManagerForTimeline newParamManager;
+	Kit* kit = (Kit*)storageManager.createNewInstrument(OutputType::KIT, &newParamManager);
+	if (kit == nullptr) {
+		return nullptr;
+	}
+	// Named DRONE1, DRONE2... as the song has none of that name yet
+	char name[12];
+	for (int32_t n = 1; n < 1000; n++) {
+		snprintf(name, sizeof(name), "DRONE%d", (int)n);
+		if (currentSong->getInstrumentFromPresetSlot(OutputType::KIT, 0, -1, name, getInstrumentFolder(OutputType::KIT),
+		                                             true, true)
+		    == nullptr) {
+			break;
+		}
+	}
+	std::array<DroneDrum*, deluge::dsp::DroneSettings::kNumTones> drums{};
+	bool ok =
+	    (kit->dirPath.set(getInstrumentFolder(OutputType::KIT)) == Error::NONE) && (kit->name.set(name) == Error::NONE);
+	for (size_t i = 0; ok && i < drums.size(); i++) {
+		drums[i] = (DroneDrum*)storageManager.createNewDrum(DrumType::DRONE);
+		if (drums[i] == nullptr) {
+			ok = false;
+			break;
+		}
+		drums[i]->tone = drone.tones[i];
+		drums[i]->tone.active = true;
+		kit->addDrum(drums[i]);
+	}
+	void* clipMemory = ok ? GeneralMemoryAllocator::get().allocMaxSpeed(sizeof(InstrumentClip)) : nullptr;
+	if (clipMemory == nullptr || !currentSong->sessionClips.ensureEnoughSpaceAllocated(1)) {
+		if (clipMemory != nullptr) {
+			delugeDealloc(clipMemory);
+		}
+		kit->~Kit(); // And its drums
+		delugeDealloc(kit);
+		return nullptr;
+	}
+
+	InstrumentClip* clip = new (clipMemory) InstrumentClip(currentSong);
+	char modelStackMemory[MODEL_STACK_MAX_SIZE];
+	ModelStackWithTimelineCounter* modelStack =
+	    setupModelStackWithSong(modelStackMemory, currentSong)->addTimelineCounter(clip);
+	if (clip->setAudioInstrument(kit, currentSong, true, &newParamManager) != Error::NONE) {
+		clip->~InstrumentClip();
+		delugeDealloc(clipMemory);
+		kit->~Kit();
+		delugeDealloc(kit);
+		return nullptr;
+	}
+	clip->setupAsNewKitClipIfNecessary(modelStack); // A row for each drum, in their order
+	kit->editedByUser = true;
+	kit->existsOnCard = false;
+	currentSong->addOutput(kit);
+	((Output*)kit)->setActiveClip(modelStack);
+
+	setupNewClip(clip);
+	clip->activeIfNoSolo = false; // Launched when wanted
+
+	// The drone's tones that are on, each a note as long as the clip (held across the loop point)
+	for (size_t i = 0; i < drums.size(); i++) {
+		if (!drone.tones[i].active) {
+			continue;
+		}
+		ModelStackWithNoteRow* modelStackWithNoteRow = clip->getNoteRowForDrum(modelStack, drums[i]);
+		NoteRow* noteRow = modelStackWithNoteRow->getNoteRowAllowNull();
+		if (noteRow != nullptr) {
+			noteRow->attemptNoteAdd(0, clip->loopLength, kit->defaultVelocity, kNumProbabilityValues,
+			                        modelStackWithNoteRow, nullptr);
+		}
+	}
+
+	// At the end of Song view
+	int32_t index = currentSong->sessionClips.getNumElements();
+	if (index > 0) {
+		clip->section = currentSong->sessionClips.getClipAtIndex(index - 1)->section;
+	}
+	currentSong->sessionClips.insertClipAtIndex(clip, index); // Space allocated above
+	resyncNewClip(clip, modelStack);
+	return clip;
+}
