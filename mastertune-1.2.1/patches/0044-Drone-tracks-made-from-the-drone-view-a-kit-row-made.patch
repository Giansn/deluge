+/// mastertune-v16: a drone row's pitch, from the select encoder (1 Hz a click, with Shift 0.1 Hz) or the upper gold
+/// knob (1 Hz, turned quickly 10 Hz, with Shift 0.01 Hz); for a tone set by note, semitones, with Shift cents. While
+/// the clip records, into its Hz lane (where Shift, as for any automation, deletes the lane instead).
+void InstrumentClipView::droneDrumPitchAction(DroneDrum* drum, int32_t offset, bool selectEncoder) {
+	using Step = DroneDrum::PitchStep;
+	Step step;
+	if (Buttons::isShiftButtonPressed()) {
+		step = selectEncoder ? Step::TENTH : Step::FINE;
+	}
+	else if (selectEncoder) {
+		step = Step::NORMAL;
+	}
+	else {
+		uint32_t now = AudioEngine::audioSampleTimer;
+		bool quick = (now - timeLastDronePitchTurn_) < (uint32_t)(kSampleRate / 16); // Under 60 ms apart
+		timeLastDronePitchTurn_ = now;
+		step = quick ? Step::QUICK : Step::NORMAL;
+	}
+	char modelStackMemory[MODEL_STACK_MAX_SIZE];
+	ModelStackWithTimelineCounter* modelStack = currentSong->setupModelStackWithCurrentClip(modelStackMemory);
+	drum->changePitch(modelStack, offset, step);
+	drawDrumName(drum, true);
+}
+
 void InstrumentClipView::modEncoderAction(int32_t whichModEncoder, int32_t offset) {
 	dontDeleteNotesOnDepress();
 
+	// mastertune-v16: a drone row selected: the upper gold knob its pitch, the lower its level
+	if (DroneDrum* droneDrum = getSelectedDroneDrum()) {
+		if (whichModEncoder == 1) {
+			droneDrumPitchAction(droneDrum, offset, false);
+		}
+		else {
+			int32_t& level = droneDrum->tone.level;
+			level = std::clamp(level + offset, (int32_t)0, deluge::dsp::DroneSettings::kMaxLevel);
+			char buffer[16];
+			snprintf(buffer, sizeof(buffer), display->haveOLED() ? "Level %d" : "%d", (int)level);
+			display->displayPopup(buffer);
+		}
+		return;
+	}
+
 	InstrumentClip* clip = getCurrentInstrumentClip();
 
 	char modelStackMemory[MODEL_STACK_MAX_SIZE];
