index bdca75b3..9e32c9a8 100644
--- a/src/deluge/dsp/filter/ladder_components.h
+++ b/src/deluge/dsp/filter/ladder_components.h
@@ -20,6 +20,18 @@
 #include "util/fixedpoint.h"
 #include <cstdint>
 namespace deluge::dsp::filter {
+// sum + multiply_32x32_rshift32(a, b) in one instruction (smmla). Exactly the same: sum << 32 only adds a multiple of
+// 2^32 to the 64-bit product, so the high word is sum + ((a * b) >> 32), modulo 2^32 like the add it replaces
+[[gnu::always_inline]] inline q31_t multiply_accumulate_32x32_rshift32(q31_t sum, q31_t a, q31_t b) {
+#if defined(__arm__)
+	q31_t out;
+	asm("smmla %0, %1, %2, %3" : "=r"(out) : "r"(a), "r"(b), "r"(sum));
+	return out;
+#else
+	return static_cast<q31_t>(static_cast<uint32_t>(sum) + static_cast<uint32_t>(multiply_32x32_rshift32(a, b)));
+#endif
+}
+
