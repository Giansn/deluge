+
+// The branches that depend on the configuration only are taken once per block
+template <HpLadderFilter::Layout layout>
+void HpLadderFilter::render(q31_t* startSample, q31_t* endSample, int32_t sampleIncrement) {
+	// Only saturate / anti-alias if lots of resonance
+	if (morph_ != 0) {
+		if (hpfProcessedResonance > 900000000) { // 890551738
+			renderLoop<true, Saturation::ANTIALIASED, layout>(startSample, endSample, sampleIncrement);
+		}
+		else if (hpfProcessedResonance > 750000000) { // 400551738
+			renderLoop<true, Saturation::TANH, layout>(startSample, endSample, sampleIncrement);
+		}
+		else {
+			renderLoop<true, Saturation::NONE, layout>(startSample, endSample, sampleIncrement);
+		}
+	}
+	else {
+		if (hpfProcessedResonance > 900000000) {
+			renderLoop<false, Saturation::ANTIALIASED, layout>(startSample, endSample, sampleIncrement);
+		}
+		else if (hpfProcessedResonance > 750000000) {
+			renderLoop<false, Saturation::TANH, layout>(startSample, endSample, sampleIncrement);
+		}
+		else {
+			renderLoop<false, Saturation::NONE, layout>(startSample, endSample, sampleIncrement);
+		}
+	}
+}
+
+template <bool morph, HpLadderFilter::Saturation saturation, HpLadderFilter::Layout layout>
+[[gnu::hot]] void HpLadderFilter::renderLoop(q31_t* startSample, q31_t* endSample, int32_t sampleIncrement) {
+	const Coefficients c{fc,
+	                     morph_,
+	                     hpfHPF3Feedback,
+	                     hpfLPF1Feedback,
+	                     divideByTotalMoveability,
+	                     hpfDivideByProcessedResonance,
+	                     hpfProcessedResonance};
+	// Without morph, doHPF's cutoff is max(multiply_accumulate_32x32_rshift32_rounded(fc, input << 4, 0), lowerLimit)
+	// = max(fc, lowerLimit) for every sample: smmlar adds (0 + 2^31) >> 32 = 0 to fc
+	const q31_t fixedFc = std::max(fc, lowerLimit);
+	renderChannel<morph, saturation, layout, 0>(startSample, endSample, sampleIncrement, l, c, fixedFc);
+	if constexpr (layout == Layout::STEREO) {
+		// The channels don't depend on each other, so each gets its own pass (fewer registers needed)
+		renderChannel<morph, saturation, layout, 1>(startSample, endSample, sampleIncrement, r, c, fixedFc);
+	}
+}
+
+template <bool morph, HpLadderFilter::Saturation saturation, HpLadderFilter::Layout layout, int channel>
+[[gnu::always_inline]] inline void HpLadderFilter::renderChannel(q31_t* startSample, q31_t* endSample,
+                                                                 int32_t sampleIncrement, HPLadderState& channelState,
+                                                                 const Coefficients& c, q31_t fixedFc) {
+	HPLadderState state = channelState;
+	q31_t lastA = 0; // the last sample's a before the tanh, for hpfLastWorkingValue
+
+	// For STEREO, currentSample points at the frame, as in the loop over both channels (same number of frames)
 	q31_t* currentSample = startSample;
 	do {
-		*currentSample = doHPF(*currentSample, l);
-		currentSample += 1;
-		*currentSample = doHPF(*currentSample, r);
-		currentSample += 1;
+		currentSample[channel] = doHPF<morph, saturation>(currentSample[channel], state, c, fixedFc, lastA);
+		if constexpr (layout == Layout::MONO) {
+			currentSample += 1;
+		}
+		else if constexpr (layout == Layout::STEREO) {
+			currentSample += 2;
+		}
+		else {
+			currentSample += sampleIncrement;
+		}
 	} while (currentSample < endSample);
+
+	// Without antialiasing, hpfLastWorkingValue is written on every sample and read by none of this block's (only
+	// the antialiased tanh reads it), so only the last sample's value matters
+	if constexpr (saturation == Saturation::TANH || saturation == Saturation::NONE) {
+		state.hpfLastWorkingValue = (uint32_t)lshiftAndSaturate<2>(lastA) + 2147483648u;
+	}
+	channelState = state;
 }
