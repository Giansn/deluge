+template <bool morph, HpLadderFilter::Saturation saturation>
+[[gnu::always_inline]] inline q31_t HpLadderFilter::doHPF(q31_t input, HPLadderState& state, const Coefficients& c,
+                                                          q31_t fixedFc, q31_t& lastA) {
+	q31_t temp_fc;
+	if constexpr (morph) {
+		temp_fc = std::max(multiply_accumulate_32x32_rshift32_rounded(c.fc, input << 4, c.morph), lowerLimit);
+	}
+	else {
+		temp_fc = fixedFc;
+	}
 
 	q31_t firstHPFOutput = input - state.hpfHPF1.doFilter(input, temp_fc);
 
-	q31_t feedbacksValue =
-	    state.hpfHPF3.getFeedbackOutput(hpfHPF3Feedback) + state.hpfLPF1.getFeedbackOutput(hpfLPF1Feedback);
+	// (a << 2) + (b << 2) as (a + b) << 2, the same modulo 2^32, with smmlar: sum + multiply_32x32_rshift32_rounded
+	// in one instruction, exactly (sum << 32 doesn't change the rounding of the low word)
+	q31_t feedbacksValue = multiply_accumulate_32x32_rshift32_rounded(
+	    multiply_32x32_rshift32_rounded(state.hpfHPF3.memory, c.hpfHPF3Feedback), state.hpfLPF1.memory,
+	    c.hpfLPF1Feedback);
 
-	q31_t a = multiply_32x32_rshift32_rounded(divideByTotalMoveability, firstHPFOutput + feedbacksValue) << (4 + 1);
+	q31_t a = multiply_32x32_rshift32_rounded(c.divideByTotalMoveability, firstHPFOutput + (feedbacksValue << 2))
+	          << (4 + 1);
 
 	// Only saturate / anti-alias if lots of resonance
-	if (hpfProcessedResonance > 900000000) { // 890551738
+	if constexpr (saturation == Saturation::ANTIALIASED) {
 		a = getTanHAntialiased(a, &state.hpfLastWorkingValue, 1);
 	}
+	else if constexpr (saturation == Saturation::TANH) {
+		lastA = a;
+		a = getTanHUnknown(a, 2);
+	}
+	else if constexpr (saturation == Saturation::NONE) {
+		lastA = a;
+	}
 	else {
-		state.hpfLastWorkingValue = (uint32_t)lshiftAndSaturate<2>(a) + 2147483648u;
-		if (hpfProcessedResonance > 750000000) { // 400551738
-			a = getTanHUnknown(a, 2);
+		if (c.hpfProcessedResonance > 900000000) { // 890551738
+			a = getTanHAntialiased(a, &state.hpfLastWorkingValue, 1);
+		}
+		else {
+			state.hpfLastWorkingValue = (uint32_t)lshiftAndSaturate<2>(a) + 2147483648u;
+			if (c.hpfProcessedResonance > 750000000) { // 400551738
+				a = getTanHUnknown(a, 2);
+			}
 		}
 	}
 
 	state.hpfLPF1.doFilter(a - state.hpfHPF3.doFilter(a, temp_fc), temp_fc);
 
 	// Normalization
-	a = multiply_32x32_rshift32_rounded(a, hpfDivideByProcessedResonance) << (8 - 1);
+	a = multiply_32x32_rshift32_rounded(a, c.hpfDivideByProcessedResonance) << (8 - 1);
 
 	return a;
 }
