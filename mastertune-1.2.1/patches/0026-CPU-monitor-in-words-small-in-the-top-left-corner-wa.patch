+void setMode(uint8_t newMode) {
+	mode = (newMode <= ALERTS) ? newMode : OFF;
+	enabled = (mode != OFF);
+}
+
 namespace {
 
 /// Room that must stay free in the USB MIDI send buffer, so the numbers never crowd out notes or clock
@@ -41,6 +48,11 @@ constexpr int32_t kMinUsbSendSpace = 1024;
 
 bool wasEnabled = false;
 uint32_t lastHalfSeq = 0;
+/// Warnings: voices cut in the window shown, and how many more half-seconds the warning stays up after the last cut
+int32_t cutHoldHalves = 0;
+bool blinkOff = false;
+char alert[20];                       // Empty if none
+constexpr int32_t kCutHoldHalves = 4; // 2 s
 uint32_t lastSecondSeq = 0;
 Window previousHalf;
 char line[kLineChars + 1]; // Empty until the first window is in
@@ -97,6 +109,9 @@ void routine() {
 			wasEnabled = false;
 			collector.stop();
 			line[0] = 0;
+			alert[0] = 0;
+			cutHoldHalves = 0;
+			blinkOff = false;
 			markOLEDChanged(); // Takes the line away
 		}
 		return;
@@ -113,34 +128,68 @@ void routine() {
 		return;
 	}
 
-	// OLED: the last two half-second windows, so the line is new twice a second
+	// OLED: the last two half-second windows, so the numbers are new twice a second. Under them the warning: voices
+	// cut (blinking, and up 2 s after the last cut) or the quality lowered
 	if (collector.readHalf(window, lastHalfSeq)) {
 		Window shown = previousHalf;
 		merge(shown, window);
 		previousHalf = window;
+		Summary summary = summarize(shown);
+		if (window.culled > 0) {
+			cutHoldHalves = kCutHoldHalves;
+		}
+		else if (cutHoldHalves > 0) {
+			cutHoldHalves--;
+		}
+		bool cutting = cutHoldHalves > 0;
+		blinkOff = cutting && !blinkOff;
 		if (display->haveOLED()) {
-			formatLine(summarize(shown), line, sizeof(line));
+			if (mode == ON) {
+				formatInfo(summary, line, sizeof(line));
+			}
+			else {
+				line[0] = 0;
+			}
+			formatAlert(cutting, summary.direMax, alert, sizeof(alert));
 			deluge::hid::display::OLED::markChanged();
 		}
 		else {
 			line[0] = 0;
+			alert[0] = 0;
 		}
 	}
 
-	// SysEx each second; the 7-segment display gets a short popup every other second, unless it shows another one
+	// SysEx each second (mode On); the 7-segment display gets a short popup every other second, unless it shows
+	// another one: "CUT" while voices are cut, else the CPU (mode On)
 	if (collector.readSecond(window, lastSecondSeq)) {
 		Summary summary = summarize(window);
-		sendSysex(summary);
+		if (mode == ON) {
+			sendSysex(summary);
+		}
 		if (!display->haveOLED() && (secondsSeen++ & 1) == 0 && !display->hasPopup()) {
 			char text[8];
-			formatSevenSegment(summary, text, sizeof(text));
-			display->displayPopup(text, 1);
+			if (cutHoldHalves > 0) {
+				snprintf(text, sizeof(text), "CUT");
+			}
+			else if (mode == ON) {
+				formatSevenSegment(summary, text, sizeof(text));
+			}
+			else {
+				text[0] = 0;
+			}
+			if (text[0]) {
+				display->displayPopup(text, 1);
+			}
 		}
 	}
