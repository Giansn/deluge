 		oledCurrentImage = &popup.hackGetImageStore()[0];
 	}
 
-	// mastertune-diag: the CPU monitor line (Settings > CPU monitor) goes on top of the finished image, in a canvas of
-	// its own, so no screen's image is changed and the line is gone as soon as the monitor is switched off
-	if (char const* line = cpu_stats::oledLine()) {
