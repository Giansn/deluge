+// group). A first file followed by one of its versions is shown right either way, the group (folded in) or a version
+// (folded out)
+int32_t LoadSongUI::rowsBeyondWindow(int32_t* lastRow) {
+	int32_t numItems = fileItems.getNumElements();
+	int32_t i = scrollPosVertical;
+	for (int32_t rows = 0; i < numItems && rows < kNumRows; i++) {
+		if (!isHiddenVersion(i)) {
+			rows++;
+			if (lastRow) {
+				*lastRow = i;
+			}
+		}
+	}
+	int32_t sides = 0;
+	if (i >= numItems && numFileItemsDeletedAtEnd) {
+		sides |= 1;
+	}
+	if (scrollPosVertical == 0 && numFileItemsDeletedAtStart && numItems && !itemAt(0)->isFolder
+	    && !(numItems > 1 && sameGroup(itemAt(0), itemAt(1)))) {
+		sides |= 2;
+	}
+	return sides;
