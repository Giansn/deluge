+void FilterSet::restartAfterSilence() {
+	endFade();
+	// (the filters as setConfig() uses them for the modes it was last given)
+	if (LPFOn) {
+		if ((lpfMode_ == FilterMode::SVF_BAND) || (lpfMode_ == FilterMode::SVF_NOTCH)) {
+			lpfilter.svf.restartAfterSilence();
+		}
+		else {
+			lpfilter.ladder.restartAfterSilence();
+		}
+	}
+	if (HPFOn) {
+		if (hpfMode_ == FilterMode::HPLADDER) {
+			hpfilter.ladder.restartAfterSilence();
+		}
+		else {
+			hpfilter.svf.restartAfterSilence();
+		}
+	}
+	haveRenderedGain_ = false;
+	gainRampStart_ = 1.0f;
+}
