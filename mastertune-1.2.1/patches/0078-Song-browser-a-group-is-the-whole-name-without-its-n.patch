@@ -1090,19 +1156,23 @@ bool LoadSongUI::isFoldedHeader(int32_t i) {
 	return !isInOpenGroup(item) && !isHiddenVersion(i) && sameGroup(item, itemAt(i + 1));
 }
 
-// The group folded out is the selected version's, or none: leaving it folds it in, arriving on one of its later
-// versions (the current song on entry, typing, a deleted file) folds it out
+// Arriving on a later version of a group folded in (the current song on entry, typing, a deleted file) folds it out;
+// the group of the selected version goes to the end of openGroups (the last one to fold in when there are too many).
+// Leaving a group doesn't fold it in: only BACK on one of its versions does (backButtonAction())
 void LoadSongUI::syncOpenGroup() {
 	FileItem* item = selectedItem();
 	if (!item || item->isFolder) {
-		openGroup.clear();
 		return;
 	}
-	if (!openGroup.isEmpty() && !isInOpenGroup(item)) {
-		openGroup.clear();
+	int32_t k = openGroupIndex(item);
+	if (k >= 0 && k + 1 < numOpenGroups) {
+		String key;
+		key.set(&openGroups[k]);
+		closeOpenGroup(k);
+		openGroups[numOpenGroups++].set(&key);
 	}
-	if (openGroup.isEmpty() && isHiddenVersion(fileIndexSelected)) {
-		openGroup.set(item->displayName, groupKeyLength(item));
+	else if (k < 0 && isHiddenVersion(fileIndexSelected)) {
+		openGroupOf(item);
 	}
 }
 
@@ -1337,18 +1407,27 @@ bool LoadSongUI::selectionShownFolded() {
 	return !selectionTyped() && isFoldedHeader(fileIndexSelected);
 }
 
-// BACK: an open group folds in, its first version selected; otherwise up a folder, or out, as before
+// BACK on a version of a group folded out: that group folds in, its first version selected (the others folded out
+// stay so); otherwise up a folder, or out, as before (the groups then all folded in)
 ActionResult LoadSongUI::backButtonAction() {
 	if (sdRoutineLock) {
 		return ActionResult::REMIND_ME_OUTSIDE_CARD_ROUTINE; // The folder may be read
 	}
-	// Typed onto a file at the window's start: whether it's a later version depends on the file before it
+	// Typed onto a file at the window's start: whether it's a later version depends on the file before it (reading
+	// back from it); at the window's end, whether a version follows
 	FileItem* item = selectedItem();
 	if (item && !item->isFolder && fileIndexSelected == 0 && numFileItemsDeletedAtStart) {
 		readWindow(0, -1);
 	}
+	fillWindowAroundSelection();
 	syncOpenGroup();
-	if (openGroup.isEmpty()) {
+	item = selectedItem();
+	int32_t k = item ? openGroupIndex(item) : -1;
+	int32_t numItems = fileItems.getNumElements();
+	if (k < 0
+	    || !((fileIndexSelected > 0 && sameGroup(itemAt(fileIndexSelected - 1), item))
+	         || (fileIndexSelected + 1 < numItems && sameGroup(item, itemAt(fileIndexSelected + 1))))) {
+		clearOpenGroups();
 		return LoadUI::backButtonAction();
 	}
 	// Folded in: the group's row, not what was typed (the keyboard off the pads, the song's preview on them)
@@ -1357,7 +1436,7 @@ ActionResult LoadSongUI::backButtonAction() {
 	if (!qwertyAlwaysVisible) {
 		qwertyVisible = false;
 	}
-	openGroup.clear();
+	closeOpenGroup(k);
 	bool moved = selectGroupTop();
 	fillWindowForRows();
 	displayText();
