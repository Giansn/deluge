@@ -207,7 +231,7 @@ void LoadSongUI::enterKeyPress() {
 
 	// If it's a directory...
 	if (currentFileItem && currentFileItem->isFolder) {
-		openGroup.clear();
+		clearOpenGroups();
 		rowsWindowTried[2] = -1;
 
 		Error error = goIntoFolder(currentFileItem->filename.get());
@@ -226,8 +250,7 @@ void LoadSongUI::enterKeyPress() {
 			fillWindowAroundSelection(); // Whether the next file is one of its versions (may read the folder again)
 			syncOpenGroup();
 			if (selectionShownFolded()) {
-				FileItem* header = getCurrentFileItem();
-				openGroup.set(header->displayName, groupKeyLength(header));
+				openGroupOf(getCurrentFileItem());
 				fillWindowForRows();
 				displayText();
 				return;
@@ -1069,7 +1092,50 @@ FileItem* LoadSongUI::selectedItem() {
 }
 
 bool LoadSongUI::isInOpenGroup(FileItem* item) {
-	return !openGroup.isEmpty() && hasGroupKey(item, openGroup.get(), openGroup.getLength());
+	return openGroupIndex(item) >= 0;
+}
+
+// Which of openGroups the file's group is, or -1
+int32_t LoadSongUI::openGroupIndex(FileItem const* item) {
+	if (!numOpenGroups || item->isFolder) {
+		return -1;
+	}
+	int32_t keyLength = groupKeyLength(item);
+	for (int32_t k = numOpenGroups - 1; k >= 0; k--) {
+		if ((int32_t)openGroups[k].getLength() == keyLength
+		    && !memcasecmp(item->displayName, openGroups[k].get(), keyLength)) {
+			return k;
+		}
+	}
+	return -1;
+}
+
+// The file's group folded out, the last of openGroups (if it isn't one of them yet). With kMaxOpenGroups folded out
+// already, the first of them, which the selection has been in longest ago, folds in. If there's no memory for the
+// name, the group stays folded in
+void LoadSongUI::openGroupOf(FileItem const* item) {
+	if (item->isFolder || openGroupIndex(item) >= 0) {
+		return;
+	}
+	if (numOpenGroups == kMaxOpenGroups) {
+		closeOpenGroup(0);
+	}
+	if (openGroups[numOpenGroups].set(item->displayName, groupKeyLength(item)) == Error::NONE) {
+		numOpenGroups++;
+	}
+}
+
+void LoadSongUI::closeOpenGroup(int32_t k) {
+	for (; k + 1 < numOpenGroups; k++) {
+		openGroups[k].set(&openGroups[k + 1]); // Shares the name's memory
+	}
+	openGroups[--numOpenGroups].clear();
+}
+
+void LoadSongUI::clearOpenGroups() {
+	while (numOpenGroups) {
+		openGroups[--numOpenGroups].clear();
+	}
 }
 
