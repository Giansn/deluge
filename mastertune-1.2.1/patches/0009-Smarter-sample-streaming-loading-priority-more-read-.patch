+namespace kit_ram_saver {
+namespace {
+
+// Calls f(source, holder) for each loaded sample the drum can play
+template <typename F>
+void forEachSample(SoundDrum* drum, F f) {
+	for (int32_t s = 0; s < kNumSources; s++) {
+		Source& source = drum->sources[s];
+		if (source.oscType != OscType::SAMPLE) {
+			continue;
+		}
+		for (int32_t r = 0; r < source.ranges.getNumElements(); r++) {
+			SampleHolderForVoice& holder = ((MultisampleRange*)source.ranges.getElement(r))->sampleHolder;
+			if (holder.audioFile) {
+				f(source, holder);
+			}
+		}
+	}
+}
+
+void markKitRows(ClipArray& clips) {
+	for (int32_t c = 0; c < clips.getNumElements(); c++) {
+		Clip* clip = clips.getClipAtIndex(c);
+		if (clip->type != ClipType::INSTRUMENT || !clip->output || clip->output->type != OutputType::KIT) {
+			continue;
+		}
+		InstrumentClip* instrumentClip = (InstrumentClip*)clip;
+		// With the kit arpeggiator on, any row can sound
+		bool keepAll = (instrumentClip->arpSettings.mode != ArpMode::OFF);
+		if (keepAll) {
+			for (Drum* drum = ((Kit*)clip->output)->firstDrum; drum; drum = drum->next) {
+				drum->keepSampleStarts = true;
+			}
+			continue;
+		}
+		for (int32_t i = 0; i < instrumentClip->noteRows.getNumElements(); i++) {
+			NoteRow* noteRow = instrumentClip->noteRows.getElement(i);
+			if (!noteRow->drum || noteRow->hasNoNotes()) {
+				continue;
+			}
+			// Reach the drum only through the kit's own list: a row can still point at a drum that's gone, while a
+			// preset loads into it, or in another clip of the kit
+			for (Drum* drum = ((Kit*)clip->output)->firstDrum; drum; drum = drum->next) {
+				if (drum == noteRow->drum) {
+					drum->keepSampleStarts = true;
+					break;
+				}
+			}
+		}
+	}
+}
+
+} // namespace
+
+void routine() {
+	if (!currentSong || getCurrentUI() == &loadSongUI || currentUIMode == UI_MODE_LOADING_SONG_ESSENTIAL_SAMPLES
+	    || currentUIMode == UI_MODE_LOADING_SONG_UNESSENTIAL_SAMPLES_UNARMED
+	    || currentUIMode == UI_MODE_LOADING_SONG_UNESSENTIAL_SAMPLES_ARMED
+	    || currentUIMode == UI_MODE_LOADING_SONG_NEW_SONG_PLAYING) {
+		return;
+	}
+
+	bool enabled = runtimeFeatureSettings.isOn(RuntimeFeatureSettingType::KitRamSaver);
+
+	// Which rows may sound
+	for (Output* output = currentSong->firstOutput; output; output = output->next) {
+		if (output->type != OutputType::KIT) {
+			continue;
+		}
+		Kit* kit = (Kit*)output;
+		bool keepAll = !enabled || kit->midiInput.containsSomething() || kit->defaultArpSettings.mode != ArpMode::OFF;
+		for (Drum* drum = kit->firstDrum; drum; drum = drum->next) {
+			drum->keepSampleStarts = keepAll || drum->midiInput.containsSomething();
+		}
+	}
+	if (enabled) {
+		markKitRows(currentSong->sessionClips);
+		markKitRows(currentSong->arrangementOnlyClips);
+	}
+
+	// Let go of or claim again the starts of their samples
+	for (Output* output = currentSong->firstOutput; output; output = output->next) {
+		if (output->type != OutputType::KIT) {
+			continue;
+		}
+		for (Drum* drum = ((Kit*)output)->firstDrum; drum; drum = drum->next) {
+			if (drum->type != DrumType::SOUND) {
+				continue;
+			}
+			bool keep = drum->keepSampleStarts;
+			forEachSample((SoundDrum*)drum, [keep](Source& source, SampleHolderForVoice& holder) {
+				bool claimed = (holder.clustersForStart[0] != nullptr);
+				if (keep && !claimed) {
+					holder.claimClusterReasons(source.sampleControls.reversed, CLUSTER_ENQUEUE);
+				}
+				else if (!keep && claimed) {
+					holder.unassignAllClusterReasons();
+				}
+			});
+		}
+	}
+}
+
+} // namespace kit_ram_saver
