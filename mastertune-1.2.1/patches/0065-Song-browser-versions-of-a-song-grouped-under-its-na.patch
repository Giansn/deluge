+
+// mastertune: versions of a song grouped under its name
+
+FileItem* LoadSongUI::selectedItem() {
+	return (fileIndexSelected >= 0 && fileIndexSelected < fileItems.getNumElements()) ? itemAt(fileIndexSelected)
+	                                                                                  : nullptr;
+}
+
+bool LoadSongUI::isInOpenGroup(FileItem* item) {
+	return !openGroup.isEmpty() && hasGroupKey(item, openGroup.get(), openGroup.getLength());
+}
+
+// A version after a group's first one, with the group folded in: not shown, the encoder steps over it
+bool LoadSongUI::isHiddenVersion(int32_t i) {
+	if (i <= 0 || i >= fileItems.getNumElements()) {
+		return false;
+	}
+	FileItem* item = itemAt(i);
+	return sameGroup(itemAt(i - 1), item) && !isInOpenGroup(item);
+}
+
+// A group's first version, with the group folded in: the row that stands for the group
+bool LoadSongUI::isFoldedHeader(int32_t i) {
+	if (i < 0 || i + 1 >= fileItems.getNumElements()) {
+		return false;
+	}
+	FileItem* item = itemAt(i);
+	return !isInOpenGroup(item) && !isHiddenVersion(i) && sameGroup(item, itemAt(i + 1));
+}
+
+// The group folded out is the selected version's, or none: leaving it folds it in, arriving on one of its later
+// versions (the current song on entry, typing, a deleted file) folds it out
+void LoadSongUI::syncOpenGroup() {
+	FileItem* item = selectedItem();
+	if (!item || item->isFolder) {
+		openGroup.clear();
+		return;
+	}
+	if (!openGroup.isEmpty() && !isInOpenGroup(item)) {
+		openGroup.clear();
+	}
+	if (openGroup.isEmpty() && isHiddenVersion(fileIndexSelected)) {
+		openGroup.set(item->displayName, groupKeyLength(item));
+	}
+}
+
+// The OLED's rows: scrollPosVertical is the top row's item, the selection on the screen, counted in rows shown
+void LoadSongUI::fixScrollPos(bool fillFromAbove) {
+	int32_t numItems = fileItems.getNumElements();
+	if (fileIndexSelected < 0 || fileIndexSelected >= numItems) {
+		return;
+	}
+	scrollPosVertical = std::clamp<int32_t>(scrollPosVertical, 0, fileIndexSelected);
+	while (scrollPosVertical > 0 && isHiddenVersion(scrollPosVertical)) {
+		scrollPosVertical--;
+	}
+	int32_t rows = 0;
+	for (int32_t i = scrollPosVertical; i <= fileIndexSelected; i++) {
+		rows += !isHiddenVersion(i);
+	}
+	while (rows > kNumRows) {
+		do {
+			scrollPosVertical++;
+		} while (isHiddenVersion(scrollPosVertical));
+		rows--;
+	}
+	// At the end of the folder, or of the window (past a group of more versions than it holds), rows above rather
+	// than empty rows below
+	if (!fillFromAbove) {
+		return;
+	}
+	for (int32_t i = fileIndexSelected + 1; i < numItems; i++) {
+		rows += !isHiddenVersion(i);
+	}
+	while (rows < kNumRows && scrollPosVertical > 0) {
+		do {
+			scrollPosVertical--;
+		} while (scrollPosVertical > 0 && isHiddenVersion(scrollPosVertical));
+		rows++;
+	}
+}
+
+// The folder read again with the selected file in the middle of the window of items
+void LoadSongUI::recentreWindow() {
+	FileItem* item = selectedItem();
+	if (!item) {
+		return;
+	}
+	String name;
+	if (name.set(item->displayName) != Error::NONE) {
+		return;
+	}
+	int32_t top = numFileItemsDeletedAtStart + scrollPosVertical;
+	Error error = readFileItemsFromFolderAndMemory(currentSong, outputTypeToLoad, filePrefix, name.get(), NULL, true,
+	                                               Availability::ANY, CATALOG_SEARCH_BOTH);
+	if (error != Error::NONE) {
+		emptyFileItems();
+		fileIndexSelected = -1;
+		scrollPosVertical = 0;
+		display->displayError(error);
+		return;
+	}
+	shouldInterpretNoteNames = shouldInterpretNoteNamesForThisBrowser;
+	octaveStartsFromA = false;
+	fileIndexSelected = std::min<int32_t>(fileItems.search(name.get()), fileItems.getNumElements() - 1);
+	scrollPosVertical =
+	    std::clamp<int32_t>(top - numFileItemsDeletedAtStart, 0, std::max<int32_t>(fileIndexSelected, 0));
+}
+
+// Whether the selected file is a group's first version, a later one or on its own depends on its neighbours: at the
+// window's edge, with more files beyond it, the folder is read again around it
+void LoadSongUI::fillWindowAroundSelection() {
+	FileItem* item = selectedItem();
+	if (!item || item->isFolder) {
+		return;
+	}
+	if ((fileIndexSelected == 0 && numFileItemsDeletedAtStart)
+	    || (fileIndexSelected == fileItems.getNumElements() - 1 && numFileItemsDeletedAtEnd)) {
+		recentreWindow();
+	}
+}
+
+// The rows shown around the selection (fixScrollPos()) are items of the window: when they run to its edge, with more
+// files beyond it, the folder is read again around the selection. On the 7-segment display there's just the selection
+void LoadSongUI::fillWindowForRows() {
+	FileItem* item = selectedItem();
+	if (!item || !display->haveOLED()) {
+		return;
+	}
+	fixScrollPos(false);
+	int32_t numItems = fileItems.getNumElements();
+	int32_t i = scrollPosVertical;
+	for (int32_t rows = 0; i < numItems && rows < kNumRows; i++) {
+		rows += !isHiddenVersion(i);
+	}
+	// Below: the rows (or the last row's group) may go on beyond the window. Above: the top row may be a version whose
+	// group's first one is beyond it
+	if ((i >= numItems && numFileItemsDeletedAtEnd)
+	    || (scrollPosVertical == 0 && numFileItemsDeletedAtStart && !itemAt(0)->isFolder)) {
+		recentreWindow();
+		fixScrollPos();
+	}
+}
+
+// The selected version's group's first version. Returns whether the selection moved
+bool LoadSongUI::selectGroupTop() {
+	FileItem* item = selectedItem();
+	if (!item || item->isFolder) {
+		return false;
+	}
+	int32_t start = numFileItemsDeletedAtStart + fileIndexSelected;
+	for (int32_t n = 0; n < kMaxGroupSteps; n++) {
+		if (fileIndexSelected == 0 && numFileItemsDeletedAtStart) {
+			recentreWindow();
+		}
+		if (fileIndexSelected <= 0 || !sameGroup(itemAt(fileIndexSelected - 1), itemAt(fileIndexSelected))) {
+			break;
+		}
+		fileIndexSelected--;
+	}
+	if (!selectedItem() || numFileItemsDeletedAtStart + fileIndexSelected == start) {
+		return false;
+	}
+	setEnteredTextFromCurrentFilename();
+	enteredTextEditPos = 0;
+	if (display->haveOLED()) {
+		scrollPosHorizontal = 0;
+	}
+	return true;
+}
+
+// BACK: an open group folds in, its first version selected; otherwise up a folder, or out, as before
+ActionResult LoadSongUI::backButtonAction() {
+	syncOpenGroup();
+	if (openGroup.isEmpty()) {
+		return LoadUI::backButtonAction();
+	}
+	if (sdRoutineLock) {
+		return ActionResult::REMIND_ME_OUTSIDE_CARD_ROUTINE; // selectGroupTop() may read the folder
+	}
+	openGroup.clear();
+	bool moved = selectGroupTop();
+	fillWindowForRows();
+	displayText();
+	if (moved) {
+		currentFileChanged(-1);
+	}
+	return ActionResult::DEALT_WITH;
+}
+
+// Browser::renderOLED(), with a group's later versions not shown while it's folded in, the folded group's row showing
+// its name and an arrow (as a submenu), and the versions of the group folded out indented by a character
+void LoadSongUI::renderOLED(deluge::hid::display::oled_canvas::Canvas& canvas) {
+	using deluge::hid::display::OLED;
+	if (!steppingInGroup) {
+		syncOpenGroup();
+		fixScrollPos();
+	}
+	canvas.drawScreenTitle(title);
+
+	int32_t textStartX = 14;
+	int32_t iconStartX = 1;
+
+	int32_t yPixel = (OLED_MAIN_HEIGHT_PIXELS == 64) ? 15 : 14;
+	yPixel += OLED_MAIN_TOPMOST_PIXEL;
+
+	int32_t maxChars = (uint32_t)(OLED_MAIN_WIDTH_PIXELS - textStartX) / (uint32_t)kTextSpacingX;
+
+	auto drawIcon = [&](bool isFolder, int32_t x) {
+		int32_t iconWidth = 8;
+		canvas.drawGraphicMultiLine(isFolder ? OLED::folderIcon : fileIcon, x, yPixel + 0, iconWidth);
+		if (!isFolder && fileIconPt2 && fileIconPt2Width) {
+			canvas.drawGraphicMultiLine(fileIconPt2, x + iconWidth, yPixel + 0, fileIconPt2Width);
+		}
+	};
+	auto drawSelectedName = [&](int32_t x, int32_t chars) {
+		drawTextForOLEDEditing(x, OLED_MAIN_WIDTH_PIXELS, yPixel, chars, canvas);
+		if (!enteredTextEditPos) {
+			OLED::setupSideScroller(0, enteredText.get(), x, OLED_MAIN_WIDTH_PIXELS, yPixel, yPixel + 8, kTextSpacingX,
+			                        kTextSpacingY, true);
+		}
+	};
+
+	// If we're currently typing a filename which doesn't (yet?) have a file...
+	if (fileIndexSelected == -1) {
+		drawIcon(false, iconStartX);
+		drawSelectedName(textStartX, maxChars);
+		return;
+	}
+
+	int32_t numItems = fileItems.getNumElements();
+	int32_t row = 0;
+	for (int32_t i = scrollPosVertical; i < numItems && row < OLED_HEIGHT_CHARS - 1; i++) {
+		if (isHiddenVersion(i)) {
+			continue;
+		}
+		FileItem* thisFile = itemAt(i);
+		bool isSelectedIndex = (i == fileIndexSelected);
+		bool folded = isFoldedHeader(i) && !(isSelectedIndex && qwertyVisible); // Typing: the name typed
+		bool inOpenGroup = !folded && isInOpenGroup(thisFile)
+		                   && ((i > 0 && sameGroup(itemAt(i - 1), thisFile))
+		                       || (i + 1 < numItems && sameGroup(thisFile, itemAt(i + 1))));
+		int32_t indent = inOpenGroup ? kTextSpacingX : 0;
+		int32_t x = textStartX + indent;
+		drawIcon(thisFile->isFolder, iconStartX + indent);
+
+		if (folded) {
+			int32_t keyLength = groupKeyLength(thisFile);
+			int32_t arrowX = OLED_MAIN_WIDTH_PIXELS - kSubmenuIconSpacingX - 3;
+			canvas.drawString(std::string_view{thisFile->displayName, static_cast<size_t>(keyLength)}, x, yPixel,
+			                  kTextSpacingX, kTextSpacingY, 0, arrowX - kTextSpacingX);
+			canvas.drawGraphicMultiLine(OLED::submenuArrowIcon, arrowX, yPixel, kSubmenuIconSpacingX);
+			if (isSelectedIndex) {
+				canvas.invertArea(x - 1, OLED_MAIN_WIDTH_PIXELS - x + 1, yPixel, yPixel + kTextSpacingY - 1);
+				if (headerLabel.set(thisFile->displayName, keyLength) == Error::NONE) {
+					OLED::setupSideScroller(0, headerLabel.get(), x, arrowX - 2, yPixel, yPixel + 8, kTextSpacingX,
+					                        kTextSpacingY, true);
+				}
+			}
+		}
+		else if (isSelectedIndex) {
+			drawSelectedName(x, maxChars - (indent ? 1 : 0));
+		}
+		else {
+			// Draw filename
+			char const* displayName = thisFile->filename.get();
+			char const* finalCharAddress = thisFile->isFolder ? nullptr : strrchr(displayName, '.');
+			if (!finalCharAddress) {
+				finalCharAddress = strchr(displayName, 0);
+			}
+			canvas.drawString(std::string_view{displayName, static_cast<size_t>(finalCharAddress - displayName)}, x,
+			                  yPixel, kTextSpacingX, kTextSpacingY);
+		}
+
+		yPixel += kTextSpacingY;
+		row++;
+	}
+}
