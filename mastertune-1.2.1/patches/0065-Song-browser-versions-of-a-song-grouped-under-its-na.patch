+namespace {
+// mastertune: versions of a song grouped under its name (LoadSongUI::openGroup)
+
+constexpr int32_t kMaxGroupSteps = 4096; // Only against a loop that doesn't end; a group can have any number
+// The song browser's window of file items (Browser::fileItemsWindow; 20 in the other browsers). A folded group takes
+// one row but all its versions' items, and the rows around it come from the window: 100 shows them for a group of up to
+// about 40 versions (a larger one works the same, only a row next to it may be missing)
+constexpr int32_t kSongBrowserWindow = 100;
+constexpr int32_t kNumRows = OLED_HEIGHT_CHARS - 1;
+
+FileItem* itemAt(int32_t i) {
+	return (FileItem*)Browser::fileItems.getElementAddress(i);
+}
+
+// A file's group: its name up to the first space, or else up to the extension's dot ("TRACK.XML", "TRACK 2.XML",
+// "track 3.XML": "TRACK"). The files are sorted by name (strcmpspecial(): case doesn't matter, numbers by value, and a
+// space sorts before any other character but '.' and '_'), so a song's versions come right after its first one.
+// Only a name that continues with '_' or '.' ("TRACK_B", "TRACK.B.XML") or a folder can sort between them: the group
+// is then two rows
+int32_t groupKeyLength(FileItem const* item) {
+	char const* name = item->displayName;
+	char const* dot = strrchr(name, '.');
+	int32_t length = dot ? (int32_t)(dot - name) : (int32_t)strlen(name);
+	char const* space = (char const*)memchr(name, ' ', length);
+	return space ? (int32_t)(space - name) : length;
+}
+
+bool hasGroupKey(FileItem const* item, char const* key, int32_t keyLength) {
+	return !item->isFolder && keyLength > 0 && groupKeyLength(item) == keyLength
+	       && !memcasecmp(item->displayName, key, keyLength);
+}
+
+bool sameGroup(FileItem const* a, FileItem const* b) {
+	return !a->isFolder && hasGroupKey(b, a->displayName, groupKeyLength(a));
+}
+} // namespace
