+ *
+ * The Synthstrom Audible Deluge Firmware is free software: you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software Foundation,
+ * either version 3 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+// mastertune v18: the output limiter (Community features > Output limiter, off by default): the last stage before the
+// output's hard clip (AudioEngine: the render buffer after the song's FX and the metronome, where 2^24 is the 24-bit
+// output's full scale).
+//
+// A look-ahead peak limiter with a soft knee: each sample's peak p (the larger side, so the stereo image stays) asks
+// for the gain f(p) / p, where f is the knee: the identity up to T (1 dB below full scale), above it
+// f(p) = T + (C - T) s((p - T) / (C - T)), s(v) = v / sqrt(1 + v^2), which joins the straight line with slope 1 and
+// curvature 0 and approaches C (just under full scale) without reaching it. The gain applied is the lowest asked for
+// over the next kLatency + 1 samples (held for 15 ms, so that the sample peaks' beating near a quarter of the sample
+// rate doesn't modulate it, then released over 60 ms), averaged over kLatency samples (the attack: a
+// straight-line ramp of 0.73 ms), and applied to the input delayed by kLatency samples: when a peak comes out, the
+// gain has got to what it asked for, so no sample reaches full scale and nothing hard-clips; the gain moves smoothly,
+// so the limiting adds no harmonics that could alias (a waveshaping soft clipper, even 2x oversampled, only took the
+// aliasing of a hard clip down by 7 to 10 dB at 5 to 11 kHz: tests/volume/limiter_test.cpp).
+// Below the knee the gain is exactly 1: the output is the input bit for bit, delayed by kLatency samples (0.73 ms, the
+// limiter's latency while it's on). Off, it doesn't run at all: the output is exactly as without it.
+
+#pragma once
+
+#include "dsp/stereo_sample.h"
+#include <cstdint>
+
+namespace deluge::dsp {
+
+class OutputLimiter {
+public:
+	static constexpr int32_t kLatency = 32;          // samples of look-ahead (0.73 ms)
+	static constexpr int32_t kMaxBlock = 128;        // SSI_TX_BUFFER_NUM_SAMPLES
+	static constexpr float kFullScale = 16777216.0f; // 2^24: the output's full scale inside the firmware
+	static constexpr float kKnee = 14953486.0f;      // T: 1 dB below
+	static constexpr float kCeiling = 16777152.0f;   // C: 2^24 - 64, where the knee flattens out
+	static constexpr int32_t kHoldSamples = 662;     // 15 ms: how long the gain holds before it releases
+	static constexpr float kReleaseMs = 60.0f;       // time constant of the gain's return to 1 after that
+
+	/// In place; numSamples at most kMaxBlock
+	void process(StereoSample* buffer, int32_t numSamples);
+	/// Silence before, the gain at 1 (when switched on)
+	void reset();
+
+private:
+	StereoSample history_[kLatency] = {}; // the last kLatency input samples: the delay
+	float asked_[kLatency + 1];           // the gains the last kLatency + 1 samples asked for (a ring)
+	float held_[kLatency];                // the held and released gains of the last kLatency samples (a ring)
+	int32_t pos_ = 0;                     // ring position
+	float lowest_ = 1.0f;                 // the lowest gain asked for in the window
+	int32_t lowestAge_ = 0;               // how many samples ago it was asked for
+	float release_ = 1.0f;                // the held gain, releasing towards 1
+	int32_t holdLeft_ = 0;                // samples it holds on for
+	double heldSum_ = kLatency;           // the sum of held_
+	int32_t heldBelowOne_ = 0;            // how many of held_ are below 1 (none: the gain is exactly 1)
+	int32_t askedBelowOne_ = 0;           // the same for asked_
+};
+
+} // namespace deluge::dsp
