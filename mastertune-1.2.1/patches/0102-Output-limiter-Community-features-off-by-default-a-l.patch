+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "dsp/output_limiter.h"
+#include <algorithm>
+#include <arm_neon.h>
+#include <cmath>
+#include <cstring>
+
+namespace deluge::dsp {
+
+namespace {
+// The gain a peak p asks for: f(p) / p above the knee, 1 below
+inline float askedGain(float p) {
+	if (p <= OutputLimiter::kKnee) {
+		return 1.0f;
+	}
+	constexpr float kRange = OutputLimiter::kCeiling - OutputLimiter::kKnee;
+	float v = (p - OutputLimiter::kKnee) * (1.0f / kRange);
+	float f = OutputLimiter::kKnee + kRange * v / std::sqrt(1.0f + v * v);
+	return f / p;
+}
+
+// round(x * g) for 0 <= g < 1, g as Q31
+inline int32_t applyGain(int32_t x, int32_t gQ31) {
+	return (int32_t)(((int64_t)x * gQ31 + ((int64_t)1 << 30)) >> 31);
+}
+
+// exp(-1 / (release time in samples)): the held gain's distance from 1 shrinks by this per sample
+const float kReleaseFactor = std::exp(-1000.0f / (OutputLimiter::kReleaseMs * 44100.0f));
+} // namespace
+
+void OutputLimiter::reset() {
+	std::memset(history_, 0, sizeof(history_));
+	std::fill(std::begin(asked_), std::end(asked_), 1.0f);
+	std::fill(std::begin(held_), std::end(held_), 1.0f);
+	pos_ = 0;
+	lowest_ = 1.0f;
+	lowestAge_ = 0;
+	release_ = 1.0f;
+	holdLeft_ = 0;
+	heldSum_ = kLatency;
+	heldBelowOne_ = 0;
+	askedBelowOne_ = 0;
+}
+
+void OutputLimiter::process(StereoSample* buffer, int32_t numSamples) {
+	numSamples = std::min<int32_t>(numSamples, kMaxBlock);
+
+	// Nothing near the knee coming in and the gain at 1 throughout: only the delay runs
+	// (saturating absolute values: |INT32_MIN| counts as INT32_MAX)
+	int32x4_t peak4 = vdupq_n_s32(0);
+	int32_t i = 0;
+	for (; i + 2 <= numSamples; i += 2) {
+		peak4 = vmaxq_s32(peak4, vqabsq_s32(vld1q_s32(&buffer[i].l)));
+	}
+	int32x2_t peak2 = vpmax_s32(vget_low_s32(peak4), vget_high_s32(peak4));
+	int32_t peak = std::max(vget_lane_s32(peak2, 0), vget_lane_s32(peak2, 1));
+	for (; i < numSamples; i++) {
+		peak = std::max(
+		    peak, std::max(std::abs(std::max(buffer[i].l, -INT32_MAX)), std::abs(std::max(buffer[i].r, -INT32_MAX))));
+	}
+	bool idle =
+	    ((float)peak <= kKnee && heldBelowOne_ == 0 && askedBelowOne_ == 0 && release_ == 1.0f && lowest_ == 1.0f);
+
+	// The input and the history, in order: work[k] is the input kLatency samples before buffer[k]
+	StereoSample work[kLatency + kMaxBlock];
+	std::memcpy(work, history_, sizeof(history_));
+	std::memcpy(work + kLatency, buffer, numSamples * sizeof(StereoSample));
+
+	if (idle) {
+		std::memcpy(buffer, work, numSamples * sizeof(StereoSample));
+	}
+	else {
+		int32_t askedPos = pos_ % (kLatency + 1);
+		int32_t heldPos = pos_ % kLatency;
+		for (int32_t k = 0; k < numSamples; k++) {
+			// The gain the newest sample asks for, into the look-ahead window
+			const StereoSample& in = work[kLatency + k];
+			float p = (float)std::max(std::abs((int64_t)in.l), std::abs((int64_t)in.r));
+			float asked = askedGain(p);
+			askedBelowOne_ += (asked < 1.0f) - (asked_[askedPos] < 1.0f);
+			asked_[askedPos] = asked;
+			// The lowest over the window (kept with its age: searched again only when it leaves the window), held,
+			// releasing towards 1 after
+			if (asked <= lowest_) {
+				lowest_ = asked;
+				lowestAge_ = 0;
+			}
+			else if (++lowestAge_ > kLatency) {
+				lowest_ = 1.0f;
+				lowestAge_ = 0;
+				if (askedBelowOne_ != 0) {
+					// (the ring from the oldest to the newest: the age of each)
+					for (int32_t a = kLatency; a >= 0; a--) {
+						int32_t idx = askedPos - a;
+						float v = asked_[idx < 0 ? idx + kLatency + 1 : idx];
+						if (v <= lowest_) {
+							lowest_ = v;
+							lowestAge_ = a;
+						}
+					}
+				}
+			}
+			askedPos = (askedPos == kLatency) ? 0 : askedPos + 1;
+			if (lowest_ <= release_) {
+				release_ = lowest_;
+				holdLeft_ = kHoldSamples;
+			}
+			else if (holdLeft_ > 0) {
+				holdLeft_--;
+			}
+			else {
+				release_ = std::min(lowest_, 1.0f - (1.0f - release_) * kReleaseFactor);
+				if (release_ > 0.9999999f) {
+					release_ = 1.0f;
+				}
+			}
+			// Averaged over kLatency samples: the attack
+			heldBelowOne_ += (release_ < 1.0f) - (held_[heldPos] < 1.0f);
+			heldSum_ += (double)release_ - (double)held_[heldPos];
+			held_[heldPos] = release_;
+			heldPos = (heldPos == kLatency - 1) ? 0 : heldPos + 1;
+			if (heldBelowOne_ == 0) {
+				heldSum_ = kLatency; // (exactly: no drift left over from the sums)
+				buffer[k] = work[k];
+			}
+			else {
+				float g = std::min((float)(heldSum_ * (1.0 / kLatency)), 0.99999994f);
+				int32_t gQ31 = (int32_t)(g * 2147483648.0f);
+				buffer[k].l = applyGain(work[k].l, gQ31);
+				buffer[k].r = applyGain(work[k].r, gQ31);
+			}
+		}
+		pos_ += numSamples;
+	}
+	std::memcpy(history_, work + numSamples, sizeof(history_));
+}
+
+} // namespace deluge::dsp
