+// mastertune v18: the filter params that glide move on by this block's length, and tell the patcher, as the param LPF
+// does (see dsp/filter/param_glide.h)
+void Sound::doFilterGlide(int32_t numSamples, ModelStackWithSoundFlags* modelStack) {
+	if (!filterGlide.active) {
+		return;
+	}
+	const float k = deluge::dsp::filter::FilterParamGlide::blockFactor(numSamples);
+	PatchedParamSet* patchedParams = modelStack->paramManager->getPatchedParamSet();
+	for (int32_t i = 0; i < deluge::dsp::filter::FilterParamGlide::kNumParams; i++) {
+		if (filterGlide.isActive(i)) {
+			int32_t p = kFilterGlideParams[i];
+			int32_t oldValue = filterGlide.value[i];
+			int32_t newValue = filterGlide.advance(i, patchedParams->getValue(p), k);
+			patchedParamPresetValueChanged(p, modelStack, oldValue, newValue);
+		}
+	}
+}
+
+// Every glide at its end at once (as stopParamLPF(); modelStack may be NULL)
+void Sound::stopFilterGlide(ModelStackWithSoundFlags* modelStack) {
+	uint8_t was = filterGlide.active;
+	filterGlide.active = 0; // first: the patcher reads the params' own values from here on
+	if (was && modelStack) {
+		PatchedParamSet* patchedParams = modelStack->paramManager->getPatchedParamSet();
+		for (int32_t i = 0; i < deluge::dsp::filter::FilterParamGlide::kNumParams; i++) {
+			if ((was >> i) & 1) {
+				int32_t p = kFilterGlideParams[i];
+				patchedParamPresetValueChanged(p, modelStack, filterGlide.value[i], patchedParams->getValue(p));
+			}
+		}
+	}
+}
+
