+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+
+namespace deluge::dsp::filter {
+
+// mastertune v18: the filters' params (the LPF's and the HPF's cutoff, resonance and morph) glide to a new value
+// instead of taking it at once, whatever set it: a knob, automation (stepped or interpolated) or a MIDI CC (about 94
+// cents per step on the cutoff), in a synth or kit row (Sound) as in the song, a kit or an audio track
+// (GlobalEffectable). A one-pole on the param's value (the cutoffs' is their log frequency) with a time constant of
+// 10 ms, advanced once per block (exactly: the factor from the block's length), so a step becomes a smooth curve over
+// some 30 ms and the per-sample coefficient ramps (Filter) take it through the block. Modulation (envelopes, LFOs,
+// velocity...) doesn't go through it and stays as fast as it is. A value that stays put renders exactly as before: the
+// glide reaches the param's own value (within kSnap, then exactly) and stops.
+// 1.2.1 smoothed only the cutoffs, only while a knob was turned by hand (Sound's param LPF, one param at a time, a
+// one-pole of 5.8 ms), and took everything else as a step once per block
+struct FilterParamGlide {
+	// LPF cutoff, resonance, morph, HPF cutoff, resonance, morph
+	static constexpr int32_t kNumParams = 6;
+	static constexpr float kTauSamples = 441.0f; // 10 ms
+	static constexpr int64_t kSnap = 1 << 12;    // 2^-20 of the param's range: there
+	int32_t value[kNumParams];
+	uint8_t active; // bit i: value[i] is on its way to the param's own value
+
+	[[nodiscard]] bool isActive(int32_t i) const { return (active >> i) & 1; }
+	// Start gliding param i from `from` (where it is now), unless it already glides
+	void start(int32_t i, int32_t from) {
+		if (!isActive(i)) {
+			value[i] = from;
+			active |= (uint8_t)(1 << i);
+		}
+	}
+	// The factor a block of numSamples moves the value by, of what's left
+	[[nodiscard]] static float blockFactor(int32_t numSamples) {
+		return 1.0f - std::exp(-(float)numSamples / kTauSamples);
+	}
+	// Moves value[i] towards target by the block's factor k; at the target (within kSnap) it stops there. Returns
+	// the new value
+	int32_t advance(int32_t i, int32_t target, float k) {
+		int64_t diff = (int64_t)target - (int64_t)value[i];
+		if (std::llabs(diff) <= kSnap) {
+			value[i] = target;
+			active &= (uint8_t)~(1 << i);
+		}
+		else {
+			value[i] = (int32_t)((int64_t)value[i] + (int64_t)((float)diff * k));
+		}
+		return value[i];
+	}
+};
+
+} // namespace deluge::dsp::filter
