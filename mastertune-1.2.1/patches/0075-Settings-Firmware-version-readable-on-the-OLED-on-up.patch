+#include "gui/menu_item/firmware/version.h"
+#include "definitions_cxx.hpp"
+#include <algorithm>
+#include <cstring>
+
+namespace deluge::gui::menu_item::firmware {
+
+namespace {
+constexpr int32_t kMaxLineChars = OLED_MAIN_WIDTH_PIXELS / kTextSpacingX; // 21
+constexpr int32_t kMaxLines = 3;                                          // 30 pixels below the title
+constexpr int32_t kTooMany = kMaxLines + 1;
+
+/// Fills lines of at most `limit` characters from the text's start, each as far as its last '-' in reach (or, with
+/// hardBreaks, full where there's none in reach). The number of lines (kTooMany when they don't fit), each one's first
+/// character in starts[].
+int32_t fillLines(char const* text, int32_t length, int32_t limit, bool hardBreaks, int32_t* starts) {
+	int32_t lines = 0;
+	int32_t pos = 0;
+	while (pos < length) {
+		if (lines == kMaxLines) {
+			return kTooMany;
+		}
+		starts[lines++] = pos;
+		if (length - pos <= limit) {
+			break;
+		}
+		int32_t end = -1;
+		for (int32_t i = pos; i < pos + limit; i++) {
+			if (text[i] == '-') {
+				end = i + 1; // The '-' stays at the end of the line: the text goes on on the next one
+			}
+		}
+		if (end < 0) {
+			if (!hardBreaks) {
+				return kTooMany;
+			}
+			end = pos + limit;
+		}
+		pos = end;
+	}
+	return lines;
+}
+} // namespace
+
+// noipa: a function of its own with both arguments (tests/settings/firmware_version_emu.py calls it)
+[[gnu::noipa]] void drawLinesBrokenAtDashes(hid::display::oled_canvas::Canvas& canvas, char const* text) {
+	int32_t length = (int32_t)strlen(text);
+	int32_t starts[kMaxLines];
+	int32_t lines = kTooMany;
+	// As few lines as it takes, only broken after a '-' if that works, then the shortest limit that still needs no
+	// more lines: the lines as even as they can be ("1.2.1-mastertune-" / "v17-l2d-b3385d83", not 21 + 12 characters)
+	for (bool hardBreaks : {false, true}) {
+		int32_t fewest = fillLines(text, length, kMaxLineChars, hardBreaks, starts);
+		if (fewest == kTooMany) {
+			continue;
+		}
+		int32_t limit = 1;
+		while (fillLines(text, length, limit, hardBreaks, starts) > fewest) {
+			limit++;
+		}
+		lines = fewest;
+		break;
+	}
+	if (lines == kTooMany) { // Longer than three full lines (not a version string): its first three lines
+		for (int32_t i = 0; i < kMaxLines; i++) {
+			starts[i] = std::min(i * kMaxLineChars, length);
+		}
+		lines = kMaxLines;
+		length = std::min(length, kMaxLines * kMaxLineChars);
+	}
+
+	// The area below the title's line (Canvas::drawScreenTitle()), to the bottom of the image
+	int32_t top = OLED_MAIN_TOPMOST_PIXEL + ((OLED_MAIN_HEIGHT_PIXELS == 64) ? 0 : 1) + 12;
+	int32_t height = OLED_MAIN_HEIGHT_PIXELS - top;
+	int32_t blockHeight = (lines - 1) * kTextSpacingY + kTextSizeYUpdated;
+	int32_t y = top + ((height - blockHeight) >> 1);
+	for (int32_t i = 0; i < lines; i++) {
+		int32_t end = (i + 1 < lines) ? starts[i + 1] : length;
+		int32_t chars = end - starts[i];
+		int32_t x = (OLED_MAIN_WIDTH_PIXELS - chars * kTextSpacingX) >> 1;
+		canvas.drawString(std::string_view{text + starts[i], (size_t)chars}, x, y, kTextSpacingX, kTextSizeYUpdated);
+		y += kTextSpacingY;
+	}
+}
+
+} // namespace deluge::gui::menu_item::firmware
