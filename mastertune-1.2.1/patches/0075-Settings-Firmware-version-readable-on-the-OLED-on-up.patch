+/// block centred below the menu's title. It used to be squeezed onto one line: 33 characters had 3 pixels each.
+void drawLinesBrokenAtDashes(hid::display::oled_canvas::Canvas& canvas, char const* text);
+
 class Version final : public MenuItem {
 public:
 	using MenuItem::MenuItem;
 
-	void drawPixelsForOled() {
-		deluge::hid::display::oled_canvas::Canvas& canvas = hid::display::OLED::main;
-		canvas.drawStringCentredShrinkIfNecessary(kFirmwareVersionString, 22, 18, 20);
-	}
+	void drawPixelsForOled() { drawLinesBrokenAtDashes(hid::display::OLED::main, kFirmwareVersionString); }
 
 	void beginSession(MenuItem* navigatedBackwardFrom) override { drawValue(); }
 
