+// mastertune v18: 2x oversampling for the drive ladder (lpladder.cpp): a polyphase IIR half-band interpolator and
+// decimator (two branches of first-order allpass sections in z^-2, Valenzuela / Constantinides; the elliptic design
+// of Laurent de Soras' HIIR, PolyphaseIir2Designer, 5 coefficients for a transition band of (26.1 - 18) / 88.2 kHz):
+// passband 0 to 18 kHz flat within 1e-7 dB, stopband from 26.1 kHz at 83.7 dB (interpolator images, decimator
+// aliases). An IIR rather than a linear-phase FIR (about 55 taps, 27 samples of latency at 88.2 kHz): 16 multiplies
+// per sample and channel instead of about 30, and a group delay of a few samples at 88.2 kHz (see tests/filters
+// drive_test), so the drive ladder's output lines up with what it is summed with (the parallel route's other filter,
+// the fade-in from the dry signal, a crossfade's copy) to within a fraction of a sample at 44.1 kHz below a few kHz,
+// where a FIR's 13.5 samples would have to be delayed in all of those. Its phase isn't linear, as the ladder's own
+// isn't. 1.2.1's "oversampling" ran the ladder twice on the same input and kept the second output: no filter at all,
+// so everything its saturation made above 22 kHz folded back.
+//
+// Fixed point: each allpass y = x1 + a (x - y1) with the product rounded (smmulr, 1 LSB), the difference and the sum
+// saturating (never wrapping). The interpolator runs at half the input's level (the allpasses' transient peaks, 6 dB
+// of headroom), and doubles its outputs back, saturating.
+
+#pragma once
+
+#include "dsp/filter/ladder_components.h"
+#include <cstdint>
+
+namespace deluge::dsp::filter {
+
+// The allpass coefficients in Q31, branch 0: 0, 2, 4, branch 1: 1, 3
+inline constexpr q31_t kHalfbandCoef[5] = {123200196, 449991472, 888043942, 1363941814, 1867103462};
+
+// A branch's chain of N first-order allpass sections at the low rate; s[i]: the last input of section i, s[N] the last
+// output of the chain (section i's last output is section i + 1's last input)
+template <int32_t N, int32_t first>
+[[gnu::always_inline]] inline q31_t halfbandBranch(q31_t v, q31_t* s) {
+	for (int32_t i = 0; i < N; i++) {
+		const q31_t d = subSaturate(v, s[i + 1]);
+		const q31_t y = addSaturate(s[i], doubleSaturate(multiply_32x32_rshift32_rounded(d, kHalfbandCoef[first + 2 * i])));
+		s[i] = v;
+		v = y;
+	}
+	s[N] = v;
+	return v;
+}
+
+struct HalfbandUp {
+	q31_t s0[4];
+	q31_t s1[3];
+	// One input sample -> two at the double rate (even, odd)
+	[[gnu::always_inline]] inline void process(q31_t x, q31_t& even, q31_t& odd) {
+		const q31_t h = x >> 1;
+		even = doubleSaturate(halfbandBranch<3, 0>(h, s0));
+		odd = doubleSaturate(halfbandBranch<2, 1>(h, s1));
+	}
+	void reset() {
+		for (q31_t& v : s0) {
+			v = 0;
+		}
+		for (q31_t& v : s1) {
+			v = 0;
+		}
+	}
+};
+
+struct HalfbandDown {
+	q31_t s0[4];
+	q31_t s1[3];
+	// Two samples at the double rate (even, odd) -> one: (A0(odd) + A1(even)) / 2, rounded
+	[[gnu::always_inline]] inline q31_t process(q31_t even, q31_t odd) {
+		const q31_t a = halfbandBranch<3, 0>(odd, s0);
+		const q31_t b = halfbandBranch<2, 1>(even, s1);
+		return (q31_t)(((int64_t)a + b + 1) >> 1);
+	}
+	void reset() {
+		for (q31_t& v : s0) {
+			v = 0;
+		}
+		for (q31_t& v : s1) {
+			v = 0;
+		}
+	}
+};
+
+} // namespace deluge::dsp::filter
