+// mastertune v18: the drive ladder. At the sample rate: its bass compensation on the input (driveCompensate()), then
+// the ladder's loop, in place. 2x oversampled: each channel on its own (stride: between its samples), through the
+// half-band interpolator into osBuffer at 88.2 kHz, the compensation and the ladder's loop there (mono, with this
+// channel's state; the coefficients ramp over the doubled block, the knots the same; its tanhs' harmonics up to 44
+// kHz, which the decimator takes out instead of letting them fold back), and the half-band decimator back into place
+namespace {
+q31_t osBuffer[SSI_TX_BUFFER_NUM_SAMPLES * 2];
+} // namespace
+
+void LpLadderFilter::renderDrive(q31_t* startSample, q31_t* endSample, int32_t stride, bool stereo) {
+	const int32_t frames = stereo ? (int32_t)(endSample - startSample) >> 1
+	                              : (int32_t)((endSample - startSample + stride - 1) / stride);
+	if (frames <= 0) {
+		return;
+	}
+	if (!doOversampling) {
+		halfbandsLive_ = false;
+		driveCompensate(startSample, frames, stereo ? 2 : stride, stereo ? 2 : 1);
+		if (stereo) {
+			renderSaturation<FilterMode::TRANSISTOR_24DB_DRIVE, false, Layout::STEREO>(startSample, endSample, 2);
+		}
+		else {
+			renderMono<FilterMode::TRANSISTOR_24DB_DRIVE, false>(startSample, endSample, stride);
+		}
+	}
+	else {
+		if (!halfbandsLive_) {
+			// (switched to 2x: the half-bands start empty. FilterSet crossfades where oversampling switches)
+			upL_.reset();
+			upR_.reset();
+			downL_.reset();
+			downR_.reset();
+		}
+		halfbandsLive_ = true;
+		renderDriveOversampled(startSample, frames, stereo ? 2 : stride, 0);
+		if (stereo) {
+			renderDriveOversampled(startSample + 1, frames, 2, 1);
+		}
+	}
+	lastCompA_ = compA_;
+	lastCompS_ = compS_;
+	lastCompR_ = processedResonance;
+	compLive_ = true;
+}
+
+namespace {
+// The drive ladder's bass compensation on one sample (see LpLadderFilter::driveCompensate()): x' = x + x k G^4 +
+// 2 k T(c x), with a = k G^4 (Q30), s = c / 2 (Q30), r = processedResonance; the products rounded, the sums saturating.
+// kRamp: the three move per sample in straight lines (32.32 from the last block's + 1/2, the steps truncated: exactly
+// onto this block's at its last sample, n steps missing by less than n / 2^32)
+template <bool kRamp>
+struct DriveCompensation {
+	int64_t a, s, r;
+	int64_t da, ds, dr;
+	DriveCompensation(q31_t a0, q31_t s0, q31_t r0, q31_t a1, q31_t s1, q31_t r1, int32_t n) {
+		auto line = [n](q31_t from, q31_t to, int64_t& acc) {
+			acc = ((int64_t)from << 32) + ((int64_t)1 << 31);
+			return kRamp ? (int64_t)(((double)to - (double)from) * 4294967296.0 / (double)n) : (int64_t)0;
+		};
+		da = line(kRamp ? a0 : a1, a1, a);
+		ds = line(kRamp ? s0 : s1, s1, s);
+		dr = line(kRamp ? r0 : r1, r1, r);
+	}
+	// The next sample's coefficients (per frame: both channels take the same)
+	[[gnu::always_inline]] inline void step() {
+		if constexpr (kRamp) {
+			a += da;
+			s += ds;
+			r += dr;
+		}
+	}
+	[[gnu::always_inline]] inline q31_t operator()(q31_t x) const {
+		const q31_t g4 = lshiftAndSaturate<2>(multiply_32x32_rshift32_rounded(x, (q31_t)(a >> 32)));
+		const q31_t cx = lshiftAndSaturate<3>(multiply_32x32_rshift32_rounded(x, (q31_t)(s >> 32)));
+		const q31_t t = lshiftAndSaturate<3>(multiply_32x32_rshift32_rounded(ladderTanH<7>(cx), (q31_t)(r >> 32)));
+		return addSaturate(x, addSaturate(g4, t));
+	}
+};
+
+// Upsampling one channel into osBuffer, with the compensation (kComp) at the double rate
+template <bool kComp, bool kRamp>
+void upsampleChannel(HalfbandUp& state, const q31_t* in, int32_t frames, int32_t stride,
+                     DriveCompensation<kRamp> comp) {
+	HalfbandUp up = state;
+	for (int32_t i = 0; i < frames; i++) {
+		q31_t even, odd;
+		up.process(in[i * stride], even, odd);
+		if constexpr (kComp) {
+			comp.step();
+			even = comp(even);
+			comp.step();
+			odd = comp(odd);
+		}
+		osBuffer[2 * i] = even;
+		osBuffer[2 * i + 1] = odd;
+	}
+	state = up;
+}
+
+template <bool kRamp>
+void compensateInPlace(q31_t* p, int32_t count, int32_t stride, int32_t channels, DriveCompensation<kRamp> comp) {
+	for (int32_t i = 0; i < count; i++, p += stride) {
+		comp.step();
+		p[0] = comp(p[0]);
+		if (channels == 2) {
+			p[1] = comp(p[1]);
+		}
+	}
+}
+} // namespace
+
+void LpLadderFilter::renderDriveOversampled(q31_t* startSample, int32_t frames, int32_t stride, int32_t channel) {
+	HalfbandUp& up = channel ? upR_ : upL_;
+	const q31_t a1 = compA_, s1 = compS_, r1 = processedResonance;
+	const q31_t a0 = compLive_ ? lastCompA_ : a1, s0 = compLive_ ? lastCompS_ : s1, r0 = compLive_ ? lastCompR_ : r1;
+	if (r0 == 0 && r1 == 0) {
+		upsampleChannel<false, false>(up, startSample, frames, stride, {a1, s1, r1, a1, s1, r1, 2 * frames});
+	}
+	else if (a0 == a1 && s0 == s1 && r0 == r1) {
+		upsampleChannel<true, false>(up, startSample, frames, stride, {a1, s1, r1, a1, s1, r1, 2 * frames});
