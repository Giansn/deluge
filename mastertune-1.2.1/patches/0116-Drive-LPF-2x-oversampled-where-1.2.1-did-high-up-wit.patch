 #include "dsp/filter/lpladder.h"
 #include "processing/engines/audio_engine.h"
+#include <algorithm>
 
 namespace deluge::dsp::filter {
+// 1.2.1's: above this resonance (processedResonance, 1 = 1073741824, from the table's value << 16), the drive ladder
+// runs oversampled, by the cutoff's logFreq >> 24 (only above 51 at all; see driveWantsOversampling())
+const int16_t resonanceThresholdsForOversampling[] = {
+    16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384,
+    16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384,
+    16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384,
+    16384, // 48
+    16384, // 49
+    16384, // 50
+    16384,
+    15500, // 52
+    20735, // 14848,
+    17000, // 12800, // 54
+    9000,  // 4300,
+    9000,  // 56
+    9000,  9000,  9000,  9000,  9000,  9000,  9000,  9000,
+};
+
+bool LpLadderFilter::driveWantsOversampling(q31_t lpfFrequency, q31_t lpfResonance, bool keep) {
+	// (as setConfig() works them out; the resonance in 64 bits: a patch cable can take it past what << 2 holds)
+	int32_t logFreq = std::min(quickLog(lpfFrequency), (int32_t)63 << 24);
+	int64_t processedResonance = std::clamp((int64_t)lpfResonance << 2, (int64_t)0, (int64_t)INT32_MAX);
+	if (keep) {
+		logFreq = std::min(logFreq + (1 << 23), (int32_t)63 << 24); // a quarter of an octave (2^25 per octave)
+	}
+	if ((logFreq >> 24) <= 51) {
+		return false;
+	}
+	int32_t threshold = interpolateTableSigned(logFreq, 30, resonanceThresholdsForOversampling, 6);
+	if (keep) {
+		threshold -= threshold / 10;
+	}
+	return processedResonance > threshold;
+}
+
