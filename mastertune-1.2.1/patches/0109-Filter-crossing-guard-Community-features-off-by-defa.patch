+// The crossing guard (see crossingGuard). In series, the two filters' gains multiply: where their peaks meet, the
+// combination's peak height (over the level both pass) is the sum of theirs in dB. So at the crossing each filter's
+// resonance is lowered to where its own peak is half as high (plus 0.5 dB): together they then peak at most 1 dB above
+// the higher one alone, (hL + 1) / 2 + (hH + 1) / 2 <= max(hL, hH) + 1. (In parallel the two sum at half level and
+// don't stack: no guard there.) The peak heights are the filters' own, measured (tests/filters crossing_guard
+// "heights": the impulse response at -66 dBFS, where every filter is linear and the peaks are highest; 200 Hz to 2.5
+// kHz, the voice's and the song's filters alike within 0.5 dB up to where they sing on their own) at resonance 0,
+// 2.5, ... 50 of the display's 50. Where a ladder sings on its own (the 12 /
+// 24 dB LP ladders from 37.5, the drive ladder from 25) the table goes on at 45 dB, 1 dB a step: there the guard
+// takes it down to about 23 dB, so it stops singing at the crossing. The HP ladder sings from 35 at 1 kHz, from 42.5
+// at 5 kHz, where it peaks about 5 dB lower throughout: its table rises on in 5 dB steps from 35, so the guard
+// halves it enough at every cutoff.
+namespace {
+constexpr int32_t kResonancePerStep = 10737418; // the resonance's param per step of the display's 0 to 50
+constexpr float kPeakLp12[21] = {0.0f,  0.2f,  1.0f,  2.5f,  4.2f,  6.0f,  7.9f,  9.8f,  11.9f, 14.2f, 16.7f,
+                                 19.6f, 23.1f, 27.7f, 35.3f, 45.0f, 46.0f, 47.0f, 48.0f, 49.0f, 50.0f};
+constexpr float kPeakLp24[21] = {0.0f,  0.2f,  0.9f,  2.6f,  4.4f,  6.3f,  8.3f,  10.3f, 12.5f, 14.8f, 17.3f,
+                                 20.2f, 23.8f, 28.4f, 36.2f, 45.0f, 46.0f, 47.0f, 48.0f, 49.0f, 50.0f};
+constexpr float kPeakDrive[21] = {0.0f,  0.2f,  0.9f,  2.7f,  4.7f,  7.1f,  9.7f,  12.9f, 17.0f, 23.5f, 45.0f,
+                                   46.0f, 47.0f, 48.0f, 49.0f, 50.0f, 51.0f, 52.0f, 53.0f, 54.0f, 55.0f};
+constexpr float kPeakSvf[21] = {0.9f,  1.5f,  2.2f,  3.0f,  3.9f,  4.9f,  6.0f,  7.2f,  8.5f,  10.0f, 11.6f,
+                                13.4f, 15.4f, 17.7f, 20.4f, 23.6f, 27.4f, 32.4f, 39.5f, 51.5f, 64.6f};
+constexpr float kPeakHpLadder[21] = {0.0f,  0.05f, 0.1f,  0.7f,  1.6f,  2.6f,  3.9f,  5.4f,  7.1f,  9.2f,  11.6f,
+                                     15.3f, 18.8f, 23.1f, 28.0f, 33.0f, 38.0f, 43.0f, 45.0f, 47.0f, 49.0f};
+// A table's peak height at a resonance (steps of the display, 0 to 50), linear between its values
+float peakAt(const float* peaks, float steps) {
+	float x = std::clamp(steps / 2.5f, 0.0f, 20.0f);
+	int32_t i = std::min((int32_t)x, (int32_t)19);
+	return peaks[i] + (peaks[i + 1] - peaks[i]) * (x - (float)i);
+}
+// The resonance (steps) where a table's peak height is h (the inverse of peakAt(); the tables rise throughout)
+float resonanceForPeak(const float* peaks, float h) {
+	if (h <= peaks[0]) {
+		return 0.0f;
+	}
+	int32_t i = 0;
+	while (i < 19 && peaks[i + 1] < h) {
+		i++;
+	}
+	float t = std::clamp((h - peaks[i]) / (peaks[i + 1] - peaks[i]), 0.0f, 1.0f);
+	return 2.5f * ((float)i + t);
+}
+} // namespace
+
+const float* FilterSet::guardPeaks(FilterMode mode) {
+	switch (mode) {
+	case FilterMode::TRANSISTOR_12DB:
+		return kPeakLp12;
+	case FilterMode::TRANSISTOR_24DB:
+		return kPeakLp24;
+	case FilterMode::TRANSISTOR_24DB_DRIVE:
+		return kPeakDrive;
+	case FilterMode::HPLADDER:
+		return kPeakHpLadder;
+	case FilterMode::SVF_BAND:
+	case FilterMode::SVF_NOTCH:
+		return kPeakSvf;
+	default:
+		return nullptr;
+	}
+}
+
+// Strength: 0 up to 2 octaves below the crossing (the HPF at a quarter of the LPF's cutoff), rising to 1 at half an
+// octave below (0.7 times it; a smoothstep: continuous in value and slope, so a cutoff swept through moves the
+// resonance without a kink), 1 to half an octave above, falling to 0 at 3 octaves above (there only the skirts meet)
+float FilterSet::guardStrength(float octaves) {
+	constexpr float kRiseFrom = -2.0f, kFullFrom = -0.5f, kFullTo = 0.5f, kFallTo = 3.0f;
+	auto smooth = [](float t) { return t * t * (3.0f - 2.0f * t); };
+	if (octaves <= kRiseFrom || octaves >= kFallTo) {
+		return 0.0f;
+	}
+	if (octaves < kFullFrom) {
+		return smooth((octaves - kRiseFrom) / (kFullFrom - kRiseFrom));
+	}
+	if (octaves > kFullTo) {
+		return smooth((kFallTo - octaves) / (kFallTo - kFullTo));
+	}
+	return 1.0f;
+}
+
+// At full strength the resonance where the peak is (h + 1) / 2 high; between, in a straight line from the resonance
+// as it is (monotonic in the knob's resonance at every strength: turning it up never lowers it)
+q31_t FilterSet::guardResonance(q31_t resonance, float strength, const float* peaks) {
+	if (resonance <= 0 || strength <= 0.0f || peaks == nullptr) {
+		return resonance;
+	}
+	const float steps = (float)resonance * (1.0f / (float)kResonancePerStep);
+	const float h = peakAt(peaks, steps);
+	const float full = std::min(resonanceForPeak(peaks, 0.5f * (h + 1.0f)), steps);
+	const float guarded = steps - strength * (steps - full);
+	return std::min(resonance, (q31_t)(guarded * (float)kResonancePerStep));
+}
+
 int32_t FilterSet::setConfig(q31_t lpfFrequency, q31_t lpfResonance, FilterMode lpfmode, q31_t lpfMorph,
                              q31_t hpfFrequency, q31_t hpfResonance, FilterMode hpfmode, q31_t hpfMorph,
                              q31_t filterGain, FilterRoute routing, bool adjustVolumeForHPFResonance,
@@ -392,6 +485,18 @@ int32_t FilterSet::setConfig(q31_t lpfFrequency, q31_t lpfResonance, FilterMode
 	lpfMode_ = lpfmode;
 	hpfMode_ = hpfmode;
 	routing_ = routing;
+	// mastertune v18: the crossing guard, where it's switched on (off: this doesn't run, nothing changes). Both
+	// resonances lowered as the cutoffs come near each other (guardStrength()); the coefficients move per sample from
+	// the last block's, so the resonance follows a cutoff swept through smoothly, without steps
+	if (crossingGuard && LPFOn && HPFOn && routing_ != FilterRoute::PARALLEL && lpfFrequency > 0
+	    && hpfFrequency > 0 && (lpfResonance > 0 || hpfResonance > 0)) {
+		// quickLog: 2^25 per octave (piecewise linear between octaves, continuous, within 0.09 of an octave)
+		const float octaves = (float)(quickLog(hpfFrequency) - quickLog(lpfFrequency)) * (1.0f / 33554432.0f);
+		const float strength = guardStrength(octaves);
+		lpfResonance = guardResonance(lpfResonance, strength, guardPeaks(lpfMode_));
+		hpfResonance = guardResonance(hpfResonance, strength, guardPeaks(hpfMode_));
+	}
+
 	// 1.2.1 cut the HPF's resonance to 256 steps here ("having changes happen in the small bytes too often causes
 	// rustling": each block's change jumped). mastertune v18: the coefficients move per sample from block to block, so
 	// the resonance keeps its full resolution: a modulated or automated one no longer moves in steps of up to 0.8 dB
