+	static inline bool crossingGuard = false;
+	/// The guard's strength (0: none, 1: full) at the cutoffs' distance in octaves (log2 of the HPF's cutoff param over
+	/// the LPF's)
+	[[nodiscard]] static float guardStrength(float octaves);
+	/// A filter mode's peak heights (dB over its passband) at resonance 0, 2.5, ... 50, for the guard
+	[[nodiscard]] static const float* guardPeaks(FilterMode mode);
+	/// A resonance (param, 10737418 per step of the display's 0 to 50) as the guard lowers it at a strength
+	[[nodiscard]] static q31_t guardResonance(q31_t resonance, float strength, const float* peaks);
+
