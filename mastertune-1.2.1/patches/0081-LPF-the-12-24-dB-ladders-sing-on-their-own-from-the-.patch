+	enum class Saturation { NONE, TANH, TANH_MORPH, TANH_GLOBAL, TANH_MORPH_GLOBAL, PER_SAMPLE };
 	// MONO: sampleIncrement 1 (all callers), MONO_STRIDED: any sampleIncrement, STEREO: interleaved
 	enum class Layout { MONO, MONO_STRIDED, STEREO };
 	template <FilterMode mode, Saturation saturation, bool oversample, Layout layout>
 	void renderLoop(q31_t* startSample, q31_t* endSample, int32_t sampleIncrement);
 	template <FilterMode mode, bool oversample, Layout layout>
 	void renderSaturation(q31_t* startSample, q31_t* endSample, int32_t sampleIncrement);
+	template <FilterMode mode, bool oversample, Layout layout, Saturation voice, Saturation global>
+	void renderSaturationAmount(q31_t* startSample, q31_t* endSample, int32_t sampleIncrement);
+	// The saturation amount for this block: kSaturationGlobal for the 12 dB and 24 dB ladders in the song's, a kit's
+	// and an audio track's filters with the resonance up (where they saturate without morph, processedResonance
+	// 510000000, about 26 %), else kSaturationVoice (the drive ladder's everywhere, morph's below that resonance)
+	template <FilterMode mode>
+	[[nodiscard]] int32_t saturationAmount() const {
+		return mode != FilterMode::TRANSISTOR_24DB_DRIVE && saturationAmount_ == kSaturationGlobal
+		               && processedResonance > 510000000
+		           ? kSaturationGlobal
+		           : kSaturationVoice;
+	}
 	template <FilterMode mode, bool oversample>
 	void renderMono(q31_t* startSample, q31_t* endSample, int32_t sampleIncrement);
 	// One channel: every sample from startSample on (MONO, MONO_STRIDED), or the left or right of each frame (STEREO,
@@ -118,5 +143,6 @@ private:
 	q31_t lpf3Feedback;
 
 	bool doOversampling;
+	uint8_t saturationAmount_; // in the padding after the bool: a voice's FilterSet stays the same size
 };
