+// The saturation amount is the original firmware's per context for the 12 dB and 24 dB ladders: 1 + extraSaturation,
+// that is 2 in voices (its dsp/filter/filter_set.h:122, renderLong(): renderLPFLong(..., 1, 1)) and 3 in the song's, a
+// kit's and an audio track's filters (its model/global_effectable/global_effectable.cpp:372-373, processFilters():
+// renderLPFLong(..., 2, 2, 1)), used at filter_set.cpp:241 (12 dB) and :259 (24 dB). Community #336 (04faf186,
+// "Morphable and Driveable and Parallel filters") made it 2 everywhere, which put the level where the song's ladder
+// limits 1 bit higher, and a self-oscillating ladder sings at its cutoff at about that level: 6 dB louder than in the
+// original firmware. Voices keep 2, as there. So does morph (#336's) below the resonance where the ladder saturates
+// without it (about 26 %): its drive sounds as before. The drive ladder's input tanh (#336's, the original had none
+// there) keeps 2: its own feedback and output tanhs (7 and 4, the original's extraSaturationDrive 1 in every context)
+// limit first.
+template <FilterMode mode, bool oversample, LpLadderFilter::Layout layout, LpLadderFilter::Saturation voice,
+          LpLadderFilter::Saturation global>
+void LpLadderFilter::renderSaturationAmount(q31_t* startSample, q31_t* endSample, int32_t sampleIncrement) {
+	if constexpr (mode != FilterMode::TRANSISTOR_24DB_DRIVE) {
+		if (saturationAmount<mode>() == kSaturationGlobal) {
+			renderLoop<mode, global, oversample, layout>(startSample, endSample, sampleIncrement);
+			return;
+		}
+	}
+	renderLoop<mode, voice, oversample, layout>(startSample, endSample, sampleIncrement);
+}
+
 // The noise generator, getNoise(): jcong = kNoiseMul * jcong + kNoiseAdd (mod 2^32). Two steps at once are
 // jcong = kNoiseMul^2 * jcong + (kNoiseMul + 1) * kNoiseAdd, and kNoiseMul (odd) has an inverse mod 2^32, which
 // steps back
@@ -273,7 +303,8 @@ template <FilterMode mode, LpLadderFilter::Saturation saturation, bool oversampl
 	                     lpf1Feedback,
 	                     lpf2Feedback,
 	                     lpf3Feedback,
-	                     divideBy1PlusTannedFrequency};
+	                     divideBy1PlusTannedFrequency,
+	                     saturationAmount<mode>()};
 	if constexpr (layout != Layout::STEREO) {
 		uint32_t noise = jcong;
 		renderChannel<mode, saturation, oversample, layout, 0, false>(startSample, endSample, sampleIncrement, l, c,
@@ -379,17 +410,18 @@ template <LpLadderFilter::Saturation saturation>
 	                 (input - (multiply_32x32_rshift32_rounded(feedbacksSum, c.processedResonance) << 3)),
 	                 c.divideByTotalMoveabilityAndProcessedResonance)
 	             << 2;
-	if constexpr (saturation == Saturation::TANH_MORPH) {
+	if constexpr (saturation == Saturation::TANH_MORPH || saturation == Saturation::TANH_MORPH_GLOBAL) {
 		q31_t extra = 2 * multiply_32x32_rshift32(input, c.morph);
-		temp = getTanHUnknown(temp + extra, 2);
+		temp = getTanHUnknown(temp + extra,
+		                      saturation == Saturation::TANH_MORPH_GLOBAL ? kSaturationGlobal : kSaturationVoice);
 	}
-	else if constexpr (saturation == Saturation::TANH) {
-		temp = getTanHUnknown(temp, 2); // morph is 0
+	else if constexpr (saturation == Saturation::TANH || saturation == Saturation::TANH_GLOBAL) {
+		temp = getTanHUnknown(temp, saturation == Saturation::TANH_GLOBAL ? kSaturationGlobal : kSaturationVoice);
 	}
 	else if constexpr (saturation == Saturation::PER_SAMPLE) {
 		if (c.morph > 0 || c.processedResonance > 510000000) {
 			q31_t extra = 2 * multiply_32x32_rshift32(input, c.morph);
-			temp = getTanHUnknown(temp + extra, 2);
+			temp = getTanHUnknown(temp + extra, c.saturationAmount);
 		}
 	}
 	return temp;
