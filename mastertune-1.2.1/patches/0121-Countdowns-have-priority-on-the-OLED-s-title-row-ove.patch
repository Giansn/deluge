+#include <algorithm>
+#include <cstring>
+
+namespace deluge::gui::countdown {
+
+namespace {
+
+enum class Where : uint8_t { NONE, SONG_CHANGE, LAUNCH };
+
+/// Which countdown the current UI shows, if any. Asked anew each time, so that nothing can stay up after it
+Where where() {
+	if (!currentSong || stemExport.processStarted) {
+		return Where::NONE;
+	}
+	UI* ui = getCurrentUI();
+	if (ui == &loadSongUI) {
+		return (currentUIMode == UI_MODE_LOADING_SONG_UNESSENTIAL_SAMPLES_ARMED) ? Where::SONG_CHANGE : Where::NONE;
+	}
+	// The views that draw through SessionView::renderOLED(), where 1.2.1 showed the launch
+	bool drawsThroughSongView = (ui == &sessionView || ui == &performanceSessionView || ui == &arrangerView);
+	if (drawsThroughSongView && currentPlaybackMode == &session && session.launchEventAtSwungTickCount
+	    && playbackHandler.isEitherClockActive()) {
+		return Where::LAUNCH;
+	}
+	return Where::NONE;
+}
+
+// What routine() last saw
+bool lastShown = false;
+char const* lastLabel = nullptr;
+char lastNumber[12] = "";
+
+} // namespace
+
+bool line(char const** label, char* number, size_t size) {
+	Where now = where();
+	if (now == Where::NONE || size < 12) {
+		return false;
+	}
+	if (now == Where::LAUNCH) {
+		// As Song view counted it (SessionView::displayLoopsRemainingPopup(), community firmware): the bars until the
+		// launch, in the last bar the beats. At least 1 until the launch: its sixteenths are rounded, and an external
+		// clock's position is an estimate between its ticks
+		int32_t sixteenths = std::max<int32_t>(session.getNumSixteenthNotesRemainingTilLaunch(), 1);
+		bool bars = (sixteenths > 16);
+		*label = bars ? "Bars remaining" : "Beats remaining";
+		intToString(bars ? (sixteenths - 1) / 16 + 1 : (sixteenths - 1) / 4 + 1, number);
+		return true;
+	}
+	using Unit = Session::LaunchCountdown::Unit;
+	Session::LaunchCountdown countdown = session.getLaunchCountdown(); // The song change's (v14)
+	*label = (countdown.unit == Unit::LOOPS)   ? "Loops remaining"
+	         : (countdown.unit == Unit::BARS)  ? "Bars remaining"
+	         : (countdown.unit == Unit::BEATS) ? "Beats remaining"
+	                                           : "Song will begin...";
+	number[0] = 0;
+	if (countdown.unit != Unit::NONE) {
+		intToString(countdown.count, number);
+	}
+	return true;
+}
+
+void routine() {
+	if (!display->haveOLED()) {
+		return;
+	}
+	char const* label = nullptr;
+	char number[12];
+	bool shown = line(&label, number, sizeof(number));
+	if (shown != lastShown || (shown && (label != lastLabel || strcmp(number, lastNumber) != 0))) {
+		lastShown = shown;
+		lastLabel = label;
+		strcpy(lastNumber, shown ? number : "");
+		deluge::hid::display::OLED::markChanged();
+	}
+}
+
+bool knobPopupAllowed() {
+	if (display->haveOLED()) {
+		return true; // The OLED moves popups below the countdown
+	}
+	switch (where()) {
+	case Where::SONG_CHANGE:
+		return false;
+	case Where::LAUNCH:
+		// As SessionView::redrawNumericDisplay() shows it: the arranger only while it will switch to the arrangement
+		return getCurrentUI() == &arrangerView && !session.switchToArrangementAtLaunchEvent;
+	default:
+		return true;
+	}
+}
+
+KnobPopupGuard::KnobPopupGuard() : held_(!knobPopupAllowed() && !deluge::hid::display::popupsHeld) {
+	if (held_) {
+		deluge::hid::display::popupsHeld = true;
+	}
+}
+
+KnobPopupGuard::~KnobPopupGuard() {
+	if (held_) {
+		deluge::hid::display::popupsHeld = false;
+	}
+}
+
+} // namespace deluge::gui::countdown
