+/// The popup's box (minX to maxX, minY to maxY in from) onto to, dy pixels lower; cut at the bottom of the screen
+void copyBoxDown(ImageStore from, ImageStore to, int32_t minX, int32_t minY, int32_t maxX, int32_t maxY, int32_t dy) {
+	maxX = std::min<int32_t>(maxX, OLED_MAIN_WIDTH_PIXELS - 1);
+	for (int32_t y = maxY; y >= minY; y--) {
+		int32_t toY = y + dy;
+		if (toY < 0 || toY >= OLED_MAIN_HEIGHT_PIXELS) {
+			continue;
+		}
+		uint8_t toBit = 1 << (toY & 7);
+		for (int32_t x = std::max<int32_t>(minX, 0); x <= maxX; x++) {
+			if ((from[y >> 3][x] >> (y & 7)) & 1) {
+				to[toY >> 3][x] |= toBit;
+			}
+			else {
+				to[toY >> 3][x] &= ~toBit;
+			}
+		}
+	}
