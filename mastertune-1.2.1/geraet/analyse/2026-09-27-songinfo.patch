+#include "io/usb/usb_song_info.h"
+#include "io/midi/midi_device.h"
+#include "io/midi/midi_device_manager.h"
+#include "io/usb/usb_audio.h"
+#include "model/song/song.h"
+#include "processing/engines/audio_engine.h"
+#include "version.h"
+#include <cstring>
+
+namespace usb_song_info {
+
+namespace {
+
+/// Room that must stay free in the USB MIDI send buffer, so the message never crowds out notes or clock
+constexpr int32_t kMinUsbSendSpace = 1024;
+/// Again every 2 s (in samples of the audio clock)
+constexpr uint32_t kRepeatSamples = 2 * 44100;
+
+char lastSong[kMaxNameBytes + 1] = {0};
+bool told = false; // Since the stream started
+uint32_t lastTime = 0;
+
+} // namespace
+
+void routine() {
+	if (!usbAudioIsStreaming()) {
+		told = false; // Told again as soon as the computer opens the stream
+		return;
+	}
+	char const* song = currentSong ? currentSong->name.get() : "";
+	uint32_t now = AudioEngine::audioSampleTimer;
+	if (told && !strncmp(song, lastSong, kMaxNameBytes) && now - lastTime < kRepeatSamples) {
+		return;
+	}
+	MIDIDeviceUSBUpstream& port = MIDIDeviceManager::upstreamUSBMIDIDevice_port3;
+	if (port.sendBufferSpace() < kMinUsbSendSpace) {
+		return; // Next time
+	}
+	uint8_t message[kMaxMessageBytes];
+	size_t length = build(message, sizeof message, song, kFirmwareVersionString);
+	if (!length) {
+		return;
+	}
+	port.sendSysex(message, static_cast<int32_t>(length));
+	strncpy(lastSong, song, kMaxNameBytes);
+	lastSong[kMaxNameBytes] = 0;
+	told = true;
+	lastTime = now;
+}
+
+} // namespace usb_song_info
diff --git a/src/deluge/io/usb/usb_song_info.h b/src/deluge/io/usb/usb_song_info.h
new file mode 100644
index 00000000..feb2b2c4
--- /dev/null
+++ b/src/deluge/io/usb/usb_song_info.h
@@ -0,0 +1,51 @@
+/*
+ * Copyright © 2026 Synthstrom Audible Limited
+ *
+ * This file is part of The Synthstrom Audible Deluge Firmware.
+ *
+ * The Synthstrom Audible Deluge Firmware is free software: you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software Foundation,
+ * either version 3 of the License, or (at your option) any later version.
