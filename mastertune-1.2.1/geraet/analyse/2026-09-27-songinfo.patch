+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// mastertune: the song's name and the firmware, told to the computer while USB audio streams, so a recorder there
+// (DelugeRec, tools/deluge_rec.py) can name its files after them. Sent only, never answered, on USB MIDI port 3 (the
+// port for SysEx, which DAWs leave alone):
+//
+//   F0 00 21 7B 01 12 <{"song":"...","fw":"..."}: JSON, UTF-8, packed 7 bytes into 8 as in util/pack.c> F7
+//
+// "song" is currentSong->name ("" for a new song not saved yet), converted from CP437 (FatFs's code page) to UTF-8;
+// "fw" is kFirmwareVersionString. It goes out when the stream starts and at once when the song's name changes, else
+// again every 2 s, so a recorder that starts listening later learns it too. (If the Deluge has had SysEx with the
+// developer ID 0x7D, MIDIDeviceUSB::sendSysex sends the header as F0 7D 12 instead; the recorder takes both.)
+namespace usb_song_info {
+
+constexpr uint8_t kSysexCommand = 0x12;
+/// At most this many characters of a name (one byte each in CP437) ...
+constexpr size_t kMaxNameBytes = 120;
+/// ... and at most this many bytes of JSON for the song and for the firmware (cut before a whole character)
+constexpr size_t kMaxSongBytes = 240;
+constexpr size_t kMaxFirmwareBytes = 96;
+constexpr size_t kMaxJsonBytes = 32 + kMaxSongBytes + kMaxFirmwareBytes;
+/// Room for any message: the JSON packed 7 into 8, and the frame (far below 1 KB)
+constexpr size_t kMaxMessageBytes = 7 + (kMaxJsonBytes * 8 + 6) / 7;
+
+/// The whole SysEx for a song and a firmware in out; its length, or 0 if out is too small
+size_t build(uint8_t* out, size_t outSize, char const* song, char const* firmware);
+
+/// Main loop, every 0.25 s: sends the message when it is due
+void routine();
+
+} // namespace usb_song_info
diff --git a/src/deluge/io/usb/usb_song_info_message.cpp b/src/deluge/io/usb/usb_song_info_message.cpp
new file mode 100644
index 00000000..cef0d803
--- /dev/null
+++ b/src/deluge/io/usb/usb_song_info_message.cpp
@@ -0,0 +1,122 @@
+/*
+ * Copyright © 2026 Synthstrom Audible Limited
+ *
+ * This file is part of The Synthstrom Audible Deluge Firmware.
+ *
+ * The Synthstrom Audible Deluge Firmware is free software: you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software Foundation,
+ * either version 3 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+// The message alone, without the hardware: also built on a computer, to test it against the recorder that reads it.
+
+#include "fatfs/ff.h"
+#include "io/usb/usb_song_info.h"
+#include "util/pack.h"
+
+namespace usb_song_info {
+
+namespace {
+
+/// One character of a name (CP437, as FatFs gives names with FF_CODE_PAGE 437) as JSON in UTF-8: " and \ escaped,
+/// control characters as \u00XX, anything above 0x7F converted; its length.
+size_t encode(uint8_t c, char* out) {
+	char const* hex = "0123456789abcdef";
+	if (c == '"' || c == '\\') {
+		out[0] = '\\';
+		out[1] = static_cast<char>(c);
+		return 2;
+	}
+	if (c < 0x20) {
+		char const u[6] = {'\\', 'u', '0', '0', hex[c >> 4], hex[c & 15]};
+		for (size_t k = 0; k < 6; k++) {
+			out[k] = u[k];
+		}
+		return 6;
+	}
+	if (c < 0x80) {
+		out[0] = static_cast<char>(c);
+		return 1;
+	}
+	uint32_t u = ff_oem2uni(c, FF_CODE_PAGE);
+	if (!u) {
+		out[0] = '?';
+		return 1;
+	}
+	if (u < 0x800) {
+		out[0] = static_cast<char>(0xC0 | (u >> 6));
+		out[1] = static_cast<char>(0x80 | (u & 0x3F));
+		return 2;
+	}
+	out[0] = static_cast<char>(0xE0 | (u >> 12));
+	out[1] = static_cast<char>(0x80 | ((u >> 6) & 0x3F));
+	out[2] = static_cast<char>(0x80 | (u & 0x3F));
+	return 3;
+}
+
+/// Appends s as a JSON string with its quotes: at most kMaxNameBytes characters of s and maxOut bytes between the
+/// quotes, cut before a character that would not fit. Returns the new pos, 0 if out is full.
+size_t appendString(char* out, size_t pos, size_t size, char const* s, size_t maxOut) {
+	if (pos + 2 > size) {
+		return 0;
+	}
+	out[pos++] = '"';
+	size_t used = 0;
+	for (size_t i = 0; s[i] && i < kMaxNameBytes; i++) {
+		char encoded[6];
+		size_t length = encode(static_cast<uint8_t>(s[i]), encoded);
+		if (used + length > maxOut || pos + length + 1 > size) {
+			break;
+		}
+		for (size_t k = 0; k < length; k++) {
+			out[pos++] = encoded[k];
+		}
+		used += length;
+	}
+	out[pos++] = '"';
+	return pos;
+}
+
+size_t appendText(char* out, size_t pos, size_t size, char const* text) {
+	for (; *text; text++) {
+		if (pos + 1 > size) {
+			return 0;
+		}
+		out[pos++] = *text;
+	}
+	return pos;
+}
+
+} // namespace
+
+size_t build(uint8_t* out, size_t outSize, char const* song, char const* firmware) {
+	char json[kMaxJsonBytes];
+	size_t pos = appendText(json, 0, sizeof json, "{\"song\":");
+	pos = pos ? appendString(json, pos, sizeof json, song ? song : "", kMaxSongBytes) : 0;
+	pos = pos ? appendText(json, pos, sizeof json, ",\"fw\":") : 0;
+	pos = pos ? appendString(json, pos, sizeof json, firmware ? firmware : "", kMaxFirmwareBytes) : 0;
+	pos = pos ? appendText(json, pos, sizeof json, "}") : 0;
+	uint8_t const header[] = {0xF0, 0x00, 0x21, 0x7B, 0x01, kSysexCommand};
+	if (!pos || outSize < sizeof header + 1) {
+		return 0;
+	}
+	for (size_t i = 0; i < sizeof header; i++) {
+		out[i] = header[i];
+	}
+	int32_t packed = pack_8bit_to_7bit(out + sizeof header, static_cast<int32_t>(outSize - sizeof header - 1),
+	                                   reinterpret_cast<uint8_t*>(json), static_cast<int32_t>(pos));
+	if (packed <= 0) {
+		return 0;
+	}
+	out[sizeof header + packed] = 0xF7;
+	return sizeof header + packed + 1;
+}
+
+} // namespace usb_song_info
