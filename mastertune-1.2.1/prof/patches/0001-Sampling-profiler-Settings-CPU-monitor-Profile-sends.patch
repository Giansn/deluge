+++ b/src/deluge/processing/engines/profiler_core.h
@@ -0,0 +1,127 @@
+/*
+ * Copyright © 2026 Synthstrom Audible Limited
+ *
+ * This file is part of The Synthstrom Audible Deluge Firmware.
+ *
+ * The Synthstrom Audible Deluge Firmware is free software: you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software Foundation,
+ * either version 3 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+// The sampling profiler's parts that don't touch hardware (mastertune-v15-prof), so a host test can check them: the
+// ring the timer interrupt fills and the SysEx messages the samples and the names go out in. See profiler.h.
+//
+// Samples message (the computer decodes it: tools/profiler.html, tools/deluge_profiler.py):
+//   F0 00 21 7B 01 11  seq (2 bytes, 14 bits)  dropped (3 bytes, 21 bits, saturating)  count (1 byte, <= 32)
+//   per sample: the address (5 bytes, 7 bits each, least significant first) and the context (3 bytes, same)  F7
+//   seq counts the messages (wrapping at 2^14), so the computer sees lost ones; dropped is the number of samples the
+//   ring had no room for since the last message.
+// Names message:
+//   F0 00 21 7B 01 12  kind (0 tasks, 1 outputs of the song)  count  per name: index (2 bytes, 7 bits each) the
+//   name's characters (printable ASCII, at most kMaxNameLength) 00  F7
+//
+// Output times message (once a second: each output's render time, measured exactly around its renderOutput(), which
+// runs with interrupts disabled, so samples can't look inside):
+//   F0 00 21 7B 01 13  window number (1 byte, wrapping at 128)  window (5 bytes: OS timer ticks, 33.33 MHz, the time
+//   the numbers cover)  count  per output that rendered: index (2 bytes) ticks (5 bytes)  F7
+//   (several messages for one window when there are many outputs; its number and length repeat in each)
+//
+// A sample's context (21 bits):
+//   bits 0-4   the task running (TaskManager's TaskID, 31 none: the scheduler itself, or before it runs)
+//   bit 5      inside AudioEngine::routine()
+//   bit 6      the interrupted code wasn't in System mode (the main program's), e.g. an abort or undefined handler
+//   bits 8-15  the output of the song being rendered, counted from the first (255 none)
+//   bits 16-20 weight: timer periods since the last sample, 1 to 31. More than 1 when interrupts were disabled for
+//              longer than a period (as while each output renders): the sample then stands for all that time and was
+//              taken where they were enabled again
+
+#include <cstddef>
+#include <cstdint>
+
+namespace profiler {
+
+constexpr uint8_t kSysexSamples = 0x11;
+constexpr uint8_t kSysexNames = 0x12;
+constexpr uint8_t kSysexOutputTimes = 0x13;
+
+constexpr uint8_t kNoTask = 31;
+constexpr uint8_t kNoOutput = 255;
+
+constexpr size_t kMaxSamplesPerMessage = 32;
+constexpr size_t kBytesPerSample = 8;
+constexpr size_t kSamplesHeaderLength = 6 + 2 + 3 + 1;
+constexpr size_t kMaxSamplesMessageLength = kSamplesHeaderLength + kMaxSamplesPerMessage * kBytesPerSample + 1;
+
+constexpr size_t kMaxNameLength = 24;
+constexpr size_t kMaxNamesMessageLength = 512;
+
+constexpr size_t kMaxOutputs = 255; // Output indices 0 to 254
+constexpr size_t kMaxOutputTimesMessageLength = 512;
+
+struct Sample {
+	uint32_t address;
+	uint32_t context;
+};
+
+/// What the CPU is doing, for the samples: set by the firmware as it goes, a store each, whether profiling or not
+inline volatile uint8_t currentTask = kNoTask;     ///< TaskManager::runTask()
+inline volatile uint8_t currentOutput = kNoOutput; ///< Song::renderAudio(): which output renders
+inline volatile bool inAudioRoutine = false;       ///< AudioEngine::routine()
+/// While profiling: Song::renderAudio() adds each output's render time (OS timer ticks) to outputTicks[its index]
+inline volatile bool timingOutputs = false;
+inline uint32_t outputTicks[kMaxOutputs];
+
+constexpr uint32_t packContext(uint8_t task, bool inAudioRoutine, bool otherMode, uint8_t output, uint32_t weight) {
+	return (uint32_t)(task & 31) | (inAudioRoutine ? 0x20u : 0u) | (otherMode ? 0x40u : 0u) | ((uint32_t)output << 8)
+	       | ((weight < 1    ? 1u
+	           : weight > 31 ? 31u
+	                         : weight)
+	          << 16);
+}
+
+/// Filled by the timer interrupt, emptied by the main program: one writer and one reader, so no locks. The interrupt
+/// only moves head_, the main program only tail_.
+class Ring {
+public:
+	static constexpr uint32_t kSize = 1024; // A power of two: 1 s of samples at 1 kHz
+
+	/// From the interrupt. False when full: the sample is counted as dropped
+	bool push(Sample sample);
+	/// From the main program: up to max samples, oldest first
+	size_t pop(Sample* out, size_t max);
+	/// Samples dropped so far (wraps; take differences)
+	uint32_t droppedTotal() const { return dropped_; }
+	/// From the main program, with the interrupt off
+	void clear();
+	size_t size() const { return head_ - tail_; }
+
+private:
+	Sample buffer_[kSize];
+	volatile uint32_t head_ = 0;
+	volatile uint32_t tail_ = 0;
+	volatile uint32_t dropped_ = 0;
+};
+
+/// A samples message into out (at least kMaxSamplesMessageLength bytes), n <= kMaxSamplesPerMessage. Returns its length
+size_t encodeSamples(const Sample* samples, size_t n, uint32_t seq, uint32_t dropped, uint8_t* out);
+
+/// A names message into out (size bytes): as many of the count names as fit. names[i] may be nullptr (then left out).
+/// Returns its length, 0 if not even an empty one fits
+size_t encodeNames(uint8_t kind, const char* const* names, const uint8_t* indices, size_t count, uint8_t* out,
+                   size_t size);
+
+/// An output times message into out (size bytes), for the outputs with ticks from *next on (ticks has kMaxOutputs
+/// entries); *next is left where it stopped (kMaxOutputs when all are in). Returns its length
+size_t encodeOutputTimes(uint8_t windowNumber, uint32_t window, const uint32_t* ticks, size_t* next, uint8_t* out,
+                         size_t size);
+
+} // namespace profiler
