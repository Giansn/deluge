+
+#pragma once
+
+// Sampling profiler (mastertune-v15-prof): Settings > CPU monitor > Profile. OS timer 1 interrupts kSampleRate times
+// a second; each time the address the CPU was at goes into a ring with what it was doing (the task, whether inside
+// the audio routine, which output of the song was rendering). The CPU monitor's task sends the samples to the computer
+// over USB MIDI (port 3, as the CPU monitor's numbers), where tools/profiler.html or tools/deluge_profiler.py name the
+// functions from the firmware's symbols. So the share of time each function, task and track takes shows on the device
+// itself, with its caches, which the emulator doesn't model.
+//
+// The timer's interrupt has the lowest priority there is (30), so it's never taken inside another interrupt's
+// handler, only from the main program: then irq_handler (irqfiq_handler.S) has just pushed the interrupted address and
+// its SPSR onto the empty IRQ stack, at its top. Time in other interrupts' handlers isn't sampled (they're short).
+// Code running with interrupts disabled is sampled where it enables them again, with a weight for the periods it
+// took. That includes each output's renderOutput() (Song::renderAudio() disables interrupts around it), so samples
+// can't tell which functions inside a track take the time; for that each output's render time is measured exactly
+// (OS timer 0) and sent once a second, and the emulator's profile (tests/song) names the functions.
+//
+// Off, it costs nothing but the context stores and a flag test per output (profiler_core.h). On, about 150 cycles per
+// sample (0.04 % CPU), two timer reads per output rendered and ~8 KB/s of USB MIDI.
+
+#include "processing/engines/profiler_core.h"
+
+namespace profiler {
+
+constexpr uint32_t kSampleRate = 1000;
+
+void start();
+void stop();
+bool isRunning();
+
+/// From the CPU monitor's task: sends the samples collected, as many messages as the USB MIDI buffer has room for, and
+/// every 2 s the names of the tasks and of the song's outputs
+void send();
+
+} // namespace profiler
+
+extern "C" void profilerTimerInterrupt(uint32_t sense);
diff --git a/src/deluge/processing/engines/profiler_core.cpp b/src/deluge/processing/engines/profiler_core.cpp
new file mode 100644
index 00000000..07c1feb5
--- /dev/null
+++ b/src/deluge/processing/engines/profiler_core.cpp
@@ -0,0 +1,166 @@
+/*
+ * Copyright © 2026 Synthstrom Audible Limited
+ *
+ * This file is part of The Synthstrom Audible Deluge Firmware.
+ *
+ * The Synthstrom Audible Deluge Firmware is free software: you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software Foundation,
+ * either version 3 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "processing/engines/profiler_core.h"
+#include <atomic>
+
+namespace profiler {
+
+namespace {
+
+constexpr uint8_t kHeader[] = {0xF0, 0x00, 0x21, 0x7B, 0x01};
+
+/// The order of the loads and stores around the index updates, for the compiler (one core: no hardware barrier)
+void compilerBarrier() {
+	std::atomic_signal_fence(std::memory_order_seq_cst);
+}
+
+uint8_t* putBits(uint8_t* out, uint32_t value, int bytes) {
+	for (int i = 0; i < bytes; i++) {
+		*out++ = (uint8_t)(value & 0x7F);
+		value >>= 7;
+	}
+	return out;
+}
+
+} // namespace
+
+bool Ring::push(Sample sample) {
+	uint32_t head = head_;
+	if (head - tail_ >= kSize) {
+		dropped_ = dropped_ + 1;
+		return false;
+	}
+	buffer_[head & (kSize - 1)] = sample;
+	compilerBarrier(); // The sample is in before the reader can see it
+	head_ = head + 1;
+	return true;
+}
+
+size_t Ring::pop(Sample* out, size_t max) {
+	uint32_t tail = tail_;
+	uint32_t available = head_ - tail;
+	compilerBarrier(); // Read the samples only after seeing the head
+	size_t n = (available < max) ? available : max;
+	for (size_t i = 0; i < n; i++) {
+		out[i] = buffer_[(tail + i) & (kSize - 1)];
+	}
+	compilerBarrier(); // Done with them before the writer may reuse their slots
+	tail_ = tail + (uint32_t)n;
+	return n;
+}
+
+void Ring::clear() {
+	tail_ = head_;
+}
+
+size_t encodeSamples(const Sample* samples, size_t n, uint32_t seq, uint32_t dropped, uint8_t* out) {
+	if (n > kMaxSamplesPerMessage) {
+		n = kMaxSamplesPerMessage;
+	}
+	uint8_t* p = out;
+	for (uint8_t b : kHeader) {
+		*p++ = b;
+	}
+	*p++ = kSysexSamples;
+	p = putBits(p, seq & 0x3FFF, 2);
+	p = putBits(p, (dropped > 0x1FFFFF) ? 0x1FFFFF : dropped, 3);
+	*p++ = (uint8_t)n;
+	for (size_t i = 0; i < n; i++) {
+		p = putBits(p, samples[i].address, 5);
+		p = putBits(p, samples[i].context & 0x1FFFFF, 3);
+	}
+	*p++ = 0xF7;
+	return (size_t)(p - out);
+}
+
+size_t encodeNames(uint8_t kind, const char* const* names, const uint8_t* indices, size_t count, uint8_t* out,
+                   size_t size) {
+	constexpr size_t kFixed = 5 + 1 + 1 + 1 + 1; // Header, command, kind, count, F7
+	if (size < kFixed) {
+		return 0;
+	}
+	uint8_t* p = out;
+	for (uint8_t b : kHeader) {
+		*p++ = b;
+	}
+	*p++ = kSysexNames;
+	*p++ = kind & 0x7F;
+	uint8_t* countPos = p++;
+	uint8_t* end = out + size - 1; // Room for F7
+	uint8_t written = 0;
+	for (size_t i = 0; i < count && written < 127; i++) {
+		const char* name = names[i];
+		if (name == nullptr) {
+			continue;
+		}
+		size_t length = 0;
+		while (name[length] != 0 && length < kMaxNameLength) {
+			length++;
+		}
+		if ((size_t)(end - p) < length + 3) {
+			break;
+		}
+		p = putBits(p, indices[i], 2);
+		for (size_t c = 0; c < length; c++) {
+			char ch = name[c];
+			*p++ = (ch >= 0x20 && ch <= 0x7E) ? (uint8_t)ch : (uint8_t)'?';
+		}
+		*p++ = 0;
+		written++;
+	}
+	*countPos = written;
+	*p++ = 0xF7;
+	return (size_t)(p - out);
+}
+
+size_t encodeOutputTimes(uint8_t windowNumber, uint32_t window, const uint32_t* ticks, size_t* next, uint8_t* out,
+                         size_t size) {
+	constexpr size_t kFixed = 5 + 1 + 1 + 5 + 1 + 1; // Header, command, window number and length, count, F7
+	constexpr size_t kPerOutput = 2 + 5;
+	if (size < kFixed) {
+		return 0;
+	}
+	uint8_t* p = out;
+	for (uint8_t b : kHeader) {
+		*p++ = b;
+	}
+	*p++ = kSysexOutputTimes;
+	*p++ = windowNumber & 0x7F;
+	p = putBits(p, window, 5);
+	uint8_t* countPos = p++;
+	uint8_t* end = out + size - 1; // Room for F7
+	uint8_t written = 0;
+	size_t i = *next;
+	for (; i < kMaxOutputs && written < 127; i++) {
+		if (ticks[i] == 0) {
+			continue;
+		}
+		if ((size_t)(end - p) < kPerOutput) {
+			break;
+		}
+		p = putBits(p, (uint32_t)i, 2);
+		p = putBits(p, ticks[i], 5);
+		written++;
+	}
+	*next = i;
+	*countPos = written;
+	*p++ = 0xF7;
+	return (size_t)(p - out);
+}
+
+} // namespace profiler
