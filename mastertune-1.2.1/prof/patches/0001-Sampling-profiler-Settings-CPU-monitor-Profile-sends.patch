+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "processing/engines/profiler.h"
+#include "OSLikeStuff/task_scheduler.h"
+#include "io/midi/midi_device.h"
+#include "io/midi/midi_device_manager.h"
+#include "model/output.h"
+#include "model/song/song.h"
+#include "processing/engines/cpu_stats.h"
+
+extern "C" {
+#include "OSLikeStuff/timers_interrupts/timers_interrupts.h"
+#include "RZA1/intc/devdrv_intc.h"
+#include "RZA1/ostm/ostm.h"
+
+/// The top of the IRQ mode stack (linker script)
+extern char irq_stack_end[];
+}
+
+namespace profiler {
+
+namespace {
+
+constexpr int kTimer = 1;                  // OS timer 1: OS timer 0 is the task scheduler's clock
+constexpr uint8_t kLowestPriority = 30;    // The interrupt controller's mask lets 0 to 30 through
+constexpr int32_t kMinUsbSendSpace = 1024; // As the CPU monitor: room that stays free for notes and clock
+constexpr double kNamesInterval = 2.0;     // Seconds
+constexpr size_t kNamesPerMessage = 16;
+constexpr uint32_t kPeriodTicks = DELUGE_CLOCKS_PER / kSampleRate;
+constexpr uint32_t kOutputTimesWindow = DELUGE_CLOCKS_PER; // 1 s
+
+Ring ring;
+bool running = false;
+uint32_t seq = 0;
+uint32_t droppedReported = 0;
+double lastNamesTime = -1e9;
+uint32_t lastSampleTicks = 0; // The interrupt's, for the weights
+uint32_t windowStartTicks = 0;
+uint32_t windowTicks[kMaxOutputs]; // A window's output times, while they're sent
+uint32_t windowLength = 0;
+uint8_t windowNumber = 0;
+size_t windowNext = kMaxOutputs; // Where sending them has got to (kMaxOutputs: all sent)
+Sample batch[kMaxSamplesPerMessage];
+uint8_t message[kMaxNamesMessageLength]; // Big enough for any kind
+
+MIDIDeviceUSBUpstream& port() {
+	return MIDIDeviceManager::upstreamUSBMIDIDevice_port3;
+}
+
+bool roomFor(size_t length) {
+	return port().sendBufferSpace() >= kMinUsbSendSpace + (int32_t)length;
+}
+
+char outputPrefix(OutputType type) {
+	switch (type) {
+	case OutputType::SYNTH:
+		return 'S';
+	case OutputType::KIT:
+		return 'K';
+	case OutputType::MIDI_OUT:
+		return 'M';
+	case OutputType::CV:
+		return 'C';
+	case OutputType::AUDIO:
+		return 'A';
+	default:
+		return '?';
+	}
+}
+
+/// One kind of names, in messages of kNamesPerMessage. False if the USB MIDI buffer had no room (then all again later)
+bool sendNames(uint8_t kind) {
+	static char text[kNamesPerMessage][kMaxNameLength + 1];
+	const char* names[kNamesPerMessage];
+	uint8_t indices[kNamesPerMessage];
+	size_t n = 0;
+	auto flush = [&]() {
+		if (n == 0) {
+			return true;
+		}
+		size_t length = encodeNames(kind, names, indices, n, message, sizeof(message));
+		if (!roomFor(length)) {
+			return false;
+		}
+		port().sendSysex(message, (int32_t)length);
+		n = 0;
+		return true;
+	};
+	auto add = [&](uint8_t index, char prefix, const char* name) {
+		char* t = text[n];
+		size_t i = 0;
+		if (prefix) {
+			t[i++] = prefix;
+			t[i++] = ' ';
+		}
+		for (const char* c = name; *c && i < kMaxNameLength; c++) {
+			t[i++] = *c;
+		}
+		t[i] = 0;
+		names[n] = t;
+		indices[n] = index;
+		n++;
+		return (n < kNamesPerMessage) || flush();
+	};
+
+	if (kind == 0) {
+		for (int32_t id = 0; id < getNumTaskSlots(); id++) {
+			const char* name = getTaskName((TaskID)id);
+			if (name != nullptr && !add((uint8_t)id, 0, name)) {
+				return false;
+			}
+		}
+	}
+	else if (currentSong != nullptr) {
+		uint8_t index = 0;
+		for (Output* output = currentSong->firstOutput; output != nullptr && index < kNoOutput; output = output->next) {
+			if (!add(index, outputPrefix(output->type), output->name.get())) {
+				return false;
+			}
+			index++;
+		}
+	}
+	return flush();
+}
+
+} // namespace
+
+void start() {
+	if (running) {
+		return;
+	}
+	ring.clear();
+	droppedReported = ring.droppedTotal();
+	lastNamesTime = -1e9;
+	for (uint32_t& t : outputTicks) {
+		t = 0;
+	}
+	windowNext = kMaxOutputs;
+	windowStartTicks = getTimerValue(0);
+	lastSampleTicks = windowStartTicks;
+	timingOutputs = true;
+	// Interval timer: loads the compare value when started and counts down, an interrupt and a reload at each
+	// underflow, so every compare value + 1 cycles of P0 (33.33 MHz)
+	setOperatingMode(kTimer, TIMER, false);
+	setTimerValue(kTimer, DELUGE_CLOCKS_PER / kSampleRate - 1);
+	setupAndEnableInterrupt(profilerTimerInterrupt, INTC_ID_OSTM1TINT, kLowestPriority);
+	enableTimer(kTimer);
+	running = true;
+}
+
+void stop() {
+	if (!running) {
+		return;
+	}
+	disableTimer(kTimer);
+	R_INTC_Disable(INTC_ID_OSTM1TINT);
+	timingOutputs = false;
+	running = false;
+}
+
+bool isRunning() {
+	return running;
+}
+
+void send() {
+	if (!running) {
+		return;
+	}
+	double now = getSystemTime();
+	if (now - lastNamesTime >= kNamesInterval && sendNames(0) && sendNames(1)) {
+		lastNamesTime = now;
+	}
+
+	// Each second, the outputs' render times: taken out of outputTicks (only the audio routine adds to it, and it
+	// doesn't run inside this task), then sent as the USB MIDI buffer has room
+	uint32_t ticksNow = getTimerValue(0);
+	if (windowNext >= kMaxOutputs && ticksNow - windowStartTicks >= kOutputTimesWindow) {
+		for (size_t i = 0; i < kMaxOutputs; i++) {
+			windowTicks[i] = outputTicks[i];
+			outputTicks[i] = 0;
+		}
+		windowLength = ticksNow - windowStartTicks;
+		windowStartTicks = ticksNow;
+		windowNumber = (windowNumber + 1) & 0x7F;
+		windowNext = 0;
+	}
+	while (windowNext < kMaxOutputs) {
+		size_t next = windowNext;
+		size_t length =
+		    encodeOutputTimes(windowNumber, windowLength, windowTicks, &next, message, kMaxOutputTimesMessageLength);
+		if (!roomFor(length)) {
+			break;
+		}
+		port().sendSysex(message, (int32_t)length);
+		windowNext = next;
+	}
+	while (ring.size() > 0) {
+		constexpr size_t kFullLength = kSamplesHeaderLength + kMaxSamplesPerMessage * kBytesPerSample + 1;
+		if (!roomFor(kFullLength)) {
+			return; // Later; if the ring fills meanwhile, the interrupt counts what it drops
+		}
+		size_t n = ring.pop(batch, kMaxSamplesPerMessage);
+		uint32_t droppedTotal = ring.droppedTotal();
+		size_t length = encodeSamples(batch, n, seq++, droppedTotal - droppedReported, message);
+		droppedReported = droppedTotal;
+		port().sendSysex(message, (int32_t)length);
+	}
+}
+
+} // namespace profiler
+
+/// The timer's interrupt: one sample. See profiler.h for why the interrupted address is at the IRQ stack's top
+extern "C" void profilerTimerInterrupt(uint32_t sense) {
+	(void)sense;
+	using namespace profiler;
+	auto const* top = reinterpret_cast<uint32_t const*>(irq_stack_end);
+	uint32_t address = top[-1];             // irq_handler: lr - 4, the instruction to resume at, pushed first
+	uint32_t spsr = top[-2];                // Then SPSR
+	bool otherMode = (spsr & 0x1F) != 0x1F; // Not System mode, the main program's
+	// How many periods this sample stands for: more than one if interrupts were disabled for longer
+	uint32_t now = getTimerValue(0);
+	uint32_t weight = (now - lastSampleTicks + kPeriodTicks / 2) / kPeriodTicks;
+	lastSampleTicks = now;
+	ring.push({address, packContext(currentTask, inAudioRoutine, otherMode, currentOutput, weight)});
+}
