@@ -0,0 +1,82 @@
+/*
+ * Copyright © 2026 Deluge community contributors
+ *
+ * This file is part of The Synthstrom Audible Deluge Firmware.
+ *
+ * The Synthstrom Audible Deluge Firmware is free software: you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software Foundation,
+ * either version 3 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+class MIDIDrum;
+class MIDIInstrument;
+
+/// Global reference pitch ("master tune"), A4 = 415.3 ... 466.2 Hz in steps of 0.1 Hz.
+///
+/// Everything that makes sound follows it: synth and kit rows (all oscillator types including samples, wavetables,
+/// FM and DX7), audio clips (pitch-shifted, tempo kept), the CV outputs and external MIDI (via RPN 1, Channel Fine
+/// Tuning). Audio recorded on the Deluge remembers the tuning it was recorded at, so it is only shifted by the
+/// difference and never tuned twice. Live input used as an oscillator already sounds at the current tuning and is
+/// left alone. At 440.0 Hz, everything not recorded at another tuning is bit-identical to the unmodified firmware.
+namespace MasterTune {
+
+constexpr int32_t kDefaultTenthsHz = 4400;
+constexpr int32_t kMinTenthsHz = 4153; // 440 Hz one semitone down
+constexpr int32_t kMaxTenthsHz = 4662; // 440 Hz one semitone up
+
+/// Name of the entry in CommunityFeatures.XML on the SD card. Firmware that doesn't know it keeps it as an unknown
+/// setting.
+constexpr char const* kSettingName = "masterTune";
+
+/// RIFF chunk written into WAV files recorded while the tuning isn't 440 Hz: 4 bytes, the tuning in tenths of Hz.
+/// Other software skips unknown chunks.
+constexpr uint32_t kRecordingChunkId = 0x6e75746d; // "mtun"
+
+/// Sets the reference pitch (clamped to the valid range) and retunes everything, including notes already sounding.
+void set(int32_t tenthsHz);
+int32_t getTenthsHz();
+
+/// Offset from 440 Hz in cents.
+double getCents();
+
+/// Scales a phase increment by the tuning ratio against the pitch the audio was recorded at (440 Hz for everything
+/// not recorded on the Deluge at another tuning). Exact (64-bit) and a no-op when both are equal.
+uint32_t applyToPhaseIncrement(uint32_t phaseIncrement, int32_t recordedTenthsHz = kDefaultTenthsHz);
+
+/// Whether a recorded tuning read from a file is plausible.
+bool isValid(int32_t tenthsHz);
+
+/// Changes whenever the tuning changes, so voices can recalculate their pitch at their next render.
+uint32_t getGeneration();
+
+/// Makes sure an external MIDI channel has received the current Channel Fine Tuning before a note is sent on it.
+void prepareMIDIChannel(MIDIInstrument& instrument, int32_t outputChannel);
+void prepareMIDIChannel(MIDIDrum& drum);
+
+/// External devices may have been switched on or reconnected since we last tuned them.
+void playbackBegun();
+
+/// Sends pending tuning messages to external MIDI devices. Called regularly from the main loop.
+void routine();
+
+/// Reads our entry from the community settings file. Returns false if the entry is not ours.
+bool readSetting(char const* name, int32_t value);
+
+/// Earlier master-tune builds kept the value in bytes 198-199 of the flash settings. It is adopted unless the settings
+/// file provides a value, and kept in flash only until it has been written to the settings file once.
+void adoptLegacyFlashValue(int32_t tenthsHz);
+bool keepLegacyFlashValue();
+void savedToSettingsFile();
+
+} // namespace MasterTune
diff --git a/src/deluge/model/tuning/master_tune_math.h b/src/deluge/model/tuning/master_tune_math.h
