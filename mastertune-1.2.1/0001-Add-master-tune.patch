+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "model/tuning/master_tune.h"
+#include "definitions_cxx.hpp"
+#include "io/midi/midi_device_manager.h"
+#include "io/midi/midi_engine.h"
+#include "model/clip/clip.h"
+#include "model/instrument/midi_instrument.h"
+#include "model/model_stack.h"
+#include "model/output.h"
+#include "model/song/song.h"
+#include "model/tuning/master_tune_math.h"
+#include "processing/engines/cv_engine.h"
+#include "processing/sound/sound.h"
+#include "processing/sound/sound_instrument.h"
+#include <algorithm>
+#include <cstring>
+
+namespace MasterTune {
+
+namespace {
+
+int32_t tenthsHz = kDefaultTenthsHz;
+uint32_t ratioQ30 = math::kUnityRatioQ30; // tenthsHz / 4400 as unsigned Q2.30
+double cents = 0;
+int32_t midiFineTuning = math::kMIDIFineTuningCentre; // 14 bits, 8192 +- 8192 per 100 cents
+
+// Bumped whenever external MIDI devices have to be (re)tuned. Each MIDIInstrument remembers for which generation it
+// has already sent the fine tuning on which channels.
+uint32_t midiGeneration = 1;
+// Stays false as long as no device has ever been sent a tuning other than 0 cents, so a firmware that is never
+// retuned sends nothing extra at all.
+bool midiTuningUsed = false;
+
+bool settingReadFromFile = false;
+bool legacyValuePending = false; // Adopted from flash, not yet in the settings file
+
+void recalculate() {
+	ratioQ30 = math::ratioQ30(tenthsHz);
+	cents = math::cents(tenthsHz);
+	midiFineTuning = math::midiFineTuning(cents);
+}
+
+void sendFineTuning(MIDIInstrument& instrument, int32_t outputChannel) {
+	// Same device filter as the notes of this instrument
+	int32_t filter = instrument.channel;
+	midiEngine.sendCC(instrument, outputChannel, 101, 0, filter); // RPN MSB
+	midiEngine.sendCC(instrument, outputChannel, 100, 1, filter); // RPN LSB: 1 = Channel Fine Tuning
+	midiEngine.sendCC(instrument, outputChannel, 6, midiFineTuning >> 7, filter);
+	midiEngine.sendCC(instrument, outputChannel, 38, midiFineTuning & 127, filter);
+	midiEngine.sendCC(instrument, outputChannel, 101, 127, filter); // RPN null, so later data entry goes nowhere
+	midiEngine.sendCC(instrument, outputChannel, 100, 127, filter);
+}
+
+void prepareAllChannelsOf(MIDIInstrument& instrument) {
+	if (instrument.sendsToInternal()) {
+		return;
+	}
+	if (!instrument.sendsToMPE()) {
+		prepareMIDIChannel(instrument, instrument.channel);
+		return;
+	}
+	// Same member channel range as MIDIInstrument::noteOnPostArp()
+	bool lowerZone = (instrument.channel == MIDI_CHANNEL_MPE_LOWER_ZONE);
+	int32_t lowest = lowerZone ? 1 : MIDIDeviceManager::highestLastMemberChannelOfUpperZoneOnConnectedOutput;
+	int32_t highest = lowerZone ? MIDIDeviceManager::lowestLastMemberChannelOfLowerZoneOnConnectedOutput : 14;
+	for (int32_t memberChannel = lowest; memberChannel <= highest; memberChannel++) {
+		prepareMIDIChannel(instrument, memberChannel);
+	}
+}
+
+// Held notes must not keep the old tuning.
+void retuneSoundingNotes() {
+	midiGeneration++;
+
+	if (currentSong == nullptr) {
+		return; // Still booting
+	}
+
+	for (Output* output = currentSong->firstOutput; output; output = output->next) {
+		switch (output->type) {
+		case OutputType::SYNTH: {
+			SoundInstrument* sound = static_cast<SoundInstrument*>(output);
+			if (!sound->numVoicesAssigned) {
+				break;
+			}
+			// Like Output::getParamManager(), but skip instead of freezing if there is none
+			Clip* clip = output->getActiveClip();
+			ParamManager* paramManager =
+			    clip ? &clip->paramManager : currentSong->getBackedUpParamManagerPreferablyWithClip(sound, nullptr);
+			if (!paramManager) {
+				break;
+			}
+			char modelStackMemory[MODEL_STACK_MAX_SIZE];
+			ModelStackWithSoundFlags* modelStack =
+			    setupModelStackWithThreeMainThingsButNoNoteRow(modelStackMemory, currentSong, sound, clip, paramManager)
+			        ->addSoundFlags();
+			sound->recalculateAllVoicePhaseIncrements(modelStack);
+			break;
+		}
+		case OutputType::MIDI_OUT:
+			prepareAllChannelsOf(*static_cast<MIDIInstrument*>(output));
+			break;
+		default:
+			break;
+		}
+	}
+
+	cvEngine.recalculateAllCVChannelVoltages();
+}
+
+} // namespace
+
+void set(int32_t newTenthsHz) {
+	newTenthsHz = std::clamp(newTenthsHz, kMinTenthsHz, kMaxTenthsHz);
+	if (newTenthsHz == tenthsHz) {
+		return;
+	}
+	tenthsHz = newTenthsHz;
+	recalculate();
+	retuneSoundingNotes();
+}
+
+int32_t getTenthsHz() {
+	return tenthsHz;
+}
+
+double getCents() {
+	return cents;
+}
+
+bool appliesTo(Sound& sound) {
+	return !sound.isDrum();
+}
+
+uint32_t applyToPhaseIncrement(uint32_t phaseIncrement) {
+	return math::scalePhaseIncrement(phaseIncrement, ratioQ30);
+}
+
+void prepareMIDIChannel(MIDIInstrument& instrument, int32_t outputChannel) {
+	if (outputChannel < 0 || outputChannel > 15) {
+		return;
+	}
+
+	if (instrument.masterTuneGenerationSent != midiGeneration) {
+		instrument.masterTuneGenerationSent = midiGeneration;
+		instrument.masterTuneChannelsSent = 0;
+	}
+
+	bool neutral = (midiFineTuning == math::kMIDIFineTuningCentre);
+	if (neutral && !midiTuningUsed) {
+		return; // Never retuned anything, so behave exactly like the unmodified firmware
+	}
+
+	uint16_t channelBit = 1u << outputChannel;
+	if (instrument.masterTuneChannelsSent & channelBit) {
+		return;
+	}
+	instrument.masterTuneChannelsSent |= channelBit;
+	if (!neutral) {
+		midiTuningUsed = true;
+	}
+	sendFineTuning(instrument, outputChannel);
+}
+
+void playbackBegun() {
+	midiGeneration++;
+}
+
+bool readSetting(char const* name, int32_t value) {
+	if (strcmp(name, kSettingName) != 0) {
+		return false;
+	}
+	settingReadFromFile = true;
+	legacyValuePending = false;
+	set(value);
+	return true;
+}
+
+void adoptLegacyFlashValue(int32_t legacyTenthsHz) {
+	if (settingReadFromFile || legacyTenthsHz < kMinTenthsHz || legacyTenthsHz > kMaxTenthsHz) {
+		return;
+	}
+	legacyValuePending = true;
+	set(legacyTenthsHz);
+}
+
+bool keepLegacyFlashValue() {
+	return legacyValuePending;
+}
+
+void savedToSettingsFile() {
+	legacyValuePending = false;
+}
+
+} // namespace MasterTune
