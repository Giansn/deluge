index 00000000..4886c091
--- /dev/null
+++ b/src/deluge/model/tuning/master_tune.cpp
@@ -0,0 +1,287 @@
+/*
+ * Copyright © 2026 Deluge community contributors
+ *
+ * This file is part of The Synthstrom Audible Deluge Firmware.
+ *
+ * The Synthstrom Audible Deluge Firmware is free software: you can redistribute it and/or modify it under the
+ * terms of the GNU General Public License as published by the Free Software Foundation,
+ * either version 3 of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "model/tuning/master_tune.h"
+#include "definitions_cxx.hpp"
+#include "io/midi/midi_device_manager.h"
+#include "io/midi/midi_engine.h"
+#include "model/drum/drum.h"
+#include "model/drum/midi_drum.h"
+#include "model/instrument/kit.h"
+#include "model/instrument/midi_instrument.h"
+#include "model/output.h"
+#include "model/song/song.h"
+#include "model/tuning/master_tune_math.h"
+#include "processing/engines/cv_engine.h"
+#include <algorithm>
+#include <cstring>
+#include <iterator>
+
+extern "C" {
+#include "drivers/uart/uart.h"
+}
+
+namespace MasterTune {
+
+namespace {
+
+int32_t tenthsHz = kDefaultTenthsHz;
+uint32_t ratioQ30 = math::kUnityRatioQ30; // tenthsHz / 4400 as unsigned Q2.30
+double cents = 0;
+int32_t midiFineTuning = math::kMIDIFineTuningCentre; // 14 bits, 8192 +- 8192 per 100 cents
+
+// Bumped on every tuning change; each Voice recalculates its pitch when it sees a new value.
+uint32_t tuningGeneration = 1;
+
+bool settingReadFromFile = false;
+bool legacyValuePending = false; // Adopted from flash, not yet in the settings file
+
+// ---- External MIDI ----
+//
+// The Channel Fine Tuning goes out
+// - to every channel the song plays on, from routine(), as soon as the tuning changes (retunes held notes) and again
+//   when playback begins (for devices switched on since). Being sent from routine() it never delays the notes playback
+//   starts with.
+// - before a note, on a channel that doesn't have the current tuning yet.
+// Which devices a message reaches only depends on its channel and on whether it is meant for an MPE zone, so there is
+// one channel mask per zone and one for everything else. Tracks and drums sharing a channel tune it only once.
+
+// Stays false as long as no device has ever been sent a tuning other than 0 cents, so a firmware that is never
+// retuned sends nothing extra at all.
+bool midiTuningUsed = false;
+uint16_t channelsTuned[3] = {0, 0, 0}; // Channels that have the current tuning
+
+bool broadcastPending = false;
+bool broadcastToAll = false;               // Also to the channels that have the current tuning already
+uint16_t channelsBroadcast[3] = {0, 0, 0}; // Progress of the pending broadcast
+
+// The DIN MIDI output buffer (1024 bytes) doesn't guard against overflowing, so we only add our 18 bytes while little
+// is waiting in it. What doesn't fit is sent a few milliseconds later from routine().
+constexpr int32_t kMaxDINBytesWaiting = 256;
+
+void recalculate() {
+	ratioQ30 = math::ratioQ30(tenthsHz);
+	cents = math::cents(tenthsHz);
+	midiFineTuning = math::midiFineTuning(cents);
+}
+
+bool midiTuningActive() {
+	return midiFineTuning != math::kMIDIFineTuningCentre || midiTuningUsed;
+}
+
+int32_t maskIndex(int32_t filter) {
+	return (filter == MIDI_CHANNEL_MPE_LOWER_ZONE) ? 1 : (filter == MIDI_CHANNEL_MPE_UPPER_ZONE) ? 2 : 0;
+}
+
+bool dinMIDIHasRoom() {
+	return uartGetTxBufferFullnessByItem(UART_ITEM_MIDI) <= kMaxDINBytesWaiting;
+}
+
+void sendFineTuning(MIDISource source, int32_t outputChannel, int32_t filter) {
+	if (midiFineTuning != math::kMIDIFineTuningCentre) {
+		midiTuningUsed = true;
+	}
+	channelsTuned[maskIndex(filter)] |= 1u << outputChannel;
+
+	midiEngine.sendCC(source, outputChannel, 101, 0, filter); // RPN MSB
+	midiEngine.sendCC(source, outputChannel, 100, 1, filter); // RPN LSB: 1 = Channel Fine Tuning
+	midiEngine.sendCC(source, outputChannel, 6, midiFineTuning >> 7, filter);
+	midiEngine.sendCC(source, outputChannel, 38, midiFineTuning & 127, filter);
+	midiEngine.sendCC(source, outputChannel, 101, 127, filter); // RPN null, so later data entry goes nowhere
+	midiEngine.sendCC(source, outputChannel, 100, 127, filter);
+}
+
+void startBroadcast(bool toAll) {
+	broadcastPending = true;
+	broadcastToAll = broadcastToAll || toAll;
+	std::fill(std::begin(channelsBroadcast), std::end(channelsBroadcast), 0);
+}
+
+// Calls action(source, outputChannel, filter) for every external MIDI channel the current song plays on, the same
+// channels and device filters the notes use. Stops early if action returns false, and returns whether it got through.
+template <typename Action>
+bool forEachMIDIChannel(Action action) {
+	for (Output* output = currentSong->firstOutput; output; output = output->next) {
+		if (output->type == OutputType::MIDI_OUT) {
+			MIDIInstrument* instrument = static_cast<MIDIInstrument*>(output);
+			if (instrument->sendsToInternal()) {
+				continue;
+			}
+			if (!instrument->sendsToMPE()) {
+				if (!action(*instrument, instrument->channel, instrument->channel)) {
+					return false;
+				}
+				continue;
+			}
+			// Same member channel range as MIDIInstrument::noteOnPostArp()
+			bool lowerZone = (instrument->channel == MIDI_CHANNEL_MPE_LOWER_ZONE);
+			int32_t lowest = lowerZone ? 1 : MIDIDeviceManager::highestLastMemberChannelOfUpperZoneOnConnectedOutput;
+			int32_t highest = lowerZone ? MIDIDeviceManager::lowestLastMemberChannelOfLowerZoneOnConnectedOutput : 14;
+			for (int32_t memberChannel = lowest; memberChannel <= highest; memberChannel++) {
+				if (!action(*instrument, memberChannel, instrument->channel)) {
+					return false;
+				}
+			}
+		}
+		else if (output->type == OutputType::KIT) {
+			for (Drum* drum = static_cast<Kit*>(output)->firstDrum; drum; drum = drum->next) {
+				if (drum->type == DrumType::MIDI) {
+					MIDIDrum* midiDrum = static_cast<MIDIDrum*>(drum);
+					// Same device filter as MIDIDrum::noteOn()
+					if (!action(*midiDrum, midiDrum->channel, kMIDIOutputFilterNoMPE)) {
+						return false;
+					}
+				}
+			}
+		}
+	}
+	return true;
+}
+
+void prepareChannel(MIDISource source, int32_t outputChannel, int32_t filter) {
+	if (outputChannel < 0 || outputChannel > 15 || !midiTuningActive()) {
+		return;
+	}
+	if (channelsTuned[maskIndex(filter)] & (1u << outputChannel)) {
+		return;
+	}
+	if (!dinMIDIHasRoom()) {
+		broadcastPending = true; // The note goes out now regardless, and routine() retunes it shortly after
+		return;
+	}
+	sendFineTuning(source, outputChannel, filter);
+}
+
+} // namespace
+
+void set(int32_t newTenthsHz) {
+	newTenthsHz = std::clamp(newTenthsHz, kMinTenthsHz, kMaxTenthsHz);
+	if (newTenthsHz == tenthsHz) {
+		return;
+	}
+	tenthsHz = newTenthsHz;
+	recalculate();
+
+	// Held notes must not keep the old tuning. Voices pick the change up themselves at their next render (see
+	// getGeneration()), audio clips work out their pitch at every render anyway, and external MIDI gets it from
+	// routine().
+	tuningGeneration++;
+	std::fill(std::begin(channelsTuned), std::end(channelsTuned), 0);
+	startBroadcast(false);
+
+	if (currentSong != nullptr) { // Not still booting
+		cvEngine.recalculateAllCVChannelVoltages();
+	}
+}
+
+int32_t getTenthsHz() {
+	return tenthsHz;
+}
+
+double getCents() {
+	return cents;
+}
+
+uint32_t applyToPhaseIncrement(uint32_t phaseIncrement, int32_t recordedTenthsHz) {
+	uint32_t ratio = (recordedTenthsHz == kDefaultTenthsHz || !isValid(recordedTenthsHz))
+	                     ? ratioQ30
+	                     : math::ratioQ30(tenthsHz, recordedTenthsHz);
+	return math::scalePhaseIncrement(phaseIncrement, ratio);
+}
+
+bool isValid(int32_t value) {
+	return value >= kMinTenthsHz && value <= kMaxTenthsHz;
+}
+
+uint32_t getGeneration() {
+	return tuningGeneration;
+}
+
+void prepareMIDIChannel(MIDIInstrument& instrument, int32_t outputChannel) {
+	prepareChannel(instrument, outputChannel, instrument.channel); // Same device filter as the notes of this instrument
+}
+
+void prepareMIDIChannel(MIDIDrum& drum) {
+	prepareChannel(drum, drum.channel, kMIDIOutputFilterNoMPE); // Same device filter as MIDIDrum::noteOn()
+}
+
+void playbackBegun() {
+	startBroadcast(true);
+}
+
+void routine() {
+	if (!broadcastPending || currentSong == nullptr) {
+		return; // Nothing to do, or still booting - then the song that gets loaded is tuned as soon as it's there
+	}
+	if (!midiTuningActive()) {
+		broadcastPending = false;
+		broadcastToAll = false;
+		return;
+	}
+
+	bool finished = forEachMIDIChannel([](MIDISource source, int32_t outputChannel, int32_t filter) {
+		if (outputChannel < 0 || outputChannel > 15) {
+			return true;
+		}
+		int32_t index = maskIndex(filter);
+		uint16_t channelBit = 1u << outputChannel;
+		if (channelsBroadcast[index] & channelBit) {
+			return true;
+		}
+		if (broadcastToAll || !(channelsTuned[index] & channelBit)) {
+			if (!dinMIDIHasRoom()) {
+				return false; // Carry on next time
+			}
+			sendFineTuning(source, outputChannel, filter);
+		}
+		channelsBroadcast[index] |= channelBit;
+		return true;
+	});
+
+	if (finished) {
+		broadcastPending = false;
+		broadcastToAll = false;
+	}
+}
+
+bool readSetting(char const* name, int32_t value) {
+	if (strcmp(name, kSettingName) != 0) {
+		return false;
+	}
+	settingReadFromFile = true;
+	legacyValuePending = false;
+	set(value);
+	return true;
+}
+
+void adoptLegacyFlashValue(int32_t legacyTenthsHz) {
+	if (settingReadFromFile || !isValid(legacyTenthsHz)) {
+		return;
+	}
+	legacyValuePending = true;
+	set(legacyTenthsHz);
+}
+
+bool keepLegacyFlashValue() {
+	return legacyValuePending;
+}
+
+void savedToSettingsFile() {
+	legacyValuePending = false;
+}
+
+} // namespace MasterTune
