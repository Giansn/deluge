+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+// Pure master tune arithmetic, kept free of firmware dependencies so it can be checked on a host machine.
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace MasterTune::math {
+
+constexpr int32_t kReferenceTenthsHz = 4400;
+constexpr uint32_t kUnityRatioQ30 = 1u << 30;
+constexpr int32_t kMIDIFineTuningCentre = 8192; // RPN 1 "Channel Fine Tuning": 8192 = 0 cents, +-8192 = +-100 cents
+constexpr double kCentsPerNaturalLog = 1200.0 / 0.693147180559945309417; // 1200 / ln(2)
+
+inline int32_t roundToInt(double value) {
+	return (int32_t)std::floor(value + 0.5);
+}
+
+/// tenthsHz / 4400 as unsigned Q2.30
+inline uint32_t ratioQ30(int32_t tenthsHz) {
+	return (uint32_t)roundToInt(tenthsHz * (double)kUnityRatioQ30 / kReferenceTenthsHz);
+}
+
+/// Offset from 440 Hz in cents
+inline double cents(int32_t tenthsHz) {
+	return std::log(tenthsHz / (double)kReferenceTenthsHz) * kCentsPerNaturalLog;
+}
+
+/// 14-bit value for RPN 1, clamped to what the message can carry (+-100 cents)
+inline int32_t midiFineTuning(double centsOffset) {
+	return std::clamp<int32_t>(kMIDIFineTuningCentre + roundToInt(centsOffset * 8192.0 / 100.0), 0, 16383);
+}
+
+/// Exact (rounded) multiplication of a phase increment by a Q2.30 ratio, saturating instead of wrapping around
+inline uint32_t scalePhaseIncrement(uint32_t phaseIncrement, uint32_t ratio) {
+	if (ratio == kUnityRatioQ30) {
+		return phaseIncrement;
+	}
+	uint64_t scaled = ((uint64_t)phaseIncrement * ratio + (kUnityRatioQ30 >> 1)) >> 30;
+	return (scaled > UINT32_MAX) ? UINT32_MAX : (uint32_t)scaled;
+}
+
+} // namespace MasterTune::math
