+#pragma once
+
+#include <cstdint>
+
+class MIDIInstrument;
+class Sound;
+
+/// Global reference pitch ("master tune"), A4 = 415.3 ... 466.2 Hz in steps of 0.1 Hz.
+///
+/// It retunes everything that plays notes: synth tracks (all oscillator types including samples, wavetables, FM and
+/// DX7), the CV outputs and external MIDI instruments (via RPN 1, Channel Fine Tuning). Kit rows and audio clips keep
+/// their exact recorded pitch. At 440.0 Hz every path is bit-identical to the unmodified firmware and nothing extra is
+/// sent over MIDI.
+namespace MasterTune {
+
+constexpr int32_t kDefaultTenthsHz = 4400;
+constexpr int32_t kMinTenthsHz = 4153; // 440 Hz one semitone down
+constexpr int32_t kMaxTenthsHz = 4662; // 440 Hz one semitone up
+
+/// Name of the entry in CommunityFeatures.XML on the SD card. Firmware that doesn't know it keeps it as an unknown
+/// setting.
+constexpr char const* kSettingName = "masterTune";
+
+/// Sets the reference pitch (clamped to the valid range) and immediately retunes all currently sounding notes.
+void set(int32_t tenthsHz);
+int32_t getTenthsHz();
+
+/// Offset from 440 Hz in cents.
+double getCents();
+
+/// Whether a sound follows the master tune. Kit rows keep their exact pitch.
+bool appliesTo(Sound& sound);
+
+/// Scales an oscillator phase increment by the tuning ratio. Exact (64-bit) and a no-op at 440 Hz.
+uint32_t applyToPhaseIncrement(uint32_t phaseIncrement);
+
+/// Makes sure an external MIDI channel has received the current Channel Fine Tuning before a note is sent on it.
+void prepareMIDIChannel(MIDIInstrument& instrument, int32_t outputChannel);
+
+/// External devices may have been switched on or reconnected since we last tuned them.
+void playbackBegun();
+
+/// Reads our entry from the community settings file. Returns false if the entry is not ours.
+bool readSetting(char const* name, int32_t value);
+
+/// Earlier master-tune builds kept the value in bytes 198-199 of the flash settings. It is adopted unless the settings
+/// file provides a value, and kept in flash only until it has been written to the settings file once.
+void adoptLegacyFlashValue(int32_t tenthsHz);
+bool keepLegacyFlashValue();
+void savedToSettingsFile();
+
+} // namespace MasterTune
