From d29b4fd539ae6cf6460c5458b7bd6409444099ff Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 26 Sep 2026 23:02:49 +0000
Subject: [PATCH 1/3] L2 cache for code only (test version)

Port of upstream c44d2476: the 128 KB L2 cache is enabled after the L1, with all ways locked
for data, so only instruction fetches fill it and DMA buffers stay coherent with the L1
maintenance alone. The duplicate alignment-bit clear from that commit is left out.

Chainloader (firmware over USB SysEx, developer setting): clean and invalidate the L1 for
everything the MMU-off stub touches (upstream c0586341, an L1 bug already in 1.2.1), and leave
the L2 written back, empty and disabled, so that the new firmware never runs stale lines of
the old code, even one without L2 support.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Eb214cM1zi1k5Gpcn9RLKh
---
 src/RZA1/cache/cache.c        | 36 ++++++++++++++++++++++++++++++++++-
 src/RZA1/cache/cache.h        |  7 +++++++
 src/deluge/util/chainload.cpp | 15 +++++++++++++++
 src/resetprg.c                |  6 ++++--
 4 files changed, 61 insertions(+), 3 deletions(-)

diff --git a/src/RZA1/cache/cache.c b/src/RZA1/cache/cache.c
index de25a2e2..bc9235b8 100644
--- a/src/RZA1/cache/cache.c
+++ b/src/RZA1/cache/cache.c
@@ -240,7 +240,10 @@ void L2CacheFlushAll(void)
 void L2CacheEnable(void)
 {
     L2C.REG2_INT_CLEAR   = 0x000001FFuL; /* Clear the reg2_int_raw_status register */
-    L2C.REG9_D_LOCKDOWN0 = 0x00000000uL;
+    /* Data never allocates in the L2 (all ways locked for data): DMA buffers stay coherent with the L1 maintenance
+       alone. Only instruction fetches fill it. */
+    L2C.REG9_D_LOCKDOWN0 = 0xFFFFFFFFuL;
+    L2C.REG9_I_LOCKDOWN0 = 0x00000000uL;
 
     L2C.REG1_CONTROL = 0x00000001uL; /* Enable L2 cache */
 }
@@ -256,4 +259,35 @@ void L2CacheDisable(void)
     L2C.REG1_CONTROL = 0x00000000uL; /* Disable L2 cache */
 }
 
+/******************************************************************************
+ * Function Name: L2CacheInit
+ * Description  : Invalidate and enable the L2 cache. Call after R_CACHE_L1Init().
+ * Arguments    : none
+ * Return Value : none
+ ******************************************************************************/
+void L2CacheInit(void)
+{
+    L2CacheDisable();
+    L2CacheFlushAll();
+    L2CacheEnable();
+}
+
+/******************************************************************************
+ * Function Name: L2CacheCleanFlushAllAndDisable
+ * Description  : Write back and invalidate the whole L2 cache, then disable it, so that code started without a
+ *                reset (the chainloader) finds it as after a reset.
+ * Arguments    : none
+ * Return Value : none
+ ******************************************************************************/
+void L2CacheCleanFlushAllAndDisable(void)
+{
+    L2C.REG7_CLEAN_INV_WAY = L2CACHE_8WAY;
+    while ((L2C.REG7_CLEAN_INV_WAY & L2CACHE_8WAY) != 0x00000000uL)
+    {
+        /* Wait completion */
+    }
+    L2C.REG7_CACHE_SYNC = 0x00000000uL;
+    L2CacheDisable();
+}
+
 /* End of File */
diff --git a/src/RZA1/cache/cache.h b/src/RZA1/cache/cache.h
index b861bcd1..e7d4cc6d 100644
--- a/src/RZA1/cache/cache.h
+++ b/src/RZA1/cache/cache.h
@@ -28,6 +28,9 @@
  ******************************************************************************/
 #ifndef CACHE_H
 #define CACHE_H
+#ifdef __cplusplus
+extern "C" {
+#endif
 
 /******************************************************************************
 Includes   <System Includes> , "Project Includes"
@@ -64,9 +67,13 @@ void L2CacheInit(void);
 void L2CacheFlushAll(void);
 void L2CacheEnable(void);
 void L2CacheDisable(void);
+void L2CacheCleanFlushAllAndDisable(void);
 
 extern void R_CACHE_L1Init(void);
 
+#ifdef __cplusplus
+}
+#endif
 #endif /* CACHE_H */
 
 /* End of File */
diff --git a/src/deluge/util/chainload.cpp b/src/deluge/util/chainload.cpp
index 4fb03970..5434cbdc 100644
--- a/src/deluge/util/chainload.cpp
+++ b/src/deluge/util/chainload.cpp
@@ -18,11 +18,15 @@
  */
 
 #include "chainload.h"
+#include "RZA1/cache/cache.h"
 #include "RZA1/mtu/mtu.h"
 #include "definitions.h"
 #include "timers_interrupts/timers_interrupts.h"
 
 extern uint32_t spareRenderingBuffer[][SSI_TX_BUFFER_NUM_SAMPLES];
+#if defined(__arm__)
+extern "C" void v7_dma_flush_range(uint32_t start, uint32_t end);
+#endif
 
 void chainload_from_buf(uint8_t* buffer, int buf_size) {
 	uint32_t user_code_start = *(uint32_t*)(buffer + OFF_USER_CODE_START);
@@ -46,6 +50,17 @@ void chainload_from_buf(uint8_t* buffer, int buf_size) {
 	uint8_t* funcbuf = reinterpret_cast<uint8_t*>(spareRenderingBuffer);
 
 #if defined(__arm__)
+	// The chainloader runs with the MMU and caches disabled, storing straight to RAM, and its per-word maintenance
+	// writes back lines left dirty in the (disabled, not emptied) L1 data cache over words it just stored (upstream
+	// c0586341). So clean and invalidate everything it touches while the MMU is still on: the new image, the copy
+	// destination and funcbuf (an audio rendering buffer, full of dirty lines once audio has rendered).
+	v7_dma_flush_range((uint32_t)buffer, (uint32_t)buffer + (uint32_t)buf_size);
+	v7_dma_flush_range(user_code_start, user_code_start + (uint32_t)code_size + 4);
+	v7_dma_flush_range((uint32_t)funcbuf, (uint32_t)funcbuf + 1024);
+	// The L2 keeps lines of the old code at the addresses of the new one, and a firmware without L2 support would
+	// never clear them: leave it empty and off, as after a reset.
+	L2CacheCleanFlushAllAndDisable();
+
 	// Jump to the chainloader
 	asm volatile("mov r0,%0\n\t"
 	             "mov r1,%1\n\t"
diff --git a/src/resetprg.c b/src/resetprg.c
index 1938c489..8278b820 100644
--- a/src/resetprg.c
+++ b/src/resetprg.c
@@ -54,6 +54,7 @@
 #include "RZA1/system/r_typedefs.h"
 
 #include "RZA1/bsc/bsc_userdef.h" //sdram init
+#include "RZA1/cache/cache.h"
 #include "RZA1/compiler/asm/inc/asm.h"
 #include "RZA1/gpio/gpio.h"
 #include "RZA1/stb/stb.h"
@@ -72,8 +73,6 @@
 #define HAVE_CALL_INDIRECT
 #endif
 
-extern int R_CACHE_L1Init(void);
-
 extern void __libc_init_array(void);
 
 #define PLACEMENT_SDRAM_START (0x0C000000)
@@ -178,6 +177,9 @@ void resetprg(void) {
 
 	R_CACHE_L1Init(); // Makes everything go about 1000x faster
 
+	// Second, or the L1 would write back into it. Instruction fetches only (see L2CacheEnable())
+	L2CacheInit();
+
 	__enable_irq();
 	__enable_fiq();
 	// Setup SDRAM. Have to do this before we init global objects
