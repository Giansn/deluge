 #include "processing/vector_rendering_function.h"
+#include <cstdint>
+
+// dividend / divisor (unsigned, divisor not 0), exactly, with the VFP's double division instead of the library call
+// (__udivsi3; the Cortex-A9 has no integer division). Both are exact doubles, and the correctly rounded double
+// quotient never reaches the next integer: with dividend = q * divisor + r, 0 < r < divisor, q + 1 is at least
+// 1 / divisor away, more than the spacing of doubles there ((q + 1) * 2^-52 <= (dividend + divisor) / divisor * 2^-52
+// < 2^-19 / divisor); with r = 0 the quotient q is exact. So truncating it gives q. The division is asm so that it
+// stays one correctly rounded division (-funsafe-math-optimizations could otherwise use a rounded reciprocal).
+[[gnu::always_inline]] static inline uint32_t divideExactly(uint32_t dividend, uint32_t divisor) {
+#if defined(__arm__)
+	double quotient;
+	asm("vdiv.f64 %P0, %P1, %P2" : "=w"(quotient) : "w"((double)dividend), "w"((double)divisor));
+	return (uint32_t)quotient;
+#else
+	return dividend / divisor;
+#endif
+}
+
+// (x << shift) / divisor (unsigned, 64-bit dividend), exactly, for a divisor of at least 2^shift (so the quotient is
+// below 2^32; shift at most 31), with the VFP's double division instead of the library's 64-bit one (__udivmoddi4,
+// about 300 instructions). x * 2^shift and the divisor are exact doubles and the quotient is correctly rounded (asm,
+// as above), so it lies between the exact integer quotient q and q + 1: truncated, it is q, or q + 1 where it rounded
+// up to that; the remainder check below takes that back (and would add 1 back to a quotient 1 too small).
+[[gnu::always_inline]] static inline uint32_t divideShiftedExactly(uint32_t x, int32_t shift, uint32_t divisor) {
+	uint64_t dividend = (uint64_t)x << shift;
+#if defined(__arm__)
+	double approximate;
+	asm("vdiv.f64 %P0, %P1, %P2"
+	    : "=w"(approximate)
+	    : "w"((double)x * (double)((uint32_t)1 << shift)), "w"((double)divisor));
+	uint32_t quotient = (approximate < 4294967295.0) ? (uint32_t)approximate : 4294967295u; // q is at most x
+	uint64_t product = (uint64_t)quotient * divisor;
+	if (product > dividend) {
+		quotient--;
+	}
+	else if (dividend - product >= divisor) {
+		quotient++;
+	}
+	return quotient;
+#else
+	return dividend / divisor;
+#endif
+}
 
