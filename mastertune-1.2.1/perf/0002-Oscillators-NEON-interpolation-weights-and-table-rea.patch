+// multiply_accumulate_32x32_rshift32_rounded() (smmlar) on 4 lanes, bit for bit: smmlar gives bits 32 to 63 of
+// (sum << 32) + a * b + 2^31, which is sum + ((a * b + 2^31) >> 32) modulo 2^32. vmull_s32 makes the exact 64-bit
+// products, vrshrn_n_s64(, 32) adds 2^31 and takes bits 32 to 63, and vaddq_s32 adds modulo 2^32.
+[[gnu::always_inline]] static inline int32x4_t multiplyAccumulateRoundedVector(int32x4_t sum, int32x4_t a,
+                                                                               int32x4_t b) {
+	int32x2_t low = vrshrn_n_s64(vmull_s32(vget_low_s32(a), vget_low_s32(b)), 32);
+	int32x2_t high = vrshrn_n_s64(vmull_s32(vget_high_s32(a), vget_high_s32(b)), 32);
+	return vaddq_s32(sum, vcombine_s32(low, high));
+}
+
+// The values of the next 4 samples of something incremented by increment each sample (a phase, or an amplitude),
+// modulo 2^32 like the scalar loops' additions.
+[[gnu::always_inline]] static inline uint32x4_t incrementedVector(uint32_t now, uint32_t increment) {
+	uint32_t lanes[4];
+	for (int32_t lane = 0; lane < 4; lane++) {
+		lanes[lane] = now + increment * (uint32_t)(lane + 1);
+	}
+	return vld1q_u32(lanes);
+}
