+// Inner loops of ModControllableAudio's per-track effects (mod_controllable_audio.cpp), specialised per case with
+// their state in registers. Each one computes exactly what the per-sample code it replaced computed, with the same
+// operations in the same order per sample; the notes say where something is done differently and why that is exact.
+
+#pragma once
+
+#include "definitions_cxx.hpp"
+#include "dsp/stereo_sample.h"
+#include "modulation/lfo.h"
+#include "util/fixedpoint.h"
+#include <algorithm>
+#include <arm_neon.h>
+#include <cstdint>
+
+namespace deluge::dsp::track_fx {
+
+// Additions and subtractions that wrap around, as the ARM instructions do that the old loops' int32_t arithmetic
+// became (its overflow is undefined in C++, the compiler simply used those instructions)
+[[gnu::always_inline]] inline int32_t addWrap(int32_t a, int32_t b) {
+	return (int32_t)((uint32_t)a + (uint32_t)b);
+}
+[[gnu::always_inline]] inline int32_t subWrap(int32_t a, int32_t b) {
+	return (int32_t)((uint32_t)a - (uint32_t)b);
+}
+
+// multiply_32x32_rshift32() (smmul) on four lanes: the high words of the exact 64-bit products, picked out of the two
+// vmull results by one vuzp. (vqdmulh + shift would be one instruction less but saturates for INT32_MIN * INT32_MIN.)
+[[gnu::always_inline]] inline int32x4_t smmul4(int32x4_t a, int32x4_t b) {
+	int32x4_t low = vreinterpretq_s32_s64(vmull_s32(vget_low_s32(a), vget_low_s32(b)));
+	int32x4_t high = vreinterpretq_s32_s64(vmull_s32(vget_high_s32(a), vget_high_s32(b)));
+	return vuzpq_s32(low, high).val[1]; // little-endian: the odd 32-bit lanes are the high words
+}
+
+// ModControllableAudio::processReverbSendAndVolume()'s loop. Per sample, as before:
+//   reverb[i] += multiply_32x32_rshift32(in[i].l + in[i].r, reverbVolume) << 1   (kReverb)
+//   volume += increment                                                         (per side, before use)
+//   o = multiply_32x32_rshift32(in[i], volume) << 5, then out[i] += o (kAdd) or out[i] = o (in place, out == in)
+// Four samples at a time with NEON. The sums wrap as the ARM add instructions of the old loop did (it had them as
+// int32_t, whose overflow the compiler turned into those same instructions): here the NEON adds wrap, and the scalar
+// ones are done in uint32_t. The volume ramp is volume + k * increment mod 2^32, the same whether added up one step or
+// four at a time. in/out/reverb are the sound's buffer, the output (or null) and the engine's reverb buffer: separate
+// arrays (out == in only in place, where each sample is read before it is written), so doing four at a time reads
+// and writes the same values.
+template <bool kReverb, bool kAdd>
+[[gnu::always_inline]] inline void reverbSendAndVolume(const StereoSample* in, StereoSample* out, int32_t numSamples,
+                                                       int32_t* reverb, int32_t reverbVolume, uint32_t volumeL,
+                                                       uint32_t volumeR, uint32_t incrementL, uint32_t incrementR) {
+	int32_t numBlocks = numSamples >> 2;
+	if (numBlocks) {
+		const uint32x4_t steps = {1, 2, 3, 4};
+		uint32x4_t vL = vmlaq_n_u32(vdupq_n_u32(volumeL), steps, incrementL); // volume after 1, 2, 3, 4 steps
+		uint32x4_t vR = vmlaq_n_u32(vdupq_n_u32(volumeR), steps, incrementR);
+		const uint32x4_t stepL = vdupq_n_u32(incrementL << 2);
+		const uint32x4_t stepR = vdupq_n_u32(incrementR << 2);
+		const int32x4_t reverbV = vdupq_n_s32(reverbVolume);
+		const int32_t* inW = &in->l;
+		int32_t* outW = &out->l;
+		int32_t n = numBlocks;
+		do {
+			int32x4x2_t s = vld2q_s32(inW); // val[0]: 4 x l, val[1]: 4 x r
+			inW += 8;
+			if constexpr (kReverb) {
+				int32x4_t send = vshlq_n_s32(smmul4(vaddq_s32(s.val[0], s.val[1]), reverbV), 1);
+				vst1q_s32(reverb, vaddq_s32(vld1q_s32(reverb), send));
+				reverb += 4;
+			}
+			int32x4_t oL = vshlq_n_s32(smmul4(s.val[0], vreinterpretq_s32_u32(vL)), 5);
+			int32x4_t oR = vshlq_n_s32(smmul4(s.val[1], vreinterpretq_s32_u32(vR)), 5);
+			vL = vaddq_u32(vL, stepL);
+			vR = vaddq_u32(vR, stepR);
+			if constexpr (kAdd) {
+				int32x4x2_t a = vld2q_s32(outW);
+				a.val[0] = vaddq_s32(a.val[0], oL);
+				a.val[1] = vaddq_s32(a.val[1], oR);
+				vst2q_s32(outW, a);
+			}
+			else {
+				int32x4x2_t o = {{oL, oR}};
+				vst2q_s32(outW, o);
+			}
+			outW += 8;
+		} while (--n);
+		volumeL += (uint32_t)numBlocks * (incrementL << 2);
+		volumeR += (uint32_t)numBlocks * (incrementR << 2);
+	}
+
+	// The last 0 to 3 samples, one at a time
+	int32_t done = numBlocks << 2;
+	for (int32_t i = done; i < numSamples; i++) {
+		StereoSample s = in[i];
+		if constexpr (kReverb) {
+			*reverb =
+			    (int32_t)((uint32_t)*reverb
+			              + ((uint32_t)multiply_32x32_rshift32((int32_t)((uint32_t)s.l + (uint32_t)s.r), reverbVolume)
+			                 << 1));
+			reverb++;
+		}
+		volumeL += incrementL;
+		volumeR += incrementR;
+		int32_t oL = multiply_32x32_rshift32(s.l, (int32_t)volumeL) << 5;
+		int32_t oR = multiply_32x32_rshift32(s.r, (int32_t)volumeR) << 5;
+		if constexpr (kAdd) {
+			out[i].l = (int32_t)((uint32_t)out[i].l + (uint32_t)oL);
+			out[i].r = (int32_t)((uint32_t)out[i].r + (uint32_t)oR);
+		}
+		else {
+			out[i].l = oL;
+			out[i].r = oR;
+		}
+	}
+}
+
+// ---- processFX() ---------------------------------------------------------------------------------------------------
+// The old loop ran all mod FX types through one per-sample loop that checked the type each sample and kept the LFO,
+// the write index and the phaser/allpass memories in the object: every store to the buffer (a StereoSample* the
+// compiler had to assume could point into the object) forced them out to memory and back. Here each type has its own
+// loop, with that state in locals, loaded before and stored after. The buffer is the sound's (or clip's) render
+// buffer and the delay line the object's own allocation, neither overlaps the object, so this reads and writes the
+// same values. Per sample, the operations and their order are the old ones.
+
+// Phaser. The coefficient per sample comes from the LFO alone, so it is worked out first for a stretch of samples,
+// then each side runs through the feedback and the six allpass stages with its seven state values in registers (both
+// sides at once would not fit). The sides do not mix, so doing all of L before R changes nothing.
+constexpr int32_t kPhaserStretch = 32;
+
+// multiply_32x32_rshift32_rounded() (the same smmulr), but kept in program order: the compiler would otherwise move the
+// six independent multiplies of the allpass chain ahead and run out of registers
+[[gnu::always_inline]] inline int32_t smmulrInOrder(int32_t a, int32_t b) {
+#if defined(__arm__)
+	int32_t out;
+	asm volatile("smmulr %0, %1, %2" : "=r"(out) : "r"(a), "r"(b));
+	return out;
+#else
+	return multiply_32x32_rshift32_rounded(a, b); // host tests
+#endif
+}
+
+[[gnu::always_inline]] inline void phaserAllpass(int32_t& memory, int32_t& stage, int32_t a1, int32_t minusA1) {
+	int32_t whatWasInput = memory;
+	memory = addWrap(smmulrInOrder(memory, minusA1) << 2, stage);
+	stage = addWrap(smmulrInOrder(memory, a1) << 2, whatWasInput);
+}
+
+template <int32_t StereoSample::*kSide>
+[[gnu::always_inline]] inline void phaserSide(StereoSample* buffer, int32_t numSamples, const int32_t (*a1)[2],
+                                              int32_t feedback, StereoSample& phaserMemory, StereoSample* allpass) {
+	static_assert(kNumAllpassFiltersPhaser == 6);
+	int32_t memory = phaserMemory.*kSide;
+	int32_t s0 = allpass[0].*kSide, s1 = allpass[1].*kSide, s2 = allpass[2].*kSide;
+	int32_t s3 = allpass[3].*kSide, s4 = allpass[4].*kSide, s5 = allpass[5].*kSide;
+	// Counting up to 0 from the end: the loop needs no register for its end (the 14 are just enough without one)
+	StereoSample* bufferEnd = buffer + numSamples;
+	for (int32_t i = -numSamples; i != 0; i++) {
+		int32_t a = (*a1)[0];
+		int32_t minusA = (*a1)[1];
+		a1++;
+		memory = addWrap(bufferEnd[i].*kSide, smmulrInOrder(memory, feedback) << 1);
+		phaserAllpass(memory, s0, a, minusA);
+		phaserAllpass(memory, s1, a, minusA);
+		phaserAllpass(memory, s2, a, minusA);
+		phaserAllpass(memory, s3, a, minusA);
+		phaserAllpass(memory, s4, a, minusA);
+		phaserAllpass(memory, s5, a, minusA);
+		bufferEnd[i].*kSide = addWrap(bufferEnd[i].*kSide, memory);
+	}
+	phaserMemory.*kSide = memory;
+	allpass[0].*kSide = s0;
+	allpass[1].*kSide = s1;
+	allpass[2].*kSide = s2;
+	allpass[3].*kSide = s3;
+	allpass[4].*kSide = s4;
+	allpass[5].*kSide = s5;
+}
+
+inline void phaser(StereoSample* buffer, int32_t numSamples, LFO& modFXLFO, uint32_t rate, int32_t depth,
+                   int32_t feedback, StereoSample& phaserMemory, StereoSample* allpass) {
+	int32_t a1[kPhaserStretch][2]; // a1 and -a1 per sample
+	LFO lfo = modFXLFO;
+	for (int32_t done = 0; done < numSamples; done += kPhaserStretch) {
+		int32_t n = std::min(numSamples - done, kPhaserStretch);
+		for (int32_t i = 0; i < n; i++) {
+			int32_t lfoOutput = lfo.render(1, LFOType::SINE, rate);
+			// "1" is sorta represented by 1073741824 here
+			int32_t a = 1073741824
+			            - multiply_32x32_rshift32_rounded((((uint32_t)lfoOutput + (uint32_t)2147483648) >> 1), depth);
+			int32_t minusA = subWrap(0, a);
+			a1[i][0] = a;
+			a1[i][1] = minusA;
+		}
+		phaserSide<&StereoSample::l>(buffer + done, n, a1, feedback, phaserMemory, allpass);
+		phaserSide<&StereoSample::r>(buffer + done, n, a1, feedback, phaserMemory, allpass);
+	}
+	modFXLFO = lfo;
+}
+
+// Chorus, stereo chorus and flanger: a modulated read from the delay line, then the write into it. The delay line is
+// read (at the two taps) before the sample is written into it, as before.
+template <ModFXType kType>
+[[gnu::always_inline]] inline void delayLineModFX(StereoSample* buffer, int32_t numSamples, StereoSample* delayLine,
+                                                  uint16_t& modFXBufferWriteIndex, LFO& modFXLFO, uint32_t rate,
+                                                  int32_t depth, int32_t delayOffset, int32_t feedback) {
+	constexpr LFOType kWave = kType == ModFXType::FLANGER ? LFOType::TRIANGLE : LFOType::SINE;
+	LFO lfo = modFXLFO;
+	int32_t writeIndex = modFXBufferWriteIndex;
+	int32_t minusDepth = subWrap(0, depth);
+	StereoSample* const bufferEnd = buffer + numSamples;
+	StereoSample* currentSample = buffer;
+	do {
+		int32_t lfoOutput = lfo.render(1, kWave, rate);
+
+		int32_t delayTime = multiply_32x32_rshift32(lfoOutput, depth) + delayOffset;
+		int32_t strength2 = (delayTime & 65535) << 15;
+		int32_t strength1 = (65535 << 15) - strength2;
+		int32_t sample1Pos = writeIndex - ((delayTime) >> 16);
+
+		int32_t scaledValue1L =
+		    multiply_32x32_rshift32_rounded(delayLine[sample1Pos & kModFXBufferIndexMask].l, strength1);
+		int32_t scaledValue2L =
+		    multiply_32x32_rshift32_rounded(delayLine[(sample1Pos - 1) & kModFXBufferIndexMask].l, strength2);
+		int32_t modFXOutputL = scaledValue1L + scaledValue2L;
+
+		if constexpr (kType == ModFXType::CHORUS_STEREO) {
+			delayTime = multiply_32x32_rshift32(lfoOutput, minusDepth) + delayOffset;
+			strength2 = (delayTime & 65535) << 15;
+			strength1 = (65535 << 15) - strength2;
+			sample1Pos = writeIndex - ((delayTime) >> 16);
+		}
+
+		int32_t scaledValue1R =
+		    multiply_32x32_rshift32_rounded(delayLine[sample1Pos & kModFXBufferIndexMask].r, strength1);
+		int32_t scaledValue2R =
+		    multiply_32x32_rshift32_rounded(delayLine[(sample1Pos - 1) & kModFXBufferIndexMask].r, strength2);
+		int32_t modFXOutputR = scaledValue1R + scaledValue2R;
+
+		if constexpr (kType == ModFXType::FLANGER) {
+			modFXOutputL = multiply_32x32_rshift32_rounded(modFXOutputL, feedback) << 2;
+			delayLine[writeIndex].l = addWrap(modFXOutputL, currentSample->l); // Feedback
+			modFXOutputR = multiply_32x32_rshift32_rounded(modFXOutputR, feedback) << 2;
+			delayLine[writeIndex].r = addWrap(modFXOutputR, currentSample->r); // Feedback
+		}
+		else { // Chorus
+			modFXOutputL <<= 1;
+			delayLine[writeIndex].l = currentSample->l; // Feedback
+			modFXOutputR <<= 1;
+			delayLine[writeIndex].r = currentSample->r; // Feedback
+		}
+
+		currentSample->l = addWrap(currentSample->l, modFXOutputL);
+		currentSample->r = addWrap(currentSample->r, modFXOutputR);
+		writeIndex = (writeIndex + 1) & kModFXBufferIndexMask;
+	} while (++currentSample != bufferEnd);
+	modFXBufferWriteIndex = writeIndex;
+	modFXLFO = lfo;
+}
+
+// EQ, as doEQ() was per sample, for just the bands that are on, with the filter states in locals
+template <bool kBass, bool kTreble>
+[[gnu::always_inline]] inline void eqChannel(int32_t& input, int32_t& withoutTreble, int32_t& bassOnly,
+                                             int32_t bassFreq, int32_t trebleFreq, int32_t bassAmount,
+                                             int32_t trebleAmount) {
+	int32_t trebleOnly;
+	if constexpr (kTreble) {
+		int32_t distanceToGo = subWrap(input, withoutTreble);
+		withoutTreble = addWrap(withoutTreble, multiply_32x32_rshift32(distanceToGo, trebleFreq) << 1);
+		trebleOnly = subWrap(input, withoutTreble);
+		input = withoutTreble; // Input now has had the treble removed. Or is this bad?
+	}
+	if constexpr (kBass) {
+		int32_t distanceToGo = subWrap(input, bassOnly);
+		bassOnly = addWrap(bassOnly, multiply_32x32_rshift32(distanceToGo, bassFreq)); // 33554432
+	}
+	if constexpr (kTreble) {
+		input = addWrap(input, multiply_32x32_rshift32(trebleOnly, trebleAmount) << 3);
+	}
+	if constexpr (kBass) {
+		input = addWrap(input, multiply_32x32_rshift32(bassOnly, bassAmount) << 3);
+	}
+}
+
+template <bool kBass, bool kTreble>
+[[gnu::always_inline]] inline void eq(StereoSample* buffer, int32_t numSamples, int32_t& withoutTrebleL,
+                                      int32_t& withoutTrebleR, int32_t& bassOnlyL, int32_t& bassOnlyR, int32_t bassFreq,
+                                      int32_t trebleFreq, int32_t bassAmount, int32_t trebleAmount) {
+	int32_t withoutTrebleLLocal = withoutTrebleL, withoutTrebleRLocal = withoutTrebleR;
+	int32_t bassOnlyLLocal = bassOnlyL, bassOnlyRLocal = bassOnlyR;
+	StereoSample* const bufferEnd = buffer + numSamples;
+	StereoSample* currentSample = buffer;
+	do {
+		int32_t l = currentSample->l;
+		int32_t r = currentSample->r;
+		eqChannel<kBass, kTreble>(l, withoutTrebleLLocal, bassOnlyLLocal, bassFreq, trebleFreq, bassAmount,
+		                          trebleAmount);
+		eqChannel<kBass, kTreble>(r, withoutTrebleRLocal, bassOnlyRLocal, bassFreq, trebleFreq, bassAmount,
+		                          trebleAmount);
+		currentSample->l = l;
+		currentSample->r = r;
+	} while (++currentSample != bufferEnd);
+	withoutTrebleL = withoutTrebleLLocal;
+	withoutTrebleR = withoutTrebleRLocal;
+	bassOnlyL = bassOnlyLLocal;
+	bassOnlyR = bassOnlyRLocal;
+}
+
+// ---- processSRRAndBitcrushing() ------------------------------------------------------------------------------------
+
+// Bitcrushing alone: the mask on four samples at a time
+[[gnu::always_inline]] inline void bitcrush(StereoSample* buffer, int32_t numSamples, uint32_t mask) {
+	const int32x4_t maskV = vreinterpretq_s32_u32(vdupq_n_u32(mask));
+	int32_t i = 0;
+	for (; i + 4 <= numSamples; i += 4) {
+		vst1q_s32(&buffer[i].l, vandq_s32(vld1q_s32(&buffer[i].l), maskV));         // samples i, i + 1
+		vst1q_s32(&buffer[i + 2].l, vandq_s32(vld1q_s32(&buffer[i + 2].l), maskV)); // i + 2, i + 3
+	}
+	for (; i < numSamples; i++) {
+		buffer[i].l &= mask;
+		buffer[i].r &= mask;
+	}
+}
+
+// Sample rate reduction: the old loop unchanged, but with its state in locals (the old one kept it in the object, see
+// processFX() above for why that cost)
+[[gnu::always_inline]] inline void
+sampleRateReduction(StereoSample* buffer, int32_t numSamples, uint32_t& lowSampleRatePosState,
+                    uint32_t& highSampleRatePosState, StereoSample& lastSampleState, StereoSample& grabbedSampleState,
+                    StereoSample& lastGrabbedSampleState, int32_t lowSampleRateIncrement,
+                    int32_t highSampleRateIncrement, uint32_t bitCrushMaskForSRR) {
+	uint32_t lowSampleRatePos = lowSampleRatePosState;
+	uint32_t highSampleRatePos = highSampleRatePosState;
+	StereoSample lastSample = lastSampleState;
+	StereoSample grabbedSample = grabbedSampleState;
+	StereoSample lastGrabbedSample = lastGrabbedSampleState;
+
+	StereoSample* const bufferEnd = buffer + numSamples;
+	StereoSample* currentSample = buffer;
+	do {
+
+		// Convert down.
+		// If time to "grab" another sample for down-conversion...
+		if (lowSampleRatePos < 4194304) {
+			int32_t strength2 = lowSampleRatePos;
+			int32_t strength1 = 4194303 - strength2;
+
+			lastGrabbedSample = grabbedSample; // What was current is now last
+			grabbedSample.l = multiply_32x32_rshift32_rounded(lastSample.l, strength1 << 9)
+			                  + multiply_32x32_rshift32_rounded(currentSample->l, strength2 << 9);
+			grabbedSample.r = multiply_32x32_rshift32_rounded(lastSample.r, strength1 << 9)
+			                  + multiply_32x32_rshift32_rounded(currentSample->r, strength2 << 9);
+			grabbedSample.l &= bitCrushMaskForSRR;
+			grabbedSample.r &= bitCrushMaskForSRR;
+
+			// Set the "time" at which we want to "grab" our next sample for down-conversion.
+			lowSampleRatePos += lowSampleRateIncrement;
+
+			// "Re-sync" the up-conversion spinner.
+			// I previously had it using strength2 instead of "lowSampleRatePos & 16777215", but that just works
+			// better. Ah, writing the massive explanation would take ages.
+			highSampleRatePos =
+			    multiply_32x32_rshift32_rounded(lowSampleRatePos & 4194303, highSampleRateIncrement << 8) << 2;
+		}
+		lowSampleRatePos -= 4194304; // We're one step closer to grabbing our next sample for down-conversion
+		lastSample = *currentSample;
+
+		// Convert up
+		int32_t strength2 =
+		    std::min(highSampleRatePos,
+		             (uint32_t)4194303); // Would only overshoot if we raised the sample rate during playback
+		int32_t strength1 = 4194303 - strength2;
+		currentSample->l = (multiply_32x32_rshift32_rounded(lastGrabbedSample.l, strength1 << 9)
+		                    + multiply_32x32_rshift32_rounded(grabbedSample.l, strength2 << 9))
+		                   << 2;
+		currentSample->r = (multiply_32x32_rshift32_rounded(lastGrabbedSample.r, strength1 << 9)
+		                    + multiply_32x32_rshift32_rounded(grabbedSample.r, strength2 << 9))
+		                   << 2;
+
+		highSampleRatePos += highSampleRateIncrement;
+	} while (++currentSample != bufferEnd);
+
+	lowSampleRatePosState = lowSampleRatePos;
+	highSampleRatePosState = highSampleRatePos;
+	lastSampleState = lastSample;
+	grabbedSampleState = grabbedSample;
+	lastGrabbedSampleState = lastGrabbedSample;
+}
