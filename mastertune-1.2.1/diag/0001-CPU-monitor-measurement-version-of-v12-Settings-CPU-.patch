 #include "processing/engines/cv_engine.h"
 #include "processing/live/live_input_buffer.h"
 #include "processing/metronome/metronome.h"
@@ -297,6 +298,15 @@ char audioLogStrings[AUDIO_LOG_SIZE][64];
