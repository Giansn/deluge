+
+#pragma once
+
+// CPU monitor (mastertune-v12-diag), the part without any hardware access, so it also compiles and runs on a computer
+// (mastertune-1.2.1/tests/cpu_stats). The firmware side is cpu_stats.h.
+//
+// Times are counts of the free-running OS timer 0 (33.33 MHz, started by the task manager). All differences are taken
+// as uint32_t, so a wrap-around of the counter (every 129 s) does no harm. Nothing here allocates.
+
+#include <cstddef>
+#include <cstdint>
+
+namespace cpu_stats {
+
+/// Timer ticks per second, as in RZA1/ostm/ostm.h
+constexpr uint32_t kTicksPerSecond = 33330000;
+constexpr uint32_t kAudioSampleRate = 44100;
+/// Length of one measuring window. The display shows the last two, the SysEx message is sent for each pair.
+constexpr uint32_t kWindowTicks = kTicksPerSecond / 2;
+/// Calls that rendered less than this only count towards the average: their fixed cost would make the peak meaningless
+constexpr uint32_t kMinPeakSamples = 16;
+
+/// Raw sums of one measuring window. Everything shown or sent is derived from it, and two windows can be merged.
+struct Window {
+	uint32_t ticks = 0;          ///< Wall-clock length of the window
+	uint64_t busyTicks = 0;      ///< Time spent in AudioEngine::routine()
+	uint32_t samples = 0;        ///< Samples it rendered
+	uint32_t peakTicks = 0;      ///< The busiest call (relative to the audio it rendered): its time
+	uint32_t peakSamples = 0;    ///< and the samples it rendered
+	uint32_t voicesNow = 0;      ///< Active voices after the last call
+	uint32_t voicesMax = 0;      ///< Most active voices after any call
+	uint32_t direMax = 0;        ///< Highest AudioEngine::cpuDireness after any call
+	uint32_t direSamples = 0;    ///< Samples rendered while cpuDireness was above 0
+	uint32_t culled = 0;         ///< Voices culled because the CPU was behind
+	uint32_t sdLoads = 0;        ///< Sample clusters read from the SD card
+	uint64_t sdTicks = 0;        ///< Their summed read time (wall clock, including the audio routine calls meanwhile)
+	uint64_t sdCardTicks = 0;    ///< The same without the audio routine calls that ran while waiting for the card
+	uint32_t sdMaxTicks = 0;     ///< The longest read (wall clock)
+	uint32_t sdCardMaxTicks = 0; ///< The longest read without the audio routine calls meanwhile
+	uint32_t maxGapTicks = 0;    ///< Longest time between the starts of two audio routine calls
+};
+
+/// Adds a later window to an earlier one (or to an empty one)
+void merge(Window& into, const Window& later);
+
+/// What is shown and sent, in whole units
+struct Summary {
+	uint32_t windowMs;
+	uint32_t dspAvgPermille;  ///< Render time / audio time rendered, in 0.1 %
+	uint32_t dspPeakPermille; ///< The same for the busiest call (one or two blocks)
+	uint32_t voicesNow;
+	uint32_t voicesMax;
+	uint32_t direMax;
+	uint32_t direSharePermille; ///< Share of the audio rendered while cpuDireness was above 0, in 0.1 %
+	uint32_t culled;
+	uint32_t sdLoads;
+	uint32_t sdAvgUs; ///< Wall clock from the start of a read to its end: what streaming has to wait
+	uint32_t sdMaxUs;
+	uint32_t maxGapUs;
+	uint32_t samples;
+	uint32_t sdCardAvgUs; ///< The same without the audio rendered meanwhile: how fast the card is
+	uint32_t sdCardMaxUs;
+};
+
+Summary summarize(const Window& w);
+
+/// Collects the numbers. Each call of the audio routine is framed by routineStart() and routineDone(); the others may
+/// come from anywhere in the main loop. Readers use readHalf() / readSecond(), which never block and never return a
+/// half-written window.
+class Collector {
+public:
+	bool running() const { return running_; }
+	void stop() { running_ = false; }
+
+	void routineStart(uint32_t now, uint32_t sampleCounter);
+	/// voices and direness as they are after the call
+	void routineDone(uint32_t now, uint32_t sampleCounter, uint32_t voices, int32_t direness);
+
+	/// Time spent in the audio routine since it first ran: never reset, wraps (every 129 s of rendering). The
+	/// difference (as uint32_t) of two readings is the render time in between.
+	uint32_t busyTicksTotal() const { return busyTotal_; }
+
+	/// readTicks: wall clock of the read; audioTicks: busyTicksTotal() at its end minus at its start
+	void clusterLoaded(uint32_t readTicks, uint32_t audioTicks);
+	void voiceCulled() { acc_.culled++; }
+
+	/// The latest half-second window, if there is one newer than lastSeq (which is updated)
+	bool readHalf(Window& out, uint32_t& lastSeq) const { return read(half_, out, lastSeq); }
+	/// The latest one-second window (two halves), if there is one newer than lastSeq (which is updated)
+	bool readSecond(Window& out, uint32_t& lastSeq) const { return read(second_, out, lastSeq); }
+
+private:
+	struct Slot {
+		volatile uint32_t seq = 0; // Odd while being written
+		Window window;
+	};
+	static void publish(Slot& slot, const Window& w);
+	static bool read(const Slot& slot, Window& out, uint32_t& lastSeq);
+
+	bool running_ = false;
+	uint32_t windowStart_ = 0;
+	uint32_t routineStart_ = 0;
+	uint32_t routineSamplesStart_ = 0;
+	uint32_t lastVoices_ = 0;
+	uint32_t busyTotal_ = 0;
+	int32_t halvesInSecond_ = 0;
+	Window acc_;
+	Window secondAcc_;
+	Slot half_;
+	Slot second_;
+};
+
+/// SysEx: F0 00 21 7B 01 10, then the payload, then F7. Each field is 1, 2 or 4 bytes of 7 bits, least significant
+/// first, saturated at the largest value that fits:
+///   format version (1) = 2, sequence number (2, counts seconds, wraps at 16384), window length in ms (2),
+///   CPU average in 0.1 % (2), CPU peak in 0.1 % (2), voices now (2), voices max (2), direness max (1),
+///   time with direness above 0 in 0.1 % (2), voices culled (2), SD cluster reads (2), their average in us (4),
+///   the longest in us (4), longest time between two audio routine calls in us (4), samples rendered (4),
+///   from version 2: SD cluster reads without the audio rendered meanwhile, average in us (4), the longest in us (4).
+/// The first SD pair is wall clock: while the read waits for the card, the audio routine and other tasks run.
+/// Readers accept a longer payload, so fields can be added at the end.
+constexpr uint8_t kSysexCommand = 0x10;
+constexpr uint8_t kSysexFormatVersion = 2;
+constexpr size_t kSysexPayloadLength = 44;
+constexpr size_t kSysexLength = 6 + kSysexPayloadLength + 1;
+
+/// Writes the whole message (kSysexLength bytes, all data bytes below 0x80) and returns its length
+size_t encodeSysex(const Summary& s, uint32_t seq, uint8_t* out);
+
+/// Characters that fit on one OLED line in the small font
+constexpr size_t kLineChars = 21;
+/// "C43/71% V24 D0 S2.4/9": CPU average/peak, voices, direness, SD average/longest read in ms (without the audio
+/// rendered meanwhile). Gets shorter when the numbers are big, never more than kLineChars.
+void formatLine(const Summary& s, char* buffer, size_t size);
+/// "C 43": CPU average for the 7-segment display
+void formatSevenSegment(const Summary& s, char* buffer, size_t size);
+
+} // namespace cpu_stats
