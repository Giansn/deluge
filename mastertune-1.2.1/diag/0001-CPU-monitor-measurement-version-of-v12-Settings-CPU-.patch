+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "processing/engines/cpu_stats_core.h"
+#include <atomic>
+#include <cstring>
+
+#include "lib/printf.h" // Not stdio: the firmware's snprintf, which doesn't allocate
+
+namespace cpu_stats {
+
+namespace {
+
+uint32_t saturate(uint64_t value) {
+	return (value > UINT32_MAX) ? UINT32_MAX : (uint32_t)value;
+}
+
+uint32_t addSaturated(uint32_t a, uint32_t b) {
+	return saturate((uint64_t)a + b);
+}
+
+uint32_t divideRounded(uint64_t numerator, uint64_t denominator) {
+	return (denominator == 0) ? 0 : saturate((numerator + denominator / 2) / denominator);
+}
+
+/// Render time over the audio time rendered, in 0.1 %. 1000 * 44100 / 33330000 = 4410 / 3333.
+uint32_t loadPermille(uint64_t ticks, uint32_t samples) {
+	return divideRounded(ticks * 4410, (uint64_t)samples * 3333);
+}
+
+/// 1000000 / 33330000 = 100 / 3333
+uint32_t ticksToUs(uint64_t ticks) {
+	return divideRounded(ticks * 100, 3333);
+}
+
+/// Whether a block of ticksA / samplesA was busier than one of ticksB / samplesB (samplesA > 0)
+bool busier(uint32_t ticksA, uint32_t samplesA, uint32_t ticksB, uint32_t samplesB) {
+	return samplesB == 0 || (uint64_t)ticksA * samplesB > (uint64_t)ticksB * samplesA;
+}
+
+void compilerBarrier() {
+	std::atomic_signal_fence(std::memory_order_seq_cst);
+}
+
+} // namespace
+
+void merge(Window& into, const Window& later) {
+	into.ticks = addSaturated(into.ticks, later.ticks);
+	into.busyTicks += later.busyTicks;
+	into.samples = addSaturated(into.samples, later.samples);
+	if (later.peakSamples != 0 && busier(later.peakTicks, later.peakSamples, into.peakTicks, into.peakSamples)) {
+		into.peakTicks = later.peakTicks;
+		into.peakSamples = later.peakSamples;
+	}
+	into.voicesNow = later.voicesNow;
+	if (later.voicesMax > into.voicesMax) {
+		into.voicesMax = later.voicesMax;
+	}
+	if (later.direMax > into.direMax) {
+		into.direMax = later.direMax;
+	}
+	into.direSamples = addSaturated(into.direSamples, later.direSamples);
+	into.culled = addSaturated(into.culled, later.culled);
+	into.sdLoads = addSaturated(into.sdLoads, later.sdLoads);
+	into.sdTicks += later.sdTicks;
+	into.sdCardTicks += later.sdCardTicks;
+	if (later.sdMaxTicks > into.sdMaxTicks) {
+		into.sdMaxTicks = later.sdMaxTicks;
+	}
+	if (later.sdCardMaxTicks > into.sdCardMaxTicks) {
+		into.sdCardMaxTicks = later.sdCardMaxTicks;
+	}
+	if (later.maxGapTicks > into.maxGapTicks) {
+		into.maxGapTicks = later.maxGapTicks;
+	}
+}
+
+Summary summarize(const Window& w) {
+	Summary s{};
+	s.windowMs = divideRounded((uint64_t)w.ticks * 1000, kTicksPerSecond);
+	s.dspAvgPermille = loadPermille(w.busyTicks, w.samples);
+	s.dspPeakPermille = loadPermille(w.peakTicks, w.peakSamples);
+	s.voicesNow = w.voicesNow;
+	s.voicesMax = w.voicesMax;
+	s.direMax = w.direMax;
+	s.direSharePermille = divideRounded((uint64_t)w.direSamples * 1000, w.samples);
+	s.culled = w.culled;
+	s.sdLoads = w.sdLoads;
+	s.sdAvgUs = (w.sdLoads != 0) ? ticksToUs(w.sdTicks / w.sdLoads) : 0;
+	s.sdMaxUs = ticksToUs(w.sdMaxTicks);
+	s.maxGapUs = ticksToUs(w.maxGapTicks);
+	s.samples = w.samples;
+	s.sdCardAvgUs = (w.sdLoads != 0) ? ticksToUs(w.sdCardTicks / w.sdLoads) : 0;
+	s.sdCardMaxUs = ticksToUs(w.sdCardMaxTicks);
+	return s;
+}
+
+void Collector::routineStart(uint32_t now, uint32_t sampleCounter) {
+	if (!running_) {
+		running_ = true;
+		acc_ = Window{};
+		secondAcc_ = Window{};
+		halvesInSecond_ = 0;
+		lastVoices_ = 0;
+		windowStart_ = now;
+	}
+	else {
+		uint32_t gap = now - routineStart_;
+		if (gap > acc_.maxGapTicks) {
+			acc_.maxGapTicks = gap;
+		}
+	}
+	routineStart_ = now;
+	routineSamplesStart_ = sampleCounter;
+}
+
+void Collector::routineDone(uint32_t now, uint32_t sampleCounter, uint32_t voices, int32_t direness) {
+	uint32_t ticks = now - routineStart_;
+	uint32_t samples = sampleCounter - routineSamplesStart_;
+	busyTotal_ += ticks; // Wraps, which is fine for differences
+	acc_.busyTicks += ticks;
+	acc_.samples = addSaturated(acc_.samples, samples);
+	if (samples >= kMinPeakSamples && busier(ticks, samples, acc_.peakTicks, acc_.peakSamples)) {
+		acc_.peakTicks = ticks;
+		acc_.peakSamples = samples;
+	}
+	lastVoices_ = voices;
+	if (voices > acc_.voicesMax) {
+		acc_.voicesMax = voices;
+	}
+	if (direness > 0) {
+		acc_.direSamples = addSaturated(acc_.direSamples, samples);
+		if ((uint32_t)direness > acc_.direMax) {
+			acc_.direMax = direness;
+		}
+	}
+
+	uint32_t elapsed = now - windowStart_;
+	if (elapsed < kWindowTicks) {
+		return;
+	}
+	acc_.ticks = elapsed;
+	acc_.voicesNow = lastVoices_;
+	publish(half_, acc_);
+	merge(secondAcc_, acc_);
+	if (++halvesInSecond_ >= 2) {
+		publish(second_, secondAcc_);
+		secondAcc_ = Window{};
+		halvesInSecond_ = 0;
+	}
+	acc_ = Window{};
+	windowStart_ = now;
+}
+
+void Collector::clusterLoaded(uint32_t readTicks, uint32_t audioTicks) {
+	// Only audio routine calls that ran while waiting for the card can be in audioTicks, so it can't be more than the
+	// read took (unless the monitor was switched on in between); be safe anyway
+	uint32_t cardTicks = (audioTicks < readTicks) ? readTicks - audioTicks : 0;
+	acc_.sdLoads = addSaturated(acc_.sdLoads, 1);
+	acc_.sdTicks += readTicks;
+	acc_.sdCardTicks += cardTicks;
+	if (readTicks > acc_.sdMaxTicks) {
+		acc_.sdMaxTicks = readTicks;
+	}
+	if (cardTicks > acc_.sdCardMaxTicks) {
+		acc_.sdCardMaxTicks = cardTicks;
+	}
+}
+
+void Collector::publish(Slot& slot, const Window& w) {
+	slot.seq = slot.seq + 1; // Odd: being written
+	compilerBarrier();
+	slot.window = w;
+	compilerBarrier();
+	slot.seq = slot.seq + 1;
+}
+
+bool Collector::read(const Slot& slot, Window& out, uint32_t& lastSeq) {
+	uint32_t seq = slot.seq;
+	if ((seq & 1) || seq == lastSeq) {
+		return false;
+	}
+	compilerBarrier();
+	out = slot.window;
+	compilerBarrier();
+	if (slot.seq != seq) {
+		return false; // Written meanwhile (only possible from an interrupt): the next call gets it
+	}
+	lastSeq = seq;
+	return true;
+}
+
+namespace {
+
+class SysexWriter {
+public:
+	explicit SysexWriter(uint8_t* out) : out_(out) {}
+	void byte(uint8_t b) { out_[pos_++] = b; }
+	/// Little-endian groups of 7 bits, saturated to what fits
+	void value(uint32_t v, int32_t numBytes) {
+		uint32_t max = (1u << (7 * numBytes)) - 1;
+		if (v > max) {
+			v = max;
+		}
+		for (int32_t i = 0; i < numBytes; i++) {
+			byte((v >> (7 * i)) & 0x7F);
+		}
+	}
+	size_t length() const { return pos_; }
+
+private:
+	uint8_t* out_;
+	size_t pos_ = 0;
+};
+
+} // namespace
+
+size_t encodeSysex(const Summary& s, uint32_t seq, uint8_t* out) {
+	SysexWriter w{out};
+	w.byte(0xF0);
+	w.byte(0x00);
+	w.byte(0x21);
+	w.byte(0x7B);
+	w.byte(0x01);
+	w.byte(kSysexCommand);
+	w.value(kSysexFormatVersion, 1);
+	w.value(seq & 0x3FFF, 2);
+	w.value(s.windowMs, 2);
+	w.value(s.dspAvgPermille, 2);
+	w.value(s.dspPeakPermille, 2);
+	w.value(s.voicesNow, 2);
+	w.value(s.voicesMax, 2);
+	w.value(s.direMax, 1);
+	w.value(s.direSharePermille, 2);
+	w.value(s.culled, 2);
+	w.value(s.sdLoads, 2);
+	w.value(s.sdAvgUs, 4);
+	w.value(s.sdMaxUs, 4);
+	w.value(s.maxGapUs, 4);
+	w.value(s.samples, 4);
+	w.value(s.sdCardAvgUs, 4);
+	w.value(s.sdCardMaxUs, 4);
+	w.byte(0xF7);
+	return w.length();
+}
+
+namespace {
+
+uint32_t percent(uint32_t permille) {
+	uint32_t p = (permille + 5) / 10;
+	return (p > 999) ? 999 : p;
+}
+
+uint32_t atMost999(uint32_t value) {
+	return (value > 999) ? 999 : value;
+}
+
+} // namespace
+
+void formatLine(const Summary& s, char* buffer, size_t size) {
+	if (size == 0) {
+		return;
+	}
+	unsigned avg = percent(s.dspAvgPermille);
+	unsigned peak = percent(s.dspPeakPermille);
+	unsigned voices = atMost999(s.voicesNow);
+	unsigned dire = atMost999(s.direMax);
+
+	// SD, without the audio rendered while waiting for the card: average read with one decimal below 10 ms, longest
+	// read rounded up to whole ms, "S-" if nothing was read
+	char sdLong[24];
+	char sdShort[8];
+	if (s.sdLoads == 0) {
+		strcpy(sdLong, "S-");
+		strcpy(sdShort, "S-");
+	}
+	else {
+		unsigned sdMaxMs = atMost999((s.sdCardMaxUs + 999) / 1000);
+		if (s.sdCardAvgUs < 9950) {
+			unsigned tenths = (s.sdCardAvgUs + 50) / 100;
+			snprintf(sdLong, sizeof(sdLong), "S%u.%u/%u", tenths / 10, tenths % 10, sdMaxMs);
+		}
+		else {
+			snprintf(sdLong, sizeof(sdLong), "S%u/%u", (unsigned)atMost999((s.sdCardAvgUs + 500) / 1000), sdMaxMs);
+		}
+		snprintf(sdShort, sizeof(sdShort), "S%u", sdMaxMs);
+	}
+
+	// The first that fits: the last one always does, as all numbers are below 1000
+	char line[48];
+	snprintf(line, sizeof(line), "C%u/%u%% V%u D%u %s", avg, peak, voices, dire, sdLong);
+	if (strlen(line) > kLineChars) {
+		snprintf(line, sizeof(line), "C%u/%u V%u D%u %s", avg, peak, voices, dire, sdLong);
+	}
+	if (strlen(line) > kLineChars) {
+		snprintf(line, sizeof(line), "C%u/%u V%u D%u %s", avg, peak, voices, dire, sdShort);
+	}
+	if (strlen(line) > kLineChars) {
+		snprintf(line, sizeof(line), "C%u/%u V%u D%u", avg, peak, voices, dire);
+	}
+	line[kLineChars] = 0;
+	snprintf(buffer, size, "%s", line);
+}
+
+void formatSevenSegment(const Summary& s, char* buffer, size_t size) {
+	snprintf(buffer, size, "C%3u", (unsigned)percent(s.dspAvgPermille));
+}
+
+} // namespace cpu_stats
