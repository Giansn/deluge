+
+#include "processing/engines/cpu_stats.h"
+#include "hid/display/display.h"
+#include "hid/display/oled.h"
+#include "io/midi/midi_device.h"
+#include "io/midi/midi_device_manager.h"
+#include "io/midi/sysex.h"
+#include "processing/engines/audio_engine.h"
+
+extern "C" {
+#include "RZA1/ostm/ostm.h"
+}
+
+namespace cpu_stats {
+
+static_assert(kSysexCommand == SysEx::SysexCommands::CpuStats);
+
+bool enabled = false;
+Collector collector;
+
+namespace {
+
+/// Room that must stay free in the USB MIDI send buffer, so the numbers never crowd out notes or clock
+constexpr int32_t kMinUsbSendSpace = 1024;
+
+bool wasEnabled = false;
+uint32_t lastHalfSeq = 0;
+uint32_t lastSecondSeq = 0;
+Window previousHalf;
+char line[kLineChars + 1]; // Empty until the first window is in
+uint32_t sysexSeq = 0;
+uint32_t secondsSeen = 0;
+uint8_t sysexMessage[kSysexLength];
+
+void sendSysex(const Summary& summary) {
+	uint32_t seq = sysexSeq++;
+	// Only to the computer, on USB port 3 (not used for notes); 0 space if the Deluge isn't connected to one
+	MIDIDeviceUSBUpstream& port = MIDIDeviceManager::upstreamUSBMIDIDevice_port3;
+	if (port.sendBufferSpace() < kMinUsbSendSpace) {
+		return;
+	}
+	size_t length = encodeSysex(summary, seq, sysexMessage);
+	port.sendSysex(sysexMessage, (int32_t)length);
+}
+
+void markOLEDChanged() {
+	if (display->haveOLED()) {
+		deluge::hid::display::OLED::markChanged();
+	}
+}
+
+} // namespace
+
+uint32_t now() {
+	return getTimerValue(0);
+}
+
+void routineStart() {
+	uint32_t time = now();
+	collector.routineStart(time, AudioEngine::audioSampleTimer);
+}
+
+void routineDone() {
+	uint32_t time = now();
+	collector.routineDone(time, AudioEngine::audioSampleTimer, AudioEngine::getNumVoices(), AudioEngine::cpuDireness);
+}
+
+ReadStart readStart() {
+	return ReadStart{now(), collector.busyTicksTotal()};
+}
+
+void clusterLoaded(ReadStart start) {
+	if (enabled) {
+		collector.clusterLoaded(now() - start.time, collector.busyTicksTotal() - start.busyTicks);
+	}
+}
+
+void routine() {
+	if (!enabled) {
+		if (wasEnabled) {
+			wasEnabled = false;
+			collector.stop();
+			line[0] = 0;
+			markOLEDChanged(); // Takes the line away
+		}
+		return;
+	}
+
+	Window window;
+	if (!wasEnabled) {
+		wasEnabled = true;
+		previousHalf = Window{};
+		line[0] = 0;
+		// Skip anything left over from before
+		collector.readHalf(window, lastHalfSeq);
+		collector.readSecond(window, lastSecondSeq);
+		return;
+	}
+
+	// OLED: the last two half-second windows, so the line is new twice a second
+	if (collector.readHalf(window, lastHalfSeq)) {
+		Window shown = previousHalf;
+		merge(shown, window);
+		previousHalf = window;
+		if (display->haveOLED()) {
+			formatLine(summarize(shown), line, sizeof(line));
+			deluge::hid::display::OLED::markChanged();
+		}
+		else {
+			line[0] = 0;
+		}
+	}
+
+	// SysEx each second; the 7-segment display gets a short popup every other second, unless it shows another one
+	if (collector.readSecond(window, lastSecondSeq)) {
+		Summary summary = summarize(window);
+		sendSysex(summary);
+		if (!display->haveOLED() && (secondsSeen++ & 1) == 0 && !display->hasPopup()) {
+			char text[8];
+			formatSevenSegment(summary, text, sizeof(text));
+			display->displayPopup(text, 1);
+		}
+	}
+}
+
+char const* oledLine() {
+	return (enabled && line[0]) ? line : nullptr;
+}
+
+} // namespace cpu_stats
