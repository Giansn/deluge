+// mastertune-diag: Settings > CPU monitor counts the voices the CPU guard (cullVoices(), the only caller that names no
+// Sound) really cuts short, each once: not a call that leaves its voice as it was, nor a voice already fading fast or
+// stopped
+static void countCulledVoice(Sound* stopFrom) {
+	if (stopFrom == nullptr) {
+		cpu_stats::voiceCulled();
+	}
+}
+
 // To be called when CPU is overloaded and we need to free it up. This stops the voice which has been
 // releasing longest, or if none, the voice playing longest.
 Voice* cullVoice(bool saveVoice, CullType type, size_t numSamples, Sound* stopFrom) {
@@ -335,6 +345,9 @@ Voice* cullVoice(bool saveVoice, CullType type, size_t numSamples, Sound* stopFr
 		case SOFT: {
 			if (bestVoice->envelopes[0].state < EnvelopeStage::FAST_RELEASE
 			    || bestVoice->envelopes[0].fastReleaseIncrement < SOFT_CULL_INCREMENT) {
+				if (bestVoice->envelopes[0].state != EnvelopeStage::OFF) { // mastertune-diag
+					countCulledVoice(stopFrom);
+				}
 				bool stillGoing = bestVoice->doFastRelease(SOFT_CULL_INCREMENT);
 
 				if (!stillGoing) {
@@ -353,7 +366,12 @@ Voice* cullVoice(bool saveVoice, CullType type, size_t numSamples, Sound* stopFr
 		}
 
 		case FORCE: {
+			// mastertune-diag: a voice still sounding normally, not one already stopped or counted as soft-culled
+			bool wasSounding = bestVoice->envelopes[0].state < EnvelopeStage::FAST_RELEASE;
 			bool stillGoing = bestVoice->doImmediateRelease();
+			if (wasSounding || !stillGoing) {
+				countCulledVoice(stopFrom);
+			}
 
 			if (!stillGoing) {
 				unassignVoice(bestVoice, bestVoice->assignedToSound);
@@ -365,6 +383,7 @@ Voice* cullVoice(bool saveVoice, CullType type, size_t numSamples, Sound* stopFr
 			break;
 		}
 		case HARD:
+			countCulledVoice(stopFrom); // mastertune-diag
 			unassignVoice(bestVoice, bestVoice->assignedToSound, NULL, true, !saveVoice);
 			D_PRINTLN("hard-culled 1 voice.  numSamples:  %d. Voices left: %d. Audio clips left: %d", numSamples,
 			          getNumVoices(), getNumAudio());
@@ -1064,7 +1083,9 @@ void scheduleMidiGateOutISR(uint32_t saddrPosAtStart, int32_t unadjustedNumSampl
 	}
 }
 
-void routine() {
+/// The audio routine exactly as in v12. mastertune-diag: kept in a function of its own, so its machine code (with the
+/// whole render inlined) stays the same, and measured from outside by routine() below.
+[[gnu::noinline]] static void routineUnmeasured() {
 
 	logAction("AudioDriver::routine");
 
@@ -1117,6 +1138,19 @@ void routine() {
 	routineBeenCalled = true;
 }
 
+void routine() {
+	// mastertune-diag: Settings > CPU monitor measures each call. Not calls from inside a call, which return at once,
+	// and not the offline stem export, which renders as fast as it can.
+	if (cpu_stats::enabled && !audioRoutineLocked && !(stemExport.processStarted && stemExport.renderOffline))
+	    [[unlikely]] {
+		cpu_stats::routineStart();
+		routineUnmeasured();
+		cpu_stats::routineDone();
+		return;
+	}
+	routineUnmeasured();
+}
+
 int32_t getNumSamplesLeftToOutputFromPreviousRender() {
 	return ((uint32_t)renderingBufferOutputEnd - (uint32_t)renderingBufferOutputPos) >> 3;
 }
