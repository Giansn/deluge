+ * without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+// CPU monitor (mastertune-v12-diag): Settings > CPU monitor, off after every power-up. While on, it measures how long
+// AudioEngine::routine() takes for the audio it renders, counts voices, direness, culled voices and SD cluster reads,
+// shows a line on the OLED (a short popup on the 7-segment display) and sends the numbers once a second as SysEx to
+// the computer over USB MIDI (port 3, never to DIN). It only measures: no sound is changed. While off, each hook costs
+// one flag test. The SysEx format is in cpu_stats_core.h, the page that shows it is
+// mastertune-1.2.1/tools/cpu_monitor.html.
+
+#include "processing/engines/cpu_stats_core.h"
+
+namespace cpu_stats {
+
+extern bool enabled;
+extern Collector collector;
+
+/// OS timer 0, see cpu_stats_core.h
+uint32_t now();
+
+/// Frame one call of AudioEngine::routine(), only while enabled
+void routineStart();
+void routineDone();
+
+/// A voice was culled because the CPU was behind
+inline void voiceCulled() {
+	if (enabled) [[unlikely]] {
+		collector.voiceCulled();
+	}
+}
+
+/// Taken just before a sample cluster is read from the SD card
+struct ReadStart {
+	uint32_t time;      ///< now()
+	uint32_t busyTicks; ///< Collector::busyTicksTotal()
+};
+ReadStart readStart();
+
+/// That read has finished. Records its wall-clock time and, apart, the time without the audio routine calls that ran
+/// while the read waited for the card (it yields to the task manager meanwhile).
+void clusterLoaded(ReadStart start);
+
+/// Task, a few times a second: display and SysEx
+void routine();
+
+/// The OLED line, drawn on top of every image sent to the OLED, or nullptr
+char const* oledLine();
+
+} // namespace cpu_stats
